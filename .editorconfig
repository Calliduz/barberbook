root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_space_after_cast = false

[*.{json,yml,yaml,xml}]
indent_size = 2

[*.{html,cshtml,razor}]
indent_size = 2

[*.{js,ts,jsx,tsx,css}]
indent_size = 2

