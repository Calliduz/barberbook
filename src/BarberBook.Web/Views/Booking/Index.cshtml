@model BarberBook.Web.Models.Appointment.BookingWizardViewModel
@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "Book an Appointment";
}

<div class="max-w-3xl mx-auto px-4 py-8 sm:px-6">
    <!-- Header -->
    <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
            <span>MASTER GROOMING SCHEDULER</span>
        </div>
        <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight sm:text-4xl">Book an Appointment</h1>
        <p class="mt-2 text-sm text-slate-600 font-light">Select your service, preferred craftsman, date and available time slot.</p>
    </div>

    <!-- Stepper Indicator -->
    <div class="mb-8">
        <div class="flex items-center justify-between relative">
            <div class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-1 bg-slate-200 -z-0"></div>
            <div id="step-progress-bar" class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-amber-500 transition-all duration-300 -z-0" style="width: 0%;"></div>

            <!-- Step 1 Indicator -->
            <button type="button" onclick="goToStep(1)" id="step-indicator-1" aria-label="Step 1: Choose Service" class="relative z-10 w-9 h-9 rounded-full flex items-center justify-center text-xs font-black border-2 transition-colors bg-amber-500 text-slate-950 border-amber-500 shadow-md focus:outline-none focus:ring-2 focus:ring-amber-500">
                1
            </button>
            <!-- Step 2 Indicator -->
            <button type="button" onclick="goToStep(2)" id="step-indicator-2" aria-label="Step 2: Choose Barber" class="relative z-10 w-9 h-9 rounded-full flex items-center justify-center text-xs font-semibold border-2 transition-colors bg-white text-slate-500 border-slate-300 focus:outline-none focus:ring-2 focus:ring-amber-500">
                2
            </button>
            <!-- Step 3 Indicator -->
            <button type="button" onclick="goToStep(3)" id="step-indicator-3" aria-label="Step 3: Select Date and Time" class="relative z-10 w-9 h-9 rounded-full flex items-center justify-center text-xs font-semibold border-2 transition-colors bg-white text-slate-500 border-slate-300 focus:outline-none focus:ring-2 focus:ring-amber-500">
                3
            </button>
            <!-- Step 4 Indicator -->
            <button type="button" onclick="goToStep(4)" id="step-indicator-4" aria-label="Step 4: Review and Confirm Booking" class="relative z-10 w-9 h-9 rounded-full flex items-center justify-center text-xs font-semibold border-2 transition-colors bg-white text-slate-500 border-slate-300 focus:outline-none focus:ring-2 focus:ring-amber-500">
                4
            </button>
        </div>
        <div class="flex justify-between text-[11px] sm:text-xs text-slate-600 font-semibold mt-2 px-1">
            <span>1. Service</span>
            <span>2. Barber</span>
            <span>3. Date & Time</span>
            <span>4. Review</span>
        </div>
    </div>

    <!-- Error Alert Box -->
    <div id="wizard-error-box" class="hidden mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm shadow-sm" role="alert" aria-live="assertive">
        <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div id="wizard-error-message" class="font-medium"></div>
        </div>
    </div>

    <!-- Step 1: Choose Service -->
    <div id="wizard-step-1" class="wizard-step">
        <h2 class="text-xl font-serif font-black text-slate-900 tracking-tight mb-4">Choose a Service</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            @foreach (var svc in Model.Services)
            {
                <div class="service-card cursor-pointer p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:border-amber-500/60 hover:shadow-md transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2"
                     tabindex="0"
                     role="button"
                     aria-pressed="false"
                     aria-label="Select service @svc.Name for @svc.FormattedPrice"
                     data-id="@svc.Id"
                     data-name="@svc.Name"
                     data-price="@svc.FormattedPrice"
                     data-duration="@svc.DurationMinutes"
                     onclick="selectService(@svc.Id, '@svc.Name', '@svc.FormattedPrice', @svc.DurationMinutes)"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectService(@svc.Id, '@svc.Name', '@svc.FormattedPrice', @svc.DurationMinutes);}">
                    <div class="flex justify-between items-start gap-2">
                        <h3 class="text-lg font-serif font-bold text-slate-900">@svc.Name</h3>
                        <span class="text-amber-800 font-mono font-bold text-lg whitespace-nowrap">@svc.FormattedPrice</span>
                    </div>
                    <p class="text-xs text-slate-600 mt-1 line-clamp-2">@svc.Description</p>
                    <div class="mt-3 flex items-center text-xs text-slate-500">
                        <svg class="w-4 h-4 mr-1 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="font-medium">@svc.DurationMinutes mins</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Step 2: Choose Barber -->
    <div id="wizard-step-2" class="wizard-step hidden">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-serif font-black text-slate-900 tracking-tight">Choose a Barber</h2>
            <button type="button" onclick="goToStep(1)" class="text-xs text-amber-800 hover:text-amber-900 font-bold px-2 py-1 rounded-lg hover:bg-amber-100 transition focus:outline-none focus:ring-2 focus:ring-amber-500">&larr; Change Service</button>
        </div>

        @if (Model.Branches.Any())
        {
            <!-- Branch Filter Chips -->
            <div class="mb-4 flex flex-wrap items-center gap-2">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Branch:</span>
                <button type="button" onclick="filterBarbersByBranch(null)" id="branch-chip-all" class="branch-chip px-3 py-1.5 rounded-lg text-xs font-bold transition bg-amber-500 text-slate-950 shadow-xs">
                    All Locations
                </button>
                @foreach (var br in Model.Branches)
                {
                    <button type="button" onclick="filterBarbersByBranch(@br.Id)" id="branch-chip-@br.Id" class="branch-chip px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 bg-slate-200/80 hover:bg-slate-300 transition">
                        @br.Name
                    </button>
                }
            </div>
        }

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="barbers-list-container">
            @foreach (var barber in Model.Barbers)
            {
                <div class="barber-card cursor-pointer p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:border-amber-500/60 hover:shadow-md transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2"
                     tabindex="0"
                     role="button"
                     aria-pressed="false"
                     aria-label="Select master barber @barber.DisplayName"
                     data-id="@barber.Id"
                     data-name="@barber.DisplayName"
                     data-branch-id="@(barber.BranchId?.ToString() ?? "0")"
                     onclick="selectBarber(@barber.Id, '@barber.DisplayName')"
                     onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();selectBarber(@barber.Id, '@barber.DisplayName');}">
                    <div class="flex items-center gap-4">
                        @if (!string.IsNullOrEmpty(barber.PhotoUrl))
                        {
                            <img src="@barber.PhotoUrl" alt="@barber.DisplayName" class="w-14 h-14 rounded-full object-cover border-2 border-slate-200 shadow-sm" />
                        }
                        else
                        {
                            <div class="w-14 h-14 rounded-full bg-amber-500/20 text-amber-700 border-2 border-amber-500/30 font-bold text-xl flex items-center justify-center shrink-0">
                                @(string.IsNullOrEmpty(barber.DisplayName) ? "B" : barber.DisplayName[..1].ToUpperInvariant())
                            </div>
                        }
                        <div class="flex-grow">
                            <div class="flex items-center justify-between">
                                <h3 class="text-lg font-serif font-bold text-slate-900">@barber.DisplayName</h3>
                                @if (!string.IsNullOrEmpty(barber.BranchName))
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 text-amber-900 border border-amber-200">
                                        <svg class="w-2.5 h-2.5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                        @barber.BranchName
                                    </span>
                                }
                            </div>
                            <p class="text-xs text-amber-800 font-semibold mt-0.5">@barber.Specialties</p>
                        </div>
                    </div>
                    <p class="text-xs text-slate-600 mt-3 line-clamp-2">@barber.Bio</p>
                    <div class="mt-3 pt-3 border-t border-slate-100 text-[11px] text-slate-500 flex items-center">
                        <svg class="w-3.5 h-3.5 mr-1 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span>@barber.WeeklyScheduleText</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Step 3: Select Date & Time -->
    <div id="wizard-step-3" class="wizard-step hidden">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-serif font-black text-slate-900 tracking-tight">Select Date & Time</h2>
            <button type="button" onclick="goToStep(2)" class="text-xs text-amber-800 hover:text-amber-900 font-bold px-2 py-1 rounded-lg hover:bg-amber-100 transition focus:outline-none focus:ring-2 focus:ring-amber-500">&larr; Change Barber</button>
        </div>

        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 mb-6 shadow-sm">
            <label for="booking-date-picker" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Select Date</label>
            <input type="date" id="booking-date-picker" min="@Model.TodayDateString" value="@Model.TodayDateString"
                   onchange="onDateChanged()"
                   class="w-full sm:w-64 px-4 py-2.5 rounded-xl border border-slate-300 text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 font-medium text-sm shadow-xs" />
            <p class="text-xs text-slate-500 mt-1.5">Availability is computed live in Asia/Manila standard time.</p>
        </div>

        <div class="bg-white border border-slate-200/90 rounded-2xl p-5 shadow-sm">
            <h3 class="text-sm font-serif font-bold text-slate-900 mb-3 flex items-center gap-2">
                <span>Available Times</span>
                <span id="slots-count-badge" class="hidden text-xs px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 font-bold"></span>
            </h3>

            <!-- Loading Spinner -->
            <div id="slots-loading" class="py-10 text-center hidden" role="status" aria-label="Loading available time slots">
                <div class="inline-block w-7 h-7 border-3 border-amber-500/30 border-t-amber-500 rounded-full animate-spin"></div>
                <p class="text-xs text-slate-500 mt-2 font-medium">Checking real-time barber availability...</p>
            </div>

            <!-- Empty Slots Message -->
            <div id="slots-empty" class="py-10 text-center hidden bg-slate-50 rounded-xl p-6 border border-slate-100">
                <svg class="w-10 h-10 mx-auto text-slate-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <p class="text-sm font-bold text-slate-700">No available time slots on this date.</p>
                <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">The barber may be off, fully booked, or remaining intervals do not fit the service duration. Please pick another date.</p>
            </div>

            <!-- Slots Grid -->
            <div id="slots-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5">
                <!-- Dynamically rendered slot buttons -->
            </div>
        </div>
    </div>

    <!-- Step 4: Review & Book -->
    <div id="wizard-step-4" class="wizard-step hidden">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-serif font-black text-slate-900 tracking-tight">Review & Confirm Booking</h2>
            <button type="button" onclick="goToStep(3)" class="text-xs text-amber-800 hover:text-amber-900 font-bold px-2 py-1 rounded-lg hover:bg-amber-100 transition focus:outline-none focus:ring-2 focus:ring-amber-500">&larr; Change Time</button>
        </div>

        <div class="bg-white border border-slate-200/90 rounded-3xl p-6 sm:p-8 mb-6 divide-y divide-slate-100 shadow-sm">
            <div class="pb-4 flex justify-between items-start">
                <div>
                    <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Service</span>
                    <h3 id="review-service-name" class="text-xl font-serif font-bold text-slate-900 mt-0.5"></h3>
                    <p id="review-service-duration" class="text-xs text-slate-500 mt-0.5"></p>
                </div>
                <span id="review-service-price" class="text-2xl font-black text-slate-900 font-mono"></span>
            </div>

            <div class="py-4">
                <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Craftsman</span>
                <p id="review-barber-name" class="text-base font-bold text-slate-900 mt-0.5"></p>
            </div>

            <div class="py-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Appointment Date</span>
                    <p id="review-date-str" class="text-base font-bold text-slate-900 mt-0.5"></p>
                </div>
                <div>
                    <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Confirmed Slot</span>
                    <p id="review-time-str" class="text-base font-bold text-amber-800 mt-0.5"></p>
                </div>
            </div>

            <div class="pt-4">
                <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Customer Details</span>
                <div class="text-xs text-slate-700 mt-1 space-y-0.5">
                    <p><span class="text-slate-400">Name:</span> <strong class="text-slate-900 font-bold">@Model.CustomerName</strong></p>
                    <p><span class="text-slate-400">Email:</span> @Model.CustomerEmail</p>
                    @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                    {
                        <p><span class="text-slate-400">Phone:</span> @Model.CustomerPhone</p>
                    }
                </div>
            </div>
        </div>

        <!-- Optional Notes -->
        <div class="mb-6">
            <label for="booking-notes" class="block text-sm font-semibold text-slate-800 mb-1.5">Special Requests or Notes <span class="text-slate-400 text-xs font-normal">(optional)</span></label>
            <textarea id="booking-notes" rows="2" maxlength="500" placeholder="e.g. Skin fade with razor finish, sensitive skin..."
                      class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 text-sm shadow-xs"></textarea>
            <p class="text-[11px] text-slate-500 mt-1">Payment is settled directly in cash or in-shop after your grooming service.</p>
        </div>

        <!-- Submit Button -->
        <button type="button" id="submit-booking-btn" onclick="submitBooking()"
                class="w-full py-4 px-6 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-base transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2">
            <span>Confirm & Book Appointment &rarr;</span>
        </button>
    </div>
</div>

<script>
    // State
    const state = {
        serviceId: @(Model.PreSelectedServiceId.HasValue ? Model.PreSelectedServiceId.Value.ToString() : "null"),
        serviceName: '',
        servicePrice: '',
        serviceDuration: 0,
        barberId: @(Model.PreSelectedBarberId.HasValue ? Model.PreSelectedBarberId.Value.ToString() : "null"),
        barberName: '',
        date: '@Model.TodayDateString',
        slotUtc: '',
        slotFormattedTime: '',
        currentStep: 1
    };

    document.addEventListener('DOMContentLoaded', () => {
        // Check for deep-linked query parameters or pre-selections
        if (state.serviceId) {
            const card = document.querySelector(`.service-card[data-id="${state.serviceId}"]`);
            if (card) {
                state.serviceName = card.dataset.name;
                state.servicePrice = card.dataset.price;
                state.serviceDuration = parseInt(card.dataset.duration, 10);
                highlightCard(card, 'service');
            }
        }

        if (state.barberId) {
            const card = document.querySelector(`.barber-card[data-id="${state.barberId}"]`);
            if (card) {
                state.barberName = card.dataset.name;
                highlightCard(card, 'barber');
            }
        }

        // Check for branch filter from URL query param
        const urlParams = new URLSearchParams(window.location.search);
        const branchParam = urlParams.get('branchId');
        if (branchParam) {
            filterBarbersByBranch(parseInt(branchParam, 10));
        }

        // Determine initial step based on pre-selections
        if (state.serviceId && state.barberId) {
            goToStep(3);
        } else if (state.serviceId) {
            goToStep(2);
        } else {
            goToStep(1);
        }
    });

    function showError(msg) {
        const box = document.getElementById('wizard-error-box');
        const text = document.getElementById('wizard-error-message');
        text.innerText = msg;
        box.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function clearError() {
        const box = document.getElementById('wizard-error-box');
        box.classList.add('hidden');
    }

    function goToStep(step) {
        clearError();

        if (step > 1 && !state.serviceId) {
            showError('Please select a service first.');
            return;
        }
        if (step > 2 && !state.barberId) {
            showError('Please select a barber first.');
            return;
        }
        if (step > 3 && (!state.slotUtc || !state.date)) {
            showError('Please select a date and an available time slot.');
            return;
        }

        state.currentStep = step;

        // Hide all steps
        for (let i = 1; i <= 4; i++) {
            const el = document.getElementById(`wizard-step-${i}`);
            if (el) el.classList.toggle('hidden', i !== step);

            const ind = document.getElementById(`step-indicator-${i}`);
            if (ind) {
                if (i < step) {
                    ind.className = 'relative z-10 w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold border-2 transition-colors bg-amber-100 text-amber-900 border-amber-500 shadow-xs';
                } else if (i === step) {
                    ind.className = 'relative z-10 w-9 h-9 rounded-full flex items-center justify-center text-xs font-black border-2 transition-colors bg-amber-500 text-slate-950 border-amber-500 shadow-md';
                } else {
                    ind.className = 'relative z-10 w-9 h-9 rounded-full flex items-center justify-center text-xs font-semibold border-2 transition-colors bg-white text-slate-400 border-slate-300';
                }
            }
        }

        const progressPercent = ((step - 1) / 3) * 100;
        document.getElementById('step-progress-bar').style.width = `${progressPercent}%`;

        if (step === 3) {
            loadAvailability();
        } else if (step === 4) {
            populateReview();
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function selectService(id, name, price, duration) {
        state.serviceId = id;
        state.serviceName = name;
        state.servicePrice = price;
        state.serviceDuration = duration;

        document.querySelectorAll('.service-card').forEach(c => {
            c.classList.remove('border-amber-500', 'bg-amber-50/40', 'ring-2', 'ring-amber-500/20');
            c.classList.add('border-slate-200/90', 'bg-white');
        });
        const chosen = document.querySelector(`.service-card[data-id="${id}"]`);
        if (chosen) highlightCard(chosen, 'service');

        goToStep(2);
    }

    function selectBarber(id, name) {
        state.barberId = id;
        state.barberName = name;

        document.querySelectorAll('.barber-card').forEach(c => {
            c.classList.remove('border-amber-500', 'bg-amber-50/40', 'ring-2', 'ring-amber-500/20');
            c.classList.add('border-slate-200/90', 'bg-white');
        });
        const chosen = document.querySelector(`.barber-card[data-id="${id}"]`);
        if (chosen) highlightCard(chosen, 'barber');

        goToStep(3);
    }

    function filterBarbersByBranch(branchId) {
        document.querySelectorAll('.branch-chip').forEach(btn => {
            btn.className = 'branch-chip px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 bg-slate-200/80 hover:bg-slate-300 transition';
        });
        const activeChip = branchId ? document.getElementById(`branch-chip-${branchId}`) : document.getElementById('branch-chip-all');
        if (activeChip) {
            activeChip.className = 'branch-chip px-3 py-1.5 rounded-lg text-xs font-bold transition bg-amber-500 text-slate-950 shadow-xs';
        }

        document.querySelectorAll('.barber-card').forEach(card => {
            const bBranchId = card.getAttribute('data-branch-id');
            if (!branchId || bBranchId === branchId.toString()) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }

    function highlightCard(card, type) {
        document.querySelectorAll(`.${type}-card`).forEach(c => {
            c.setAttribute('aria-pressed', 'false');
        });
        card.classList.remove('border-slate-200/90', 'bg-white');
        card.classList.add('border-amber-500', 'bg-amber-50/40', 'ring-2', 'ring-amber-500/20');
        card.setAttribute('aria-pressed', 'true');
    }

    function onDateChanged() {
        const picker = document.getElementById('booking-date-picker');
        state.date = picker.value;
        state.slotUtc = '';
        state.slotFormattedTime = '';
        loadAvailability();
    }

    async function loadAvailability() {
        if (!state.barberId || !state.serviceId || !state.date) return;

        const loading = document.getElementById('slots-loading');
        const empty = document.getElementById('slots-empty');
        const grid = document.getElementById('slots-grid');
        const countBadge = document.getElementById('slots-count-badge');

        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        grid.innerHTML = '';
        countBadge.classList.add('hidden');

        try {
            const resp = await fetch(`/api/barbers/${state.barberId}/availability?serviceId=${state.serviceId}&date=${state.date}`);
            loading.classList.add('hidden');

            if (!resp.ok) {
                showError('Failed to load available time slots. Please try another date.');
                return;
            }

            const data = await resp.json();
            const slots = data.slotDetails || [];

            if (slots.length === 0) {
                empty.classList.remove('hidden');
                return;
            }

            countBadge.innerText = `${slots.length} available`;
            countBadge.classList.remove('hidden');

            slots.forEach(slot => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'slot-btn py-3 px-2 rounded-xl border border-slate-200 bg-slate-50 hover:border-amber-500 hover:bg-amber-50/50 text-slate-800 font-bold text-sm transition-all text-center focus:outline-none focus:ring-2 focus:ring-amber-500 shadow-xs';
                btn.innerText = slot.formattedTime;
                btn.setAttribute('aria-pressed', 'false');
                btn.setAttribute('aria-label', `Select time slot ${slot.formattedTime}`);
                btn.onclick = () => selectSlot(btn, slot.startsAtUtc, slot.formattedTime);
                grid.appendChild(btn);
            });
        } catch (e) {
            loading.classList.add('hidden');
            showError('Network error checking availability. Please try again.');
        }
    }

    function selectSlot(btn, startsAtUtc, formattedTime) {
        state.slotUtc = startsAtUtc;
        state.slotFormattedTime = formattedTime;

        document.querySelectorAll('.slot-btn').forEach(b => {
            b.className = 'slot-btn py-3 px-2 rounded-xl border border-slate-200 bg-slate-50 hover:border-amber-500 hover:bg-amber-50/50 text-slate-800 font-bold text-sm transition-all text-center focus:outline-none focus:ring-2 focus:ring-amber-500 shadow-xs';
            b.setAttribute('aria-pressed', 'false');
        });

        btn.className = 'slot-btn py-3 px-2 rounded-xl border-2 border-amber-500 bg-amber-500 text-slate-950 font-black text-sm transition-all text-center focus:outline-none focus:ring-2 focus:ring-amber-500 shadow-md';
        btn.setAttribute('aria-pressed', 'true');

        setTimeout(() => goToStep(4), 250);
    }

    function populateReview() {
        document.getElementById('review-service-name').innerText = state.serviceName;
        document.getElementById('review-service-duration').innerText = `${state.serviceDuration} minutes duration`;
        document.getElementById('review-service-price').innerText = state.servicePrice;
        document.getElementById('review-barber-name').innerText = state.barberName;
        document.getElementById('review-date-str').innerText = state.date;
        document.getElementById('review-time-str').innerText = state.slotFormattedTime;
    }

    async function submitBooking() {
        clearError();
        const btn = document.getElementById('submit-booking-btn');
        const notes = document.getElementById('booking-notes').value;

        btn.disabled = true;
        btn.innerHTML = `
            <div class="inline-block w-5 h-5 border-2 border-slate-950/40 border-t-slate-950 rounded-full animate-spin"></div>
            <span>Reserving Slot...</span>
        `;

        try {
            const resp = await fetch('/api/appointments', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    serviceId: state.serviceId,
                    barberId: state.barberId,
                    startsAt: state.slotUtc,
                    notes: notes
                })
            });

            if (resp.status === 201) {
                const data = await resp.json();
                window.location.href = `/book/confirmation?referenceCode=${encodeURIComponent(data.referenceCode)}`;
                return;
            }

            const err = await resp.json().catch(() => null);
            if (err?.error?.code === 'SLOT_TAKEN') {
                showError('That slot was just booked by another client. Please choose another available slot.');
                goToStep(3);
            } else {
                showError(err?.error?.message || 'Failed to complete booking. Please review your selections.');
            }
        } catch (e) {
            showError('A network error occurred while submitting your booking.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<span>Confirm & Book Appointment &rarr;</span>';
        }
    }
</script>
