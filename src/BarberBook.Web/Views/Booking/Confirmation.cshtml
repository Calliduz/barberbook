@model BarberBook.Web.Models.Appointment.AppointmentDetailDto
@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "Booking Confirmed";
}

<div class="max-w-2xl mx-auto px-4 py-12 sm:px-6">
    <div class="bg-neutral-900 border border-neutral-800 rounded-3xl overflow-hidden shadow-2xl relative">
        <!-- Animated Barber Pole Ribbon Accent -->
        <div class="barber-pole-divider"></div>

        <div class="p-6 sm:p-10 text-center relative">
            <!-- Subtle gold background glow -->
            <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Success checkmark icon -->
            <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 border-2 border-emerald-500/40 flex items-center justify-center mx-auto mb-6">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
            </div>

            <h1 class="text-2xl sm:text-3xl font-serif font-black text-amber-50 tracking-tight">Booking Submitted!</h1>
            <p class="mt-2 text-sm text-neutral-400">Your appointment request has been recorded successfully.</p>

            <!-- Reference Code Highlight Box with Mini Barber Pole -->
            <div class="mt-8 p-5 rounded-2xl bg-neutral-950 border border-amber-500/30 max-w-sm mx-auto shadow-inner">
                <span class="text-xs uppercase tracking-wider text-neutral-400 font-bold block mb-1.5">Appointment Reference Code</span>
                <div class="flex items-center justify-center gap-3">
                    <div class="barber-pole-icon" style="height: 24px; width: 11px;"></div>
                    <span class="text-2xl sm:text-3xl font-mono font-extrabold text-amber-400 tracking-wider select-all" id="confirmation-ref-code">
                        @Model.ReferenceCode
                    </span>
                    <div class="barber-pole-icon" style="height: 24px; width: 11px;"></div>
                </div>
                <p class="text-[11px] text-neutral-400 mt-2">Save this code to track your booking.</p>
            </div>

        <!-- Status Banner -->
        <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span>Status: @Model.StatusDisplay</span>
        </div>

        <!-- Summary Details Card -->
        <div class="mt-8 bg-neutral-950/70 border border-neutral-800/80 rounded-2xl p-5 text-left divide-y divide-neutral-800/80 text-sm">
            <div class="pb-3 flex justify-between items-center">
                <span class="text-neutral-400">Service</span>
                <span class="font-bold text-neutral-100">@Model.ServiceName</span>
            </div>
            <div class="py-3 flex justify-between items-center">
                <span class="text-neutral-400">Barber</span>
                <span class="font-bold text-neutral-100">@Model.BarberName</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.BranchName))
            {
                <div class="py-3 flex justify-between items-center">
                    <span class="text-neutral-400">Branch Location</span>
                    <div class="text-right">
                        <span class="font-bold text-neutral-100 block">@Model.BranchName</span>
                        @if (!string.IsNullOrEmpty(Model.BranchAddress))
                        {
                            <span class="text-[11px] text-neutral-400 block">@Model.BranchAddress</span>
                        }
                    </div>
                </div>
            }
            <div class="py-3 flex justify-between items-center">
                <span class="text-neutral-400">Date</span>
                <span class="font-bold text-neutral-100">@Model.FormattedDate</span>
            </div>
            <div class="py-3 flex justify-between items-center">
                <span class="text-neutral-400">Time (Asia/Manila)</span>
                <span class="font-bold text-amber-400">@Model.FormattedTime</span>
            </div>
            <div class="py-3 flex justify-between items-center">
                <span class="text-neutral-400">Estimated Price</span>
                <span class="font-extrabold text-amber-400 text-base">@Model.FormattedPrice</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="pt-3">
                    <span class="text-neutral-400 block text-xs">Customer Notes:</span>
                    <span class="text-neutral-300 text-xs mt-0.5 block italic">"@Model.Notes"</span>
                </div>
            }
        </div>

        <p class="text-xs text-neutral-400 mt-4">
            Payment will be settled in cash at the barber shop upon service completion (LM-1).
        </p>

        <!-- Calendar Sync & Print Slip (Enterprise Booking Feature) -->
        <div class="mt-6 p-4 rounded-2xl bg-neutral-950/80 border border-neutral-800 flex flex-wrap items-center justify-center gap-3">
            <span class="text-xs text-neutral-400 font-semibold w-full sm:w-auto">Keep your schedule handy:</span>
            <button type="button" onclick="addToGoogleCalendar()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-amber-300 text-xs font-semibold border border-amber-500/20 transition">
                <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/></svg>
                <span>Google Calendar</span>
            </button>
            <button type="button" onclick="downloadIcsFile()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-neutral-200 text-xs font-semibold border border-neutral-700 transition">
                <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                <span>iCal / Apple (.ics)</span>
            </button>
            <button type="button" onclick="window.print()" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-neutral-200 text-xs font-semibold border border-neutral-700 transition">
                <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                <span>Print Voucher</span>
            </button>
        </div>

        <!-- CTA Action Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/my-appointments"
               class="w-full sm:w-auto px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-sm transition-colors text-center shadow-md">
                My Appointments
            </a>
            <a href="/book"
               class="w-full sm:w-auto px-6 py-3 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-bold text-sm transition-colors text-center border border-neutral-700">
                Book Another
            </a>
        </div>
    </div>
</div>
</div>

<script>
    const appData = {
        title: "BarberBook: @Model.ServiceName with @Model.BarberName",
        details: "Appointment @Model.ReferenceCode for @Model.ServiceName at BarberBook. Status: @Model.StatusDisplay. Settled in-shop.",
        location: "@(Model.BranchName ?? "BarberBook Heritage Barbershop")@(string.IsNullOrEmpty(Model.BranchAddress) ? "" : ", " + Model.BranchAddress)",
        startsAtUtc: "@Model.StartsAt",
        endsAtUtc: "@Model.EndsAt",
        refCode: "@Model.ReferenceCode"
    };

    function parseToCalString(isoStr) {
        if (!isoStr) return "";
        const d = new Date(isoStr);
        return d.toISOString().replace(/-|:|\.\d+/g, "");
    }

    function addToGoogleCalendar() {
        const startStr = parseToCalString(appData.startsAtUtc);
        const endStr = parseToCalString(appData.endsAtUtc);
        const gUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(appData.title)}&dates=${startStr}/${endStr}&details=${encodeURIComponent(appData.details)}&location=${encodeURIComponent(appData.location)}`;
        window.open(gUrl, '_blank', 'noopener,noreferrer');
    }

    function downloadIcsFile() {
        const startStr = parseToCalString(appData.startsAtUtc);
        const endStr = parseToCalString(appData.endsAtUtc);
        const icsContent = [
            "BEGIN:VCALENDAR",
            "VERSION:2.0",
            "PRODID:-//BarberBook//Appointment System//EN",
            "CALSCALE:GREGORIAN",
            "METHOD:PUBLISH",
            "BEGIN:VEVENT",
            `UID:barberbook-${appData.refCode}@@barberbook.local`,
            `DTSTAMP:${startStr}`,
            `DTSTART:${startStr}`,
            `DTEND:${endStr}`,
            `SUMMARY:${appData.title}`,
            `DESCRIPTION:${appData.details}`,
            `LOCATION:${appData.location}`,
            "STATUS:CONFIRMED",
            "END:VEVENT",
            "END:VCALENDAR"
        ].join("\r\n");

        const blob = new Blob([icsContent], { type: "text/calendar;charset=utf-8" });
        const link = document.createElement("a");
        link.href = window.URL.createObjectURL(blob);
        link.setAttribute("download", `BarberBook-${appData.refCode}.ics`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>

