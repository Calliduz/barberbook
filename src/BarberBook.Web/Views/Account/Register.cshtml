@model BarberBook.Web.Models.Auth.RegisterModel
@{
    ViewData["Title"] = "Customer Registration";
}

<div class="max-w-md mx-auto my-6 sm:my-12 bg-white/95 rounded-2xl shadow-xl border border-amber-900/10 p-8 sm:p-10 backdrop-blur-sm">
    <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 mb-3 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
            <span>NEW CLIENT REGISTRATION</span>
        </div>
        <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Create Account</h1>
        <p class="text-sm text-slate-600 mt-2 font-sans">Book master cuts and manage your grooming history</p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    <form method="post" action="/register" class="space-y-4">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="FullName" class="block text-xs uppercase tracking-wider text-slate-600 font-bold mb-1">Full Name</label>
            <input asp-for="FullName" type="text" required autocomplete="name" placeholder="e.g. Juan dela Cruz"
                   class="block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 text-sm" />
            <span asp-validation-for="FullName" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-xs uppercase tracking-wider text-slate-600 font-bold mb-1">Email Address</label>
            <input asp-for="Email" type="email" required autocomplete="email" placeholder="juan@example.com"
                   class="block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 text-sm" />
            <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Phone" class="block text-xs uppercase tracking-wider text-slate-600 font-bold mb-1">Phone Number <span class="text-slate-400 font-normal lowercase">(optional)</span></label>
            <input asp-for="Phone" type="tel" autocomplete="tel" placeholder="0917xxxxxxx"
                   class="block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 text-sm" />
            <span asp-validation-for="Phone" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-xs uppercase tracking-wider text-slate-600 font-bold mb-1">Password</label>
            <input asp-for="Password" type="password" required autocomplete="new-password" placeholder="At least 6 characters"
                   class="block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 text-sm" />
            <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-xs uppercase tracking-wider text-slate-600 font-bold mb-1">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" required autocomplete="new-password" placeholder="Repeat your password"
                   class="block w-full rounded-xl border border-slate-300 px-4 py-2.5 text-slate-900 shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 text-sm" />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div class="pt-3">
            <button type="submit"
                    class="w-full py-3 px-4 rounded-xl text-neutral-950 font-bold text-sm bg-amber-500 hover:bg-amber-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 transition shadow-md shadow-amber-500/20">
                Create Account
            </button>
        </div>
    </form>

    <div class="mt-8 text-center text-xs text-slate-600 pt-6 border-t border-slate-200">
        Already registered?
        <a href="/login" class="font-bold text-amber-700 hover:text-amber-800 underline decoration-amber-500/40 ml-1">
            Sign in
        </a>
    </div>
</div>
