@model BarberBook.Web.Models.Auth.RegisterModel
@{
    ViewData["Title"] = "Customer Registration";
}

<div class="max-w-md mx-auto bg-white rounded-xl shadow-sm border border-slate-200 p-8">
    <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-slate-900">Create Customer Account</h1>
        <p class="text-sm text-slate-600 mt-1">Book appointments and track your barber visit history</p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="mb-4 p-3 rounded bg-red-50 border border-red-200 text-red-700 text-sm">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    <form asp-action="Register" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="FullName" class="block text-sm font-medium text-slate-700">Full Name</label>
            <input asp-for="FullName" type="text" required autocomplete="name"
                   class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm" />
            <span asp-validation-for="FullName" class="text-xs text-red-600 mt-1"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-slate-700">Email Address</label>
            <input asp-for="Email" type="email" required autocomplete="email"
                   class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm" />
            <span asp-validation-for="Email" class="text-xs text-red-600 mt-1"></span>
        </div>

        <div>
            <label asp-for="Phone" class="block text-sm font-medium text-slate-700">Phone Number (optional)</label>
            <input asp-for="Phone" type="tel" autocomplete="tel" placeholder="0917xxxxxxx"
                   class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm" />
            <span asp-validation-for="Phone" class="text-xs text-red-600 mt-1"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-slate-700">Password</label>
            <input asp-for="Password" type="password" required autocomplete="new-password"
                   class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm" />
            <span asp-validation-for="Password" class="text-xs text-red-600 mt-1"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-medium text-slate-700">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" required autocomplete="new-password"
                   class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm" />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600 mt-1"></span>
        </div>

        <div>
            <button type="submit"
                    class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition">
                Create Account
            </button>
        </div>
    </form>

    <div class="mt-6 text-center text-sm text-slate-600">
        Already registered?
        <a asp-action="Login" class="font-medium text-brand-600 hover:text-brand-500">
            Sign in
        </a>
    </div>
</div>
