@model BarberBook.Web.Models.Auth.LoginModel
@{
    ViewData["Title"] = "Log In";
}

<div class="max-w-md mx-auto bg-white rounded-xl shadow-sm border border-slate-200 p-8">
    <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-slate-900">Sign in to BarberBook</h1>
        <p class="text-sm text-slate-600 mt-1">Access your appointments, schedule, or management dashboard</p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="mb-4 p-3 rounded bg-red-50 border border-red-200 text-red-700 text-sm">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    <form asp-action="Login" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-slate-700">Email Address</label>
            <input asp-for="Email" type="email" required autocomplete="email"
                   class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm" />
            <span asp-validation-for="Email" class="text-xs text-red-600 mt-1"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-slate-700">Password</label>
            <input asp-for="Password" type="password" required autocomplete="current-password"
                   class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500 sm:text-sm" />
            <span asp-validation-for="Password" class="text-xs text-red-600 mt-1"></span>
        </div>

        <div class="flex items-center justify-between text-sm">
            <label class="flex items-center">
                <input asp-for="RememberMe" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
                <span class="ml-2 text-slate-600">Remember me</span>
            </label>
        </div>

        <div>
            <button type="submit"
                    class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-brand-600 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-500 transition">
                Sign In
            </button>
        </div>
    </form>

    <div class="mt-6 text-center text-sm text-slate-600">
        Don't have an account?
        <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="font-medium text-brand-600 hover:text-brand-500">
            Register as a customer
        </a>
    </div>
</div>
