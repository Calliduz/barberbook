@model BarberBook.Web.Models.Auth.LoginModel
@{
    ViewData["Title"] = "Log In";
}

<div class="max-w-md mx-auto my-6 sm:my-12 bg-white/95 rounded-2xl shadow-xl border border-amber-900/10 p-8 sm:p-10 backdrop-blur-sm">
    <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 mb-3 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
            <span>BARBERBOOK MANILA</span>
        </div>
        <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Welcome Back</h1>
        <p class="text-sm text-slate-600 mt-2 font-sans">Sign in to manage your appointments and schedule</p>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
            @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }

    <form method="post" action="/login" class="space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div>
            <label asp-for="Email" class="block text-xs uppercase tracking-wider text-slate-600 dark:text-slate-300 font-bold mb-1.5">Email Address</label>
            <input asp-for="Email" type="email" required autocomplete="email" placeholder="you@example.com"
                   class="block w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-2.5 text-slate-900 dark:text-slate-100 shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 text-sm transition" />
            <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-xs uppercase tracking-wider text-slate-600 dark:text-slate-300 font-bold mb-1.5">Password</label>
            <div class="relative">
                <input asp-for="Password" id="login-password" type="password" required autocomplete="current-password" placeholder="••••••••"
                       class="block w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-2.5 pr-10 text-slate-900 dark:text-slate-100 shadow-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 text-sm transition" />
                <button type="button" onclick="togglePasswordVisibility('login-password', this)"
                        class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition focus:outline-none"
                        aria-label="Show password">
                    <svg class="icon-eye w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    <svg class="icon-eye-slash w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
        </div>

        <div class="flex items-center justify-between text-sm pt-1">
            <label class="flex items-center cursor-pointer">
                <input asp-for="RememberMe" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500" />
                <span class="ml-2 text-slate-600 dark:text-slate-300 text-xs">Keep me signed in</span>
            </label>
        </div>

        <div class="pt-2">
            <button type="submit"
                    class="w-full py-2.5 px-4 rounded-lg text-neutral-950 font-bold text-sm bg-amber-500 hover:bg-amber-400 active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 transition shadow-md shadow-amber-500/20">
                Sign In
            </button>
        </div>
    </form>

    <div class="mt-8 text-center text-xs text-slate-600 pt-6 border-t border-slate-200">
        Don't have an account?
        @{
            var regUrl = string.IsNullOrEmpty(Model?.ReturnUrl) ? "/register" : $"/register?returnUrl={Uri.EscapeDataString(Model.ReturnUrl)}";
        }
        <a href="@regUrl" class="font-bold text-amber-700 hover:text-amber-800 underline decoration-amber-500/40 ml-1">
            Register as a customer
        </a>
    </div>
</div>
