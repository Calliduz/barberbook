@{
    ViewData["Title"] = "System Error";
    var statusCode = ViewData["StatusCode"] ?? 500;
}

<div class="max-w-md mx-auto my-12 bg-white/95 rounded-3xl shadow-xl border border-slate-200/90 p-8 sm:p-10 text-center space-y-6">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 mx-auto">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
        </svg>
    </div>

    <div>
        <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
            <span>BARBERBOOK SYSTEM NOTICE</span>
        </div>
        <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">System Error (@statusCode)</h1>
        <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed font-sans">
            An unexpected error occurred while processing your request. Please try again or return to the shop home page.
        </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <a href="/" class="w-full sm:w-auto px-6 py-2.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm">
            Back to Home
        </a>
        <button onclick="window.history.back()" class="w-full sm:w-auto px-5 py-2.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
            Go Back
        </button>
    </div>
</div>
