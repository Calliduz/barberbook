@{
    ViewData["Title"] = "Page Not Found";
}

<div class="max-w-md mx-auto bg-white rounded-xl shadow-sm border border-slate-200 p-8 text-center">
    <div class="inline-flex items-center justify-center p-3 bg-amber-100 rounded-full mb-4">
        <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
    </div>
    <h1 class="text-2xl font-bold text-slate-900">404 — Not Found</h1>
    <p class="mt-2 text-slate-600">
        The page you are looking for does not exist or has been moved.
    </p>
    <div class="mt-6">
        <a href="/" class="inline-flex items-center px-4 py-2 border border-slate-300 rounded-md text-sm font-medium text-slate-700 bg-white hover:bg-slate-50">
            Back to Home
        </a>
    </div>
</div>

