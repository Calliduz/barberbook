@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "My Appointments";
}

<div class="max-w-4xl mx-auto px-4 py-8 sm:px-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-amber-50 tracking-tight">My Appointments</h1>
            <p class="mt-1 text-sm text-neutral-400">Manage your upcoming bookings and review your haircut history.</p>
        </div>
        <a href="/book" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-sm transition-colors shadow-lg shadow-amber-500/20">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
            Book New
        </a>
    </div>

    <!-- Alert Box -->
    <div id="status-alert" class="hidden mb-6 p-4 rounded-xl text-sm transition-all"></div>

    <!-- Tabs Navigation -->
    <div class="flex border-b border-neutral-800 mb-6">
        <button type="button" id="tab-upcoming-btn" onclick="switchTab('upcoming')"
                class="px-5 py-3 text-sm font-bold border-b-2 border-amber-500 text-amber-400 flex items-center gap-2 transition-colors">
            <span>Upcoming</span>
            <span id="badge-upcoming-count" class="hidden text-xs px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 font-semibold">0</span>
        </button>
        <button type="button" id="tab-history-btn" onclick="switchTab('history')"
                class="px-5 py-3 text-sm font-semibold border-b-2 border-transparent text-neutral-400 hover:text-neutral-200 flex items-center gap-2 transition-colors">
            <span>History</span>
            <span id="badge-history-count" class="hidden text-xs px-2 py-0.5 rounded-full bg-neutral-800 text-neutral-400 font-semibold">0</span>
        </button>
    </div>

    <!-- Loading State -->
    <div id="appointments-loading" class="py-16 text-center">
        <div class="inline-block w-8 h-8 border-3 border-amber-500/30 border-t-amber-500 rounded-full animate-spin"></div>
        <p class="text-xs text-neutral-400 mt-2">Loading appointments...</p>
    </div>

    <!-- Appointments List Container -->
    <div id="appointments-container" class="space-y-4">
        <!-- Dynamically rendered -->
    </div>

    <!-- Empty State -->
    <div id="appointments-empty" class="hidden py-16 text-center bg-neutral-900/50 border border-neutral-800 rounded-2xl p-8">
        <svg class="w-12 h-12 mx-auto text-neutral-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <h3 id="empty-title" class="text-base font-bold text-neutral-200">No appointments found</h3>
        <p id="empty-subtitle" class="text-xs text-neutral-400 mt-1 max-w-sm mx-auto">Ready for a fresh cut or styling? Book your slot online in seconds.</p>
        <div class="mt-5">
            <a href="/book" class="inline-flex items-center px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold text-xs transition-colors">
                Book an Appointment
            </a>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div id="cancel-modal" class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4">
    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl max-w-md w-full p-6 shadow-2xl">
        <h3 class="text-lg font-bold text-neutral-100">Cancel Appointment</h3>
        <p class="text-xs text-neutral-400 mt-1">Are you sure you want to cancel this booking? This action cannot be undone.</p>
        
        <div class="mt-4 p-3 bg-neutral-950 rounded-xl border border-neutral-800 text-xs text-neutral-300">
            <div id="cancel-modal-summary"></div>
        </div>

        <div class="mt-4">
            <label for="cancel-reason" class="block text-xs font-semibold text-neutral-300 mb-1">Reason for cancellation <span class="text-neutral-500">(optional)</span></label>
            <textarea id="cancel-reason" rows="2" maxlength="300" placeholder="e.g. Schedule conflict, feeling unwell..."
                      class="w-full px-3 py-2 rounded-xl bg-neutral-950 border border-neutral-700 text-neutral-100 text-xs focus:outline-none focus:border-amber-500"></textarea>
        </div>

        <div class="mt-6 flex justify-end gap-3">
            <button type="button" onclick="closeCancelModal()" class="px-4 py-2 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-300 text-xs font-bold transition-colors">
                Keep Appointment
            </button>
            <button type="button" id="confirm-cancel-btn" onclick="executeCancel()" class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-500 text-white text-xs font-bold transition-colors">
                Confirm Cancellation
            </button>
        </div>
    </div>
</div>

<!-- Reschedule Modal -->
<div id="reschedule-modal" class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl my-8">
        <div class="flex justify-between items-start mb-4">
            <div>
                <h3 class="text-lg font-bold text-neutral-100">Reschedule Appointment</h3>
                <p class="text-xs text-neutral-400 mt-0.5">Choose a new date and time with your barber.</p>
            </div>
            <button type="button" onclick="closeRescheduleModal()" class="text-neutral-400 hover:text-neutral-200">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Current Appointment Info -->
        <div class="mb-4 p-3 bg-neutral-950 rounded-xl border border-neutral-800 text-xs text-neutral-300" id="reschedule-modal-summary"></div>

        <!-- Date Picker -->
        <div class="mb-4">
            <label for="reschedule-date" class="block text-xs font-semibold text-neutral-300 mb-1">New Date</label>
            <input type="date" id="reschedule-date" onchange="onRescheduleDateChanged()"
                   class="w-full px-3 py-2 rounded-xl bg-neutral-950 border border-neutral-700 text-neutral-100 text-xs focus:outline-none focus:border-amber-500 font-medium" />
        </div>

        <!-- Slot Picker -->
        <div class="mb-6">
            <label class="block text-xs font-semibold text-neutral-300 mb-2">Available Slots (Asia/Manila)</label>
            <div id="reschedule-slots-loading" class="hidden py-6 text-center">
                <div class="inline-block w-6 h-6 border-2 border-amber-500/30 border-t-amber-500 rounded-full animate-spin"></div>
                <p class="text-[11px] text-neutral-400 mt-1">Loading open slots...</p>
            </div>
            <div id="reschedule-slots-empty" class="hidden py-6 text-center text-xs text-neutral-400">
                No available slots on this date. Please select another date.
            </div>
            <div id="reschedule-slots-grid" class="grid grid-cols-3 sm:grid-cols-4 gap-2 max-h-48 overflow-y-auto p-1">
                <!-- Dynamically rendered slot buttons -->
            </div>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-neutral-800">
            <button type="button" onclick="closeRescheduleModal()" class="px-4 py-2 rounded-xl bg-neutral-800 hover:bg-neutral-700 text-neutral-300 text-xs font-bold transition-colors">
                Cancel
            </button>
            <button type="button" id="confirm-reschedule-btn" disabled onclick="executeReschedule()"
                    class="px-5 py-2 rounded-xl bg-amber-500 disabled:opacity-50 disabled:cursor-not-allowed hover:bg-amber-400 text-neutral-950 text-xs font-bold transition-colors shadow">
                Confirm New Slot
            </button>
        </div>
    </div>
</div>

<script>
    let currentScope = 'upcoming';
    let appointmentsData = [];
    let activeModalAppointment = null;
    let selectedRescheduleSlotUtc = null;

    document.addEventListener('DOMContentLoaded', () => {
        loadAppointments('upcoming');
    });

    function switchTab(scope) {
        currentScope = scope;
        const upcomingBtn = document.getElementById('tab-upcoming-btn');
        const historyBtn = document.getElementById('tab-history-btn');

        if (scope === 'upcoming') {
            upcomingBtn.className = 'px-5 py-3 text-sm font-bold border-b-2 border-amber-500 text-amber-400 flex items-center gap-2 transition-colors';
            historyBtn.className = 'px-5 py-3 text-sm font-semibold border-b-2 border-transparent text-neutral-400 hover:text-neutral-200 flex items-center gap-2 transition-colors';
        } else {
            historyBtn.className = 'px-5 py-3 text-sm font-bold border-b-2 border-amber-500 text-amber-400 flex items-center gap-2 transition-colors';
            upcomingBtn.className = 'px-5 py-3 text-sm font-semibold border-b-2 border-transparent text-neutral-400 hover:text-neutral-200 flex items-center gap-2 transition-colors';
        }

        loadAppointments(scope);
    }

    async function loadAppointments(scope) {
        const loading = document.getElementById('appointments-loading');
        const empty = document.getElementById('appointments-empty');
        const container = document.getElementById('appointments-container');

        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        container.innerHTML = '';

        try {
            const resp = await fetch(`/api/me/appointments?scope=${scope}`);
            loading.classList.add('hidden');

            if (!resp.ok) {
                showAlert('Failed to load appointments.', 'error');
                return;
            }

            appointmentsData = await resp.json();

            // Update badge count
            const countBadge = document.getElementById(`badge-${scope}-count`);
            if (countBadge) {
                countBadge.innerText = appointmentsData.length;
                countBadge.classList.remove('hidden');
            }

            if (appointmentsData.length === 0) {
                document.getElementById('empty-title').innerText = scope === 'upcoming'
                    ? 'No upcoming appointments'
                    : 'No appointment history';
                document.getElementById('empty-subtitle').innerText = scope === 'upcoming'
                    ? 'You have no pending or confirmed bookings at the moment.'
                    : 'Completed and past appointments will appear here.';
                empty.classList.remove('hidden');
                return;
            }

            renderAppointments(appointmentsData, container);
        } catch (e) {
            loading.classList.add('hidden');
            showAlert('Network error loading appointments.', 'error');
        }
    }

    function renderAppointments(list, container) {
        list.forEach(app => {
            const card = document.createElement('div');
            card.className = 'bg-neutral-900 border border-neutral-800 rounded-2xl p-5 hover:border-neutral-700 transition-all';
            
            const statusBadgeHtml = getStatusBadge(app.status, app.statusDisplay);

            const actionsHtml = app.canCancelOrReschedule ? `
                <div class="mt-4 pt-4 border-t border-neutral-800/80 flex flex-wrap items-center justify-end gap-2.5">
                    <button type="button" onclick="openRescheduleModal(${app.id})" class="px-3 py-1.5 rounded-lg bg-neutral-800 hover:bg-neutral-700 text-neutral-200 font-bold text-xs border border-neutral-700 transition-colors">
                        Reschedule
                    </button>
                    <button type="button" onclick="openCancelModal(${app.id})" class="px-3 py-1.5 rounded-lg bg-red-950/40 hover:bg-red-900/60 text-red-300 font-bold text-xs border border-red-900/40 transition-colors">
                        Cancel
                    </button>
                </div>
            ` : '';

            const timelineHtml = renderTimeline(app.timeline, app.id);

            card.innerHTML = `
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                    <div>
                        <div class="flex items-center gap-2 mb-1.5">
                            <span class="text-xs font-mono font-bold text-amber-400 bg-amber-500/10 px-2.5 py-0.5 rounded-md border border-amber-500/20">
                                ${app.referenceCode}
                            </span>
                            ${statusBadgeHtml}
                        </div>
                        <h3 class="text-lg font-bold text-neutral-100">${app.serviceName}</h3>
                        <p class="text-xs text-neutral-400 mt-0.5">Barber: <strong class="text-neutral-200">${app.barberName}</strong>${app.branchName ? ` · <span class="text-amber-300 font-medium">${app.branchName}</span>` : ''} · ${app.durationMinutes} mins</p>
                    </div>
                    <div class="text-left sm:text-right">
                        <span class="text-lg font-extrabold text-amber-400">${app.formattedPrice}</span>
                        <p class="text-xs font-semibold text-neutral-300 mt-0.5">${app.formattedDate}</p>
                        <p class="text-xs text-amber-400/90 font-medium">${app.formattedTime}</p>
                    </div>
                </div>

                ${app.notes ? `
                    <div class="mt-3 text-xs bg-neutral-950/60 p-2.5 rounded-xl border border-neutral-800/60 text-neutral-400">
                        <span class="text-neutral-500">Notes:</span> "${app.notes}"
                    </div>
                ` : ''}

                <div class="mt-3 flex items-center justify-between text-xs">
                    <button type="button" onclick="toggleTimeline(${app.id})" class="text-xs text-neutral-400 hover:text-amber-400 font-medium flex items-center gap-1">
                        <span id="timeline-toggle-text-${app.id}">View Status History</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                </div>

                <div id="timeline-${app.id}" class="hidden mt-3 pt-3 border-t border-neutral-800">
                    ${timelineHtml}
                </div>

                ${actionsHtml}
            `;

            container.appendChild(card);
        });
    }

    function renderTimeline(timeline, appId) {
        if (!timeline || timeline.length === 0) {
            return '<p class="text-[11px] text-neutral-500 italic">No history records found.</p>';
        }

        const items = timeline.map(item => `
            <li class="mb-3 ml-4">
                <div class="absolute -left-1.5 mt-1.5 w-3 h-3 rounded-full border-2 border-neutral-900 bg-amber-500"></div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-neutral-200 uppercase tracking-wider">${item.toStatus}</span>
                    <span class="text-[11px] text-neutral-500">by ${item.changedByRole}</span>
                </div>
                <p class="text-[11px] text-neutral-400 mt-0.5">${item.note || 'No notes'}</p>
                <time class="text-[10px] text-neutral-500 block mt-0.5">${item.formattedChangedAt}</time>
            </li>
        `).join('');

        return `
            <div class="pl-2">
                <span class="text-[11px] font-bold text-neutral-400 block mb-2 uppercase tracking-wider">Status History Timeline</span>
                <ol class="relative border-l border-neutral-800 text-xs">
                    ${items}
                </ol>
            </div>
        `;
    }

    function toggleTimeline(id) {
        const el = document.getElementById(`timeline-${id}`);
        const text = document.getElementById(`timeline-toggle-text-${id}`);
        if (!el) return;
        const isHidden = el.classList.toggle('hidden');
        text.innerText = isHidden ? 'View Status History' : 'Hide Status History';
    }

    function getStatusBadge(status, display) {
        let cls = 'bg-neutral-800 text-neutral-400 border-neutral-700';
        if (status === 'pending') cls = 'bg-amber-500/10 text-amber-300 border-amber-500/30';
        else if (status === 'confirmed') cls = 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30';
        else if (status === 'completed') cls = 'bg-sky-500/10 text-sky-300 border-sky-500/30';
        else if (status === 'cancelled') cls = 'bg-neutral-800/80 text-neutral-400 border-neutral-700';
        else if (status === 'rejected') cls = 'bg-red-500/10 text-red-300 border-red-500/30';

        return `<span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full border ${cls}">${display}</span>`;
    }

    function showAlert(msg, type) {
        const alert = document.getElementById('status-alert');
        alert.innerText = msg;
        if (type === 'error') {
            alert.className = 'mb-6 p-4 rounded-xl text-sm bg-red-950/80 border border-red-800 text-red-200';
        } else {
            alert.className = 'mb-6 p-4 rounded-xl text-sm bg-emerald-950/80 border border-emerald-800 text-emerald-200';
        }
        alert.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Modal: Cancel
    function openCancelModal(id) {
        activeModalAppointment = appointmentsData.find(a => a.id === id);
        if (!activeModalAppointment) return;

        document.getElementById('cancel-modal-summary').innerHTML = `
            <strong>${activeModalAppointment.serviceName}</strong> with <strong>${activeModalAppointment.barberName}</strong><br/>
            Scheduled for ${activeModalAppointment.formattedDate} at ${activeModalAppointment.formattedTime}
        `;
        document.getElementById('cancel-reason').value = '';
        document.getElementById('cancel-modal').classList.remove('hidden');
    }

    function closeCancelModal() {
        document.getElementById('cancel-modal').classList.add('hidden');
        activeModalAppointment = null;
    }

    async function executeCancel() {
        if (!activeModalAppointment) return;
        const btn = document.getElementById('confirm-cancel-btn');
        const reason = document.getElementById('cancel-reason').value;

        btn.disabled = true;
        btn.innerText = 'Cancelling...';

        try {
            const resp = await fetch(`/api/appointments/${activeModalAppointment.id}/cancel`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ reason: reason })
            });

            closeCancelModal();

            if (resp.ok) {
                showAlert('Your appointment has been cancelled.', 'success');
                loadAppointments(currentScope);
            } else {
                const err = await resp.json().catch(() => null);
                showAlert(err?.error?.message || 'Failed to cancel appointment.', 'error');
            }
        } catch (e) {
            closeCancelModal();
            showAlert('Network error while cancelling.', 'error');
        } finally {
            btn.disabled = false;
            btn.innerText = 'Confirm Cancellation';
        }
    }

    // Modal: Reschedule
    function openRescheduleModal(id) {
        activeModalAppointment = appointmentsData.find(a => a.id === id);
        if (!activeModalAppointment) return;

        selectedRescheduleSlotUtc = null;
        document.getElementById('confirm-reschedule-btn').disabled = true;

        document.getElementById('reschedule-modal-summary').innerHTML = `
            <strong>${activeModalAppointment.serviceName}</strong> with <strong>${activeModalAppointment.barberName}</strong><br/>
            Current slot: <span class="text-amber-400">${activeModalAppointment.formattedDate} at ${activeModalAppointment.formattedTime}</span>
        `;

        // Default date picker to current appointment date or today
        const picker = document.getElementById('reschedule-date');
        const today = new Date().toISOString().split('T')[0];
        picker.min = today;
        picker.value = today;

        document.getElementById('reschedule-modal').classList.remove('hidden');
        loadRescheduleSlots();
    }

    function closeRescheduleModal() {
        document.getElementById('reschedule-modal').classList.add('hidden');
        activeModalAppointment = null;
        selectedRescheduleSlotUtc = null;
    }

    function onRescheduleDateChanged() {
        selectedRescheduleSlotUtc = null;
        document.getElementById('confirm-reschedule-btn').disabled = true;
        loadRescheduleSlots();
    }

    async function loadRescheduleSlots() {
        if (!activeModalAppointment) return;
        const date = document.getElementById('reschedule-date').value;
        const loading = document.getElementById('reschedule-slots-loading');
        const empty = document.getElementById('reschedule-slots-empty');
        const grid = document.getElementById('reschedule-slots-grid');

        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        grid.innerHTML = '';

        try {
            const resp = await fetch(`/api/barbers/${activeModalAppointment.barberId}/availability?serviceId=${activeModalAppointment.serviceId}&date=${date}`);
            loading.classList.add('hidden');

            if (!resp.ok) {
                empty.classList.remove('hidden');
                return;
            }

            const data = await resp.json();
            const slots = data.slotDetails || [];

            if (slots.length === 0) {
                empty.classList.remove('hidden');
                return;
            }

            slots.forEach(s => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'reschedule-slot-btn py-2 px-1 text-center rounded-lg bg-neutral-950 border border-neutral-700 text-neutral-200 text-xs font-semibold hover:border-amber-500 hover:bg-neutral-800 transition-all';
                btn.innerText = s.formattedTime;
                btn.onclick = () => {
                    document.querySelectorAll('.reschedule-slot-btn').forEach(b => {
                        b.className = 'reschedule-slot-btn py-2 px-1 text-center rounded-lg bg-neutral-950 border border-neutral-700 text-neutral-200 text-xs font-semibold hover:border-amber-500 hover:bg-neutral-800 transition-all';
                    });
                    btn.className = 'reschedule-slot-btn py-2 px-1 text-center rounded-lg bg-amber-500 text-neutral-950 border border-amber-500 text-xs font-extrabold transition-all';
                    selectedRescheduleSlotUtc = s.startsAtUtc;
                    document.getElementById('confirm-reschedule-btn').disabled = false;
                };
                grid.appendChild(btn);
            });
        } catch (e) {
            loading.classList.add('hidden');
            empty.classList.remove('hidden');
        }
    }

    async function executeReschedule() {
        if (!activeModalAppointment || !selectedRescheduleSlotUtc) return;
        const btn = document.getElementById('confirm-reschedule-btn');

        btn.disabled = true;
        btn.innerText = 'Updating...';

        try {
            const resp = await fetch(`/api/appointments/${activeModalAppointment.id}/reschedule`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ startsAt: selectedRescheduleSlotUtc })
            });

            if (resp.status === 200) {
                closeRescheduleModal();
                showAlert('Your appointment has been rescheduled. It is now awaiting confirmation by the shop.', 'success');
                loadAppointments(currentScope);
                return;
            }

            const err = await resp.json().catch(() => null);
            if (err?.error?.code === 'SLOT_TAKEN') {
                alert('That slot was just booked by another customer. Please choose a different slot.');
                loadRescheduleSlots();
            } else {
                alert(err?.error?.message || 'Failed to reschedule.');
            }
        } catch (e) {
            alert('A network error occurred while rescheduling.');
        } finally {
            btn.disabled = false;
            btn.innerText = 'Confirm New Slot';
        }
    }
</script>

