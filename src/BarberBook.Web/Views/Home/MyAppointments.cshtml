@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "My Appointments";
}

<div class="max-w-4xl mx-auto px-4 py-8 sm:px-6 space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-amber-900/10 dark:border-slate-800">
        <div>
            <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
                <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                <span>CLIENT APPOINTMENT PORTAL</span>
            </div>
            <h1 class="text-3xl sm:text-4xl font-serif font-black text-slate-900 dark:text-white tracking-tight">My Appointments</h1>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400 font-light">Manage your upcoming bookings, view real-time status updates, or review your past grooming history.</p>
        </div>
        <a href="/book" class="inline-flex items-center justify-center px-5 py-3 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-sm transition shadow-md hover:shadow-lg shrink-0">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Book New Visit
        </a>
    </div>

    <!-- Alert Box -->
    <div id="status-alert" class="hidden p-4 rounded-2xl text-sm transition-all shadow-sm"></div>

    <!-- Tabs Navigation -->
    <div class="flex border-b border-slate-200 dark:border-slate-800">
        <button type="button" id="tab-upcoming-btn" onclick="switchTab('upcoming')"
                class="px-6 py-3.5 text-sm font-bold border-b-2 border-amber-500 text-amber-800 dark:text-amber-400 flex items-center gap-2 transition-colors">
            <span>Upcoming Visits</span>
            <span id="badge-upcoming-count" class="hidden text-xs px-2.5 py-0.5 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300 font-bold">0</span>
        </button>
        <button type="button" id="tab-history-btn" onclick="switchTab('history')"
                class="px-6 py-3.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 flex items-center gap-2 transition-colors">
            <span>Visit History</span>
            <span id="badge-history-count" class="hidden text-xs px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold">0</span>
        </button>
    </div>

    <!-- Loading State -->
    <div id="appointments-loading" class="py-16 text-center">
        <div class="inline-block w-8 h-8 border-3 border-amber-500/30 border-t-amber-500 rounded-full animate-spin"></div>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-medium">Loading appointments...</p>
    </div>

    <!-- Appointments List Container -->
    <div id="appointments-container" class="space-y-5">
        <!-- Dynamically rendered -->
    </div>

    <!-- Empty State -->
    <div id="appointments-empty" class="hidden py-16 text-center bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-3xl p-8 sm:p-12 shadow-sm max-w-lg mx-auto">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-400 mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
        </div>
        <h3 id="empty-title" class="text-lg font-serif font-bold text-slate-900 dark:text-white">No appointments found</h3>
        <p id="empty-subtitle" class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-sm mx-auto leading-relaxed">Ready for a fresh cut or master hot towel shave? Book your preferred barber in seconds.</p>
        <div class="mt-6">
            <a href="/book" class="inline-flex items-center px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition shadow-sm">
                Book an Appointment &rarr;
            </a>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div id="cancel-modal" class="hidden fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl space-y-4">
        <div>
            <h3 class="text-xl font-serif font-black text-slate-900 dark:text-white">Cancel Appointment</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Are you sure you want to cancel this booking? This slot will immediately be released for other clients.</p>
        </div>
        
        <div class="p-3.5 bg-amber-50/60 dark:bg-amber-950/30 rounded-2xl border border-amber-200 dark:border-amber-800/60 text-xs text-slate-800 dark:text-slate-200 leading-relaxed">
            <div id="cancel-modal-summary"></div>
        </div>

        <div>
            <label for="cancel-reason" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Reason for cancellation <span class="text-slate-400 font-normal lowercase">(optional)</span></label>
            <textarea id="cancel-reason" rows="2" maxlength="300" placeholder="e.g. Schedule conflict, feeling unwell..."
                      class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-xs focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500"></textarea>
        </div>

        <div class="flex justify-end gap-2.5 pt-3 border-t border-slate-100 dark:border-slate-800">
            <button type="button" onclick="closeCancelModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold transition">
                Keep Appointment
            </button>
            <button type="button" id="confirm-cancel-btn" onclick="executeCancel()" class="px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold transition shadow-sm">
                Confirm Cancellation
            </button>
        </div>
    </div>
</div>

<!-- Reschedule Modal -->
<div id="reschedule-modal" class="hidden fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl my-8 space-y-5">
        <div class="flex justify-between items-start">
            <div>
                <h3 class="text-xl font-serif font-black text-slate-900 dark:text-white">Reschedule Appointment</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Choose a new date and open time slot with your barber.</p>
            </div>
            <button type="button" onclick="closeRescheduleModal()" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-1">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Current Appointment Info -->
        <div class="p-3.5 bg-amber-50/60 dark:bg-amber-950/30 rounded-2xl border border-amber-200 dark:border-amber-800/60 text-xs text-slate-800 dark:text-slate-200 leading-relaxed" id="reschedule-modal-summary"></div>

        <!-- Date Picker -->
        <div>
            <label for="reschedule-date" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Select New Date</label>
            <input type="date" id="reschedule-date" onchange="onRescheduleDateChanged()"
                   class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 text-xs focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 font-medium" />
        </div>

        <!-- Slot Picker -->
        <div>
            <label class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Available Slots (Asia/Manila)</label>
            <div id="reschedule-slots-loading" class="hidden py-6 text-center">
                <div class="inline-block w-6 h-6 border-2 border-amber-500/30 border-t-amber-500 rounded-full animate-spin"></div>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 font-medium">Checking live schedule...</p>
            </div>
            <div id="reschedule-slots-empty" class="hidden py-6 text-center text-xs text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800/50 rounded-xl p-4 border border-slate-100 dark:border-slate-800">
                No available slots for this date. Please pick another date.
            </div>
            <div id="reschedule-slots-grid" class="grid grid-cols-3 sm:grid-cols-4 gap-2 max-h-48 overflow-y-auto p-1">
                <!-- Dynamically rendered slot buttons -->
            </div>
        </div>

        <div class="flex justify-end gap-2.5 pt-4 border-t border-slate-100 dark:border-slate-800">
            <button type="button" onclick="closeRescheduleModal()" class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-bold transition">
                Cancel
            </button>
            <button type="button" id="confirm-reschedule-btn" disabled onclick="executeReschedule()"
                    class="px-5 py-2.5 rounded-xl bg-amber-500 disabled:opacity-50 disabled:cursor-not-allowed hover:bg-amber-400 text-slate-950 text-xs font-bold transition shadow-sm">
                Confirm New Slot
            </button>
        </div>
    </div>
</div>

<script>
    let currentScope = 'upcoming';
    let appointmentsData = [];
    let activeModalAppointment = null;
    let selectedRescheduleSlotUtc = null;

    document.addEventListener('DOMContentLoaded', () => {
        loadAppointments('upcoming');
    });

    function switchTab(scope) {
        currentScope = scope;
        const upcomingBtn = document.getElementById('tab-upcoming-btn');
        const historyBtn = document.getElementById('tab-history-btn');

        if (scope === 'upcoming') {
            upcomingBtn.className = 'px-6 py-3.5 text-sm font-bold border-b-2 border-amber-500 text-amber-800 flex items-center gap-2 transition-colors';
            historyBtn.className = 'px-6 py-3.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 transition-colors';
        } else {
            historyBtn.className = 'px-6 py-3.5 text-sm font-bold border-b-2 border-amber-500 text-amber-800 flex items-center gap-2 transition-colors';
            upcomingBtn.className = 'px-6 py-3.5 text-sm font-semibold border-b-2 border-transparent text-slate-500 hover:text-slate-800 flex items-center gap-2 transition-colors';
        }

        loadAppointments(scope);
    }

    async function loadAppointments(scope) {
        const loading = document.getElementById('appointments-loading');
        const empty = document.getElementById('appointments-empty');
        const container = document.getElementById('appointments-container');

        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        container.innerHTML = '';

        try {
            const resp = await fetch(`/api/me/appointments?scope=${scope}`);
            loading.classList.add('hidden');

            if (!resp.ok) {
                showAlert('Failed to load appointments.', 'error');
                return;
            }

            appointmentsData = await resp.json();

            // Update badge count
            const countBadge = document.getElementById(`badge-${scope}-count`);
            if (countBadge) {
                countBadge.innerText = appointmentsData.length;
                countBadge.classList.remove('hidden');
            }

            if (appointmentsData.length === 0) {
                document.getElementById('empty-title').innerText = scope === 'upcoming'
                    ? 'No upcoming appointments'
                    : 'No appointment history';
                document.getElementById('empty-subtitle').innerText = scope === 'upcoming'
                    ? 'You have no pending or confirmed bookings at the moment.'
                    : 'Completed and past appointments will appear here.';
                empty.classList.remove('hidden');
                return;
            }

            renderAppointments(appointmentsData, container);
        } catch (e) {
            loading.classList.add('hidden');
            showAlert('Network error loading appointments.', 'error');
        }
    }

    function renderAppointments(list, container) {
        list.forEach(app => {
            const card = document.createElement('div');
            card.className = 'bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-3xl p-6 shadow-sm hover:shadow-md hover:border-amber-500/50 transition duration-200';
            
            const statusBadgeHtml = getStatusBadge(app.status, app.statusDisplay);

            const actionsHtml = app.canCancelOrReschedule ? `
                <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-end gap-2.5">
                    <button type="button" onclick="openRescheduleModal(${app.id})" class="px-3.5 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-bold text-xs border border-slate-200 dark:border-slate-700 transition">
                        Reschedule
                    </button>
                    <button type="button" onclick="openCancelModal(${app.id})" class="px-3.5 py-1.5 rounded-xl bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 dark:hover:bg-rose-900/60 text-rose-700 dark:text-rose-300 font-bold text-xs border border-rose-200 dark:border-rose-800 transition">
                        Cancel
                    </button>
                </div>
            ` : '';

            const timelineHtml = renderTimeline(app.timeline, app.id);

            card.innerHTML = `
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="text-xs font-mono font-bold text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 px-2.5 py-0.5 rounded-md border border-amber-200 dark:border-amber-800">
                                ${app.referenceCode}
                            </span>
                            ${statusBadgeHtml}
                        </div>
                        <h3 class="text-xl font-serif font-bold text-slate-900 dark:text-white">${app.serviceName}</h3>
                        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">Barber: <strong class="text-slate-900 dark:text-slate-100 font-bold">${app.barberName}</strong>${app.branchName ? ` &bull; <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-300 border border-amber-200 dark:border-amber-800">${app.branchName}</span>` : ''} &bull; ${app.durationMinutes} mins</p>
                    </div>
                    <div class="text-left sm:text-right">
                        <span class="text-xl font-black text-slate-900 dark:text-white font-mono">${app.formattedPrice}</span>
                        <p class="text-xs font-bold text-slate-800 dark:text-slate-200 mt-1">${app.formattedDate}</p>
                        <p class="text-xs text-amber-700 dark:text-amber-400 font-bold">${app.formattedTime}</p>
                    </div>
                </div>

                ${app.notes ? `
                    <div class="mt-3 text-xs bg-amber-50/40 dark:bg-amber-950/30 p-3 rounded-2xl border border-amber-200/60 dark:border-amber-800/60 text-slate-700 dark:text-slate-300">
                        <span class="text-slate-500 dark:text-slate-400 font-semibold">Special Instructions:</span> "${app.notes}"
                    </div>
                ` : ''}

                <div class="mt-4 flex items-center justify-between text-xs">
                    <button type="button" onclick="toggleTimeline(${app.id})" class="text-xs text-slate-500 dark:text-slate-400 hover:text-amber-800 dark:hover:text-amber-400 font-semibold flex items-center gap-1 transition">
                        <span id="timeline-toggle-text-${app.id}">View Status History</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                </div>

                <div id="timeline-${app.id}" class="hidden mt-3 pt-3 border-t border-slate-100 dark:border-slate-800">
                    ${timelineHtml}
                </div>

                ${actionsHtml}
            `;

            container.appendChild(card);
        });
    }

    function renderTimeline(timeline, appId) {
        if (!timeline || timeline.length === 0) {
            return '<p class="text-[11px] text-slate-400 italic">No history records found.</p>';
        }

        const items = timeline.map(item => `
            <li class="mb-3 ml-4">
                <div class="absolute -left-1.5 mt-1.5 w-3 h-3 rounded-full border-2 border-white bg-amber-500"></div>
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-slate-900 uppercase tracking-wider">${item.toStatus}</span>
                    <span class="text-[11px] text-slate-500">by ${item.changedByRole}</span>
                </div>
                <p class="text-[11px] text-slate-600 mt-0.5">${item.note || 'Status updated'}</p>
                <time class="text-[10px] text-slate-400 block mt-0.5">${item.formattedChangedAt}</time>
            </li>
        `).join('');

        return `
            <div class="pl-2">
                <span class="text-[11px] font-bold text-slate-500 block mb-2 uppercase tracking-wider">Status History Audit</span>
                <ol class="relative border-l border-slate-200 text-xs">
                    ${items}
                </ol>
            </div>
        `;
    }

    function toggleTimeline(id) {
        const el = document.getElementById(`timeline-${id}`);
        const text = document.getElementById(`timeline-toggle-text-${id}`);
        if (!el) return;
        const isHidden = el.classList.toggle('hidden');
        text.innerText = isHidden ? 'View Status History' : 'Hide Status History';
    }

    function getStatusBadge(status, display) {
        let cls = 'bg-slate-100 text-slate-700 border-slate-200';
        if (status === 'pending') cls = 'bg-amber-50 text-amber-800 border-amber-200';
        else if (status === 'confirmed') cls = 'bg-blue-50 text-blue-700 border-blue-200';
        else if (status === 'completed') cls = 'bg-emerald-50 text-emerald-700 border-emerald-200';
        else if (status === 'cancelled') cls = 'bg-slate-100 text-slate-600 border-slate-200';
        else if (status === 'rejected') cls = 'bg-rose-50 text-rose-700 border-rose-200';

        return `<span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${cls}">${display}</span>`;
    }

    function showAlert(msg, type) {
        const alert = document.getElementById('status-alert');
        alert.innerText = msg;
        if (type === 'error') {
            alert.className = 'p-4 rounded-2xl text-sm bg-rose-50 border border-rose-200 text-rose-800 font-semibold';
        } else {
            alert.className = 'p-4 rounded-2xl text-sm bg-emerald-50 border border-emerald-200 text-emerald-800 font-semibold';
        }
        alert.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Modal: Cancel
    function openCancelModal(id) {
        activeModalAppointment = appointmentsData.find(a => a.id === id);
        if (!activeModalAppointment) return;

        document.getElementById('cancel-modal-summary').innerHTML = `
            <strong>${activeModalAppointment.serviceName}</strong> with <strong>${activeModalAppointment.barberName}</strong><br/>
            Scheduled for ${activeModalAppointment.formattedDate} at ${activeModalAppointment.formattedTime}
        `;
        document.getElementById('cancel-reason').value = '';
        document.getElementById('cancel-modal').classList.remove('hidden');
    }

    function closeCancelModal() {
        document.getElementById('cancel-modal').classList.add('hidden');
        activeModalAppointment = null;
    }

    async function executeCancel() {
        if (!activeModalAppointment) return;
        const btn = document.getElementById('confirm-cancel-btn');
        const reason = document.getElementById('cancel-reason').value;

        btn.disabled = true;
        btn.innerText = 'Cancelling...';

        try {
            const resp = await fetch(`/api/appointments/${activeModalAppointment.id}/cancel`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ reason: reason })
            });

            closeCancelModal();

            if (resp.ok) {
                showAlert('Your appointment has been cancelled.', 'success');
                loadAppointments(currentScope);
            } else {
                const err = await resp.json().catch(() => null);
                showAlert(err?.error?.message || 'Failed to cancel appointment.', 'error');
            }
        } catch (e) {
            closeCancelModal();
            showAlert('Network error while cancelling.', 'error');
        } finally {
            btn.disabled = false;
            btn.innerText = 'Confirm Cancellation';
        }
    }

    // Modal: Reschedule
    function openRescheduleModal(id) {
        activeModalAppointment = appointmentsData.find(a => a.id === id);
        if (!activeModalAppointment) return;

        selectedRescheduleSlotUtc = null;
        document.getElementById('confirm-reschedule-btn').disabled = true;

        document.getElementById('reschedule-modal-summary').innerHTML = `
            <strong>${activeModalAppointment.serviceName}</strong> with <strong>${activeModalAppointment.barberName}</strong><br/>
            Current slot: <span class="text-amber-800 font-bold">${activeModalAppointment.formattedDate} at ${activeModalAppointment.formattedTime}</span>
        `;

        // Default date picker to current appointment date or today
        const picker = document.getElementById('reschedule-date');
        const today = new Date().toISOString().split('T')[0];
        picker.min = today;
        picker.value = today;

        document.getElementById('reschedule-modal').classList.remove('hidden');
        loadRescheduleSlots();
    }

    function closeRescheduleModal() {
        document.getElementById('reschedule-modal').classList.add('hidden');
        activeModalAppointment = null;
        selectedRescheduleSlotUtc = null;
    }

    function onRescheduleDateChanged() {
        selectedRescheduleSlotUtc = null;
        document.getElementById('confirm-reschedule-btn').disabled = true;
        loadRescheduleSlots();
    }

    async function loadRescheduleSlots() {
        if (!activeModalAppointment) return;
        const date = document.getElementById('reschedule-date').value;
        const loading = document.getElementById('reschedule-slots-loading');
        const empty = document.getElementById('reschedule-slots-empty');
        const grid = document.getElementById('reschedule-slots-grid');

        loading.classList.remove('hidden');
        empty.classList.add('hidden');
        grid.innerHTML = '';

        try {
            const resp = await fetch(`/api/barbers/${activeModalAppointment.barberId}/availability?serviceId=${activeModalAppointment.serviceId}&date=${date}`);
            loading.classList.add('hidden');

            if (!resp.ok) {
                empty.classList.remove('hidden');
                return;
            }

            const data = await resp.json();
            const slots = data.slotDetails || [];

            if (slots.length === 0) {
                empty.classList.remove('hidden');
                return;
            }

            slots.forEach(s => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'reschedule-slot-btn py-2.5 px-2 text-center rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 text-xs font-semibold hover:border-amber-500 hover:bg-amber-50/50 dark:hover:bg-amber-500/20 transition-all';
                btn.innerText = s.formattedTime;
                btn.onclick = () => {
                    document.querySelectorAll('.reschedule-slot-btn').forEach(b => {
                        b.className = 'reschedule-slot-btn py-2.5 px-2 text-center rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 text-xs font-semibold hover:border-amber-500 hover:bg-amber-50/50 dark:hover:bg-amber-500/20 transition-all';
                    });
                    btn.className = 'reschedule-slot-btn py-2.5 px-2 text-center rounded-xl bg-amber-500 text-slate-950 border border-amber-500 text-xs font-extrabold shadow-sm transition-all';
                    selectedRescheduleSlotUtc = s.startsAtUtc;
                    document.getElementById('confirm-reschedule-btn').disabled = false;
                };
                grid.appendChild(btn);
            });
        } catch (e) {
            loading.classList.add('hidden');
            empty.classList.remove('hidden');
        }
    }

    async function executeReschedule() {
        if (!activeModalAppointment || !selectedRescheduleSlotUtc) return;
        const btn = document.getElementById('confirm-reschedule-btn');

        btn.disabled = true;
        btn.innerText = 'Updating...';

        try {
            const resp = await fetch(`/api/appointments/${activeModalAppointment.id}/reschedule`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ startsAt: selectedRescheduleSlotUtc })
            });

            if (resp.status === 200) {
                closeRescheduleModal();
                showAlert('Your appointment has been rescheduled. It is now awaiting confirmation by the shop.', 'success');
                loadAppointments(currentScope);
                return;
            }

            const err = await resp.json().catch(() => null);
            if (err?.error?.code === 'SLOT_TAKEN') {
                alert('That slot was just booked by another customer. Please choose a different slot.');
                loadRescheduleSlots();
            } else {
                alert(err?.error?.message || 'Failed to reschedule.');
            }
        } catch (e) {
            alert('A network error occurred while rescheduling.');
        } finally {
            btn.disabled = false;
            btn.innerText = 'Confirm New Slot';
        }
    }
</script>
