@model List<BarberBook.Data.Entities.Service>
@{
    ViewData["Title"] = "BarberBook · Classic Cuts & Master Grooming";
    var barbers = ViewBag.Barbers as List<BarberBook.Data.Entities.Barber> ?? new List<BarberBook.Data.Entities.Barber>();
    var branches = ViewBag.Branches as List<BarberBook.Data.Entities.Branch> ?? new List<BarberBook.Data.Entities.Branch>();
    var products = ViewBag.Products as IReadOnlyList<BarberBook.Web.Models.Inventory.ProductDto> ?? new List<BarberBook.Web.Models.Inventory.ProductDto>();

    // Local offline vectors and uploaded portraits mapped to service types
    string GetServiceImage(string name)
    {
        var lower = name.ToLowerInvariant();
        if (lower.Contains("beard"))
            return "/images/services/beard.svg";
        if (lower.Contains("color") || lower.Contains("treatment"))
            return "/images/services/color.svg";
        if (lower.Contains("shave"))
            return "/images/services/shave.svg";
        return "/images/services/haircut.svg";
    }

    // Local barber portraits and uploads
    string GetBarberImage(string name, string? existingUrl)
    {
        if (!string.IsNullOrWhiteSpace(existingUrl))
            return existingUrl;

        var lower = name.ToLowerInvariant();
        if (lower.Contains("ramon"))
            return "/images/barbers/ramon.svg";
        if (lower.Contains("dennis"))
            return "/images/barbers/dennis.svg";
        return "/images/barbers/default-barber.svg";
    }
}

<div class="space-y-20 py-4">
    <!-- HERO SECTION -->
    <div class="relative overflow-hidden rounded-3xl bg-slate-900 text-white shadow-2xl border border-slate-800">
        <!-- Background Image with Dark Vignette Overlay -->
        <div class="absolute inset-0 bg-cover bg-center pointer-events-none" style="background-image: url('/images/hero/hero-bg.svg');">
            <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-900/90 to-slate-950/80"></div>
        </div>

        <div class="relative z-10 px-6 py-16 sm:px-12 sm:py-24 max-w-4xl">
            <!-- Brass Pill Badge with Animated Mini Barber Pole -->
            <div class="inline-flex items-center gap-2.5 rounded-full bg-brand-500/15 px-4 py-1.5 text-xs font-semibold text-brand-300 border border-brand-500/30 backdrop-blur-sm shadow-inner">
                <div class="barber-pole-icon" style="height: 18px; width: 10px;"></div>
                <span class="tracking-widest uppercase">EST. 2026 &bull; MASTER GROOMING &bull; MANILA</span>
            </div>

            <!-- Vintage Serif Headline -->
            <h1 class="mt-6 text-4xl font-serif font-black tracking-tight sm:text-6xl text-white leading-[1.15]">
                The Art of Classic Grooming &amp; Precision Cuts.
            </h1>

            <p class="mt-5 text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-light">
                Where timeless craftsmanship meets modern convenience. Book your preferred master barber in seconds with guaranteed real-time availability and zero waiting.
            </p>

            <!-- CTA Actions -->
            <div class="mt-8 flex flex-wrap gap-4 items-center">
                <a href="/book" class="inline-flex items-center justify-center rounded-xl bg-brand-500 px-7 py-4 text-base font-bold text-slate-950 shadow-xl hover:bg-brand-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400 transition transform hover:-translate-y-0.5">
                    <svg class="w-5 h-5 mr-2 -ml-1 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    Book an Appointment
                </a>
                <a href="/services" class="inline-flex items-center justify-center rounded-xl bg-slate-800/80 backdrop-blur-sm px-6 py-4 text-sm font-bold text-white border border-slate-700 hover:bg-slate-700 transition">
                    Grooming Menu
                </a>
                <a href="/barbers" class="inline-flex items-center justify-center rounded-xl px-4 py-4 text-sm font-semibold text-brand-300 hover:text-brand-200 transition">
                    Meet Our Barbers &rarr;
                </a>
            </div>

            <!-- Shop Schedule Footnote -->
            <div class="mt-10 pt-6 border-t border-slate-800/80 flex flex-wrap items-center gap-6 text-xs text-slate-400">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Shop Open: <strong class="text-slate-200">Mon&ndash;Sat 9:00 AM &ndash; 6:00 PM</strong></span>
                </div>
                <div>&bull;</div>
                <div>In-Shop Settlement (Cash / Direct)</div>
                <div>&bull;</div>
                <div>30-Min Real-Time Grid</div>
            </div>
        </div>

        <!-- Decorative Spinning Barber Pole Cylinder in Corner -->
        <div class="hidden lg:flex absolute right-12 top-1/2 -translate-y-1/2 flex-col items-center p-6 bg-slate-950/60 rounded-3xl border border-slate-800 backdrop-blur-md shadow-2xl">
            <div class="barber-pole-lg shadow-2xl mb-3"></div>
            <span class="text-[10px] font-mono tracking-widest uppercase text-brand-400 font-bold">BarberBook</span>
            <span class="text-[9px] text-slate-400">Master Suite</span>
        </div>
    </div>

    <!-- SERVICES SHOWCASE ("Apothecary Grooming Menu") -->
    <div class="space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-amber-900/10 dark:border-amber-500/20 pb-5">
            <div>
                <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-700 dark:text-brand-400 mb-1">
                    <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                    <span>Service Catalog</span>
                </div>
                <h2 class="text-3xl font-serif font-black tracking-tight text-slate-900 dark:text-white">Handcrafted Grooming Menu</h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Every service includes personalized consultation, hot towel finish, and classic tonic styling.</p>
            </div>
            <div class="mt-4 sm:mt-0">
                <a href="/services" class="text-sm font-bold text-brand-700 dark:text-brand-400 hover:text-brand-800 dark:hover:text-brand-300 flex items-center group">
                    <span>View All Services</span>
                    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var svc in Model)
            {
                var imgUrl = GetServiceImage(svc.Name);
                <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col sm:flex-row hover:border-brand-500/60 hover:shadow-md transition group">
                    <div class="sm:w-44 h-48 sm:h-auto vintage-img-container shrink-0 bg-slate-900">
                        <img src="@imgUrl" alt="@svc.Name" class="w-full h-full object-cover opacity-90 group-hover:opacity-100" />
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="flex items-baseline justify-between">
                                <h3 class="text-xl font-serif font-bold text-slate-900 dark:text-white group-hover:text-brand-700 dark:group-hover:text-brand-400 transition-colors">
                                    @svc.Name
                                </h3>
                                <span class="text-lg font-extrabold text-slate-900 dark:text-amber-400 ml-2 font-mono">
                                    ₱@svc.Price.ToString("N2")
                                </span>
                            </div>
                            <span class="inline-block mt-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-300 border border-amber-200 dark:border-amber-700/50">
                                @svc.DurationMinutes mins
                            </span>
                            <p class="mt-3 text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
                                @svc.Description
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <span class="text-[11px] text-slate-600 dark:text-slate-400 font-medium italic">Snapshot price guaranteed</span>
                            <a href="/book?serviceId=@svc.Id" class="inline-flex items-center text-xs font-bold text-brand-700 dark:text-brand-400 hover:text-brand-900 dark:hover:text-brand-300">
                                Book This Service &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ARTISAN GROOMING PRODUCTS & APOTHECARY SHOWCASE -->
    @if (products.Any())
    {
        <div class="space-y-8 pt-4">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-amber-900/10 dark:border-amber-500/20 pb-5">
                <div>
                    <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-700 dark:text-brand-400 mb-1">
                        <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                        <span>Apothecary &amp; Grooming Essentials</span>
                    </div>
                    <h2 class="text-3xl font-serif font-black tracking-tight text-slate-900 dark:text-white">Artisan Grooming Products</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Premium pomades, beard oils, and soothing tonics crafted for master styling and daily maintenance.</p>
                </div>
                <div class="mt-4 sm:mt-0">
                    <a href="/products" class="text-sm font-bold text-brand-700 dark:text-brand-400 hover:text-brand-800 dark:hover:text-brand-300 flex items-center group">
                        <span>View Complete Apothecary Catalog</span>
                        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var p in products.Take(6))
                {
                    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col justify-between hover:border-amber-500/60 hover:shadow-lg transition group">
                        <div class="p-6 bg-slate-900 text-white flex items-center justify-between">
                            <div>
                                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30">
                                    @p.Category
                                </span>
                                <div class="font-mono text-xs text-slate-400 mt-1">@p.Sku</div>
                            </div>
                            <div class="w-12 h-12 rounded-2xl bg-slate-800 border border-slate-700 text-amber-400 flex items-center justify-center shrink-0 shadow-inner group-hover:scale-110 transition-transform">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                            </div>
                        </div>

                        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                            <div>
                                <div class="flex items-baseline justify-between gap-2">
                                    <h3 class="text-xl font-serif font-bold text-slate-900 dark:text-white group-hover:text-amber-800 dark:group-hover:text-amber-300 transition">
                                        @p.Name
                                    </h3>
                                    <span class="text-xl font-black text-slate-900 dark:text-amber-400 font-mono shrink-0">
                                        @p.FormattedSellPrice
                                    </span>
                                </div>

                                <div class="flex items-center gap-2 mt-2">
                                    @if (p.CurrentStock > p.ReorderLevel)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-700/50">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            <span>In Stock (@p.CurrentStock @p.Unit)</span>
                                        </span>
                                    }
                                    else if (p.CurrentStock > 0)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-700/50">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                            <span>Low Stock (Only @p.CurrentStock left)</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            <span>Out of Stock</span>
                                        </span>
                                    }
                                    <span class="text-[11px] text-slate-500 dark:text-slate-400">Unit: @p.Unit</span>
                                </div>
                            </div>

                            <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
                                <span class="text-[11px] text-slate-500 dark:text-slate-400 italic">Available in-shop</span>
                                <a href="/products" class="inline-flex items-center font-bold text-amber-700 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 group-hover:translate-x-0.5 transition-transform">
                                    Explore Product Details &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- MASTER BARBERS SHOWCASE -->
    @if (barbers.Any())
    {
        <div class="space-y-8 pt-4">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-amber-900/10 dark:border-amber-500/20 pb-5">
                <div>
                    <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-700 dark:text-brand-400 mb-1">
                        <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                        <span>The Artisans</span>
                    </div>
                    <h2 class="text-3xl font-serif font-black tracking-tight text-slate-900 dark:text-white">Meet Our Master Barbers</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Dedicated professionals with distinct grooming specialties and master techniques.</p>
                </div>
                <div class="mt-4 sm:mt-0">
                    <a href="/barbers" class="text-sm font-bold text-brand-700 dark:text-brand-400 hover:text-brand-800 dark:hover:text-brand-300 flex items-center group">
                        <span>View Profiles &amp; Weekly Schedules</span>
                        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @foreach (var b in barbers)
                {
                    var barberPhoto = GetBarberImage(b.DisplayName, b.PhotoUrl);
                    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col hover:border-brand-500/60 hover:shadow-lg transition group">
                        <div class="h-64 vintage-img-container bg-slate-900 relative">
                            <img src="@barberPhoto" alt="@b.DisplayName" class="w-full h-full object-cover object-top opacity-95 group-hover:opacity-100" />
                            <div class="absolute bottom-3 left-3 bg-slate-900/85 backdrop-blur-sm text-white px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 border border-slate-700">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <span>Active Staff</span>
                            </div>
                        </div>

                        <div class="p-6 flex-1 flex flex-col justify-between">
                            <div>
                                <h3 class="text-2xl font-serif font-bold text-slate-900 dark:text-white">
                                    @b.DisplayName
                                </h3>
                                <p class="text-xs text-brand-700 dark:text-brand-400 font-semibold mt-1">
                                    @b.Specialties
                                </p>
                                <p class="mt-3 text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3">
                                    @b.Bio
                                </p>
                            </div>

                            <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                                <a href="/barbers/@b.Id" class="text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
                                    View Schedule
                                </a>
                                <a href="/book?barberId=@b.Id" class="inline-flex items-center px-4 py-2 rounded-lg text-xs font-bold bg-brand-500 hover:bg-brand-400 text-slate-950 shadow-sm transition">
                                    Book with @b.DisplayName &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- OUR SHOP LOCATIONS (Multi-Branch Showcase) -->
    @if (branches.Any())
    {
        <div class="space-y-8 pt-4">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-amber-900/10 dark:border-amber-500/20 pb-5">
                <div>
                    <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-700 dark:text-brand-400 mb-1">
                        <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                        <span>Locations &amp; Lounges</span>
                    </div>
                    <h2 class="text-3xl font-serif font-black tracking-tight text-slate-900 dark:text-white">Our Shop Locations</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Experience premium master grooming at our strategically situated parlors across Metro Manila.</p>
                </div>
                <div class="mt-4 sm:mt-0">
                    <a href="/book" class="text-sm font-bold text-brand-700 dark:text-brand-400 hover:text-brand-800 dark:hover:text-brand-300 flex items-center group">
                        <span>Book an Appointment</span>
                        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var br in branches)
                {
                    var branchBarbers = barbers.Where(b => b.BranchId == br.Id).ToList();
                    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col justify-between hover:border-amber-500/60 hover:shadow-lg transition group">
                        <div class="p-6 sm:p-7 space-y-4">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-300 border border-amber-200/80 dark:border-amber-700/50 mb-2">
                                        Active Parlor
                                    </span>
                                    <h3 class="text-2xl font-serif font-black text-slate-900 dark:text-white group-hover:text-amber-800 dark:group-hover:text-amber-300 transition">
                                        @br.Name
                                    </h3>
                                </div>
                                <div class="w-10 h-10 rounded-2xl bg-slate-900 text-amber-400 flex items-center justify-center shrink-0 shadow-sm">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                                </div>
                            </div>

                            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed flex items-start gap-2">
                                <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                <span>@br.Address</span>
                            </p>

                            <div class="pt-3 border-t border-slate-100 dark:border-slate-800 grid grid-cols-2 gap-3 text-xs">
                                <div>
                                    <span class="text-slate-400 block text-[11px] font-medium uppercase tracking-wider">Hours</span>
                                    <span class="font-bold text-slate-800 dark:text-slate-200 font-mono">@BarberBook.Web.Common.FormattingHelpers.FormatTime12h(br.OpeningTime) &ndash; @BarberBook.Web.Common.FormattingHelpers.FormatTime12h(br.ClosingTime)</span>
                                </div>
                                <div>
                                    <span class="text-slate-400 block text-[11px] font-medium uppercase tracking-wider">Contact</span>
                                    <span class="font-bold text-slate-800 dark:text-slate-200">@(string.IsNullOrWhiteSpace(br.PhoneNumber) ? "In-Shop" : br.PhoneNumber)</span>
                                </div>
                            </div>

                            @if (branchBarbers.Any())
                            {
                                <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
                                    <span class="text-slate-400 block text-[11px] font-medium uppercase tracking-wider mb-2">Stationed Artisans</span>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var bb in branchBarbers)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                                @bb.DisplayName
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="p-6 pt-0">
                            <a href="/book?branchId=@br.Id" class="w-full inline-flex items-center justify-center px-4 py-3 rounded-2xl bg-slate-900 hover:bg-slate-800 text-amber-300 font-bold text-xs sm:text-sm shadow-md transition group-hover:bg-amber-500 group-hover:text-slate-950">
                                <span>Book at @br.Name &rarr;</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- THE BARBERBOOK STANDARD (Asymmetric Bento Grid with UI Previews) -->
    <div class="bg-slate-900 text-white rounded-3xl p-6 sm:p-10 lg:p-12 border border-slate-800 relative overflow-hidden shadow-2xl">
        <div class="relative z-10 max-w-2xl mb-8">
