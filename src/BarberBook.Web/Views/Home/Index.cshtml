@model List<BarberBook.Data.Entities.Service>
@{
    ViewData["Title"] = "BarberBook · Classic Cuts & Master Grooming";
    var barbers = ViewBag.Barbers as List<BarberBook.Data.Entities.Barber> ?? new List<BarberBook.Data.Entities.Barber>();
    var branches = ViewBag.Branches as List<BarberBook.Data.Entities.Branch> ?? new List<BarberBook.Data.Entities.Branch>();
    var products = ViewBag.Products as IReadOnlyList<BarberBook.Web.Models.Inventory.ProductDto> ?? new List<BarberBook.Web.Models.Inventory.ProductDto>();
    var nextSlots = ViewBag.NextAvailableSlots as Dictionary<int, string>;

    // Live Manila Shop Open / Closed Computation
    var manilaZone = NodaTime.DateTimeZoneProviders.Tzdb["Asia/Manila"];
    var nowInstant = NodaTime.SystemClock.Instance.GetCurrentInstant();
    var manilaNow = nowInstant.InZone(manilaZone);
    var dayOfWeek = manilaNow.DayOfWeek; // 1 (Mon) to 7 (Sun)
    var timeOfDay = manilaNow.TimeOfDay;
    var openTime = new NodaTime.LocalTime(9, 0);
    var closeTime = new NodaTime.LocalTime(18, 0);
    bool isShopOpen = dayOfWeek != NodaTime.IsoDayOfWeek.Sunday && timeOfDay >= openTime && timeOfDay < closeTime;
    string openStatusText = isShopOpen 
        ? "Shop Open · Closes 6:00 PM" 
        : (dayOfWeek == NodaTime.IsoDayOfWeek.Sunday ? "Shop Closed · Opens Mon 9:00 AM" : "Shop Closed · Opens 9:00 AM");

    // Featured 3 Barbers across distinct branches (e.g. Manila Main, BGC, Makati)
    var featuredBarbers = barbers
        .GroupBy(b => b.BranchId)
        .Select(g => g.First())
        .Take(3)
        .ToList();
    if (featuredBarbers.Count < 3 && barbers.Any())
    {
        featuredBarbers = barbers.Take(3).ToList();
    }

    // Featured 3 Products (Pomade, Beard Oil, Matte Clay)
    var featuredProducts = products
        .OrderBy(p => p.Name.Contains("Pomade", StringComparison.OrdinalIgnoreCase) ? 0 
                    : p.Name.Contains("Beard", StringComparison.OrdinalIgnoreCase) ? 1 
                    : p.Name.Contains("Clay", StringComparison.OrdinalIgnoreCase) ? 2 : 3)
        .Take(3)
        .ToList();
}

@functions {
    string GetProductDescription(string name, string category)
    {
        if (name.Contains("Pomade", StringComparison.OrdinalIgnoreCase))
            return "Water-soluble, heavy hold pomade with a polished shine finish. Perfect for classic side parts and slick pompadours.";
        if (name.Contains("Beard Oil", StringComparison.OrdinalIgnoreCase))
            return "Nourishing blend of organic jojoba and Moroccan cedarwood oils to soften coarse facial hair and moisturize skin.";
        if (name.Contains("Clay", StringComparison.OrdinalIgnoreCase))
            return "Natural dry-matte finish styling clay delivering pliable hold and defined texture for modern crops and textured tapers.";
        if (name.Contains("Shave Cream", StringComparison.OrdinalIgnoreCase))
            return "Rich cushion lather infused with eucalyptus and menthol to open pores, reduce razor burn, and deliver a clean shave.";
        if (name.Contains("Tonic", StringComparison.OrdinalIgnoreCase) || name.Contains("Bay Rum", StringComparison.OrdinalIgnoreCase))
            return "Traditional barbershop astringent tonic distilled with natural bay leaf extracts to cool, disinfect, and refresh skin.";
        return "Master-crafted grooming essential formulated and tested daily by our resident barbers.";
    }
}

<div class="space-y-20 py-4">
    <!-- HERO SECTION (Taste-Skill Place Hero with Entry Hook) -->
    <div data-enter class="relative overflow-hidden rounded-3xl bg-slate-900 text-white shadow-2xl border border-slate-800">
        <!-- Background Image with Dark Vignette Overlay -->
        <div class="absolute inset-0 bg-cover bg-center pointer-events-none opacity-30 mix-blend-luminosity" style="background-image: url('/images/hero/hero-bg.jpg');"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-900/90 to-slate-950/80 pointer-events-none"></div>

        <div class="relative z-10 px-6 py-14 sm:px-12 sm:py-20 max-w-4xl lg:pr-96">
            <!-- Brass Pill Badge with Animated Mini Barber Pole -->
            <div class="inline-flex items-center gap-2.5 rounded-full bg-amber-500/15 px-4 py-1.5 text-xs font-semibold text-amber-300 border border-amber-500/30 backdrop-blur-sm shadow-inner">
                <div class="barber-pole-icon" style="height: 18px; width: 10px;"></div>
                <span class="tracking-widest uppercase">EST. 2026 &bull; MASTER GROOMING &bull; MANILA</span>
            </div>

            <!-- Vintage Serif Headline -->
            <h1 class="mt-6 text-4xl font-serif font-black tracking-tight sm:text-6xl text-white leading-[1.15]">
                The Art of Classic Grooming &amp; Precision Cuts.
            </h1>

            <p class="mt-5 text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-light">
                Handcrafted cuts, hot towel straight-razor shaves, and traditional apothecary grooming in Manila. Book your master barber with locked 30-minute intervals and zero waiting.
            </p>

            <!-- Quick Booking Plain GET Form (Accessible & Reliable) -->
            <form method="get" action="/book" class="mt-8 p-4 sm:p-5 rounded-2xl bg-slate-950/80 border border-slate-700/80 shadow-2xl backdrop-blur-md max-w-2xl">
                <div class="text-[11px] font-mono uppercase tracking-wider text-amber-400 font-bold mb-3 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    <span>Quick Chair Finder</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                        <label for="hero-branch" class="sr-only">Select Branch</label>
                        <select id="hero-branch" name="branchId" class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500">
                            <option value="">All Branches</option>
                            @foreach (var br in branches)
                            {
                                <option value="@br.Id">@br.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="hero-service" class="sr-only">Select Service</label>
                        <select id="hero-service" name="serviceId" class="w-full px-3 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500">
                            <option value="">All Services</option>
                            @foreach (var svc in Model)
                            {
                                <option value="@svc.Id">@svc.Name (₱@svc.Price.ToString("N2"))</option>
                            }
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-all shadow-md active:scale-95 flex items-center justify-center gap-1.5">
                            <span>Find Slots</span>
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </button>
                    </div>
                </div>
            </form>

            <!-- Primary and Secondary Actions -->
            <div class="mt-6 flex flex-wrap gap-4 items-center">
                <a href="/book" class="inline-flex items-center justify-center rounded-xl bg-amber-500 px-6 py-3.5 text-sm font-bold text-slate-950 shadow-xl hover:bg-amber-400 hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900 transition-all duration-150 ease-out">
                    <svg class="w-4 h-4 mr-2 -ml-0.5 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    Book Appointment
                </a>
                <a href="/services" class="inline-flex items-center justify-center rounded-xl bg-slate-800/80 backdrop-blur-sm px-6 py-3.5 text-sm font-bold text-white border border-slate-700 hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900 transition-all duration-150 ease-out">
                    View Services Menu
                </a>
            </div>

            <!-- Dynamic Live Shop Schedule Footnote -->
            <div class="mt-8 pt-5 border-t border-slate-800/80 flex flex-wrap items-center gap-4 text-xs text-slate-400">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full @(isShopOpen ? "bg-emerald-400 animate-pulse" : "bg-amber-400")"></span>
                    <span><strong class="text-slate-200">@openStatusText</strong></span>
                </div>
                <div>&bull;</div>
                <div>In-Shop Settlement (Cash / Direct)</div>
                <div>&bull;</div>
                <div>Guaranteed 30-Min Chair Time</div>
            </div>
        </div>

        <!-- Hero Featured Master Craftsman Showcase -->
        <div class="hidden lg:block absolute right-8 sm:right-12 top-1/2 -translate-y-1/2 w-72 xl:w-80">
            <div class="relative group">
                <!-- Ambient Backglow -->
                <div class="absolute -inset-1 bg-gradient-to-r from-amber-500/30 to-amber-600/20 rounded-3xl blur-xl opacity-60 group-hover:opacity-100 transition duration-500"></div>
                <!-- Card Frame -->
                <div class="relative rounded-3xl bg-slate-950/80 border-2 border-amber-500/30 overflow-hidden shadow-2xl backdrop-blur-md">
                    <div class="h-80 vintage-img-container overflow-hidden relative">
                        <img src="/images/hero/hero-barber.jpg" alt="Master Barber Craftsmanship" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
                        <!-- Floating Badge -->
                        <div class="absolute top-4 left-4 bg-slate-950/80 backdrop-blur-md px-3 py-1.5 rounded-full border border-amber-500/30 flex items-center gap-2 text-xs font-bold text-amber-300">
                            <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                            <span>CHAIR RESERVED</span>
                        </div>
                    </div>
                    <div class="p-5 bg-slate-950/90 border-t border-slate-800">
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="text-[10px] font-mono uppercase tracking-widest text-amber-400 font-bold">Traditional &bull; Modern</span>
                                <h4 class="text-base font-serif font-black text-white">The Precision Cut</h4>
                            </div>
                            <span class="text-xs px-2.5 py-1 rounded-full @(isShopOpen ? "bg-emerald-500/20 text-emerald-300 border border-emerald-500/30" : "bg-amber-500/20 text-amber-300 border border-amber-500/30") font-semibold flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full @(isShopOpen ? "bg-emerald-400 animate-pulse" : "bg-amber-400")"></span>
                                @(isShopOpen ? "Available Today" : "Next Available: 9 AM")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 1. SERVICES SHOWCASE (All 4 Services in Balanced 2x2 Grid) -->
    <div class="space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-amber-900/10 dark:border-amber-500/20 pb-5">
            <div>
                <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-amber-800 dark:text-amber-400 mb-1">
                    <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                    <span>Service Catalog</span>
                </div>
                <h2 class="text-3xl font-serif font-black tracking-tight text-slate-900 dark:text-white">Handcrafted Grooming Menu</h2>
                <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Every service includes consultation, hot towel neck shave, and custom tonic styling.</p>
            </div>
            <div class="mt-4 sm:mt-0">
                <a href="/services" class="text-sm font-bold text-amber-800 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 flex items-center group">
                    <span>View All Services</span>
                    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var svc in Model)
            {
                var imgUrl = BarberBook.Web.Common.ImageHelpers.GetServiceImage(svc.Name);
                <article class="card bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col sm:flex-row hover:border-amber-500/60 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 group">
                    <div class="sm:w-48 h-48 sm:h-auto vintage-img-container shrink-0 bg-slate-900 overflow-hidden relative">
                        <img src="@imgUrl" alt="@svc.Name" loading="lazy" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-transform duration-300 ease-out" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 to-transparent sm:hidden"></div>
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="flex items-baseline justify-between">
                                <h3 class="text-xl font-serif font-bold text-slate-900 dark:text-white group-hover:text-amber-800 dark:group-hover:text-amber-400 transition-colors">
                                    @svc.Name
                                </h3>
                                <span class="text-lg font-extrabold text-slate-900 dark:text-amber-400 ml-2 font-mono">
                                    ₱@svc.Price.ToString("N2")
                                </span>
                            </div>
                            <span class="inline-block mt-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-300 border border-amber-200 dark:border-amber-700/50">
                                @svc.DurationMinutes mins
                            </span>
                            <p class="mt-3 text-xs text-slate-600 dark:text-slate-400 line-clamp-2 leading-relaxed">
                                @svc.Description
                            </p>
                        </div>
                        <footer class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">In-Shop Settlement</span>
                            <a href="/book?serviceId=@svc.Id" class="inline-flex items-center text-xs font-bold text-amber-800 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 active:scale-[0.98] transition-transform">
                                Book This Service &rarr;
                            </a>
                        </footer>
                    </div>
                </article>
            }
        </div>
    </div>

    <!-- 2. MASTER BARBERS SHOWCASE (Capped at 3 Featured across Branches) -->
    @if (featuredBarbers.Any())
    {
        <div class="space-y-8 pt-4">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-amber-900/10 dark:border-amber-500/20 pb-5">
                <div>
                    <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-amber-800 dark:text-amber-400 mb-1">
                        <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                        <span>The Artisans</span>
                    </div>
                    <h2 class="text-3xl font-serif font-black tracking-tight text-slate-900 dark:text-white">Meet Our Master Barbers</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Dedicated grooming craftsmen stationed across our Metro Manila locations.</p>
                </div>
                <div class="mt-4 sm:mt-0">
                    <a href="/barbers" class="text-sm font-bold text-amber-800 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 flex items-center group">
                        <span>View All Barbers &amp; Schedules</span>
                        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @foreach (var b in featuredBarbers)
                {
                    var barberPhoto = BarberBook.Web.Common.ImageHelpers.GetBarberImage(b.DisplayName, b.PhotoUrl);
                    <article class="card bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col justify-between hover:border-amber-500/60 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 group">
                        <div>
                            <div class="h-64 vintage-img-container bg-slate-900 relative overflow-hidden">
                                <img src="@barberPhoto" alt="@b.DisplayName" loading="lazy" class="w-full h-full object-cover object-top opacity-95 group-hover:opacity-100 group-hover:scale-105 transition-transform duration-300 ease-out" />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
                                @if (b.Branch != null)
                                {
                                    <div class="absolute bottom-3 left-3 bg-slate-900/90 backdrop-blur-sm text-amber-300 px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 border border-slate-700">
                                        <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                        <span>@b.Branch.Name</span>
                                    </div>
                                }
                            </div>

                            <div class="p-6">
                                <h3 class="text-2xl font-serif font-bold text-slate-900 dark:text-white">
                                    @b.DisplayName
                                </h3>
                                <p class="text-xs text-amber-800 dark:text-amber-400 font-semibold mt-1">
                                    @b.Specialties
                                </p>
                                <!-- Live Next Available Slot Indicator (CF-3, BR-04) -->
                                <div class="mt-2.5 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/60">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                    <span>Next: @(nextSlots != null && nextSlots.TryGetValue(b.Id, out var fSlot) ? fSlot : "Available This Week")</span>
                                </div>
                                <p class="mt-3 text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3">
                                    @b.Bio
                                </p>
                            </div>
                        </div>

                        <footer class="p-6 pt-0 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <a href="/barbers/@b.Id" class="text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
                                View Schedule
                            </a>
                            <a href="/book?barberId=@b.Id" class="inline-flex items-center px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-sm active:scale-[0.98] transition-all duration-150">
                                Book with @b.DisplayName &rarr;
                            </a>
                        </footer>
                    </article>
                }
            </div>
        </div>
    }

    <!-- 3. OUR SHOP LOCATIONS (Multi-Branch Showcase) -->
    @if (branches.Any())
    {
        <div class="space-y-8 pt-4">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-amber-900/10 dark:border-amber-500/20 pb-5">
                <div>
                    <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-amber-800 dark:text-amber-400 mb-1">
                        <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                        <span>Locations &amp; Lounges</span>
                    </div>
                    <h2 class="text-3xl font-serif font-black tracking-tight text-slate-900 dark:text-white">Our Shop Locations</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Experience premium master grooming at our parlors across Metro Manila.</p>
                </div>
                <div class="mt-4 sm:mt-0">
                    <a href="/book" class="text-sm font-bold text-amber-800 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 flex items-center group">
                        <span>Book an Appointment</span>
                        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var br in branches)
                {
                    var branchImg = BarberBook.Web.Common.ImageHelpers.GetBranchImage(br.Name);
                    var branchBarbers = barbers.Where(b => b.BranchId == br.Id).ToList();
                    var (district, transitCue, landmark) = BarberBook.Web.Common.BranchHelpers.GetBranchDetails(br.Name);
                    <article class="card bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col justify-between hover:border-amber-500/60 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 group">
                        <!-- Branch Photography Header -->
                        <div class="h-44 vintage-img-container bg-slate-950 relative overflow-hidden shrink-0">
                            <img src="@branchImg" alt="@br.Name" loading="lazy" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-transform duration-300 ease-out" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-slate-950/40 pointer-events-none"></div>
                            <div class="absolute top-3 left-3">
                                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-slate-900/85 text-amber-400 border border-amber-500/30 backdrop-blur-sm shadow-sm">
                                    @district
                                </span>
                            </div>
                        </div>

                        <div class="p-6 sm:p-7 space-y-4">
                            <div class="flex items-start justify-between gap-4">
                                <h3 class="text-2xl font-serif font-black text-slate-900 dark:text-white group-hover:text-amber-800 dark:group-hover:text-amber-300 transition">
                                    @br.Name
                                </h3>
                                <div class="w-10 h-10 rounded-2xl bg-slate-900 text-amber-400 flex items-center justify-center shrink-0 shadow-sm">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
                                </div>
                            </div>

                            <div class="space-y-1.5 text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                                <p class="flex items-start gap-2">
                                    <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                    <span class="font-medium text-slate-800 dark:text-slate-200">@br.Address</span>
                                </p>
                                <p class="flex items-start gap-2 text-xs text-amber-900 dark:text-amber-400/90 pl-6">
                                    <span>📍 @transitCue &bull; @landmark</span>
                                </p>
                            </div>

                            <div class="pt-3 border-t border-slate-100 dark:border-slate-800 grid grid-cols-2 gap-3 text-xs">
                                <div>
                                    <span class="text-slate-600 dark:text-slate-400 block text-[11px] font-semibold uppercase tracking-wider">Hours</span>
                                    <span class="font-bold text-slate-800 dark:text-slate-200 font-mono text-xs">Mon&ndash;Sat 9:00 AM &ndash; 6:00 PM</span>
                                    <span class="text-[10px] text-rose-600 dark:text-rose-400 font-semibold block mt-0.5">Closed Sundays</span>
                                </div>
                                <div>
                                    <span class="text-slate-600 dark:text-slate-400 block text-[11px] font-semibold uppercase tracking-wider">Contact</span>
                                    <span class="font-bold text-slate-800 dark:text-slate-200 font-mono text-xs">@(string.IsNullOrWhiteSpace(br.PhoneNumber) ? "In-Shop" : br.PhoneNumber)</span>
                                    <span class="text-[9px] text-slate-600 dark:text-slate-400 block tracking-tight mt-0.5">(Demo Landline &bull; SBIT-3D)</span>
                                </div>
                            </div>

                            @if (branchBarbers.Any())
                            {
                                <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
                                    <span class="text-slate-600 dark:text-slate-400 block text-[11px] font-semibold uppercase tracking-wider mb-2">Stationed Artisans</span>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var bb in branchBarbers)
                                        {
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                                @bb.DisplayName
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <footer class="p-6 pt-0">
                            <a href="/book?branchId=@br.Id" class="w-full inline-flex items-center justify-center px-4 py-3 rounded-2xl bg-slate-900 hover:bg-slate-800 text-amber-300 font-bold text-xs sm:text-sm shadow-md transition-all duration-150 active:scale-[0.98] group-hover:bg-amber-500 group-hover:text-slate-950">
                                <span>Book at @br.Name &rarr;</span>
                            </a>
                        </footer>
                    </article>
                }
            </div>
        </div>
    }

    <!-- 4. HOW IT WORKS (3-Step Seamless Experience) -->
    <div class="bg-amber-50/60 dark:bg-slate-900/60 border border-amber-900/10 dark:border-slate-800 rounded-3xl p-8 sm:p-12">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
            <span class="text-xs uppercase tracking-widest text-amber-800 dark:text-amber-400 font-bold">The Experience</span>
            <h2 class="text-3xl font-serif font-black tracking-tight text-slate-900 dark:text-white">How BarberBook Works</h2>
            <p class="text-sm text-slate-600 dark:text-slate-400">Three straightforward steps to guaranteed chair time and classic styling.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
            <!-- Step 1 -->
            <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-sm relative">
                <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-black text-sm flex items-center justify-center mb-4 shadow-sm">
                    1
                </div>
                <h3 class="text-lg font-serif font-bold text-slate-900 dark:text-white mb-2">Select Service &amp; Barber</h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    Pick your haircut or shave service and choose your preferred master craftsman stationed at any of our 5 Metro Manila branches.
                </p>
            </div>

            <!-- Step 2 -->
            <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-sm relative">
                <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-black text-sm flex items-center justify-center mb-4 shadow-sm">
                    2
                </div>
                <h3 class="text-lg font-serif font-bold text-slate-900 dark:text-white mb-2">Lock Your Chair Interval</h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    Choose an exact date and guaranteed 30-minute time slot. Our scheduling system prevents double-booking so you walk in with zero waiting.
                </p>
            </div>

            <!-- Step 3 -->
            <div class="bg-white dark:bg-slate-900 p-6 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-sm relative">
                <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-black text-sm flex items-center justify-center mb-4 shadow-sm">
                    3
                </div>
                <h3 class="text-lg font-serif font-bold text-slate-900 dark:text-white mb-2">Style &amp; In-Shop Settlement</h3>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    Relax at our styling chair with hot towel care. No online fees or advance charges—simply settle with cash, QR, or card at the counter upon completion.
                </p>
            </div>
        </div>
    </div>

    <!-- 5. ARTISAN GROOMING PRODUCTS (Capped at 3 Featured) -->
    @if (products.Any())
    {
        <div class="space-y-8 pt-4">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-amber-900/10 dark:border-amber-500/20 pb-5">
                <div>
                    <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-amber-800 dark:text-amber-400 mb-1">
                        <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                        <span>Apothecary &amp; Essentials</span>
                    </div>
                    <h2 class="text-3xl font-serif font-black tracking-tight text-slate-900 dark:text-white">Artisan Grooming Products</h2>
                    <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Authentic pomades, beard oils, and soothing tonics formulated for home maintenance.</p>
                </div>
                <div class="mt-4 sm:mt-0">
                    <a href="/products" class="text-sm font-bold text-amber-800 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 flex items-center group">
                        <span>View All Products</span>
                        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                @foreach (var p in featuredProducts)
                {
                    var productImg = BarberBook.Web.Common.ImageHelpers.GetProductImage(p.Sku, p.Name, p.Category);
                    <article class="card bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col justify-between hover:border-amber-500/60 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 group">
                        <!-- Product Photo Header -->
                        <div class="h-52 vintage-img-container bg-slate-950 relative overflow-hidden shrink-0">
                            <img src="@productImg" alt="@p.Name" loading="lazy" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-transform duration-300 ease-out" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-slate-950/40 pointer-events-none"></div>
                            <div class="absolute top-3 left-3">
                                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-slate-950/80 text-amber-300 border border-amber-500/30 backdrop-blur-sm">
                                    @p.Category
                                </span>
                            </div>
                        </div>

                        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                            <div>
                                <div class="flex items-baseline justify-between gap-2">
                                    <h3 class="text-xl font-serif font-bold text-slate-900 dark:text-white group-hover:text-amber-800 dark:group-hover:text-amber-300 transition">
                                        @p.Name
                                    </h3>
                                    <span class="text-xl font-black text-slate-900 dark:text-amber-400 font-mono shrink-0">
                                        @p.FormattedSellPrice
                                    </span>
                                </div>

                                <div class="flex items-center gap-2 mt-2">
                                    @if (p.CurrentStock > p.ReorderLevel)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-700/50">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            <span>In Stock</span>
                                        </span>
                                    }
                                    else if (p.CurrentStock > 0)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-700/50">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                            <span>Low Stock (Only @p.CurrentStock left)</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                            <span>Out of Stock</span>
                                        </span>
                                    }
                                </div>

                                <p class="mt-3 text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-2">
                                    @GetProductDescription(p.Name, p.Category)
                                </p>
                            </div>

                            <footer class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
                                <span class="text-[11px] text-slate-500 dark:text-slate-400 italic">Available in-shop</span>
                                <a href="/products" class="inline-flex items-center font-bold text-amber-700 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 group-hover:translate-x-0.5 active:scale-[0.98] transition-transform">
                                    Explore Product Details &rarr;
                                </a>
                            </footer>
                        </div>
                    </article>
                }
            </div>
        </div>
    }

    <!-- 6. THE BARBERBOOK STANDARD (Trust & Service Guarantees) -->
    <div class="bg-slate-900 text-white rounded-3xl p-6 sm:p-10 lg:p-12 border border-slate-800 relative overflow-hidden shadow-2xl">
        <div class="relative z-10 max-w-2xl mb-8">
            <span class="text-xs uppercase tracking-widest text-amber-400 font-bold block mb-2">The BarberBook Standard</span>
            <h3 class="text-2xl sm:text-3xl font-serif font-bold text-white">Engineered for Precision &amp; Convenience</h3>
            <p class="text-sm text-slate-300 mt-2">Built specifically for punctuality, master craftsmanship, and transparent service.</p>
        </div>

        <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Bento 1: Guaranteed Chair Time -->
            <article class="md:col-span-2 p-6 sm:p-8 rounded-2xl bg-slate-800/80 border border-slate-700/80 flex flex-col justify-between hover:border-amber-500/50 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            Zero Double-Booking
                        </span>
                        <span class="text-[11px] font-mono text-slate-400">Strict Slot Reservation</span>
                    </div>
                    <h4 class="text-lg sm:text-xl font-bold text-white font-serif">Guaranteed Chair Time</h4>
                    <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed max-w-xl">
                        Our scheduling system guarantees zero overlapping appointments. When you select an artisan and a time slot, it is locked exclusively for your grooming session.
                    </p>
                </div>

                <!-- Visual Slot Grid Preview -->
                <div class="mt-6 p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
                    <div class="flex items-center justify-between text-[11px] text-slate-400 mb-2 font-mono">
                        <span>Schedule Grid Preview</span>
                        <span class="text-emerald-400">30-Min Intervals</span>
                    </div>
                    <div class="grid grid-cols-4 sm:grid-cols-6 gap-2 text-center text-xs font-semibold">
                        <span class="py-1.5 px-2 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">10:00 AM</span>
                        <span class="py-1.5 px-2 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">10:30 AM</span>
                        <span class="py-1.5 px-2 rounded-lg bg-slate-800/60 text-slate-300 border border-slate-700/50 line-through">11:00 AM</span>
                        <span class="py-1.5 px-2 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">11:30 AM</span>
                        <span class="py-1.5 px-2 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">01:00 PM</span>
                        <span class="py-1.5 px-2 rounded-lg bg-slate-800/60 text-slate-300 border border-slate-700/50 line-through">01:30 PM</span>
                    </div>
                </div>
            </article>

            <!-- Bento 2: In-Shop Counter Settlement -->
            <article class="p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-slate-800/90 to-slate-900 border border-slate-700/80 flex flex-col justify-between hover:border-amber-500/50 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200">
                <div>
                    <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center justify-center font-bold mb-4">
                        <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" /></svg>
                    </div>
                    <h4 class="text-lg font-bold text-white font-serif">Pay After Your Cut</h4>
                    <p class="mt-2 text-xs text-slate-300 leading-relaxed">
                        No online payment gateway fees or convenience surcharges. Pay the exact service price upon completion via Cash, QR, or Card at the shop counter.
                    </p>
                </div>
                <footer class="mt-6 pt-4 border-t border-slate-700/60 flex items-center justify-between text-xs text-amber-400 font-semibold">
                    <span>Zero Surcharges</span>
                    <span>100% Transparent</span>
                </footer>
            </article>

            <!-- Bento 3: Sterilized & Sanitized Tools -->
            <article class="p-6 sm:p-8 rounded-2xl bg-slate-800/80 border border-slate-700/80 flex flex-col justify-between hover:border-blue-500/50 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200">
                <div>
                    <div class="w-10 h-10 rounded-xl bg-blue-500/20 text-blue-300 border border-blue-500/30 flex items-center justify-center font-bold mb-4">
                        <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
                    </div>
                    <h4 class="text-lg font-bold text-white font-serif">Sterilized &amp; Sanitized Tools</h4>
                    <p class="mt-2 text-xs text-slate-300 leading-relaxed">
                        Every clipper, shear, and straight razor undergoes medical-grade UV sanitation and blade disinfection before and after every single client haircut.
                    </p>
                </div>
                <footer class="mt-6 pt-4 border-t border-slate-700/60 flex items-center justify-between text-xs text-blue-300 font-semibold">
                    <span>Single-Use Blades</span>
                    <span>UV Sanitized</span>
                </footer>
            </article>

            <!-- Bento 4: Reschedule Flexibility -->
            <article class="md:col-span-2 p-6 sm:p-8 rounded-2xl bg-slate-800/80 border border-slate-700/80 flex flex-col justify-between hover:border-amber-500/50 hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                            Instant Self-Service
                        </span>
                        <span class="text-[11px] font-mono text-slate-400">Zero-Friction Rebooking</span>
                    </div>
                    <h4 class="text-lg sm:text-xl font-bold text-white font-serif">Flexible Rescheduling &amp; Cancellations</h4>
                    <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed max-w-xl">
                        Plans changed? Move your appointment to any open slot or cancel directly from your customer portal up to 2 hours before your scheduled time.
                    </p>
                </div>
                <footer class="mt-6 flex flex-wrap gap-3 items-center">
                    <a href="/book" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-amber-500 text-slate-950 font-bold text-xs shadow-md hover:bg-amber-400 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
                        <span>Book an Appointment</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                    </a>
                    <a href="/services" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-slate-700/80 text-white font-semibold text-xs hover:bg-slate-700 hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150">
                        View Service Menu
                    </a>
                </footer>
            </article>
        </div>
    </div>
</div>
