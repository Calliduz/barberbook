@model List<BarberBook.Data.Entities.Service>
@{
    ViewData["Title"] = "BarberBook — Classic Cuts & Master Grooming";
}

<div class="space-y-16 py-6">
    <!-- Hero Section -->
    <div class="relative overflow-hidden rounded-3xl bg-slate-900 text-white px-6 py-16 sm:px-12 sm:py-24 shadow-2xl border border-slate-800">
        <div class="relative z-10 max-w-3xl">
            <span class="inline-flex items-center gap-2 rounded-full bg-brand-500/20 px-3 py-1 text-xs font-semibold text-brand-300 border border-brand-500/30">
                <span>Certified Master Barbers</span>
                <span>•</span>
                <span>Mon–Sat 9:00 AM – 6:00 PM</span>
            </span>
            <h1 class="mt-6 text-4xl font-extrabold tracking-tight sm:text-6xl text-white">
                Sharp cuts. Classic craft. Zero waiting.
            </h1>
            <p class="mt-4 text-lg text-slate-300 leading-relaxed">
                Welcome to BarberBook, your premier neighborhood barber shop. Book your preferred master barber in seconds with real-time slot scheduling and guaranteed appointments.
            </p>
            <div class="mt-8 flex flex-wrap gap-4 items-center">
                <a href="/book" class="inline-flex items-center justify-center rounded-xl bg-brand-500 px-6 py-3.5 text-base font-bold text-slate-900 shadow-lg hover:bg-brand-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400 transition">
                    Book an Appointment
                </a>
                <a href="/services" class="inline-flex items-center justify-center rounded-xl bg-slate-800 px-6 py-3.5 text-base font-semibold text-white border border-slate-700 hover:bg-slate-700 transition">
                    Explore Services
                </a>
                <a href="/barbers" class="inline-flex items-center justify-center rounded-xl px-4 py-3.5 text-sm font-semibold text-slate-300 hover:text-white transition">
                    Meet Our Barbers &rarr;
                </a>
            </div>
        </div>
        <!-- Decorative Background Accent -->
        <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- Features / Perks -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <div class="h-10 w-10 rounded-lg bg-brand-100 text-brand-800 flex items-center justify-center font-bold mb-4">
                1
            </div>
            <h3 class="text-lg font-bold text-slate-900">Live 30-Min Availability</h3>
            <p class="mt-2 text-sm text-slate-500 leading-relaxed">
                Our real-time engine ensures zero double-bookings. Pick your slot and your appointment is instantly secured.
            </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <div class="h-10 w-10 rounded-lg bg-brand-100 text-brand-800 flex items-center justify-center font-bold mb-4">
                2
            </div>
            <h3 class="text-lg font-bold text-slate-900">Master Craftsmen</h3>
            <p class="mt-2 text-sm text-slate-500 leading-relaxed">
                Choose from dedicated barbers specializing in precision fades, hot-towel shaves, beard trims, and color treatments.
            </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <div class="h-10 w-10 rounded-lg bg-brand-100 text-brand-800 flex items-center justify-center font-bold mb-4">
                3
            </div>
            <h3 class="text-lg font-bold text-slate-900">In-Shop Payment</h3>
            <p class="mt-2 text-sm text-slate-500 leading-relaxed">
                No credit card required upfront. Book online with confidence and settle payment comfortably when you visit our shop.
            </p>
        </div>
    </div>

    <!-- Service Highlights -->
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-slate-900">Popular Services</h2>
                <p class="text-sm text-slate-500">Premium grooming services crafted for your individual style.</p>
            </div>
            <a href="/services" class="text-sm font-semibold text-brand-600 hover:text-brand-800 transition">View all services &rarr;</a>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-12 bg-white rounded-2xl border border-slate-200 text-slate-400">
                No services available at this time.
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var s in Model)
                {
                    <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between hover:border-brand-400 transition hover:shadow-md">
                        <div>
                            <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-0.5 text-xs font-semibold text-brand-700 border border-amber-200">
                                @s.DurationMinutes mins
                            </span>
                            <h3 class="mt-3 text-lg font-bold text-slate-900">@s.Name</h3>
                            <p class="mt-2 text-xs text-slate-500 line-clamp-2">
                                @(string.IsNullOrWhiteSpace(s.Description) ? "Professional barber service with precision finish." : s.Description)
                            </p>
                        </div>
                        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-lg font-black text-slate-900">@FormattingHelpers.FormatPeso(s.Price)</span>
                            <a href="/book?serviceId=@s.Id" class="text-xs font-bold text-brand-600 hover:text-brand-900 uppercase tracking-wide">
                                Book &rarr;
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
