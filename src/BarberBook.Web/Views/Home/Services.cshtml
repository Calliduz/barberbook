@model List<BarberBook.Data.Entities.Service>
@{
    ViewData["Title"] = "Our Services";
}

<div class="py-6 space-y-8">
    <div class="text-center max-w-2xl mx-auto">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">Our Grooming Services</h1>
        <p class="mt-3 text-lg text-slate-600">Premium haircuts, classic hot towel shaves, and styling by certified master barbers.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12 text-slate-400">
            <p>No services are currently available. Please check back later.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var service in Model)
            {
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-md hover:border-brand-300 transition">
                    <div>
                        <div class="flex justify-between items-start">
                            <h2 class="text-xl font-bold text-slate-900">@service.Name</h2>
                            <span class="inline-flex items-center rounded-md bg-amber-50 px-2.5 py-1 text-xs font-semibold text-brand-700 border border-amber-200">
                                @service.DurationMinutes mins
                            </span>
                        </div>
                        <p class="mt-3 text-sm text-slate-500 leading-relaxed">
                            @(string.IsNullOrWhiteSpace(service.Description) ? "Standard grooming service with precision cut and clean finish." : service.Description)
                        </p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-2xl font-black text-slate-900">@FormattingHelpers.FormatPeso(service.Price)</span>
                        <a href="/book?serviceId=@service.Id" class="inline-flex items-center rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-500 transition">
                            Book Now
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
