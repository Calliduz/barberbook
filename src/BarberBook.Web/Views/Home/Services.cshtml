@model List<BarberBook.Data.Entities.Service>
@{
    ViewData["Title"] = "Grooming Services & Pricing";
}

<div class="py-6 space-y-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
            <span>AUTHENTIC GROOMING CATALOG</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-serif font-black text-slate-900 dark:text-white tracking-tight">Our Services &amp; Pricing</h1>
        <p class="text-base text-slate-600 dark:text-slate-400 font-light">
            Precision haircuts, traditional hot towel straight-razor shaves, and artisanal beard sculpting. All prices are snapshotted and guaranteed at booking.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 text-slate-400">
            <p class="text-base font-semibold text-slate-600 dark:text-slate-300">No grooming services currently listed.</p>
            <p class="text-xs text-slate-400 mt-1">Please check back soon or inquire with our shop manager.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
            @foreach (var service in Model)
            {
                var imgUrl = BarberBook.Web.Common.ImageHelpers.GetServiceImage(service.Name);
                <article class="card bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-xl hover:border-amber-500/50 hover:-translate-y-0.5 transition-all duration-200 group">
                    <div class="h-56 vintage-img-container bg-slate-900 shrink-0 overflow-hidden relative">
                        <img src="@imgUrl" alt="@service.Name" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 ease-out opacity-90 group-hover:opacity-100" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent pointer-events-none"></div>
                    </div>

                    <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-4">
                        <div>
                            <div class="flex justify-between items-baseline mb-2">
                                <h2 class="text-2xl font-serif font-bold text-slate-900 dark:text-white group-hover:text-amber-800 dark:group-hover:text-amber-400 transition-colors">
                                    @service.Name
                                </h2>
                                <span class="text-2xl font-black text-slate-900 dark:text-amber-400 font-mono ml-2">
                                    ₱@service.Price.ToString("N2")
                                </span>
                            </div>

                            <div class="flex items-center gap-2 mb-3">
                                <span class="inline-flex items-center rounded-full bg-amber-50 dark:bg-amber-950/40 px-2.5 py-0.5 text-xs font-semibold text-amber-900 dark:text-amber-300 border border-amber-200 dark:border-amber-700/50">
                                    <svg class="w-3 h-3 mr-1 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    @service.DurationMinutes mins
                                </span>
                                <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">&bull; Guaranteed 30-min slot</span>
                            </div>

                            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                                @(string.IsNullOrWhiteSpace(service.Description) ? "Standard grooming service with precision cut, neckline taper, and clean finish." : service.Description)
                            </p>
                        </div>

                        <footer class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <span class="text-xs text-slate-500 dark:text-slate-400 font-medium">In-Shop Settlement</span>
                            <a href="/book?serviceId=@service.Id" class="inline-flex items-center rounded-xl bg-amber-500 px-5 py-2.5 text-xs font-bold text-slate-950 shadow-sm hover:bg-amber-400 hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 transition-all duration-150 ease-out">
                                <span>Book Service</span>
                                <svg class="w-3.5 h-3.5 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </footer>
                    </div>
                </article>
            }
        </div>
    }
</div>
