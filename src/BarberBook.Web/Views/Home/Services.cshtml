@model List<BarberBook.Data.Entities.Service>
@{
    ViewData["Title"] = "Grooming Services & Pricing";

    string GetServiceImage(string name)
    {
        var lower = name.ToLowerInvariant();
        if (lower.Contains("beard"))
            return "/images/services/beard.svg";
        if (lower.Contains("color") || lower.Contains("treatment"))
            return "/images/services/color.svg";
        if (lower.Contains("shave"))
            return "/images/services/shave.svg";
        return "/images/services/haircut.svg";
    }
}

<div class="py-6 space-y-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-brand-500/30 text-brand-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
            <span>AUTHENTIC GROOMING CATALOG</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-serif font-black text-slate-900 tracking-tight">Our Services &amp; Pricing</h1>
        <p class="text-base text-slate-600 font-light">
            Precision haircuts, traditional hot towel straight-razor shaves, and artisanal beard sculpting. All prices are snapshotted and guaranteed at booking.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 text-slate-400">
            <p class="text-base font-semibold text-slate-600">No grooming services currently listed.</p>
            <p class="text-xs text-slate-400 mt-1">Please check back soon or inquire with our shop manager.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var service in Model)
            {
                var imgUrl = GetServiceImage(service.Name);
                <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-xl hover:border-brand-500/50 transition duration-300 group">
                    <div class="h-48 vintage-img-container bg-slate-900 shrink-0">
                        <img src="@imgUrl" alt="@service.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100" />
                    </div>

                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-baseline mb-2">
                                <h2 class="text-2xl font-serif font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
                                    @service.Name
                                </h2>
                                <span class="text-xl font-black text-slate-900 font-mono ml-2">
                                    ₱@service.Price.ToString("N2")
                                </span>
                            </div>

                            <div class="flex items-center gap-2 mb-3">
                                <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-brand-800 border border-amber-200">
                                    <svg class="w-3 h-3 mr-1 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    @service.DurationMinutes mins
                                </span>
                                <span class="text-[11px] text-slate-600 font-medium">&bull; Certified Master Service</span>
                            </div>

                            <p class="text-xs text-slate-600 leading-relaxed">
                                @(string.IsNullOrWhiteSpace(service.Description) ? "Standard grooming service with precision cut, neckline taper, and clean finish." : service.Description)
                            </p>
                        </div>

                        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                            <span class="text-[11px] text-slate-600 font-medium">In-Shop Settlement</span>
                            <a href="/book?serviceId=@service.Id" class="inline-flex items-center rounded-xl bg-brand-500 px-4 py-2 text-xs font-bold text-slate-950 shadow-sm hover:bg-brand-400 transition transform hover:-translate-y-0.5">
                                Book Service &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
