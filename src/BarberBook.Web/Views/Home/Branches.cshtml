@model List<BarberBook.Data.Entities.Branch>
@{
    ViewData["Title"] = "Our Branches & Locations · BarberBook Manila";
}

<div class="space-y-12 py-4">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
            <span>METRO MANILA WORKSTATIONS</span>
        </div>
        <h1 class="text-4xl font-serif font-black tracking-tight text-slate-900 dark:text-white sm:text-5xl">
            Our Barbershop Locations
        </h1>
        <p class="text-base text-slate-600 dark:text-slate-300 font-light max-w-2xl mx-auto">
            Experience timeless craftsmanship, hot towel finishes, and master precision cuts across our 5 flagship locations in Metro Manila.
        </p>
    </div>

    <!-- Quick Filter / Locations Count Strip -->
    <div class="bg-white/95 dark:bg-slate-900/90 rounded-2xl border border-amber-900/10 dark:border-slate-800 p-4 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-3 max-w-5xl mx-auto">
        <div class="flex items-center gap-2 text-xs font-bold text-slate-700 dark:text-slate-200">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>@Model.Count Physical Workstations Open Today</span>
            <span class="text-slate-400">&bull;</span>
            <span class="text-amber-800 dark:text-amber-400">9:00 AM – 6:00 PM</span>
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400">
            <span>In-Shop Settlement (Cash / Direct)</span>
        </div>
    </div>

    <!-- Branches Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        @foreach (var branch in Model)
        {
            <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-xl hover:border-amber-500/60 transition-all duration-200 flex flex-col justify-between overflow-hidden group">
                <!-- Top Branch Header Card -->
                <div class="p-6 sm:p-7 space-y-4">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <span class="text-[10px] uppercase font-bold tracking-wider text-amber-700 dark:text-amber-400 block mb-1">
                                Flagship Location #@branch.Id
                            </span>
                            <h2 class="text-xl font-serif font-bold text-slate-900 dark:text-white group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors">
                                @branch.Name
                            </h2>
                        </div>
                        <div class="barber-pole-icon shrink-0" style="height: 24px; width: 12px;"></div>
                    </div>

                    <!-- Address & Hours -->
                    <div class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
                        <div class="flex items-start gap-2">
                            <svg class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            <span class="leading-relaxed">@branch.Address</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(branch.PhoneNumber))
                        {
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                                <a href="tel:@branch.PhoneNumber" class="hover:text-amber-700 dark:hover:text-amber-400 font-medium">@branch.PhoneNumber</a>
                            </div>
                        }
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span>Open Mon&ndash;Sat: <strong class="text-slate-800 dark:text-slate-200">@branch.OpeningTime.ToString("h:mm tt", null) &ndash; @branch.ClosingTime.ToString("h:mm tt", null)</strong></span>
                        </div>
                    </div>

                    <!-- Stationed Master Barbers -->
                    <div class="pt-3 border-t border-slate-100 dark:border-slate-800">
                        <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 dark:text-slate-500 block mb-2">
                            Stationed Craftsmen (@branch.Barbers.Count)
                        </span>
                        @if (!branch.Barbers.Any())
                        {
                            <p class="text-xs text-slate-400 italic">Rotating master barber roster assigned.</p>
                        }
                        else
                        {
                            <div class="space-y-2">
                                @foreach (var barber in branch.Barbers)
                                {
                                    <div class="flex items-center gap-2.5 p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                                        <div class="w-8 h-8 rounded-full bg-slate-900 text-amber-400 font-serif font-bold text-xs flex items-center justify-center shrink-0">
                                            @barber.DisplayName[0]
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <span class="text-xs font-bold text-slate-900 dark:text-white block truncate">@barber.DisplayName</span>
                                            <span class="text-[10px] text-slate-500 dark:text-slate-400 block truncate">@(barber.Specialties ?? "Master Craftsman")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Bottom Booking Button -->
                <div class="p-6 pt-0">
                    <a href="/book?branch=@branch.Id"
                       class="w-full py-3 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs flex items-center justify-center gap-2 shadow-sm transition transform hover:-translate-y-0.5">
                        <span>Book at @branch.Name</span>
                        <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

