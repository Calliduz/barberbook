@model List<BarberBook.Data.Entities.Barber>
@{
    ViewData["Title"] = "Our Master Barbers";

    string GetBarberImage(string name, string? existingUrl)
    {
        if (!string.IsNullOrWhiteSpace(existingUrl) && existingUrl.StartsWith("http"))
            return existingUrl;

        var lower = name.ToLowerInvariant();
        if (lower.Contains("ramon"))
            return "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80"; // Master barber
        if (lower.Contains("dennis"))
            return "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=800&q=80"; // Modern fade stylist
        if (lower.Contains("miguel"))
            return "https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?auto=format&fit=crop&w=800&q=80"; // Creative colorist
        return "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=800&q=80";
    }
}

<div class="py-6 space-y-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-brand-500/30 text-brand-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
            <span>MASTER CRAFTSMEN</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-serif font-black text-slate-900 tracking-tight">Meet Our Master Barbers</h1>
        <p class="text-base text-slate-600 font-light">
            Dedicated grooming craftsmen with specialized expertise in classic tapers, skin fades, hot towel straight-razor shaves, and beard sculpting.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 text-slate-400">
            <p class="text-base font-semibold text-slate-600">No barbers are currently active.</p>
            <p class="text-xs text-slate-400 mt-1">Please check back soon or inquire with our shop manager.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var barber in Model)
            {
                var photo = GetBarberImage(barber.DisplayName, barber.PhotoUrl);
                <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-xl hover:border-brand-500/50 transition duration-300 group">
                    <div class="h-64 vintage-img-container bg-slate-900 relative shrink-0">
                        <img src="@photo" alt="@barber.DisplayName" class="w-full h-full object-cover object-top opacity-95 group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute bottom-3 left-3 bg-slate-900/85 backdrop-blur-sm text-white px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 border border-slate-700">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span>Active Master Staff</span>
                        </div>
                    </div>

                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <h2 class="text-2xl font-serif font-bold text-slate-900 group-hover:text-brand-700 transition-colors">
                                @barber.DisplayName
                            </h2>
                            <p class="text-xs text-brand-700 font-semibold uppercase tracking-wider mt-1">
                                @(string.IsNullOrWhiteSpace(barber.Specialties) ? "Master Barber" : barber.Specialties)
                            </p>

                            <p class="mt-3 text-xs text-slate-600 leading-relaxed line-clamp-3">
                                @(string.IsNullOrWhiteSpace(barber.Bio) ? "Experienced grooming professional delivering classic and modern haircuts with surgical precision." : barber.Bio)
                            </p>

                            <!-- Weekly Hours Summary -->
                            <div class="mt-4 p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center gap-2 text-xs text-slate-700">
                                <svg class="h-4 w-4 text-brand-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="font-medium truncate">@FormattingHelpers.FormatWeeklySchedule(barber.WorkingHours)</span>
                            </div>
                        </div>

                        <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                            <a href="/barbers/@barber.Id" class="text-xs font-semibold text-slate-600 hover:text-slate-900">
                                View Profile &amp; Days Off &rarr;
                            </a>
                            <a href="/book?barberId=@barber.Id" class="inline-flex items-center rounded-xl bg-brand-500 px-4 py-2 text-xs font-bold text-slate-950 shadow-sm hover:bg-brand-400 transition transform hover:-translate-y-0.5">
                                Book with @barber.DisplayName
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
