@model List<BarberBook.Data.Entities.Barber>
@{
    ViewData["Title"] = "Our Master Barbers";
    var nextSlots = ViewBag.NextAvailableSlots as Dictionary<int, string>;
}

<div class="py-6 space-y-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
            <span>MASTER CRAFTSMEN</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-serif font-black text-slate-900 dark:text-white tracking-tight">Meet Our Master Barbers</h1>
        <p class="text-base text-slate-600 dark:text-slate-400 font-light">
            Dedicated grooming craftsmen with specialized expertise in classic tapers, skin fades, hot towel straight-razor shaves, and beard sculpting.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 text-slate-400">
            <p class="text-base font-semibold text-slate-600 dark:text-slate-300">No barbers are currently active.</p>
            <p class="text-xs text-slate-400 mt-1">Please check back soon or inquire with our shop manager.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var barber in Model)
            {
                var photo = BarberBook.Web.Common.ImageHelpers.GetBarberImage(barber.DisplayName, barber.PhotoUrl);
                <article class="card bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-xl hover:border-amber-500/50 hover:-translate-y-0.5 transition-all duration-200 group">
                    <div>
                        <div class="h-64 vintage-img-container bg-slate-900 relative shrink-0 overflow-hidden">
                            <img src="@photo" alt="@barber.DisplayName" loading="lazy" class="w-full h-full object-cover object-top opacity-95 group-hover:scale-105 transition-transform duration-300 ease-out" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent pointer-events-none"></div>
                            @if (barber.Branch != null)
                            {
                                <div class="absolute bottom-3 left-3 bg-slate-900/90 backdrop-blur-sm text-amber-300 px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 border border-slate-700">
                                    <svg class="w-3 h-3 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                    <span>@barber.Branch.Name</span>
                                </div>
                            }
                        </div>

                        <div class="p-6">
                            <h2 class="text-2xl font-serif font-bold text-slate-900 dark:text-white group-hover:text-amber-800 dark:group-hover:text-amber-400 transition-colors">
                                @barber.DisplayName
                            </h2>
                            <p class="text-xs text-amber-800 dark:text-amber-400 font-semibold uppercase tracking-wider mt-1">
                                @(string.IsNullOrWhiteSpace(barber.Specialties) ? "Master Barber" : barber.Specialties)
                            </p>

                            <!-- Live Next Available Slot Indicator (CF-3, BR-04) -->
                            <div class="mt-2.5 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/60">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span>Next: @(nextSlots != null && nextSlots.TryGetValue(barber.Id, out var slotText) ? slotText : "Available This Week")</span>
                            </div>

                            <p class="mt-3 text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3">
                                @(string.IsNullOrWhiteSpace(barber.Bio) ? "Experienced grooming professional delivering classic and modern haircuts with surgical precision." : barber.Bio)
                            </p>

                            <!-- Weekly Hours Summary (Proper Wrapping) -->
                            <div class="mt-4 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-100 dark:border-slate-700/80 flex items-start gap-2 text-xs text-slate-700 dark:text-slate-300">
                                <svg class="h-4 w-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="font-medium whitespace-normal leading-relaxed">@BarberBook.Web.Common.FormattingHelpers.FormatWeeklySchedule(barber.WorkingHours)</span>
                            </div>
                        </div>
                    </div>

                    <footer class="p-6 pt-0 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                        <a href="/barbers/@barber.Id" class="text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white active:scale-[0.98] transition-transform">
                            View Profile &amp; Schedule &rarr;
                        </a>
                        <a href="/book?barberId=@barber.Id" class="inline-flex items-center rounded-xl bg-amber-500 px-4 py-2 text-xs font-bold text-slate-950 shadow-sm hover:bg-amber-400 hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 transition-all duration-150 ease-out">
                            Book with @barber.DisplayName
                        </a>
                    </footer>
                </article>
            }
        </div>
    }
</div>
