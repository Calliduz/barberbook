@model List<BarberBook.Data.Entities.Barber>
@{
    ViewData["Title"] = "Our Barbers";
}

<div class="py-6 space-y-8">
    <div class="text-center max-w-2xl mx-auto">
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight sm:text-4xl">Meet Our Master Barbers</h1>
        <p class="mt-3 text-lg text-slate-600">Experienced craftsmen dedicated to keeping you looking sharp and fresh.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white rounded-2xl border border-slate-200 text-slate-400">
            <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <p class="mt-4 text-base font-medium text-slate-600">No barbers are currently available</p>
            <p class="mt-1 text-sm text-slate-400">Please check back soon or contact shop management.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var barber in Model)
            {
                <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-lg hover:border-brand-300 transition duration-200">
                    <div>
                        <!-- Avatar / Photo & Name -->
                        <div class="flex items-center space-x-4">
                            @if (!string.IsNullOrWhiteSpace(barber.PhotoUrl))
                            {
                                <img src="@barber.PhotoUrl" alt="@barber.DisplayName" class="h-16 w-16 rounded-full object-cover border-2 border-brand-500 shadow-sm" />
                            }
                            else
                            {
                                <div class="h-16 w-16 rounded-full bg-brand-100 text-brand-800 flex items-center justify-center font-bold text-2xl border-2 border-brand-200 shadow-sm">
                                    @barber.DisplayName.Substring(0, Math.Min(1, barber.DisplayName.Length)).ToUpperInvariant()
                                </div>
                            }
                            <div>
                                <h2 class="text-xl font-bold text-slate-900">@barber.DisplayName</h2>
                                <p class="text-xs text-brand-600 font-semibold tracking-wide uppercase mt-0.5">
                                    @(string.IsNullOrWhiteSpace(barber.Specialties) ? "Master Barber" : barber.Specialties)
                                </p>
                            </div>
                        </div>

                        <!-- Bio -->
                        <p class="mt-4 text-sm text-slate-600 leading-relaxed">
                            @(string.IsNullOrWhiteSpace(barber.Bio) ? "Experienced professional delivering classic and modern grooming cuts with precision." : barber.Bio)
                        </p>

                        <!-- Schedule Badge -->
                        <div class="mt-4 p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center gap-2 text-xs text-slate-700">
                            <svg class="h-4 w-4 text-slate-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="font-medium truncate">@FormattingHelpers.FormatWeeklySchedule(barber.WorkingHours)</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                        <a href="/barbers/@barber.Id" class="text-xs font-semibold text-slate-600 hover:text-slate-900 transition">
                            View Schedule &rarr;
                        </a>
                        <a href="/book?barberId=@barber.Id" class="inline-flex items-center rounded-xl bg-brand-600 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-brand-500 transition">
                            Book with @barber.DisplayName
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
