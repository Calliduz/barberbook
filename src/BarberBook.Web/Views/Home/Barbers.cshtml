@model List<BarberBook.Data.Entities.Barber>
@{
    ViewData["Title"] = "Our Master Barbers";

    string GetBarberImage(string name, string? existingUrl)
    {
        if (!string.IsNullOrWhiteSpace(existingUrl) && !existingUrl.StartsWith("http"))
            return existingUrl;

        var lower = name.ToLowerInvariant();
        if (lower.Contains("ramon"))
            return "/images/barbers/ramon.svg";
        if (lower.Contains("dennis"))
            return "/images/barbers/dennis.svg";
        if (lower.Contains("miguel"))
            return "/images/barbers/miguel.svg";
        return "/images/barbers/default-barber.svg";
    }
}

<div class="py-6 space-y-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-brand-500/30 text-brand-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
            <span>MASTER CRAFTSMEN</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-serif font-black text-slate-900 dark:text-white tracking-tight">Meet Our Master Barbers</h1>
        <p class="text-base text-slate-600 dark:text-slate-400 font-light">
            Dedicated grooming craftsmen with specialized expertise in classic tapers, skin fades, hot towel straight-razor shaves, and beard sculpting.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 text-slate-400">
            <p class="text-base font-semibold text-slate-600 dark:text-slate-300">No barbers are currently active.</p>
            <p class="text-xs text-slate-400 mt-1">Please check back soon or inquire with our shop manager.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var barber in Model)
            {
                var photo = GetBarberImage(barber.DisplayName, barber.PhotoUrl);
                <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-xl hover:border-brand-500/50 transition duration-300 group">
                    <div class="h-64 vintage-img-container bg-slate-900 relative shrink-0">
                        <img src="@photo" alt="@barber.DisplayName" class="w-full h-full object-cover object-top opacity-95 group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute bottom-3 left-3 bg-slate-900/85 backdrop-blur-sm text-white px-3 py-1 rounded-full text-xs font-semibold flex items-center gap-1.5 border border-slate-700">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span>Active Master Staff</span>
                        </div>
                    </div>

                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <h2 class="text-2xl font-serif font-bold text-slate-900 dark:text-white group-hover:text-brand-700 dark:group-hover:text-brand-400 transition-colors">
                                @barber.DisplayName
                            </h2>
                            <div class="flex flex-wrap items-center gap-2 mt-1">
                                <p class="text-xs text-brand-700 dark:text-brand-400 font-semibold uppercase tracking-wider">
                                    @(string.IsNullOrWhiteSpace(barber.Specialties) ? "Master Barber" : barber.Specialties)
                                </p>
                                @if (barber.Branch != null)
                                {
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-700/50">
                                        <svg class="w-2.5 h-2.5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                        @barber.Branch.Name
                                    </span>
                                }
                            </div>

                            <p class="mt-3 text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3">
                                @(string.IsNullOrWhiteSpace(barber.Bio) ? "Experienced grooming professional delivering classic and modern haircuts with surgical precision." : barber.Bio)
                            </p>

                            <!-- Weekly Hours Summary -->
                            <div class="mt-4 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-100 dark:border-slate-700/80 flex items-center gap-2 text-xs text-slate-700 dark:text-slate-300">
                                <svg class="h-4 w-4 text-brand-600 dark:text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="font-medium truncate">@FormattingHelpers.FormatWeeklySchedule(barber.WorkingHours)</span>
                            </div>
                        </div>

                        <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                            <a href="/barbers/@barber.Id" class="text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">
                                View Profile &amp; Days Off &rarr;
                            </a>
                            <a href="/book?barberId=@barber.Id" class="inline-flex items-center rounded-xl bg-brand-500 px-4 py-2 text-xs font-bold text-slate-950 shadow-sm hover:bg-brand-400 transition transform hover:-translate-y-0.5">
                                Book with @barber.DisplayName
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
