@model BarberBook.Web.Models.Customer.UpdateProfileRequest
@{
    ViewData["Title"] = "My Profile";
}

<div class="max-w-2xl mx-auto py-6 space-y-8">
    <div>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">My Profile</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Manage your contact information and account security.</p>
    </div>

    <!-- Alert Messages -->
    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 p-4 border border-emerald-200 dark:border-emerald-800">
            <div class="flex">
                <svg class="h-5 w-5 text-emerald-500 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <div class="ml-3">
                    <p class="text-sm font-medium text-emerald-800 dark:text-emerald-200">@TempData["ProfileSuccess"]</p>
                </div>
            </div>
        </div>
    }
    @if (TempData["PasswordSuccess"] != null)
    {
        <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 p-4 border border-emerald-200 dark:border-emerald-800">
            <div class="flex">
                <svg class="h-5 w-5 text-emerald-500 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <div class="ml-3">
                    <p class="text-sm font-medium text-emerald-800 dark:text-emerald-200">@TempData["PasswordSuccess"]</p>
                </div>
            </div>
        </div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="rounded-xl bg-rose-50 dark:bg-rose-950/40 p-4 border border-rose-200 dark:border-rose-800">
            <div class="flex">
                <svg class="h-5 w-5 text-rose-500 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
                <div class="ml-3 text-sm text-rose-800 dark:text-rose-200">
                    <div asp-validation-summary="All" class="space-y-1"></div>
                </div>
            </div>
        </div>
    }

    <!-- Personal Info Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm p-8 space-y-6">
        <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">Personal Information</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Update your contact details for appointment booking.</p>
        </div>

        <form method="post" action="/profile" class="space-y-4">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">First Name *</label>
                    <input type="text" name="FirstName" value="@Model.FirstName" placeholder="e.g. Juan" required class="mt-1 block w-full rounded-xl border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Last Name *</label>
                    <input type="text" name="LastName" value="@Model.LastName" placeholder="e.g. dela Cruz" required class="mt-1 block w-full rounded-xl border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Email Address *</label>
                <input type="email" name="Email" value="@Model.Email" placeholder="e.g. juan@example.com" required class="mt-1 block w-full rounded-xl border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Mobile Phone</label>
                <input type="tel" name="PhoneNumber" value="@Model.PhoneNumber" placeholder="e.g. 0917 123 4567" class="mt-1 block w-full rounded-xl border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
            </div>
            <div class="pt-4 flex justify-end">
                <button type="submit" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-brand-500 transition">
                    Save Changes
                </button>
            </div>
        </form>
    </div>

    <!-- Change Password Card -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm p-8 space-y-6">
        <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">Change Password</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Ensure your account stays secure with a strong password.</p>
        </div>

        <form method="post" action="/Account/ChangePassword" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Current Password *</label>
                <input type="password" name="CurrentPassword" placeholder="Enter your current password" required class="mt-1 block w-full rounded-xl border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">New Password *</label>
                <input type="password" name="NewPassword" placeholder="At least 6 characters" required minlength="6" class="mt-1 block w-full rounded-xl border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Confirm New Password *</label>
                <input type="password" name="ConfirmNewPassword" placeholder="Re-enter your new password" required minlength="6" class="mt-1 block w-full rounded-xl border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
            </div>
            <div class="pt-4 flex justify-end">
                <button type="submit" class="rounded-xl bg-slate-900 dark:bg-amber-500 dark:text-slate-950 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-slate-800 dark:hover:bg-amber-400 transition">
                    Update Password
                </button>
            </div>
        </form>
    </div>
</div>

