@model BarberBook.Web.Models.Customer.UpdateProfileRequest
@{
    ViewData["Title"] = "My Profile";
}

<div class="max-w-2xl mx-auto py-6 space-y-8">
    <div>
        <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
            <span>CLIENT ACCOUNT SETTINGS</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-serif font-black text-slate-900 dark:text-white tracking-tight">My Profile</h1>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-1 font-light">Manage your contact information, phone preferences, and account credentials.</p>
    </div>

    <!-- Alert Messages -->
    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 p-4 border border-emerald-200 dark:border-emerald-800 shadow-sm" role="status">
            <div class="flex items-center">
                <svg class="h-5 w-5 text-emerald-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <div class="ml-3">
                    <p class="text-sm font-semibold text-emerald-800 dark:text-emerald-200">@TempData["ProfileSuccess"]</p>
                </div>
            </div>
        </div>
    }
    @if (TempData["PasswordSuccess"] != null)
    {
        <div class="rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 p-4 border border-emerald-200 dark:border-emerald-800 shadow-sm" role="status">
            <div class="flex items-center">
                <svg class="h-5 w-5 text-emerald-500 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <div class="ml-3">
                    <p class="text-sm font-semibold text-emerald-800 dark:text-emerald-200">@TempData["PasswordSuccess"]</p>
                </div>
            </div>
        </div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="rounded-2xl bg-rose-50 dark:bg-rose-950/40 p-4 border border-rose-200 dark:border-rose-800 shadow-sm" role="alert">
            <div class="flex items-start">
                <svg class="h-5 w-5 text-rose-500 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
                <div class="ml-3 text-sm text-rose-800 dark:text-rose-200">
                    <div asp-validation-summary="All" class="space-y-1 font-medium"></div>
                </div>
            </div>
        </div>
    }

    <!-- Personal Info Card -->
    <article class="card bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm p-6 sm:p-8 space-y-6">
        <header>
            <h2 class="text-xl font-serif font-bold text-slate-900 dark:text-white">Personal Information</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Update your contact details for appointment booking.</p>
        </header>

        <form method="post" action="/profile" class="space-y-4" aria-label="Update Personal Information">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="profile-first-name" class="block text-xs uppercase tracking-wider text-slate-600 dark:text-slate-300 font-bold mb-1.5">First Name <span class="text-rose-500">*</span></label>
                    <input type="text" id="profile-first-name" name="FirstName" value="@Model.FirstName" placeholder="e.g. Juan" required autocomplete="given-name"
                           class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 shadow-xs transition" />
                </div>
                <div>
                    <label for="profile-last-name" class="block text-xs uppercase tracking-wider text-slate-600 dark:text-slate-300 font-bold mb-1.5">Last Name <span class="text-rose-500">*</span></label>
                    <input type="text" id="profile-last-name" name="LastName" value="@Model.LastName" placeholder="e.g. dela Cruz" required autocomplete="family-name"
                           class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 shadow-xs transition" />
                </div>
            </div>
            <div>
                <label for="profile-email" class="block text-xs uppercase tracking-wider text-slate-600 dark:text-slate-300 font-bold mb-1.5">Email Address <span class="text-rose-500">*</span></label>
                <input type="email" id="profile-email" name="Email" value="@Model.Email" placeholder="e.g. juan@example.com" required autocomplete="email"
                       class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 shadow-xs transition" />
            </div>
            <div>
                <label for="profile-phone" class="block text-xs uppercase tracking-wider text-slate-600 dark:text-slate-300 font-bold mb-1.5">Mobile Phone <span class="text-slate-400 font-normal lowercase">(optional)</span></label>
                <input type="tel" id="profile-phone" name="PhoneNumber" value="@Model.PhoneNumber" placeholder="e.g. 0917 123 4567" autocomplete="tel"
                       class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 shadow-xs transition" />
            </div>
            <div class="pt-4 flex justify-end">
                <button type="submit" class="rounded-xl bg-amber-500 hover:bg-amber-400 active:scale-[0.98] px-5 py-2.5 text-sm font-bold text-slate-950 shadow-md hover:shadow-lg transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900">
                    Save Changes
                </button>
            </div>
        </form>
    </article>

    <!-- Change Password Card -->
    <article class="card bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm p-6 sm:p-8 space-y-6">
        <header>
            <h2 class="text-xl font-serif font-bold text-slate-900 dark:text-white">Change Password</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Ensure your account stays secure with a strong password.</p>
        </header>

        <form method="post" action="/Account/ChangePassword" class="space-y-4" aria-label="Change Password">
            @Html.AntiForgeryToken()
            <div>
                <label for="current-password" class="block text-xs uppercase tracking-wider text-slate-600 dark:text-slate-300 font-bold mb-1.5">Current Password <span class="text-rose-500">*</span></label>
                <div class="relative">
                    <input type="password" id="current-password" name="CurrentPassword" placeholder="Enter your current password" required autocomplete="current-password"
                           class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 pr-10 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 shadow-xs transition" />
                    <button type="button" onclick="togglePasswordVisibility('current-password', this)"
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition focus:outline-none"
                            aria-label="Show password">
                        <svg class="icon-eye w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        <svg class="icon-eye-slash w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                    </button>
                </div>
            </div>
            <div>
                <label for="new-password" class="block text-xs uppercase tracking-wider text-slate-600 dark:text-slate-300 font-bold mb-1.5">New Password <span class="text-rose-500">*</span></label>
                <div class="relative">
                    <input type="password" id="new-password" name="NewPassword" placeholder="At least 6 characters" required minlength="6" autocomplete="new-password"
                           class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 pr-10 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 shadow-xs transition" />
                    <button type="button" onclick="togglePasswordVisibility('new-password', this)"
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition focus:outline-none"
                            aria-label="Show password">
                        <svg class="icon-eye w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        <svg class="icon-eye-slash w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                    </button>
                </div>
            </div>
            <div>
                <label for="confirm-new-password" class="block text-xs uppercase tracking-wider text-slate-600 dark:text-slate-300 font-bold mb-1.5">Confirm New Password <span class="text-rose-500">*</span></label>
                <div class="relative">
                    <input type="password" id="confirm-new-password" name="ConfirmNewPassword" placeholder="Re-enter your new password" required minlength="6" autocomplete="new-password"
                           class="block w-full rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 py-2.5 px-3.5 pr-10 text-sm focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 shadow-xs transition" />
                    <button type="button" onclick="togglePasswordVisibility('confirm-new-password', this)"
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition focus:outline-none"
                            aria-label="Show password">
                        <svg class="icon-eye w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        <svg class="icon-eye-slash w-4 h-4 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                    </button>
                </div>
            </div>
            <div class="pt-4 flex justify-end">
                <button type="submit" class="rounded-xl bg-amber-500 hover:bg-amber-400 active:scale-[0.98] px-5 py-2.5 text-sm font-bold text-slate-950 shadow-md hover:shadow-lg transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900">
                    Update Password
                </button>
            </div>
        </form>
    </article>
</div>
