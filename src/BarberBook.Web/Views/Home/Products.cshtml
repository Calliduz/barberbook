@model IReadOnlyList<BarberBook.Web.Models.Inventory.ProductDto>
@{
    ViewData["Title"] = "Grooming Apothecary & Products";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selectedCat = ViewBag.SelectedCategory as string;
    var searchTerm = ViewBag.SearchTerm as string;
}

@functions {
    string GetProductDescription(string name, string category)
    {
        if (name.Contains("Pomade", StringComparison.OrdinalIgnoreCase))
            return "Water-soluble, heavy hold pomade with a polished shine finish. Perfect for classic side parts, slick backs, and pompadours that wash out effortlessly.";
        if (name.Contains("Beard Oil", StringComparison.OrdinalIgnoreCase))
            return "Nourishing blend of organic jojoba, argan, and Moroccan cedarwood oils to soften coarse facial hair and moisturize skin underneath.";
        if (name.Contains("Clay", StringComparison.OrdinalIgnoreCase))
            return "Natural dry-matte finish styling clay delivering pliable hold and defined texture. Ideal for modern crops, messy tapers, and textured quiffs.";
        if (name.Contains("Shave Cream", StringComparison.OrdinalIgnoreCase))
            return "Rich, soothing cushion lather infused with eucalyptus and menthol to open pores, minimize razor irritation, and deliver an ultra-close shave.";
        if (name.Contains("Tonic", StringComparison.OrdinalIgnoreCase) || name.Contains("Bay Rum", StringComparison.OrdinalIgnoreCase))
            return "Traditional barbershop astringent tonic distilled with natural bay leaf extracts and warm spice notes to cool, disinfect, and refresh freshly shaved skin.";
        return "Master-crafted grooming essential formulated and tested daily by our resident barbers.";
    }
}

<div class="py-6 space-y-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
            <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
            <span>MASTER APOTHECARY &amp; RETAIL</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-serif font-black text-slate-900 dark:text-white tracking-tight">Artisan Grooming Products</h1>
        <p class="text-base text-slate-600 dark:text-slate-400 font-light">
            Take home the master-crafted pomades, nourishing beard oils, and soothing tonic formulas used daily at our styling chairs.
        </p>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 p-4 shadow-sm flex flex-col md:flex-row items-center justify-between gap-4">
        <!-- Category Filter Pills -->
        <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
            <a href="/products" class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition active:scale-95 @(string.IsNullOrEmpty(selectedCat) ? "bg-amber-500 text-slate-950 shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white")">
                All Products
            </a>
            @foreach (var cat in categories)
            {
                <a href="/products?category=@cat@(string.IsNullOrEmpty(searchTerm) ? "" : $"&search={searchTerm}")"
                   class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition active:scale-95 @(string.Equals(selectedCat, cat, StringComparison.OrdinalIgnoreCase) ? "bg-amber-500 text-slate-950 shadow-sm" : "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white")">
                    @cat
                </a>
            }
        </div>

        <!-- Search Bar -->
        <form method="get" action="/products" class="w-full md:w-72 flex items-center gap-2">
            @if (!string.IsNullOrEmpty(selectedCat))
            {
                <input type="hidden" name="category" value="@selectedCat" />
            }
            <div class="relative flex-1">
                <input type="text" name="search" value="@searchTerm" placeholder="Search grooming products..."
                       class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500" />
                <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <button type="submit" class="px-3 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold active:scale-95 transition-all shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500">
                Search
            </button>
            @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(selectedCat))
            {
                <a href="/products" class="p-2 text-slate-400 hover:text-slate-700 text-xs" title="Clear filters">&times;</a>
            }
        </form>
    </div>

    <!-- Product Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-16 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 text-slate-400">
            <div class="inline-flex p-3 rounded-full bg-slate-100 dark:bg-slate-800 mb-3">
                <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
            </div>
            <p class="text-base font-semibold text-slate-600 dark:text-slate-300">No retail products found matching your search.</p>
            <p class="text-xs text-slate-400 mt-1">Try clearing your filters or check our service menu for in-shop styling.</p>
            <a href="/products" class="inline-block mt-4 px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition">
                Reset Catalog
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var p in Model)
            {
                var productImg = BarberBook.Web.Common.ImageHelpers.GetProductImage(p.Sku, p.Name, p.Category);
                <article class="card bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden flex flex-col justify-between hover:shadow-xl hover:border-amber-500/50 hover:-translate-y-0.5 transition-all duration-200 group">
                    <!-- Product Photography Header Box -->
                    <div class="h-52 vintage-img-container bg-slate-950 relative overflow-hidden shrink-0">
                        <img src="@productImg" alt="@p.Name" loading="lazy" class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-transform duration-300 ease-out" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-slate-950/40 pointer-events-none"></div>
                        <div class="absolute top-3 left-3">
                            <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-slate-950/80 text-amber-300 border border-amber-500/30 backdrop-blur-sm">
                                @p.Category
                            </span>
                        </div>
                    </div>

                    <!-- Product Body Content -->
                    <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                        <div>
                            <div class="flex items-baseline justify-between gap-2 mb-2">
                                <h2 class="text-xl font-serif font-bold text-slate-900 dark:text-white group-hover:text-amber-800 dark:group-hover:text-amber-300 transition">
                                    @p.Name
                                </h2>
                                <span class="text-xl font-black text-slate-900 dark:text-amber-400 font-mono shrink-0">
                                    @p.FormattedSellPrice
                                </span>
                            </div>

                            <div class="flex items-center gap-2 mt-2">
                                @if (p.CurrentStock > p.ReorderLevel)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-700/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                        <span>In Stock</span>
                                    </span>
                                }
                                else if (p.CurrentStock > 0)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-700/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                        <span>Low Stock (Only @p.CurrentStock left)</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                                        <span>Out of Stock</span>
                                    </span>
                                }
                            </div>

                            <p class="mt-3 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                                @GetProductDescription(p.Name, p.Category)
                            </p>
                        </div>

                        <!-- Card Footer -->
                        <footer class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
                            <span class="text-[11px] text-slate-500 dark:text-slate-400 italic">Available in-shop</span>
                            <a href="/book" class="inline-flex items-center font-bold text-amber-700 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 group-hover:translate-x-0.5 active:scale-[0.98] transition-transform">
                                <span>Reserve with Cut</span>
                                <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </footer>
                    </div>
                </article>
            }
        </div>
    }

    <!-- Shop Notice Callout Banner -->
    <div class="rounded-3xl bg-amber-50 dark:bg-amber-950/30 border border-amber-200/80 dark:border-amber-900/40 p-6 sm:p-8 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-1">
            <h3 class="text-lg font-serif font-black text-amber-950 dark:text-amber-100">In-Shop Settlement &amp; Purchase Policy</h3>
            <p class="text-xs text-amber-900/80 dark:text-amber-200/80 max-w-xl">
                BarberBook maintains an authentic in-shop experience. All products are displayed, tested, and settled at our front reception desk during your visit (Cash or Direct shop settlement).
            </p>
        </div>
        <a href="/book" class="px-6 py-3 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs sm:text-sm whitespace-nowrap shadow-md transition active:scale-95">
            Book an Appointment Now
        </a>
    </div>
</div>
