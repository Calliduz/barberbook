@* Accessible Skeleton Placeholder Component (P18, EO-4) *@
@model int?
@{
    var count = Model ?? 3;
}

<div class="space-y-3" role="status" aria-label="Loading content...">
    @for (int i = 0; i < count; i++)
    {
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 animate-pulse flex items-center justify-between gap-4">
            <div class="space-y-2 flex-1">
                <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded w-1/3"></div>
                <div class="h-3 bg-slate-100 dark:bg-slate-800/60 rounded w-1/2"></div>
            </div>
            <div class="h-8 bg-slate-200 dark:bg-slate-800 rounded-xl w-24"></div>
        </div>
    }
    <span class="sr-only">Loading...</span>
</div>

