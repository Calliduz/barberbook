@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@if (Env.IsDevelopment())
{
    var currentRole = User.Identity?.IsAuthenticated == true
        ? (User.IsInRole("Admin") ? "Admin" : User.IsInRole("Barber") ? "Barber" : "Customer")
        : "Guest";
    var currentUserEmail = User.Identity?.Name ?? "guest";

    <aside id="academic-defense-toolbar" aria-label="Academic Defense and Demonstration Toolbar" class="relative z-[9990] bg-slate-950 text-white border-b border-amber-500/30 text-xs shadow-xl transition-all duration-200">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 py-1.5 flex flex-wrap items-center justify-between gap-2">
            <!-- Left: Badge & Current State -->
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/40">
                    <span class="text-sm leading-none">🎓</span> SBIT-3D Oral Defense
                </span>
                <span class="text-slate-400 hidden sm:inline text-[11px]">|</span>
                <span class="text-slate-300 text-[11px] flex items-center gap-1.5">
                    <span class="text-slate-400">Current Session:</span>
                    <strong class="font-bold text-amber-400">@currentRole</strong>
                    <span class="text-slate-400 hidden md:inline text-[10px]">(@currentUserEmail)</span>
                </span>
            </div>

            <!-- Right: 1-Click Role Switcher & Reset Button -->
            <div class="flex items-center flex-wrap gap-1.5 sm:gap-2">
                <div class="inline-flex items-center bg-slate-900 rounded-lg p-0.5 border border-slate-800">
                    <button type="button" onclick="window.__quickLogin('customer')" class="px-2 py-1 rounded-md text-[11px] font-bold transition @(currentRole == "Customer" ? "bg-amber-500 text-slate-950 shadow-sm" : "text-slate-300 hover:text-white hover:bg-slate-800")" title="Login as Demo Customer Juan Dela Cruz">
                        👤 Customer
                    </button>
                    <button type="button" onclick="window.__quickLogin('barber')" class="px-2 py-1 rounded-md text-[11px] font-bold transition @(currentRole == "Barber" ? "bg-amber-500 text-slate-950 shadow-sm" : "text-slate-300 hover:text-white hover:bg-slate-800")" title="Login as Master Barber Ramon Bautista">
                        ✂️ Barber
                    </button>
                    <button type="button" onclick="window.__quickLogin('admin')" class="px-2 py-1 rounded-md text-[11px] font-bold transition @(currentRole == "Admin" ? "bg-amber-500 text-slate-950 shadow-sm" : "text-slate-300 hover:text-white hover:bg-slate-800")" title="Login as Shop Administrator">
                        🛡️ Admin
                    </button>
                </div>

                <button type="button" id="btn-reset-demo-data" onclick="window.__resetDemoData()" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-bold bg-rose-950/70 hover:bg-rose-900 text-rose-200 border border-rose-700/50 shadow-xs active:scale-95 transition" title="Reset database to pristine paper oracle (₱1,340.00 daily sales)">
                    <svg class="w-3.5 h-3.5 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    <span>Reset Data</span>
                </button>
            </div>
        </div>
    </aside>

    <script>
        (function() {
            window.__quickLogin = async function(role) {
                try {
                    const res = await fetch('/api/dev/quick-login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ role: role })
                    });
                    if (res.ok) {
                        const data = await res.json();
                        window.location.href = data.redirect_url || '/';
                    } else {
                        alert('Quick login failed. Make sure demo accounts exist.');
                    }
                } catch (e) {
                    console.error('Quick login error:', e);
                }
            };

            window.__resetDemoData = async function() {
                if (!confirm('Re-seed database to pristine academic test state (₱1,340.00 daily sales)?')) {
                    return;
                }
                const btn = document.getElementById('btn-reset-demo-data');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<span>Resetting...</span>';
                }
                try {
                    const res = await fetch('/api/dev/reset-demo-data', { method: 'POST' });
                    if (res.ok) {
                        alert('Database successfully re-seeded to pristine academic state!');
                        window.location.reload();
                    } else {
                        alert('Reset failed. Check server console.');
                        if (btn) btn.disabled = false;
                    }
                } catch (e) {
                    alert('Error connecting to reset endpoint.');
                    if (btn) btn.disabled = false;
                }
            };
        })();
    </script>
}
