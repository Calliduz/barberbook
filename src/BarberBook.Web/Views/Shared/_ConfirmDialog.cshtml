@* Accessible Confirmation Dialog Component (P18, EO-4) *@
<div id="barberbook-confirm-dialog" 
     class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="confirm-dialog-title"
     aria-describedby="confirm-dialog-desc">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-slate-200 relative transform transition-all">
        <div class="flex items-center gap-3 mb-4">
            <div id="confirm-dialog-icon-container" class="w-10 h-10 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-700 shrink-0">
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                </svg>
            </div>
            <div>
                <h3 id="confirm-dialog-title" class="text-lg font-serif font-bold text-slate-900 leading-tight">Confirm Action</h3>
                <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">BarberBook Verification</span>
            </div>
        </div>

        <p id="confirm-dialog-desc" class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Are you sure you want to proceed with this action?
        </p>

        <div class="mt-6 flex items-center justify-end gap-2.5">
            <button type="button" id="confirm-dialog-cancel-btn"
                    class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition focus:outline-none focus:ring-2 focus:ring-amber-500">
                Cancel
            </button>
            <button type="button" id="confirm-dialog-proceed-btn"
                    class="px-5 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
                Proceed
            </button>
        </div>
    </div>
</div>

<script>
    let _confirmResolve = null;

    window.showConfirmDialog = function ({
        title = 'Confirm Action',
        message = 'Are you sure you want to proceed?',
        confirmText = 'Proceed',
        cancelText = 'Cancel',
        isDestructive = false
    } = {}) {
        return new Promise((resolve) => {
            _confirmResolve = resolve;

            const dialog = document.getElementById('barberbook-confirm-dialog');
            document.getElementById('confirm-dialog-title').textContent = title;
            document.getElementById('confirm-dialog-desc').textContent = message;

            const proceedBtn = document.getElementById('confirm-dialog-proceed-btn');
            proceedBtn.textContent = confirmText;
            if (isDestructive) {
                proceedBtn.className = 'px-5 py-2 rounded-xl text-xs font-bold bg-rose-600 text-white hover:bg-rose-500 transition shadow-sm focus:outline-none focus:ring-2 focus:ring-rose-500';
            } else {
                proceedBtn.className = 'px-5 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-500';
            }

            document.getElementById('confirm-dialog-cancel-btn').textContent = cancelText;

            dialog.classList.remove('hidden');
            proceedBtn.focus();
        });
    };

    document.addEventListener('DOMContentLoaded', () => {
        const dialog = document.getElementById('barberbook-confirm-dialog');
        if (!dialog) return;

        const cancelBtn = document.getElementById('confirm-dialog-cancel-btn');
        const proceedBtn = document.getElementById('confirm-dialog-proceed-btn');

        cancelBtn.addEventListener('click', () => {
            dialog.classList.add('hidden');
            if (_confirmResolve) _confirmResolve(false);
        });

        proceedBtn.addEventListener('click', () => {
            dialog.classList.add('hidden');
            if (_confirmResolve) _confirmResolve(true);
        });

        // Close on escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !dialog.classList.contains('hidden')) {
                dialog.classList.add('hidden');
                if (_confirmResolve) _confirmResolve(false);
            }
        });
    });
</script>

