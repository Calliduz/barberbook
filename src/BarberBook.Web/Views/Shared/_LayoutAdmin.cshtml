<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BarberBook Executive Admin</title>

    <!-- Dark Mode Init to prevent FOUC -->
    <script>
        if (localStorage.getItem('barberbook_theme') === 'dark' || (!localStorage.getItem('barberbook_theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <!-- Google Fonts: Playfair Display + Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,900;1,400;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Offline-ready with local bundle) -->
    <script src="~/lib/tailwindcss.js" asp-append-version="true"></script>
    <partial name="_TailwindConfig" />
    <!-- Custom BarberBook Styles & Rotating Barber Pole Animations -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Chart.js: High-Performance Visualizations (Local bundle with CDN fallback) -->
    <script src="~/lib/chart.umd.min.js" asp-append-version="true"></script>
    <script>
        if (typeof Chart === 'undefined') {
            document.write('<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"><\/script>');
        }
    </script>
</head>
<body class="flex flex-col min-h-full font-sans text-slate-800 antialiased bg-slate-50/70 dark:bg-[#090e17] dark:text-slate-100">
    <!-- Accessible Skip to Main Content Link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[9999] px-4 py-2 bg-amber-500 text-slate-950 font-bold rounded-lg shadow-xl ring-2 ring-slate-900 focus:outline-none transition">
        Skip to main content
    </a>

    <!-- Admin Header -->
    <header class="bg-slate-900/95 backdrop-blur-md text-white shadow-lg sticky top-0 z-50 border-b border-slate-800">
        <!-- Top Barber Pole Animated Border Divider -->
        <div class="barber-pole-divider"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Brand & Logo -->
                <div class="flex items-center space-x-6">
                    <a href="/admin" class="flex items-center space-x-2.5 group">
                        <div class="barber-pole-icon" style="height: 22px; width: 11px;"></div>
                        <div class="flex flex-col">
                            <span class="text-xl font-serif font-black tracking-tight text-amber-400 group-hover:text-amber-300 transition">Barber<span class="text-white font-sans font-bold">Book</span></span>
                            <span class="text-[9px] uppercase tracking-widest text-slate-400 font-bold -mt-1">ADMINISTRATOR</span>
                        </div>
                    </a>

                    @{
                        var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
                        var isDashboardActive = currentPath == "/admin" || currentPath == "/admin/";
                        var isBookingsActive = currentPath.StartsWith("/admin/appointments") || currentPath.StartsWith("/admin/history");
                        var isManagementActive = currentPath.StartsWith("/admin/barbers") || currentPath.StartsWith("/admin/branches") || currentPath.StartsWith("/admin/schedules") || currentPath.StartsWith("/admin/services") || currentPath.StartsWith("/admin/customers");
                        var isAnalyticsActive = currentPath.StartsWith("/admin/reports") || currentPath.StartsWith("/admin/inventory") || currentPath.StartsWith("/admin/purchases") || currentPath.StartsWith("/admin/product-sales") || currentPath.StartsWith("/admin/equipment");
                    }

                    <!-- Desktop Grouped Nav -->
                    <nav class="hidden lg:flex items-center space-x-1 text-sm font-medium whitespace-nowrap h-full">
                        <!-- Dashboard Link -->
                        <a href="/admin" class="nav-link px-3 py-2 rounded-xl text-slate-200 hover:text-white hover:bg-slate-800/80 transition flex items-center gap-1.5 font-semibold whitespace-nowrap @(isDashboardActive ? "active text-white bg-slate-800/80 font-bold" : "")">
                            <svg class="w-4 h-4 shrink-0 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
                            <span>Dashboard</span>
                        </a>

                        <!-- Dropdown 1: Bookings -->
                        <div class="nav-dropdown relative group h-full inline-flex items-center @(isBookingsActive ? "active" : "")">
                            <button type="button" class="nav-dropdown-trigger px-3 py-2 rounded-xl text-slate-200 hover:text-white hover:bg-slate-800/80 transition flex items-center gap-1.5 font-semibold whitespace-nowrap @(isBookingsActive ? "text-white bg-slate-800/80 font-bold" : "")">
                                <svg class="w-4 h-4 shrink-0 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                                <span>Bookings</span>
                                <svg class="w-3.5 h-3.5 shrink-0 transition transform group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                            </button>
                            <div class="dropdown-menu absolute left-0 w-56 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl py-2 hidden group-hover:block transition-all duration-200 z-50 divide-y divide-slate-800/50">
                                <a href="/admin/appointments" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-slate-200 hover:text-amber-300 hover:bg-slate-800/60 transition whitespace-nowrap">
                                    <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                                    <div>
                                        <span class="block">Bookings & Approvals</span>
                                        <span class="text-[10px] text-slate-400 font-normal">Active schedule calendar</span>
                                    </div>
                                </a>
                                <a href="/admin/history" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-slate-200 hover:text-amber-300 hover:bg-slate-800/60 transition whitespace-nowrap">
                                    <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    <div>
                                        <span class="block">Complete History</span>
                                        <span class="text-[10px] text-slate-400 font-normal">Audit timeline & filters</span>
                                    </div>
                                </a>
                            </div>
                        </div>

                        <!-- Dropdown 2: Management -->
                        <div class="nav-dropdown relative group h-full inline-flex items-center @(isManagementActive ? "active" : "")">
                            <button type="button" class="nav-dropdown-trigger px-3 py-2 rounded-xl text-slate-200 hover:text-white hover:bg-slate-800/80 transition flex items-center gap-1.5 font-semibold whitespace-nowrap @(isManagementActive ? "text-white bg-slate-800/80 font-bold" : "")">
                                <svg class="w-4 h-4 shrink-0 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" /></svg>
                                <span>Management</span>
                                <svg class="w-3.5 h-3.5 shrink-0 transition transform group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                            </button>
                            <div class="dropdown-menu absolute left-0 w-60 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl py-2 hidden group-hover:block transition-all duration-200 z-50 divide-y divide-slate-800/50">
                                <a href="/admin/barbers" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-slate-200 hover:text-amber-300 hover:bg-slate-800/60 transition whitespace-nowrap">
                                    <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zm-7.518-.267A8.25 8.25 0 1120.25 10.5M8.288 14.212A5.25 5.25 0 1117.25 10.5" /></svg>
                                    <div>
                                        <span class="block">Master Barbers</span>
                                        <span class="text-[10px] text-slate-400 font-normal">Staff profiles & access</span>
                                    </div>
                                </a>
                                <a href="/admin/branches" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-slate-200 hover:text-amber-300 hover:bg-slate-800/60 transition whitespace-nowrap">
                                    <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                    <div>
                                        <span class="block">Branches & Locations</span>
                                        <span class="text-[10px] text-slate-400 font-normal">Multi-branch locations</span>
                                    </div>
                                </a>
                                <a href="/admin/schedules" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-slate-200 hover:text-amber-300 hover:bg-slate-800/60 transition whitespace-nowrap">
                                    <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    <div>
                                        <span class="block">Working Hours & Days Off</span>
                                        <span class="text-[10px] text-slate-400 font-normal">Shift windows (30m grid)</span>
                                    </div>
                                </a>
                                <a href="/admin/services" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-slate-200 hover:text-amber-300 hover:bg-slate-800/60 transition whitespace-nowrap">
                                    <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.848 8.25l1.536.887m0 0l1.536.887M9.384 9.137L4.76 6.467a2.25 2.25 0 00-2.25 3.897l4.624 2.67m2.25-3.897l6.928 4m-6.928-4L4.76 11.807a2.25 2.25 0 102.25 3.897l4.624-2.67m0 0l1.536-.887m-1.536.887l1.536.887M16.312 13.137l4.624-2.67a2.25 2.25 0 00-2.25-3.897l-4.624 2.67m2.25 3.897l-6.928-4" /></svg>
                                    <div>
                                        <span class="block">Services & Fixed Pricing</span>
                                        <span class="text-[10px] text-slate-400 font-normal">Philippine Peso (₱) menu</span>
                                    </div>
                                </a>
                                <a href="/admin/customers" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-slate-200 hover:text-amber-300 hover:bg-slate-800/60 transition whitespace-nowrap">
                                    <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                                    <div>
                                        <span class="block">Customer Registry</span>
                                        <span class="text-[10px] text-slate-400 font-normal">Registered client accounts</span>
                                    </div>
                                </a>
                            </div>
                        </div>

                        <!-- Dropdown 3: Analytics -->
                        <div class="nav-dropdown relative group h-full inline-flex items-center @(isAnalyticsActive ? "active" : "")">
                            <button type="button" class="nav-dropdown-trigger px-3 py-2 rounded-xl text-slate-200 hover:text-white hover:bg-slate-800/80 transition flex items-center gap-1.5 font-semibold whitespace-nowrap @(isAnalyticsActive ? "text-white bg-slate-800/80 font-bold" : "")">
                                <svg class="w-4 h-4 shrink-0 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                                <span>Analytics</span>
                                <svg class="w-3.5 h-3.5 shrink-0 transition transform group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                            </button>
                            <div class="dropdown-menu absolute left-0 w-64 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl py-2 hidden group-hover:block transition-all duration-200 z-50 divide-y divide-slate-800/50">
                                <a href="/admin/reports" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-slate-200 hover:text-amber-300 hover:bg-slate-800/60 transition whitespace-nowrap">
                                    <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    <div>
                                        <span class="block">Sales Reports (Daily/Monthly)</span>
                                        <span class="text-[10px] text-slate-400 font-normal">Financial reports & settled totals</span>
                                    </div>
                                </a>
                                <a href="/admin/inventory" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-semibold text-slate-200 hover:text-amber-300 hover:bg-slate-800/60 transition whitespace-nowrap">
                                    <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
                                    <div>
                                        <span class="block">Inventory & Equipment</span>
                                        <span class="text-[10px] text-slate-400 font-normal">Stock alerts & tool maintenance</span>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </nav>
                </div>

                <!-- Right Nav: Shop Front & User Profile -->
                <div class="flex items-center space-x-2 sm:space-x-3">
                    <!-- Global Command Palette Search Button -->
                    <button type="button" onclick="openCommandPalette()"
                            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-700/60 transition"
                            title="Search pages and bookings (Ctrl+K or /)"
                            aria-label="Search pages and bookings">
                        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                        <span class="hidden md:inline">Quick Jump</span>
                        <kbd class="hidden md:inline-block px-1.5 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-400 border border-slate-700">Ctrl K</kbd>
                    </button>

                    <!-- Dark Mode Toggle Button -->
                    <button type="button" onclick="toggleDarkMode()"
                            class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-700/60 transition"
                            title="Toggle Light / Dark Mode"
                            aria-label="Toggle Light or Dark Mode">
                        <!-- Sun Icon (shown in dark mode) -->
                        <svg class="theme-toggle-sun w-4 h-4 text-amber-400 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                        </svg>
                        <!-- Moon Icon (shown in light mode) -->
                        <svg class="theme-toggle-moon w-4 h-4 text-slate-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
                        </svg>
                    </button>

                    <partial name="_LoginPartial" />

                    <!-- Mobile Menu Button -->
                    <button type="button" onclick="toggleMobileMenu()" class="lg:hidden p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Drawer Menu -->
        <div id="mobile-menu" class="hidden lg:hidden bg-slate-900 border-t border-slate-800 px-4 pt-3 pb-6 space-y-3">
            <a href="/admin" class="block px-3 py-2 rounded-xl text-sm font-semibold text-amber-400 bg-slate-800/80">Dashboard</a>
            
            <div class="pt-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-3">Bookings</span>
                <div class="mt-1 space-y-1">
                    <a href="/admin/appointments" class="block px-3 py-1.5 rounded-lg text-sm text-slate-200 hover:bg-slate-800">Bookings & Approvals</a>
                    <a href="/admin/history" class="block px-3 py-1.5 rounded-lg text-sm text-slate-200 hover:bg-slate-800">Complete History</a>
                </div>
            </div>

            <div class="pt-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-3">Management</span>
                <div class="mt-1 space-y-1">
                    <a href="/admin/barbers" class="block px-3 py-1.5 rounded-lg text-sm text-slate-200 hover:bg-slate-800">Master Barbers</a>
                    <a href="/admin/branches" class="block px-3 py-1.5 rounded-lg text-sm text-slate-200 hover:bg-slate-800">Branches & Locations</a>
                    <a href="/admin/schedules" class="block px-3 py-1.5 rounded-lg text-sm text-slate-200 hover:bg-slate-800">Working Hours & Days Off</a>
                    <a href="/admin/services" class="block px-3 py-1.5 rounded-lg text-sm text-slate-200 hover:bg-slate-800">Services & Fixed Pricing</a>
                    <a href="/admin/customers" class="block px-3 py-1.5 rounded-lg text-sm text-slate-200 hover:bg-slate-800">Customer Registry</a>
                </div>
            </div>

            <div class="pt-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-3">Analytics</span>
                <div class="mt-1 space-y-1">
                    <a href="/admin/reports" class="block px-3 py-1.5 rounded-lg text-sm text-slate-200 hover:bg-slate-800">Sales Reports</a>
                    <a href="/admin/inventory" class="block px-3 py-1.5 rounded-lg text-sm text-slate-200 hover:bg-slate-800">Inventory & Equipment</a>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @RenderBody()
    </main>

    <!-- Admin Footer -->
    <footer class="bg-slate-900 text-slate-400 py-6 text-xs text-center border-t border-slate-800 mt-auto">
        <div class="max-w-7xl mx-auto px-4">
            <p>&copy; @DateTime.UtcNow.Year BarberBook Management System &bull; Modern Professional Grooming</p>
        </div>
    </footer>

    <!-- Shared Accessible Toast, Confirm Modal & Command Palette Components -->
    <partial name="_Toast" />
    <partial name="_ConfirmDialog" />
    <partial name="_CommandPalette" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
