<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FBF7EE]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BarberBook Barber Portal</title>
    
    <!-- Dark Mode Init to prevent FOUC -->
    <script>
        if (localStorage.getItem('barberbook_theme') === 'dark' || (!localStorage.getItem('barberbook_theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
        } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
        }
    </script>

    <!-- Google Fonts: Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Offline-ready with local bundle) -->
    <script src="~/lib/tailwindcss.js" asp-append-version="true"></script>
    <partial name="_TailwindConfig" />
    <!-- Custom BarberBook Styles & Rotating Barber Pole Animations -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex flex-col min-h-full text-slate-800 antialiased font-sans selection:bg-brand-500 selection:text-white bg-[#FBF7EE] dark:bg-[#090e17] dark:text-slate-100">
    <!-- Accessible Skip to Main Content Link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[9999] px-4 py-2 bg-amber-500 text-slate-950 font-bold rounded-lg shadow-xl ring-2 ring-slate-900 focus:outline-none transition">
        Skip to main content
    </a>

    <header class="bg-slate-900/95 backdrop-blur-md text-white shadow-xl sticky top-0 z-50 border-b border-slate-800">
        <!-- Animated Barber Pole Ribbon Divider -->
        <div class="barber-pole-divider"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-18 py-3">
                <div class="flex items-center space-x-6 lg:space-x-8">
                    <!-- Brand with Spinning Barber Pole Icon -->
                    <a href="/barber" class="flex items-center space-x-3 group">
                        <div class="barber-pole-icon shadow-lg group-hover:scale-105 transition-transform"></div>
                        <div class="flex flex-col">
                            <span class="text-2xl font-serif font-black tracking-tight text-brand-400 group-hover:text-brand-300 transition-colors">
                                Barber<span class="text-white font-sans font-extrabold">Book</span>
                            </span>
                            <span class="text-[9px] uppercase tracking-widest text-brand-400/80 font-bold -mt-1 flex items-center gap-1">
                                <span>Barber Craftsman Portal</span>
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                            </span>
                        </div>
                    </a>

                    <!-- Barber Navigation Links -->
                    @{
                        var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
                    }
                    <nav class="hidden xl:flex space-x-1 items-center whitespace-nowrap">
                        <a href="/barber" class="px-3 py-2 rounded-xl text-xs font-semibold transition whitespace-nowrap @(currentPath == "/barber" ? "bg-amber-500/20 text-amber-300 border border-amber-500/40" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">
                            Dashboard
                        </a>
                        <a href="/barber/schedule" class="px-3 py-2 rounded-xl text-xs font-semibold transition whitespace-nowrap @(currentPath.StartsWith("/barber/schedule") ? "bg-amber-500/20 text-amber-300 border border-amber-500/40" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">
                            My Schedule
                        </a>
                        <a href="/barber/appointments" class="px-3 py-2 rounded-xl text-xs font-semibold transition whitespace-nowrap @(currentPath.StartsWith("/barber/appointments") ? "bg-amber-500/20 text-amber-300 border border-amber-500/40" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">
                            Appointments
                        </a>
                        <a href="/barber/availability" class="px-3 py-2 rounded-xl text-xs font-semibold transition whitespace-nowrap @(currentPath.StartsWith("/barber/availability") ? "bg-amber-500/20 text-amber-300 border border-amber-500/40" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">
                            Availability & Days Off
                        </a>
                        <a href="/barber/transactions" class="px-3 py-2 rounded-xl text-xs font-semibold transition whitespace-nowrap @(currentPath.StartsWith("/barber/transactions") ? "bg-amber-500/20 text-amber-300 border border-amber-500/40" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">
                            My Transactions
                        </a>
                        <a href="/barber/account" class="px-3 py-2 rounded-xl text-xs font-semibold transition whitespace-nowrap @(currentPath.StartsWith("/barber/account") ? "bg-amber-500/20 text-amber-300 border border-amber-500/40" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">
                            Account
                        </a>
                        <a href="/barber/equipment" class="px-3 py-2 rounded-xl text-xs font-semibold transition whitespace-nowrap @(currentPath.StartsWith("/barber/equipment") ? "bg-amber-500/20 text-amber-300 border border-amber-500/40" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">
                            My Equipment
                        </a>
                    </nav>
                </div>

                <div class="flex items-center space-x-2 sm:space-x-3">
                    <!-- Global Command Palette Search Button -->
                    <button type="button" onclick="openCommandPalette()"
                            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-700/60 transition"
                            title="Search pages and bookings (Ctrl+K or /)"
                            aria-label="Search pages and bookings">
                        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                        <span class="hidden md:inline">Quick Jump</span>
                        <kbd class="hidden md:inline-block px-1.5 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-400 border border-slate-700">Ctrl K</kbd>
                    </button>

                    <!-- Dark Mode Toggle Button -->
                    <button type="button" onclick="toggleDarkMode()"
                            class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-700/60 transition"
                            title="Toggle Light / Dark Mode"
                            aria-label="Toggle Light or Dark Mode">
                        <!-- Sun Icon (shown in dark mode) -->
                        <svg class="theme-toggle-sun w-4 h-4 text-amber-400 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                        </svg>
                        <!-- Moon Icon (shown in light mode) -->
                        <svg class="theme-toggle-moon w-4 h-4 text-slate-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
                        </svg>
                    </button>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>

        <!-- Sub-nav on medium screens -->
        <div class="xl:hidden bg-slate-950/90 border-t border-slate-800 px-4 py-2 overflow-x-auto flex gap-2">
            <a href="/barber" class="px-2.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap @(currentPath == "/barber" ? "bg-amber-500/20 text-amber-300 font-bold" : "text-slate-300 hover:text-white")">Dashboard</a>
            <a href="/barber/schedule" class="px-2.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap @(currentPath.StartsWith("/barber/schedule") ? "bg-amber-500/20 text-amber-300 font-bold" : "text-slate-300 hover:text-white")">Schedule</a>
            <a href="/barber/appointments" class="px-2.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap @(currentPath.StartsWith("/barber/appointments") ? "bg-amber-500/20 text-amber-300 font-bold" : "text-slate-300 hover:text-white")">Appointments</a>
            <a href="/barber/availability" class="px-2.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap @(currentPath.StartsWith("/barber/availability") ? "bg-amber-500/20 text-amber-300 font-bold" : "text-slate-300 hover:text-white")">Availability</a>
            <a href="/barber/transactions" class="px-2.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap @(currentPath.StartsWith("/barber/transactions") ? "bg-amber-500/20 text-amber-300 font-bold" : "text-slate-300 hover:text-white")">Transactions</a>
            <a href="/barber/account" class="px-2.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap @(currentPath.StartsWith("/barber/account") ? "bg-amber-500/20 text-amber-300 font-bold" : "text-slate-300 hover:text-white")">Account</a>
            <a href="/barber/equipment" class="px-2.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap @(currentPath.StartsWith("/barber/equipment") ? "bg-amber-500/20 text-amber-300 font-bold" : "text-slate-300 hover:text-white")">Equipment</a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center shadow-sm">
                <svg class="h-5 w-5 text-emerald-500 mr-2 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="p-4 rounded-xl bg-amber-50 border border-amber-300 text-amber-900 text-sm font-semibold flex items-center shadow-sm">
                <svg class="h-5 w-5 text-amber-600 mr-2 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
                <span>@TempData["WarningMessage"]</span>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm font-semibold flex items-center shadow-sm">
                <svg class="h-5 w-5 text-red-500 mr-2 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        </div>
    }

    <main id="main-content" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @RenderBody()
    </main>

    <footer class="bg-slate-900 text-slate-400 py-8 text-xs border-t border-slate-800 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-2">
                <div class="barber-pole-icon" style="height: 18px; width: 10px;"></div>
                <span class="font-serif font-bold text-brand-400">Barber<span class="text-white font-sans">Book</span></span>
                <span class="text-slate-600">&bull;</span>
                <span class="text-slate-400">Barber Portal &bull; Shop Zone Asia/Manila (UTC+8)</span>
            </div>
            <div>
                &copy; @DateTime.UtcNow.Year BarberBook Management System. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Shared Accessible Toast, Confirm Modal & Command Palette Components -->
    <partial name="_Toast" />
    <partial name="_ConfirmDialog" />
    <partial name="_CommandPalette" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
