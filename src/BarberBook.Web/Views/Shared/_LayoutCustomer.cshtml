<!DOCTYPE html>
<html lang="en" data-type="place" class="h-full bg-[#FBF7EE] dark:bg-[#090e17]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="page-type" content="place" />
    <meta name="site-kind" content="other" />
    <meta name="page-kind" content="place" />
    <title>@ViewData["Title"] - BarberBook Classic Grooming</title>
    
    <!-- Dark Mode Init to prevent FOUC & synchronize color-scheme meta -->
    <script>
        (function() {
            var stored = localStorage.getItem('barberbook_theme');
            var isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) {
                document.documentElement.classList.add('dark');
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.classList.remove('dark');
                document.documentElement.setAttribute('data-theme', 'light');
            }
            var meta = document.querySelector('meta[name="color-scheme"]');
            if (meta) meta.content = stored ? (isDark ? 'dark' : 'light') : 'light dark';
        })();
    </script>

    <!-- Google Fonts: Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Offline-ready with local bundle) -->
    <script src="~/lib/tailwindcss.js" asp-append-version="true"></script>
    <partial name="_TailwindConfig" />
    
    <!-- Custom BarberBook Styles & Rotating Barber Pole Animations -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex flex-col min-h-full text-slate-800 antialiased font-sans selection:bg-amber-500 selection:text-white bg-[#FBF7EE] dark:bg-[#090e17] dark:text-slate-100">
    <partial name="_AcademicDemoToolbar" />
    <!-- Accessible Skip to Main Content Link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[9999] px-4 py-2 bg-amber-500 text-slate-950 font-bold rounded-lg shadow-xl ring-2 ring-slate-900 focus:outline-none transition">
        Skip to main content
    </a>

    <header class="bg-slate-900/95 backdrop-blur-md text-white shadow-xl sticky top-0 z-50 border-b border-slate-800">
        <!-- Animated Barber Pole Ribbon Divider (Top of Nav Bar) -->
        <div class="barber-pole-divider"></div>
        @{
            var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
            bool isHome = currentPath == "/" || currentPath == "";
            bool isServices = currentPath.StartsWith("/services");
            bool isBarbers = currentPath.StartsWith("/barbers");
            bool isProducts = currentPath.StartsWith("/products");
            bool isBooking = currentPath.StartsWith("/book");
            bool isMyAppts = currentPath.StartsWith("/my-appointments");
            bool isProfile = currentPath.StartsWith("/profile");
        }
        <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-18 py-3">
                <div class="flex items-center space-x-8">
                    <!-- Brand with Spinning Barber Pole Icon -->
                    <a href="/" class="flex items-center space-x-2 sm:space-x-3 group shrink-0">
                        <div class="barber-pole-icon shadow-lg group-hover:scale-105 transition-transform shrink-0"></div>
                        <div class="flex flex-col">
                            <span class="text-xl sm:text-2xl font-serif font-black tracking-tight text-amber-400 group-hover:text-amber-300 transition-colors">
                                Barber<span class="text-white font-sans font-extrabold">Book</span>
                            </span>
                            <span class="hidden sm:inline text-[9px] uppercase tracking-widest text-amber-400/80 font-bold -mt-1">Classic Craft &bull; Manila</span>
                        </div>
                    </a>

                    <!-- Navigation Links with Dedicated Typography & Hierarchy -->
                    <nav class="hidden md:flex space-x-6 items-center whitespace-nowrap">
                        <a href="/" class="text-sm font-semibold transition py-1 @(isHome ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-slate-300 hover:text-white")">Home</a>
                        <a href="/services" class="text-sm font-semibold transition py-1 @(isServices ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-slate-300 hover:text-white")">Services</a>
                        <a href="/products" class="text-sm font-semibold transition py-1 @(isProducts ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-slate-300 hover:text-white")">Grooming Products</a>
                        <a href="/barbers" class="text-sm font-semibold transition py-1 @(isBarbers ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-slate-300 hover:text-white")">Master Barbers</a>
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
                        {
                            <a href="/my-appointments" class="text-sm font-semibold transition py-1 @(isMyAppts ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-slate-300 hover:text-white")">My Appointments</a>
                            <a href="/profile" class="text-sm font-semibold transition py-1 @(isProfile ? "text-amber-400 font-bold border-b-2 border-amber-400" : "text-slate-300 hover:text-white")">Profile</a>
                        }
                        <!-- Single Prominent Booking Action Button -->
                        <a href="/book" class="ml-4 inline-flex items-center px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 shadow-md hover:bg-amber-400 hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900 transition-all duration-150 uppercase tracking-wider">
                            Book Appointment
                        </a>
                    </nav>
                </div>

                <div class="flex items-center space-x-1 sm:space-x-2">
                    <!-- Staff/Admin Only Command Palette Shortcut -->
                    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Barber")))
                    {
                        <button type="button" onclick="openCommandPalette()"
                                class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-700/60 active:scale-95 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
                                title="Search staff directory (Ctrl+K or /)"
                                aria-label="Search pages and bookings">
                            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                            <span class="hidden sm:inline">Search</span>
                            <kbd class="hidden sm:inline-block px-1.5 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-400 border border-slate-700">Ctrl K</kbd>
                        </button>
                    }

                    <!-- Dark Mode Toggle Button -->
                    <button type="button" onclick="toggleDarkMode()"
                            class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-700/60 active:scale-95 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
                            title="Toggle Light / Dark Mode"
                            aria-label="Toggle Light or Dark Mode">
                        <!-- Sun Icon (shown in dark mode) -->
                        <svg class="theme-toggle-sun w-4 h-4 text-amber-400 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                        </svg>
                        <!-- Moon Icon (shown in light mode) -->
                        <svg class="theme-toggle-moon w-4 h-4 text-slate-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
                        </svg>
                    </button>

                    <partial name="_LoginPartial" />

                    <!-- Mobile Menu Hamburger Button -->
                    <button type="button" id="customer-mobile-menu-toggle" onclick="toggleCustomerMobileMenu()"
                            class="md:hidden inline-flex items-center justify-center p-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 transition"
                            aria-label="Toggle navigation menu" aria-expanded="false">
                        <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Menu Drawer -->
        <div id="customer-mobile-menu" class="hidden md:hidden bg-slate-950/95 border-t border-slate-800 px-4 pt-3 pb-5 space-y-2 backdrop-blur-md">
            <a href="/" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isHome ? "text-amber-400 font-bold bg-slate-900" : "text-slate-300 hover:text-white hover:bg-slate-900")">Home</a>
            <a href="/services" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isServices ? "text-amber-400 font-bold bg-slate-900" : "text-slate-300 hover:text-white hover:bg-slate-900")">Services Menu</a>
            <a href="/products" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isProducts ? "text-amber-400 font-bold bg-slate-900" : "text-slate-300 hover:text-white hover:bg-slate-900")">Grooming Products</a>
            <a href="/barbers" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isBarbers ? "text-amber-400 font-bold bg-slate-900" : "text-slate-300 hover:text-white hover:bg-slate-900")">Master Barbers</a>
            <a href="/book" class="block px-3.5 py-2.5 rounded-xl text-sm font-bold bg-amber-500 hover:bg-amber-400 active:scale-[0.98] text-slate-950 text-center shadow-md transition-all duration-150">
                Book Appointment
            </a>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
            {
                <div class="pt-2 border-t border-slate-800 space-y-1">
                    <a href="/my-appointments" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isMyAppts ? "text-amber-400 font-bold bg-slate-900" : "text-slate-300 hover:text-white hover:bg-slate-900")">My Appointments</a>
                    <a href="/profile" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isProfile ? "text-amber-400 font-bold bg-slate-900" : "text-slate-300 hover:text-white hover:bg-slate-900")">Profile</a>
                </div>
            }
        </div>
    </header>

    <script>
        function toggleCustomerMobileMenu() {
            const menu = document.getElementById('customer-mobile-menu');
            const btn = document.getElementById('customer-mobile-menu-toggle');
            const hamburger = document.getElementById('hamburger-icon');
            const close = document.getElementById('close-icon');

            const isExpanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', !isExpanded);

            if (isExpanded) {
                menu.classList.add('hidden');
                hamburger.classList.remove('hidden');
                close.classList.add('hidden');
            } else {
                menu.classList.remove('hidden');
                hamburger.classList.add('hidden');
                close.classList.remove('hidden');
            }
        }
    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-sm font-semibold flex items-center shadow-sm">
                <svg class="h-5 w-5 text-emerald-500 mr-2 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                @TempData["SuccessMessage"]
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200 text-sm font-semibold flex items-center shadow-sm">
                <svg class="h-5 w-5 text-rose-500 mr-2 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
                @TempData["ErrorMessage"]
            </div>
        </div>
    }

    <main id="main-content" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @RenderBody()
    </main>

    <footer class="bg-slate-900 text-slate-400 py-12 text-sm border-t border-slate-800 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 pb-8 border-b border-slate-800">
                <div class="space-y-3">
                    <div class="flex items-center space-x-2">
                        <div class="barber-pole-icon"></div>
                        <span class="text-xl font-serif font-bold text-amber-400">Barber<span class="text-white font-sans font-bold">Book</span></span>
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Handcrafted hair styling, precision hot-towel straight-razor shaves, and traditional beard sculpting. Est. 2026.
                    </p>
                    <p class="text-[11px] text-slate-300">
                        Manila Main &bull; BGC &bull; Makati &bull; QC &bull; Ortigas
                    </p>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wider font-bold text-slate-200 mb-3">Shop Hours</h4>
                    <p class="text-xs text-slate-400">Monday &ndash; Saturday</p>
                    <p class="text-xs font-semibold text-amber-300">9:00 AM &ndash; 6:00 PM</p>
                    <p class="text-xs text-slate-300 mt-1">Closed Sundays &amp; Official Holidays</p>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wider font-bold text-slate-200 mb-3">Quick Navigation</h4>
                    <ul class="space-y-1.5 text-xs text-slate-300">
                        <li><a href="/services" class="hover:text-amber-300 transition">Services Menu</a></li>
                        <li><a href="/products" class="hover:text-amber-300 transition">Grooming Products</a></li>
                        <li><a href="/barbers" class="hover:text-amber-300 transition">Master Barbers</a></li>
                        <li><a href="/book" class="hover:text-amber-300 transition">Book Appointment</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wider font-bold text-slate-200 mb-3">Shop Policy &amp; Terms</h4>
                    <p class="text-xs text-slate-300 leading-relaxed mb-2">
                        In-shop settlement upon service completion (Cash, QR, Card). Free cancellation &amp; rescheduling up to 2 hours before your scheduled appointment.
                    </p>
                    <button type="button" onclick="openPrivacyModal()" class="text-xs text-amber-400 hover:text-amber-300 underline font-semibold transition">
                        Privacy Notice (DPA 2012)
                    </button>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-slate-300 gap-2">
                <p>&copy; @DateTime.UtcNow.Year BarberBook Classic Grooming &bull; Manila</p>
                <p class="text-[11px] text-slate-300 text-center sm:text-right">
                    Academic Prototype (SBIT-3D, Group 4) &bull; All branch contacts and data are for simulation &amp; defense purposes.
                </p>
            </div>
        </div>
    </footer>

    <!-- Accessible Native Privacy Notice Modal (Modern Web Guidance: <dialog closedby="any">) -->
    <dialog id="privacy-modal" closedby="any" aria-labelledby="privacy-modal-title"
            class="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 max-w-lg w-[calc(100%-2rem)] text-slate-200 shadow-2xl backdrop:bg-slate-950/80 backdrop:backdrop-blur-sm m-auto">
        <div class="space-y-4">
            <div class="flex items-start justify-between">
                <div class="flex items-center gap-2">
                    <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
                    <h3 id="privacy-modal-title" class="text-lg font-serif font-bold text-white">Privacy Notice (DPA 2012)</h3>
                </div>
                <form method="dialog">
                    <button type="submit" class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition" aria-label="Close dialog">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </form>
            </div>
            <div class="text-xs text-slate-300 space-y-3 leading-relaxed max-h-80 overflow-y-auto pr-2">
                <p>
                    In compliance with the <strong>Data Privacy Act of 2012 (Republic Act No. 10173)</strong> of the Philippines, BarberBook is committed to protecting your personal information.
                </p>
                <p>
                    <strong>1. Information Collected:</strong> We collect your name, email address, phone number, and appointment notes exclusively for booking reservations and service fulfillment.
                </p>
                <p>
                    <strong>2. Use &amp; Storage:</strong> Your information is stored securely in an encrypted database and used strictly by our shop staff to coordinate appointments and manage in-shop settlement. We never sell, share, or transfer customer data to third-party advertisers.
                </p>
                <p>
                    <strong>3. Your Rights:</strong> As a data subject, you retain the right to access, rectify, or request deactivation of your account records by contacting our shop administrator or managing your customer profile.
                </p>
                <p>
                    <strong>4. Simulated Project:</strong> This application is developed as an academic project by SBIT-3D (Group 4). No actual credit card or payment information is ever processed or stored online.
                </p>
            </div>
            <div class="pt-4 border-t border-slate-800 flex justify-end">
                <form method="dialog">
                    <button type="submit" autofocus class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition active:scale-95 shadow-md">
                        I Understand
                    </button>
                </form>
            </div>
        </div>
    </dialog>

    <style>
        /* Modern Web Guidance: stop page scrolling behind modal dialog */
        dialog:modal {
            overscroll-behavior: contain;
        }
        dialog::backdrop {
            overflow: hidden;
            overscroll-behavior: contain;
            background-color: rgba(2, 6, 23, 0.85);
            backdrop-filter: blur(4px);
        }
    </style>

    <script>
        function openPrivacyModal() {
            const modal = document.getElementById('privacy-modal');
            if (modal) {
                if (typeof modal.showModal === 'function') {
                    modal.showModal();
                } else {
                    modal.setAttribute('open', '');
                }
            }
        }
        function closePrivacyModal() {
            const modal = document.getElementById('privacy-modal');
            if (modal) {
                if (typeof modal.close === 'function') {
                    modal.close();
                } else {
                    modal.removeAttribute('open');
                }
            }
        }

        // Modern Web Guidance: Light-dismiss fallback for browsers without native closedby support
        document.addEventListener('DOMContentLoaded', function () {
            const dialog = document.getElementById('privacy-modal');
            if (dialog && !('closedBy' in HTMLDialogElement.prototype)) {
                dialog.addEventListener('click', function (event) {
                    if (event.target !== dialog) return;
                    const rect = dialog.getBoundingClientRect();
                    const isDialogContent = (
                        rect.top <= event.clientY &&
                        event.clientY <= rect.top + rect.height &&
                        rect.left <= event.clientX &&
                        event.clientX <= rect.left + rect.width
                    );
                    if (!isDialogContent) dialog.close();
                });
            }
        });
    </script>

    <!-- Shared Accessible Toast & Confirm Modal Components -->
    <partial name="_Toast" />
    <partial name="_ConfirmDialog" />
    <partial name="_CommandPalette" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
