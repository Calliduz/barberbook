<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FBF7EE] dark:bg-[#090e17]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BarberBook Master Grooming</title>
    
    <!-- Dark Mode Init to prevent FOUC -->
    <script>
        if (localStorage.getItem('barberbook_theme') === 'dark' || (!localStorage.getItem('barberbook_theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <!-- Google Fonts: Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Offline-ready with local bundle) -->
    <script src="~/lib/tailwindcss.js" asp-append-version="true"></script>
    <partial name="_TailwindConfig" />
    
    <!-- Custom BarberBook Styles & Rotating Barber Pole Animations -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex flex-col min-h-full text-slate-800 antialiased font-sans selection:bg-brand-500 selection:text-white bg-[#FBF7EE] dark:bg-[#090e17] dark:text-slate-100">
    <!-- Accessible Skip to Main Content Link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[9999] px-4 py-2 bg-amber-500 text-slate-950 font-bold rounded-lg shadow-xl ring-2 ring-slate-900 focus:outline-none transition">
        Skip to main content
    </a>

    <header class="bg-slate-900/95 backdrop-blur-md text-white shadow-xl sticky top-0 z-50 border-b border-slate-800">
        <!-- Animated Barber Pole Ribbon Divider (Top of Nav Bar) -->
        <div class="barber-pole-divider"></div>
        @{
            var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
            bool isHome = currentPath == "/" || currentPath == "";
            bool isServices = currentPath.StartsWith("/services");
            bool isBarbers = currentPath.StartsWith("/barbers");
            bool isProducts = currentPath.StartsWith("/products");
            bool isBooking = currentPath.StartsWith("/book");
            bool isMyAppts = currentPath.StartsWith("/my-appointments");
            bool isProfile = currentPath.StartsWith("/profile");
        }
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-18 py-3">
                <div class="flex items-center space-x-8">
                    <!-- Brand with Spinning Barber Pole Icon -->
                    <a href="/" class="flex items-center space-x-2 sm:space-x-3 group shrink-0">
                        <div class="barber-pole-icon shadow-lg group-hover:scale-105 transition-transform shrink-0"></div>
                        <div class="flex flex-col">
                            <span class="text-xl sm:text-2xl font-serif font-black tracking-tight text-brand-400 group-hover:text-brand-300 transition-colors">
                                Barber<span class="text-white font-sans font-extrabold">Book</span>
                            </span>
                            <span class="hidden sm:inline text-[9px] uppercase tracking-widest text-brand-400/80 font-bold -mt-1">Classic Craft &bull; Manila</span>
                        </div>
                    </a>

                    <!-- Navigation Links -->
                    <nav class="hidden md:flex space-x-1 items-center whitespace-nowrap">
                        <a href="/" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition whitespace-nowrap @(isHome ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">Home</a>
                        <a href="/services" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition whitespace-nowrap @(isServices ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">Services</a>
                        <a href="/products" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition whitespace-nowrap @(isProducts ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">Grooming Products</a>
                        <a href="/barbers" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition whitespace-nowrap @(isBarbers ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">Master Barbers</a>
                        <a href="/book" class="ml-2 inline-flex items-center px-4 py-2 rounded-xl text-sm font-bold bg-brand-500 text-slate-950 shadow-md hover:bg-brand-400 transition transform hover:-translate-y-0.5 whitespace-nowrap">
                            Book Appointment
                        </a>
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
                        {
                            <a href="/my-appointments" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition whitespace-nowrap @(isMyAppts ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">My Appointments</a>
                            <a href="/profile" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition whitespace-nowrap @(isProfile ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">Profile</a>
                        }
                    </nav>
                </div>

                <div class="flex items-center space-x-2">
                    <!-- Global Command Palette Search Button -->
                    <button type="button" onclick="openCommandPalette()"
                            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-700/60 transition"
                            title="Search pages and bookings (Ctrl+K or /)"
                            aria-label="Search pages and bookings">
                        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                        <span class="hidden sm:inline">Search</span>
                        <kbd class="hidden sm:inline-block px-1.5 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-400 border border-slate-700">Ctrl K</kbd>
                    </button>

                    <!-- Dark Mode Toggle Button -->
                    <button type="button" onclick="toggleDarkMode()"
                            class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800 border border-slate-700/60 transition"
                            title="Toggle Light / Dark Mode"
                            aria-label="Toggle Light or Dark Mode">
                        <!-- Sun Icon (shown in dark mode) -->
                        <svg class="theme-toggle-sun w-4 h-4 text-amber-400 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                        </svg>
                        <!-- Moon Icon (shown in light mode) -->
                        <svg class="theme-toggle-moon w-4 h-4 text-slate-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
                        </svg>
                    </button>

                    <partial name="_LoginPartial" />

                    <!-- Mobile Menu Hamburger Button -->
                    <button type="button" id="customer-mobile-menu-toggle" onclick="toggleCustomerMobileMenu()"
                            class="md:hidden inline-flex items-center justify-center p-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 transition"
                            aria-label="Toggle navigation menu" aria-expanded="false">
                        <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Menu Drawer -->
        <div id="customer-mobile-menu" class="hidden md:hidden bg-slate-950/95 border-t border-slate-800 px-4 pt-3 pb-5 space-y-2 backdrop-blur-md">
            <a href="/" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isHome ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-900")">Home</a>
            <a href="/services" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isServices ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-900")">Services Menu</a>
            <a href="/barbers" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isBarbers ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-900")">Master Barbers</a>
            <a href="/book" class="block px-3.5 py-2.5 rounded-xl text-sm font-bold bg-amber-500 text-slate-950 text-center shadow-md hover:bg-amber-400 transition">
                Book Appointment
            </a>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
            {
                <div class="pt-2 border-t border-slate-800 space-y-1">
                    <a href="/my-appointments" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isMyAppts ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-900")">My Appointments</a>
                    <a href="/profile" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isProfile ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-900")">Profile</a>
                </div>
            }
        </div>
    </header>

    <script>
        function toggleCustomerMobileMenu() {
            const menu = document.getElementById('customer-mobile-menu');
            const btn = document.getElementById('customer-mobile-menu-toggle');
            const hamburger = document.getElementById('hamburger-icon');
            const close = document.getElementById('close-icon');

            const isExpanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', !isExpanded);

            if (isExpanded) {
                menu.classList.add('hidden');
                hamburger.classList.remove('hidden');
                close.classList.add('hidden');
            } else {
                menu.classList.remove('hidden');
                hamburger.classList.add('hidden');
                close.classList.remove('hidden');
            }
        }
    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-sm font-semibold flex items-center shadow-sm">
                <svg class="h-5 w-5 text-emerald-500 mr-2 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                @TempData["SuccessMessage"]
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200 text-sm font-semibold flex items-center shadow-sm">
                <svg class="h-5 w-5 text-rose-500 mr-2 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                </svg>
                @TempData["ErrorMessage"]
            </div>
        </div>
    }

    <main id="main-content" class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @RenderBody()
    </main>

    <footer class="bg-slate-900 text-slate-400 py-12 text-sm border-t border-slate-800 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 pb-8 border-b border-slate-800">
                <div class="space-y-3">
                    <div class="flex items-center space-x-2">
                        <div class="barber-pole-icon"></div>
                        <span class="text-xl font-serif font-bold text-brand-400">Barber<span class="text-white font-sans font-bold">Book</span></span>
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Handcrafted hair styling, precision hot-towel shaves, and traditional beard sculpting. Est. 2026.
                    </p>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wider font-bold text-slate-200 mb-3">Shop Hours</h4>
                    <p class="text-xs text-slate-400">Monday &ndash; Saturday</p>
                    <p class="text-xs font-semibold text-brand-300">9:00 AM &ndash; 6:00 PM</p>
                    <p class="text-xs text-slate-300 mt-1">Closed on Sundays & Special Holidays</p>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wider font-bold text-slate-200 mb-3">Quick Navigation</h4>
                    <ul class="space-y-1.5 text-xs text-slate-300">
                        <li><a href="/services" class="hover:text-brand-300 transition">Services Menu</a></li>
                        <li><a href="/products" class="hover:text-brand-300 transition">Grooming Products</a></li>
                        <li><a href="/barbers" class="hover:text-brand-300 transition">Master Barbers</a></li>
                        <li><a href="/book" class="hover:text-brand-300 transition">Book Appointment</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wider font-bold text-slate-200 mb-3">Shop Policy</h4>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        In-shop settlement upon service completion. All appointments scheduled in Asia/Manila standard time.
                    </p>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-slate-300">
                <p>&copy; @DateTime.UtcNow.Year BarberBook Management System &bull; Premium Grooming & Styling</p>
                <p class="mt-2 sm:mt-0 font-mono text-[11px] text-slate-300">Shop Zone: Asia/Manila (UTC+8)</p>
            </div>
        </div>
    </footer>

    <!-- Shared Accessible Toast & Confirm Modal Components -->
    <partial name="_Toast" />
    <partial name="_ConfirmDialog" />
    <partial name="_CommandPalette" />

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
