<!DOCTYPE html>
<html lang="en" class="h-full bg-[#FBF7EE]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BarberBook Master Grooming</title>
    
    <!-- Google Fonts: Playfair Display & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS (Offline-ready with local bundle) -->
    <script src="~/lib/tailwindcss.js" asp-append-version="true"></script>
    <partial name="_TailwindConfig" />
    
    <!-- Custom BarberBook Styles & Rotating Barber Pole Animations -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="flex flex-col min-h-full text-slate-800 antialiased font-sans selection:bg-brand-500 selection:text-white bg-[#FBF7EE]">
    <!-- Animated Barber Pole Ribbon Divider -->
    <div class="barber-pole-divider"></div>

    <header class="bg-slate-900 text-white shadow-xl sticky top-0 z-50 border-b border-slate-800">
        @{
            var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
            bool isHome = currentPath == "/" || currentPath == "";
            bool isServices = currentPath.StartsWith("/services");
            bool isBarbers = currentPath.StartsWith("/barbers");
            bool isBooking = currentPath.StartsWith("/book");
            bool isMyAppts = currentPath.StartsWith("/my-appointments");
            bool isProfile = currentPath.StartsWith("/profile");
        }
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-18 py-3">
                <div class="flex items-center space-x-8">
                    <!-- Brand with Spinning Barber Pole Icon -->
                    <a href="/" class="flex items-center space-x-2 sm:space-x-3 group shrink-0">
                        <div class="barber-pole-icon shadow-lg group-hover:scale-105 transition-transform shrink-0"></div>
                        <div class="flex flex-col">
                            <span class="text-xl sm:text-2xl font-serif font-black tracking-tight text-brand-400 group-hover:text-brand-300 transition-colors">
                                Barber<span class="text-white font-sans font-extrabold">Book</span>
                            </span>
                            <span class="hidden sm:inline text-[9px] uppercase tracking-widest text-brand-400/80 font-bold -mt-1">Classic Craft &bull; Manila</span>
                        </div>
                    </a>

                    <!-- Navigation Links -->
                    <nav class="hidden md:flex space-x-1 items-center">
                        <a href="/" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition @(isHome ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">Home</a>
                        <a href="/services" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition @(isServices ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">Services</a>
                        <a href="/barbers" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition @(isBarbers ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">Master Barbers</a>
                        <a href="/book" class="ml-2 inline-flex items-center px-4 py-2 rounded-xl text-sm font-bold bg-brand-500 text-slate-950 shadow-md hover:bg-brand-400 transition transform hover:-translate-y-0.5">
                            Book Appointment
                        </a>
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
                        {
                            <a href="/my-appointments" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition @(isMyAppts ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">My Appointments</a>
                            <a href="/profile" class="px-3.5 py-2 rounded-xl text-sm font-semibold transition @(isProfile ? "bg-amber-500/15 text-amber-300 border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-800/80")">Profile</a>
                        }
                    </nav>
                </div>

                <div class="flex items-center space-x-2">
                    <partial name="_LoginPartial" />

                    <!-- Mobile Menu Hamburger Button -->
                    <button type="button" id="customer-mobile-menu-toggle" onclick="toggleCustomerMobileMenu()"
                            class="md:hidden inline-flex items-center justify-center p-2 rounded-xl text-slate-300 hover:text-white hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-amber-500 transition"
                            aria-label="Toggle navigation menu" aria-expanded="false">
                        <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Menu Drawer -->
        <div id="customer-mobile-menu" class="hidden md:hidden bg-slate-950/95 border-t border-slate-800 px-4 pt-3 pb-5 space-y-2 backdrop-blur-md">
            <a href="/" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isHome ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-900")">Home</a>
            <a href="/services" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isServices ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-900")">Services Menu</a>
            <a href="/barbers" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isBarbers ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-900")">Master Barbers</a>
            <a href="/book" class="block px-3.5 py-2.5 rounded-xl text-sm font-bold bg-amber-500 text-slate-950 text-center shadow-md hover:bg-amber-400 transition">
                Book Appointment
            </a>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
            {
                <div class="pt-2 border-t border-slate-800 space-y-1">
                    <a href="/my-appointments" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isMyAppts ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-900")">My Appointments</a>
                    <a href="/profile" class="block px-3.5 py-2.5 rounded-xl text-sm font-semibold transition @(isProfile ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/30" : "text-slate-300 hover:text-white hover:bg-slate-900")">Profile</a>
                </div>
            }
        </div>
    </header>

    <script>
        function toggleCustomerMobileMenu() {
            const menu = document.getElementById('customer-mobile-menu');
            const btn = document.getElementById('customer-mobile-menu-toggle');
            const hamburger = document.getElementById('hamburger-icon');
            const close = document.getElementById('close-icon');

            const isExpanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', !isExpanded);

            if (isExpanded) {
                menu.classList.add('hidden');
                hamburger.classList.remove('hidden');
                close.classList.add('hidden');
            } else {
                menu.classList.remove('hidden');
                hamburger.classList.add('hidden');
                close.classList.remove('hidden');
            }
        }
    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
            <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center shadow-sm">
                <svg class="h-5 w-5 text-emerald-500 mr-2 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                @TempData["SuccessMessage"]
            </div>
        </div>
    }

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @RenderBody()
    </main>

    <footer class="bg-slate-900 text-slate-400 py-12 text-sm border-t border-slate-800 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 pb-8 border-b border-slate-800">
                <div class="space-y-3">
                    <div class="flex items-center space-x-2">
                        <div class="barber-pole-icon"></div>
                        <span class="text-xl font-serif font-bold text-brand-400">Barber<span class="text-white font-sans font-bold">Book</span></span>
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Handcrafted hair styling, precision hot-towel shaves, and traditional beard sculpting. Est. 2026.
                    </p>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wider font-bold text-slate-200 mb-3">Shop Hours</h4>
                    <p class="text-xs text-slate-400">Monday &ndash; Saturday</p>
                    <p class="text-xs font-semibold text-brand-300">9:00 AM &ndash; 6:00 PM</p>
                    <p class="text-xs text-slate-300 mt-1">Closed on Sundays & Special Holidays</p>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wider font-bold text-slate-200 mb-3">Quick Navigation</h4>
                    <ul class="space-y-1.5 text-xs text-slate-300">
                        <li><a href="/services" class="hover:text-brand-300 transition">Services Menu</a></li>
                        <li><a href="/barbers" class="hover:text-brand-300 transition">Master Barbers</a></li>
                        <li><a href="/book" class="hover:text-brand-300 transition">Book Appointment</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs uppercase tracking-wider font-bold text-slate-200 mb-3">Shop Policy</h4>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        In-shop settlement upon service completion. All appointments scheduled in Asia/Manila standard time.
                    </p>
                </div>
            </div>
            <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-slate-300">
                <p>&copy; @DateTime.UtcNow.Year BarberBook Management System &bull; SBIT-3D Group 4</p>
                <p class="mt-2 sm:mt-0 font-mono text-[11px] text-slate-300">Shop Zone: Asia/Manila (UTC+8)</p>
            </div>
        </div>
    </footer>

    <!-- Shared Accessible Toast & Confirm Modal Components -->
    <partial name="_Toast" />
    <partial name="_ConfirmDialog" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
