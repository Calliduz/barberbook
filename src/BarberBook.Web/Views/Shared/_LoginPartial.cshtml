@using Microsoft.AspNetCore.Identity
@using BarberBook.Data.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="flex items-center space-x-2 whitespace-nowrap">
@if (SignInManager.IsSignedIn(User))
{
    var role = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Barber") ? "Barber" : "Customer";
    var roleDisplayName = User.IsInRole("Admin") ? "System Administrator" : User.IsInRole("Barber") ? "Master Barber" : "Registered Client";
    var portalLink = User.IsInRole("Admin") ? "/admin" : User.IsInRole("Barber") ? "/barber" : "/my-appointments";
    var portalName = User.IsInRole("Admin") ? "Admin Operations" : User.IsInRole("Barber") ? "Barber Station" : "My Appointments";
    var userName = User.Identity?.Name ?? "User";
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "U" : userName.Substring(0, 1).ToUpperInvariant();

    <div class="relative" id="user-profile-menu-container">
        <!-- Compact Avatar Trigger Button -->
        <button type="button"
                id="user-profile-btn"
                onclick="toggleProfileDropdown(event)"
                class="inline-flex items-center gap-2 py-1 pl-1 pr-2.5 rounded-full bg-slate-800/90 hover:bg-slate-800 text-slate-200 border border-slate-700/80 shadow-sm transition focus:outline-none focus:ring-2 focus:ring-amber-500/40 whitespace-nowrap"
                aria-expanded="false"
                aria-haspopup="true">
            <span class="w-6 h-6 rounded-full bg-amber-500 text-slate-950 font-bold font-serif text-[11px] flex items-center justify-center shrink-0 shadow-inner">
                @userInitial
            </span>
            <span class="text-xs font-bold text-amber-300 uppercase tracking-wider hidden sm:inline">
                @role
            </span>
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
        </button>

        <!-- Profile Dropdown Menu -->
        <div id="user-profile-dropdown"
             class="hidden absolute right-0 mt-2 w-64 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl py-2 z-[100] text-xs divide-y divide-slate-800/70">
            <!-- User Identity Section -->
            <div class="px-4 py-3">
                <p class="text-slate-400 text-[10px] uppercase font-bold tracking-wider">Signed In As</p>
                <p class="text-white font-bold text-sm truncate mt-0.5" title="@userName">@userName</p>
                <div class="mt-1.5 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>@roleDisplayName</span>
                </div>
            </div>

            <!-- Quick Navigation Links -->
            <div class="py-1">
                <a href="@portalLink" class="flex items-center gap-2.5 px-4 py-2 text-slate-200 hover:text-white hover:bg-slate-800/80 transition">
                    <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
                    <span>@portalName</span>
                </a>
                <a href="/" target="_blank" class="flex items-center gap-2.5 px-4 py-2 text-slate-200 hover:text-white hover:bg-slate-800/80 transition">
                    <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                    <span>View Shop Front</span>
                </a>
                @if (User.IsInRole("Barber"))
                {
                    <a href="/barber/account" class="flex items-center gap-2.5 px-4 py-2 text-slate-200 hover:text-white hover:bg-slate-800/80 transition">
                        <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                        <span>Account & Security</span>
                    </a>
                }
                else if (User.IsInRole("Customer"))
                {
                    <a href="/profile" class="flex items-center gap-2.5 px-4 py-2 text-slate-200 hover:text-white hover:bg-slate-800/80 transition">
                        <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                        <span>My Profile</span>
                    </a>
                }
            </div>

            <!-- Sign Out -->
            <div class="py-1">
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0"
                      data-confirm="Are you sure you want to end your BarberBook session and sign out?"
                      data-confirm-title="Confirm Sign Out"
                      data-confirm-button="Sign Out"
                      data-cancel-button="Stay Logged In"
                      data-confirm-destructive="true">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full text-left flex items-center gap-2.5 px-4 py-2 text-rose-400 hover:text-rose-300 hover:bg-slate-800/80 transition font-semibold">
                        <svg class="w-4 h-4 shrink-0 text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" /></svg>
                        <span>Sign Out</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <a href="/login" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-200 hover:text-white hover:bg-slate-800 transition whitespace-nowrap">
        Log In
    </a>
    <a href="/register" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 transition shadow-sm whitespace-nowrap">
        Register
    </a>
}
</div>

<script>
    function toggleProfileDropdown(e) {
        if (e) e.stopPropagation();
        const dropdown = document.getElementById('user-profile-dropdown');
        if (dropdown) {
            dropdown.classList.toggle('hidden');
        }
    }

    document.addEventListener('click', function (e) {
        const container = document.getElementById('user-profile-menu-container');
        const dropdown = document.getElementById('user-profile-dropdown');
        if (container && dropdown && !container.contains(e.target)) {
            dropdown.classList.add('hidden');
        }
    });
</script>

