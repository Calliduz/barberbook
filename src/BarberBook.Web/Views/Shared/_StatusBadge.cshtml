@model string
@{
    var status = (Model ?? string.Empty).ToLowerInvariant().Trim();
}

@if (status == "pending")
{
    <span class="badge-status badge-status-pending" role="status" aria-label="Status: Pending">
        <svg class="w-3 h-3 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Pending</span>
    </span>
}
else if (status == "confirmed")
{
    <span class="badge-status badge-status-confirmed" role="status" aria-label="Status: Confirmed">
        <svg class="w-3 h-3 text-blue-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Confirmed</span>
    </span>
}
else if (status == "completed")
{
    <span class="badge-status badge-status-completed" role="status" aria-label="Status: Completed">
        <svg class="w-3 h-3 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Completed</span>
    </span>
}
else if (status == "cancelled")
{
    <span class="badge-status badge-status-cancelled" role="status" aria-label="Status: Cancelled">
        <svg class="w-3 h-3 text-slate-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
        </svg>
        <span>Cancelled</span>
    </span>
}
else if (status == "rejected")
{
    <span class="badge-status badge-status-rejected" role="status" aria-label="Status: Rejected">
        <svg class="w-3 h-3 text-rose-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Rejected</span>
    </span>
}
else
{
    <span class="badge-status badge-status-cancelled" role="status">
        <span>@(string.IsNullOrEmpty(Model) ? "Unknown" : Model)</span>
    </span>
}

