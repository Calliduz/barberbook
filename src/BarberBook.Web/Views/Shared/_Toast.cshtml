@using System.Text.Encodings.Web
@* Global Accessible Toast Notification Component (P18, EO-4, BR-13) *@
<div id="barberbook-toast-container" 
     class="fixed bottom-5 right-5 z-[10000] flex flex-col gap-2.5 max-w-sm w-[calc(100vw-2.5rem)] pointer-events-none"
     aria-live="polite" 
     aria-atomic="true">
</div>

<script>
    (function () {
        'use strict';

        window.showToast = function (message, type = 'info', durationMs = 4500) {
            const container = document.getElementById('barberbook-toast-container');
            if (!container || !message) return null;

            const toast = document.createElement('div');
            toast.className = 'pointer-events-auto relative overflow-hidden flex items-start justify-between gap-3 p-4 rounded-2xl shadow-2xl border text-xs font-semibold transform transition-all duration-300 translate-y-3 opacity-0 backdrop-blur-md';

            let iconSvg = '';
            let progressBarColor = 'bg-amber-500';

            switch (type) {
                case 'success':
                    toast.classList.add('bg-emerald-50', 'dark:bg-emerald-950/90', 'border-emerald-300', 'dark:border-emerald-700', 'text-emerald-900', 'dark:text-emerald-100');
                    iconSvg = `<svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>`;
                    progressBarColor = 'bg-emerald-500 dark:bg-emerald-400';
                    break;
                case 'error':
                    toast.classList.add('bg-rose-50', 'dark:bg-rose-950/90', 'border-rose-300', 'dark:border-rose-700', 'text-rose-900', 'dark:text-rose-100');
                    iconSvg = `<svg class="w-4 h-4 text-rose-600 dark:text-rose-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>`;
                    progressBarColor = 'bg-rose-500 dark:bg-rose-400';
                    break;
                case 'warning':
                    toast.classList.add('bg-amber-50', 'dark:bg-amber-950/90', 'border-amber-300', 'dark:border-amber-700', 'text-amber-900', 'dark:text-amber-100');
                    iconSvg = `<svg class="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`;
                    progressBarColor = 'bg-amber-500 dark:bg-amber-400';
                    break;
                default:
                    toast.classList.add('bg-slate-900', 'dark:bg-slate-900/95', 'border-slate-700', 'dark:border-amber-500/40', 'text-slate-100');
                    iconSvg = `<div class="barber-pole-icon shrink-0 mt-0.5" style="height: 16px; width: 8px;"></div>`;
                    progressBarColor = 'bg-amber-500';
                    break;
            }

            toast.innerHTML = `
                <div class="flex items-start gap-2.5 flex-1 pr-1">
                    ${iconSvg}
                    <div class="flex-1 leading-snug break-words">${message}</div>
                </div>
                <button type="button" aria-label="Close notification" class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 p-0.5 font-bold text-base leading-none focus:outline-none focus:ring-1 focus:ring-amber-500 rounded transition shrink-0">
                    &times;
                </button>
                <div class="toast-progress absolute bottom-0 left-0 h-1 ${progressBarColor} transition-all" style="width: 100%;"></div>
            `;

            const closeBtn = toast.querySelector('button');
            closeBtn.onclick = () => dismissToast(toast);

            container.appendChild(toast);

            // Animate in
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-3', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
            });

            // Progress bar and auto-dismiss
            if (durationMs > 0) {
                const progressBar = toast.querySelector('.toast-progress');
                let startTime = Date.now();
                let remaining = durationMs;
                let timerId = null;
                let isPaused = false;

                const updateProgress = () => {
                    if (!isPaused) {
                        const elapsed = Date.now() - startTime;
                        const percentage = Math.max(0, 100 - (elapsed / durationMs) * 100);
                        if (progressBar) progressBar.style.width = percentage + '%';
                        if (elapsed >= durationMs) {
                            dismissToast(toast);
                            return;
                        }
                    }
                    timerId = requestAnimationFrame(updateProgress);
                };

                timerId = requestAnimationFrame(updateProgress);

                // Pause on hover
                toast.addEventListener('mouseenter', () => {
                    isPaused = true;
                });
                toast.addEventListener('mouseleave', () => {
                    isPaused = false;
                });
            }

            return toast;
        };

        window.dismissToast = function (toast) {
            if (!toast || !toast.parentElement) return;
            toast.classList.add('opacity-0', 'translate-y-3', 'scale-95');
            setTimeout(() => {
                if (toast && toast.parentElement) {
                    toast.remove();
                }
            }, 300);
        };

        // Modern developer API
        window.toast = {
            success: (msg, dur) => window.showToast(msg, 'success', dur),
            error: (msg, dur) => window.showToast(msg, 'error', dur),
            warning: (msg, dur) => window.showToast(msg, 'warning', dur),
            info: (msg, dur) => window.showToast(msg, 'info', dur)
        };
    })();
</script>

@* Auto-trigger toasts from server TempData *@
@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            window.showToast('@Html.Raw(JavaScriptEncoder.Default.Encode(TempData["SuccessMessage"]!.ToString()!))', 'success');
        });
    </script>
}
