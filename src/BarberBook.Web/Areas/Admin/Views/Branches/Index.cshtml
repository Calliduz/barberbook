@model BarberBook.Web.Models.Admin.BranchListViewModel
@{
    ViewData["Title"] = "Branches";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                <span class="text-[11px] font-bold uppercase tracking-widest text-amber-700 dark:text-amber-400">Shop Infrastructure</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 dark:text-slate-100 tracking-tight">Branches Management</h1>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Manage physical barbershop locations, operational schedules, assigned barbers, and branch-level booking visibility.</p>
        </div>
        <div class="mt-4 sm:mt-0">
            <button type="button" onclick="openCreateModal()" class="inline-flex items-center justify-center h-[38px] rounded-xl bg-amber-500 px-4 text-xs font-bold text-slate-950 shadow-sm hover:bg-amber-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500 transition whitespace-nowrap active:scale-95">
                <svg class="-ml-1 mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Add New Branch
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 p-4 border border-emerald-200 dark:border-emerald-800/60">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-emerald-500 dark:text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-emerald-800 dark:text-emerald-300">@TempData["SuccessMessage"]</p>
                </div>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-xl bg-rose-50 dark:bg-rose-950/40 p-4 border border-rose-200 dark:border-rose-800/60">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-rose-500 dark:text-rose-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-rose-800 dark:text-rose-300">@TempData["ErrorMessage"]</p>
                </div>
            </div>
        </div>
    }

    <!-- Metric Overview Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Locations</span>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="text-2xl font-bold font-sans text-slate-900 dark:text-slate-100 tabular-nums">@Model.TotalCount</span>
                <span class="text-xs text-slate-400 dark:text-slate-500">registered</span>
            </div>
            <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">Physical shop footprint</p>
        </div>
        <div class="rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Active Operations</span>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="text-2xl font-bold font-sans text-emerald-600 dark:text-emerald-400 tabular-nums">@Model.TotalActiveCount</span>
                <span class="text-xs text-slate-400 dark:text-slate-500">open branches</span>
            </div>
            <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">Accepting appointments</p>
        </div>
        <div class="rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-xs">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Assigned Master Barbers</span>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="text-2xl font-bold font-sans text-amber-600 dark:text-amber-400 tabular-nums">@Model.TotalAssignedBarbersCount</span>
                <span class="text-xs text-slate-400 dark:text-slate-500">stationed</span>
            </div>
            <p class="mt-1 text-[11px] text-slate-500 dark:text-slate-400">Active roster capacity</p>
        </div>
    </div>

    <!-- Search & Filters -->
    <article class="card bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200/90 dark:border-slate-800 p-3.5">
        <form method="get" action="/admin/branches" class="flex flex-col sm:flex-row gap-3 items-center">
            <div class="w-full sm:w-80 relative">
                <input type="text" name="q" value="@Model.SearchQuery" placeholder="Search branch name, address, phone..." onkeydown="if(event.key==='Enter') this.form.submit()" class="filter-control w-full pl-9 pr-4 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 py-2 focus:border-amber-500 focus:ring-1 focus:ring-amber-500" />
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <label for="statusFilter" class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 whitespace-nowrap">Status:</label>
                <select id="statusFilter" name="status" onchange="this.form.submit()" class="filter-control text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 py-2 px-3 focus:border-amber-500 focus:ring-1 focus:ring-amber-500">
                    <option value="all" selected="@(Model.StatusFilter == "all")">All Statuses</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active Only</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive Only</option>
                </select>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || Model.StatusFilter != "all")
                {
                    <a href="/admin/branches" class="h-[38px] px-3 rounded-lg text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 border border-slate-200 dark:border-slate-700 transition flex items-center whitespace-nowrap active:scale-95">
                        Reset
                    </a>
                }
            </div>
        </form>
    </article>

    <!-- Branches Table & Mobile Cards -->
    <article class="card bg-white dark:bg-slate-900 rounded-3xl shadow-sm border border-slate-200/90 dark:border-slate-800 overflow-hidden">
        <!-- Desktop Table View -->
        <div class="hidden sm:block overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-100 dark:divide-slate-800 text-left text-xs">
                <thead class="bg-slate-50/90 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 font-bold uppercase tracking-wider">
                    <tr>
                        <th class="py-3.5 pl-6 pr-3 whitespace-nowrap">Branch Location</th>
                        <th class="px-3 py-3.5">Address</th>
                        <th class="px-3 py-3.5 whitespace-nowrap">Contact Phone</th>
                        <th class="px-3 py-3.5 whitespace-nowrap">Hours</th>
                        <th class="px-3 py-3.5 text-center whitespace-nowrap">Active Barbers</th>
                        <th class="px-3 py-3.5 text-center whitespace-nowrap">Completed Cuts</th>
                        <th class="px-3 py-3.5 whitespace-nowrap">Status</th>
                        <th class="py-3.5 pl-3 pr-6 text-right whitespace-nowrap">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="py-12 text-center text-slate-400 dark:text-slate-500">
                                No branches found matching the criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var branch in Model.Items)
                    {
                        <tr class="hover:bg-slate-50/70 dark:hover:bg-slate-800/50 transition">
                            <td class="py-4 pl-6 pr-3">
                                <div class="font-bold text-slate-900 dark:text-slate-100 text-sm">@branch.Name</div>
                                <div class="text-[11px] text-slate-400 dark:text-slate-500">Branch ID: #@branch.Id</div>
                            </td>
                            <td class="px-3 py-4 text-slate-600 dark:text-slate-300">@branch.Address</td>
                            <td class="px-3 py-4 text-slate-600 dark:text-slate-300">@(string.IsNullOrWhiteSpace(branch.PhoneNumber) ? "-" : branch.PhoneNumber)</td>
                            <td class="px-3 py-4 text-slate-600 dark:text-slate-300 font-mono text-[11px]">@branch.OpeningTime - @branch.ClosingTime</td>
                            <td class="px-3 py-4 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/60">
                                    @branch.BarbersCount Barbers
                                </span>
                            </td>
                            <td class="px-3 py-4 text-center">
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
                                    @branch.CompletedAppointmentsCount Done
                                </span>
                            </td>
                            <td class="px-3 py-4">
                                @if (branch.IsActive)
                                {
                                    <span class="inline-flex items-center rounded-full bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-rose-50 dark:bg-rose-950/40 px-2.5 py-1 text-xs font-semibold text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800/60">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="py-3.5 pl-3 pr-6 text-right whitespace-nowrap">
                                <div class="inline-flex items-center gap-1.5 justify-end">
                                    <button type="button" onclick="openStaffModal(@branch.Id, '@Html.Raw(Html.Encode(branch.Name))')" class="inline-flex items-center h-7 px-2.5 rounded-lg text-xs font-bold text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/50 hover:bg-indigo-100 dark:hover:bg-indigo-900/60 border border-indigo-200 dark:border-indigo-800/60 transition active:scale-95 shadow-2xs">
                                        Arrange Barbers
                                    </button>
                                    <button type="button" onclick="openEditModal(@branch.Id, '@Html.Raw(Html.Encode(branch.Name))', '@Html.Raw(Html.Encode(branch.Address))', '@Html.Raw(Html.Encode(branch.PhoneNumber ?? ""))', '@branch.OpeningTime', '@branch.ClosingTime')" class="inline-flex items-center h-7 px-2.5 rounded-lg text-xs font-bold text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/50 hover:bg-amber-100 dark:hover:bg-amber-900/60 border border-amber-200 dark:border-amber-800/60 transition active:scale-95 shadow-2xs">
                                        Edit
                                    </button>
                                    <button type="button" onclick="confirmToggleStatus(@branch.Id, '@Html.Raw(Html.Encode(branch.Name))', @(branch.IsActive ? "true" : "false"))" class="inline-flex items-center h-7 px-2.5 rounded-lg text-xs font-bold @(branch.IsActive ? "text-rose-700 dark:text-rose-300 bg-rose-50 dark:bg-rose-950/50 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200 dark:border-rose-800/60" : "text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/50 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 border border-emerald-200 dark:border-emerald-800/60") transition active:scale-95 shadow-2xs">
                                        @(branch.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Stacked Card View -->
        <div class="sm:hidden divide-y divide-slate-100 dark:divide-slate-800">
            @if (!Model.Items.Any())
            {
                <div class="py-12 text-center text-slate-400 dark:text-slate-500 text-xs">
                    No branches found matching the criteria.
                </div>
            }
            @foreach (var branch in Model.Items)
            {
                <div class="p-4 space-y-3 hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                    <div class="flex items-start justify-between">
                        <div>
                            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-sm">@branch.Name</h3>
                            <p class="text-[11px] text-slate-400 dark:text-slate-500">Branch ID: #@branch.Id</p>
                        </div>
                        @if (branch.IsActive)
                        {
                            <span class="inline-flex items-center rounded-full bg-emerald-50 dark:bg-emerald-950/40 px-2 py-0.5 text-[10px] font-bold text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-full bg-rose-50 dark:bg-rose-950/40 px-2 py-0.5 text-[10px] font-bold text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800/60">
                                Inactive
                            </span>
                        }
                    </div>

                    <p class="text-xs text-slate-600 dark:text-slate-300">@branch.Address</p>

                    <div class="grid grid-cols-2 gap-2 text-[11px] text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-100 dark:border-slate-800">
                        <div>
                            <span class="block text-slate-400 dark:text-slate-500 uppercase text-[9px] font-bold">Hours</span>
                            <span class="font-mono text-slate-800 dark:text-slate-200">@branch.OpeningTime - @branch.ClosingTime</span>
                        </div>
                        <div>
                            <span class="block text-slate-400 dark:text-slate-500 uppercase text-[9px] font-bold">Phone</span>
                            <span class="text-slate-800 dark:text-slate-200">@(string.IsNullOrWhiteSpace(branch.PhoneNumber) ? "-" : branch.PhoneNumber)</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 pt-1">
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/60">
                            @branch.BarbersCount Barbers
                        </span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
                            @branch.CompletedAppointmentsCount Done
                        </span>
                    </div>

                    <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-end gap-2 text-xs flex-wrap">
                        <button type="button" onclick="openStaffModal(@branch.Id, '@Html.Raw(Html.Encode(branch.Name))')" class="px-3 py-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-950/40 text-indigo-900 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/60 font-bold hover:bg-indigo-100 dark:hover:bg-indigo-900/60 transition active:scale-95">
                            Arrange Barbers
                        </button>
                        <button type="button" onclick="openEditModal(@branch.Id, '@Html.Raw(Html.Encode(branch.Name))', '@Html.Raw(Html.Encode(branch.Address))', '@Html.Raw(Html.Encode(branch.PhoneNumber ?? ""))', '@branch.OpeningTime', '@branch.ClosingTime')" class="px-3 py-1.5 rounded-lg bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-300 border border-amber-200 dark:border-amber-800/60 font-bold hover:bg-amber-100 dark:hover:bg-amber-900/60 transition active:scale-95">
                            Edit
                        </button>
                        <button type="button" onclick="confirmToggleStatus(@branch.Id, '@Html.Raw(Html.Encode(branch.Name))', @(branch.IsActive ? "true" : "false"))" class="px-3 py-1.5 rounded-lg @(branch.IsActive ? "bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800/60" : "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60") font-bold transition active:scale-95">
                            @(branch.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex flex-col sm:flex-row items-center justify-between border-t border-slate-100 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-850 px-4 py-3 sm:px-6 gap-3">
                <div class="text-xs text-slate-500 dark:text-slate-400">
                    Showing <span class="font-bold text-slate-800 dark:text-slate-200">@((Model.Page - 1) * Model.PageSize + 1)</span> to
                    <span class="font-bold text-slate-800 dark:text-slate-200">@Math.Min(Model.Page * Model.PageSize, Model.TotalCount)</span> of
                    <span class="font-bold text-slate-800 dark:text-slate-200">@Model.TotalCount</span> branches
                </div>
                <div class="inline-flex items-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-1 shadow-2xs space-x-1 text-xs">
                    @if (Model.Page > 1)
                    {
                        <a href="?page=@(Model.Page - 1)&q=@Model.SearchQuery&status=@Model.StatusFilter" class="px-3 py-1 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 font-semibold transition active:scale-95">&larr; Prev</a>
                    }
                    else
                    {
                        <span class="px-3 py-1 text-slate-300 dark:text-slate-600 font-semibold cursor-not-allowed opacity-50">&larr; Prev</span>
                    }

                    <span class="px-3 py-1 rounded-lg bg-amber-500 text-slate-950 font-bold shadow-xs">@Model.Page</span>

                    @if (Model.Page < Model.TotalPages)
                    {
                        <a href="?page=@(Model.Page + 1)&q=@Model.SearchQuery&status=@Model.StatusFilter" class="px-3 py-1 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 font-semibold transition active:scale-95">Next &rarr;</a>
                    }
                    else
                    {
                        <span class="px-3 py-1 text-slate-300 dark:text-slate-600 font-semibold cursor-not-allowed opacity-50">Next &rarr;</span>
                    }
                </div>
            </div>
        }
    </article>
</div>

<!-- Create Branch Modal -->
<dialog id="createModal" closedby="any" class="hidden m-auto rounded-2xl sm:rounded-3xl p-0 bg-transparent backdrop:bg-slate-950/70 backdrop:backdrop-blur-xs max-w-lg w-[calc(100%-2rem)] shadow-2xl focus:outline-none">
    <div class="modal-dialog bg-white dark:bg-slate-900 rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-100">
        <div class="flex justify-between items-center mb-5 pb-3 border-b border-slate-100 dark:border-slate-800">
            <div>
                <h3 class="text-lg font-serif font-bold text-slate-900 dark:text-slate-100">Add New Branch Location</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Register a physical barbershop workstation location</p>
            </div>
            <button type="button" onclick="closeModal('createModal')" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95" aria-label="Close dialog">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form method="post" action="/admin/branches" class="modal-body space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Branch Name *</label>
                <input type="text" name="Name" required class="modal-input mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" placeholder="e.g. Quezon City Fairview Branch" />
            </div>
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Street Address *</label>
                <input type="text" name="Address" required class="modal-input mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" placeholder="e.g. Unit 4, Regalado Highway, Fairview, QC" />
            </div>
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Contact Phone Number</label>
                <input type="text" name="PhoneNumber" class="modal-input mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" placeholder="e.g. 0917-555-1234" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="min-w-0">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Opening Time *</label>
                    <input type="time" name="OpeningTime" value="09:00" required class="modal-input mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" />
                </div>
                <div class="min-w-0">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Closing Time *</label>
                    <input type="time" name="ClosingTime" value="18:00" required class="modal-input mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" />
                </div>
            </div>
            <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeModal('createModal')" class="rounded-xl bg-slate-100 dark:bg-slate-800 px-4 py-2 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition active:scale-95">Cancel</button>
                <button type="submit" class="rounded-xl bg-amber-500 px-4 py-2 text-xs font-bold text-slate-950 hover:bg-amber-400 transition shadow-sm active:scale-95">Save Branch</button>
            </div>
        </form>
    </div>
</dialog>

<!-- Edit Branch Modal -->
<dialog id="editModal" closedby="any" class="hidden m-auto rounded-2xl sm:rounded-3xl p-0 bg-transparent backdrop:bg-slate-950/70 backdrop:backdrop-blur-xs max-w-lg w-[calc(100%-2rem)] shadow-2xl focus:outline-none">
    <div class="modal-dialog bg-white dark:bg-slate-900 rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-100">
        <div class="flex justify-between items-center mb-5 pb-3 border-b border-slate-100 dark:border-slate-800">
            <div>
                <h3 class="text-lg font-serif font-bold text-slate-900 dark:text-slate-100">Edit Branch Details</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Update operational parameters and contact information</p>
            </div>
            <button type="button" onclick="closeModal('editModal')" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95" aria-label="Close dialog">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form id="editBranchForm" method="post" action="" class="modal-body space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Branch Name *</label>
                <input type="text" id="editName" name="Name" required placeholder="e.g. Quezon City Fairview Branch" class="modal-input mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" />
            </div>
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Street Address *</label>
                <input type="text" id="editAddress" name="Address" required placeholder="e.g. Unit 4, Regalado Highway, Fairview, QC" class="modal-input mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" />
            </div>
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Contact Phone Number</label>
                <input type="text" id="editPhoneNumber" name="PhoneNumber" placeholder="e.g. 0917-555-1234" class="modal-input mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="min-w-0">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Opening Time *</label>
                    <input type="time" id="editOpeningTime" name="OpeningTime" required class="modal-input mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" />
                </div>
                <div class="min-w-0">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Closing Time *</label>
                    <input type="time" id="editClosingTime" name="ClosingTime" required class="modal-input mt-1 w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2.5 text-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" />
                </div>
            </div>
            <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeModal('editModal')" class="rounded-xl bg-slate-100 dark:bg-slate-800 px-4 py-2 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition active:scale-95">Cancel</button>
                <button type="submit" class="rounded-xl bg-amber-500 px-4 py-2 text-xs font-bold text-slate-950 hover:bg-amber-400 transition shadow-sm active:scale-95">Save Changes</button>
            </div>
        </form>
    </div>
</dialog>

<!-- Arrange Branch Barbers Modal -->
<dialog id="staffModal" closedby="any" class="hidden m-auto rounded-2xl sm:rounded-3xl p-0 bg-transparent backdrop:bg-slate-950/70 backdrop:backdrop-blur-xs max-w-lg w-[calc(100%-2rem)] shadow-2xl focus:outline-none">
    <div class="modal-dialog bg-white dark:bg-slate-900 rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-100">
        <div class="flex justify-between items-center mb-4 pb-3 border-b border-slate-100 dark:border-slate-800">
            <div>
                <h3 id="staffModalTitle" class="text-lg font-serif font-bold text-slate-900 dark:text-slate-100">Arrange Shop Barbers</h3>
                <p id="staffModalSubtitle" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Select barbers assigned to work at this branch.</p>
            </div>
            <button type="button" onclick="closeModal('staffModal')" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition p-1 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95" aria-label="Close dialog">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <form id="staffModalForm" method="post" action="" class="space-y-4">
            @Html.AntiForgeryToken()
            <div id="staffModalLoading" class="py-8 text-center text-slate-400 dark:text-slate-500 text-xs">
                <div class="inline-block w-5 h-5 border-2 border-amber-500/40 border-t-amber-500 rounded-full animate-spin mb-2"></div>
                <p>Loading shop staff...</p>
            </div>

            <div id="staffBarbersList" class="hidden space-y-2 max-h-72 overflow-y-auto pr-1">
                <!-- Barbers dynamic list -->
            </div>

            <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeModal('staffModal')" class="rounded-xl bg-slate-100 dark:bg-slate-800 px-4 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition active:scale-95">Cancel</button>
                <button type="submit" id="staffSaveBtn" class="rounded-xl bg-amber-500 px-4 py-2 text-xs font-bold text-slate-950 hover:bg-amber-400 transition shadow-sm active:scale-95">Save Arrangement</button>
            </div>
        </form>
    </div>
</dialog>

<script>
    async function openStaffModal(id, branchName) {
        document.getElementById('staffModalTitle').innerText = 'Arrange Barbers — ' + branchName;
        document.getElementById('staffModalForm').action = '/admin/branches/' + id + '/assign-barbers';
        const loading = document.getElementById('staffModalLoading');
        const list = document.getElementById('staffBarbersList');
        loading.classList.remove('hidden');
        list.classList.add('hidden');
        list.innerHTML = '';
        
        const modal = document.getElementById('staffModal');
        modal.classList.remove('hidden');
        if (typeof modal.showModal === 'function') {
            modal.showModal();
        }

        try {
            const resp = await fetch('/admin/branches/' + id + '/barbers');
            if (!resp.ok) {
                loading.innerHTML = '<p class="text-rose-500 py-4">Failed to load barbers. Please try again.</p>';
                return;
            }
            const data = await resp.json();
            loading.classList.add('hidden');
            list.classList.remove('hidden');

            if (!data.barbers || data.barbers.length === 0) {
                list.innerHTML = '<p class="text-xs text-slate-400 dark:text-slate-500 py-4 text-center">No active barbers found in the system.</p>';
                return;
            }

            data.barbers.forEach(b => {
                const label = document.createElement('label');
                label.className = 'flex items-center justify-between p-3 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-amber-500/60 hover:bg-amber-50/30 dark:hover:bg-amber-950/20 cursor-pointer transition';
                label.innerHTML = `
                    <div class="flex items-center gap-3">
                        <input type="checkbox" name="BarberIds" value="${b.barberId}" ${b.isAssignedToThisBranch ? 'checked' : ''} class="w-4 h-4 rounded text-amber-600 focus:ring-amber-500 border-slate-300 dark:border-slate-700 dark:bg-slate-800" />
                        <div>
                            <div class="text-xs font-bold text-slate-900 dark:text-slate-100">${b.displayName}</div>
                            <div class="text-[11px] text-slate-500 dark:text-slate-400">${b.specialties || 'Master Barber'}</div>
                        </div>
                    </div>
                    <div>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold ${b.isAssignedToThisBranch ? 'bg-amber-100 dark:bg-amber-950/50 text-amber-800 dark:text-amber-300' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400'}">
                            ${b.isAssignedToThisBranch ? 'This Branch' : (b.currentBranchName || 'Unassigned')}
                        </span>
                    </div>
                `;
                list.appendChild(label);
            });
        } catch (e) {
            loading.innerHTML = '<p class="text-rose-500 py-4">Error loading barbers.</p>';
        }
    }

    function openCreateModal() {
        const modal = document.getElementById('createModal');
        modal.classList.remove('hidden');
        if (typeof modal.showModal === 'function') {
            modal.showModal();
        }
    }

    function openEditModal(id, name, address, phone, openTime, closeTime) {
        document.getElementById('editBranchForm').action = '/admin/branches/' + id + '/edit';
        document.getElementById('editName').value = name;
        document.getElementById('editAddress').value = address;
        document.getElementById('editPhoneNumber').value = phone;
        document.getElementById('editOpeningTime').value = openTime;
        document.getElementById('editClosingTime').value = closeTime;
        const modal = document.getElementById('editModal');
        modal.classList.remove('hidden');
        if (typeof modal.showModal === 'function') {
            modal.showModal();
        }
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        if (modal) {
            if (typeof modal.close === 'function' && modal.open) {
                modal.close();
            }
            modal.classList.add('hidden');
        }
    }

    // Modern light-dismiss & cancel handlers
    ['createModal', 'editModal', 'staffModal'].forEach(id => {
        const modal = document.getElementById(id);
        if (!modal) return;
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal(id);
            }
        });
        modal.addEventListener('cancel', (e) => {
            e.preventDefault();
            closeModal(id);
        });
    });

    async function confirmToggleStatus(id, name, isActive) {
        const title = isActive ? 'Deactivate Branch' : 'Activate Branch';
        const msg = isActive
            ? 'Are you sure you want to deactivate ' + name + '? New customer bookings will be paused for this branch, but all historical appointments and barber associations remain intact.'
            : 'Are you sure you want to activate ' + name + '? The branch will be visible for customer bookings.';

        const confirmed = await window.showConfirmDialog({
            title: title,
            message: msg,
            confirmText: isActive ? 'Deactivate' : 'Activate',
            isDestructive: isActive
        });

        if (confirmed) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/admin/branches/' + id + '/toggle-status';
            const csrf = document.querySelector('input[name="__RequestVerificationToken"]');
            if (csrf) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = '__RequestVerificationToken';
                input.value = csrf.value;
                form.appendChild(input);
            }
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
