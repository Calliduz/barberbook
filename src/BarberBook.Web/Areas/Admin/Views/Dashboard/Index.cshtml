@model BarberBook.Web.Models.Admin.AdminDashboardViewModel
@using BarberBook.Data.Enums
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="space-y-8">
    <!-- Header with Vintage Badge -->
    <div class="sm:flex sm:items-center sm:justify-between pb-6 border-b border-slate-200">
        <div>
            <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
                <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
                <span>BARBERBOOK MANILA · EXECUTIVE DASHBOARD</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Shop Operations & Analytics</h1>
            <p class="mt-1 text-sm text-slate-600 font-sans">Live performance metrics, pending booking reviews, revenue journals, and master barber schedules.</p>
        </div>
        <div class="mt-4 sm:mt-0 flex flex-wrap gap-2.5">
            <a href="/admin/appointments" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-neutral-950 transition shadow-md shadow-amber-500/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                <span>Manage Bookings</span>
            </a>
            <a href="/admin/reports" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-100 transition border border-slate-700">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                <span>Sales Reports</span>
            </a>
        </div>
    </div>

    <!-- Quick Links Bar (P13 Requirement: quick links to Reports, Appointments, Barbers, Services, Customers) -->
    <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-3.5 flex flex-wrap items-center gap-2 sm:gap-3">
        <span class="text-xs uppercase font-extrabold text-slate-400 px-2 tracking-wider">Quick Links:</span>
        <a href="/admin/reports" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition">
            📊 Sales Reports
        </a>
        <a href="/admin/appointments" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition">
            📅 Appointments
        </a>
        <a href="/admin/barbers" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition">
            ✂️ Master Barbers
        </a>
        <a href="/admin/services" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition">
            💈 Services Menu
        </a>
        <a href="/admin/customers" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition">
            👤 Customer Records
        </a>
        <a href="/admin/schedules" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition">
            ⏰ Shop Hours
        </a>
    </div>

    <!-- Stat Cards Grid (P13: Today's sales, Month's sales, Today's schedule, Pending approvals) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Today's Completed Sales (BR-07, RP-1, HW-2, INV-06) -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Today's Sales</span>
                <span class="p-2 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-emerald-700">@Model.FormattedTodayCompletedSales</span>
            </div>
            <div class="mt-2 text-xs text-slate-500 space-y-0.5">
                <p>@Model.TodayCounts.Completed completed visits settled</p>
                @if (Model.TodayProductSales > 0)
                {
                    <p class="text-[11px] font-semibold text-amber-700">
                        + @Model.FormattedTodayProductSales products &bull; Grand: @Model.FormattedTodayGrandTotal
                    </p>
                }
            </div>
        </div>

        <!-- Month-to-Date Revenue (RP-2, HW-2, INV-06) -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Month-to-Date</span>
                <span class="p-2 rounded-xl bg-slate-900 text-amber-300 border border-amber-500/30">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-slate-900">@Model.FormattedMonthToDateCompletedSales</span>
            </div>
            <div class="mt-2 text-xs text-slate-500 space-y-0.5">
                <p>Active month services journal</p>
                @if (Model.MonthToDateProductSales > 0)
                {
                    <p class="text-[11px] font-semibold text-amber-700">
                        + @Model.FormattedMonthToDateProductSales products &bull; Grand: @Model.FormattedMonthToDateGrandTotal
                    </p>
                }
            </div>
        </div>

        <!-- Pending Bookings (Actionable) -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Pending Bookings</span>
                <span class="p-2 rounded-xl bg-amber-50 text-amber-700 border border-amber-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-amber-600">@Model.PendingBookings.Count</span>
                <span class="text-xs text-slate-500 font-medium">needs action</span>
            </div>
            <p class="mt-2 text-xs text-slate-500">Requires inline confirm or reject</p>
        </div>

        <!-- Today's Total Appointments -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Today's Total</span>
                <span class="p-2 rounded-xl bg-slate-100 text-slate-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-slate-900">@Model.TodayCounts.Total</span>
                <span class="text-xs text-slate-500 font-medium">appointments</span>
            </div>
            <p class="mt-2 text-xs text-slate-500">@Model.TodayCounts.Confirmed confirmed &bull; @Model.TodayCounts.Pending pending</p>
        </div>
    </div>

    <!-- P13 Requirement: "Needs Action" list with inline Confirm and Reject buttons -->
    <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div>
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                    <h2 class="text-xl font-serif font-bold text-slate-900 tracking-tight">Needs Action &mdash; Pending Bookings</h2>
                </div>
                <p class="text-xs text-slate-500 mt-1">Oldest first (up to 10). Review client requests and confirm or reject in one click through the appointment state machine (P09, BF-4, AF-6).</p>
            </div>
            <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-100 text-amber-800 border border-amber-300">
                @Model.PendingBookings.Count pending
            </span>
        </div>

        @if (!Model.PendingBookings.Any())
        {
            <div class="py-12 text-center text-slate-400 text-sm">
                <div class="inline-flex p-3 rounded-full bg-emerald-50 text-emerald-600 mb-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                </div>
                <p class="font-bold text-slate-700">All caught up! No pending bookings awaiting review.</p>
                <p class="text-xs text-slate-400 mt-1">New online bookings will appear here automatically.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-6">Reference</th>
                            <th class="py-3 px-6">Customer</th>
                            <th class="py-3 px-6">Scheduled For</th>
                            <th class="py-3 px-6">Barber</th>
                            <th class="py-3 px-6">Service</th>
                            <th class="py-3 px-6">Price</th>
                            <th class="py-3 px-6 text-right">Inline Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var pending in Model.PendingBookings)
                        {
                            <tr class="hover:bg-amber-50/20 transition">
                                <td class="py-4 px-6 font-mono font-bold text-xs text-amber-800 whitespace-nowrap">
                                    @pending.ReferenceCode
                                    <span class="block text-[10px] font-sans text-slate-400 font-normal">Booked: @pending.CreatedAtFormatted</span>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="font-bold text-slate-900">@pending.CustomerName</div>
                                    @if (!string.IsNullOrWhiteSpace(pending.CustomerPhone))
                                    {
                                        <div class="text-xs text-slate-500">@pending.CustomerPhone</div>
                                    }
                                </td>
                                <td class="py-4 px-6 whitespace-nowrap">
                                    <div class="font-bold text-slate-900">@pending.ScheduledDateFormatted</div>
                                    <div class="text-xs font-semibold text-amber-800">@pending.ScheduledTime</div>
                                </td>
                                <td class="py-4 px-6 font-medium text-slate-700">
                                    @pending.BarberName
                                </td>
                                <td class="py-4 px-6 text-slate-600">
                                    <div class="font-medium text-slate-800">@pending.ServiceName</div>
                                    @if (!string.IsNullOrWhiteSpace(pending.Notes))
                                    {
                                        <div class="text-xs text-slate-400 italic">"@pending.Notes"</div>
                                    }
                                </td>
                                <td class="py-4 px-6 font-serif font-bold text-slate-900 whitespace-nowrap">
                                    @pending.FormattedPrice
                                </td>
                                <td class="py-4 px-6 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-2">
                                        <!-- Inline Confirm Button -->
                                        <form method="post" action="/admin/appointments/@pending.Id/status" class="inline">
                                            <input type="hidden" name="to" value="confirmed" />
                                            <input type="hidden" name="note" value="Confirmed via admin dashboard one-click action" />
                                            <button type="submit"
                                                    class="px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm transition flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                                                <span>Confirm</span>
                                            </button>
                                        </form>

                                        <!-- Inline Reject Button -->
                                        <form method="post" action="/admin/appointments/@pending.Id/status" class="inline" onsubmit="return confirm('Reject booking #@pending.ReferenceCode?');">
                                            <input type="hidden" name="to" value="rejected" />
                                            <input type="hidden" name="note" value="Rejected via admin dashboard one-click action" />
                                            <button type="submit"
                                                    class="px-3 py-1.5 rounded-xl text-xs font-bold bg-rose-600 hover:bg-rose-500 text-white shadow-sm transition flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                                <span>Reject</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- P13 Requirement: Today's schedule by barber -->
    <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <div>
                <h2 class="text-xl font-serif font-bold text-slate-900 tracking-tight">Today's Schedule by Barber</h2>
                <p class="text-xs text-slate-500 mt-0.5">Real-time workstation appointments scheduled for today across all master barbers (EO-3)</p>
            </div>
            <a href="/admin/appointments" class="text-xs font-bold text-amber-700 hover:text-amber-800">Full Schedule →</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            @foreach (var barberCol in Model.TodayAppointmentsByBarber)
            {
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-200 pb-2.5">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-full bg-slate-900 text-amber-400 font-serif font-bold flex items-center justify-center text-xs">
                                @barberCol.BarberName[0]
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-900 text-sm">@barberCol.BarberName</h3>
                                <span class="text-[10px] text-slate-500 block">@barberCol.Specialty</span>
                            </div>
                        </div>
                        <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-white border border-slate-200 text-slate-700">
                            @barberCol.Appointments.Count
                        </span>
                    </div>

                    @if (!barberCol.Appointments.Any())
                    {
                        <div class="py-8 text-center text-slate-400 text-xs">
                            No appointments booked for today.
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var app in barberCol.Appointments)
                            {
                                var badge = app.Status switch
                                {
                                    AppointmentStatus.Pending => "bg-amber-100 text-amber-800 border-amber-300",
                                    AppointmentStatus.Confirmed => "bg-blue-100 text-blue-800 border-blue-300",
                                    AppointmentStatus.Completed => "bg-emerald-100 text-emerald-800 border-emerald-300",
                                    AppointmentStatus.Cancelled => "bg-slate-100 text-slate-600 border-slate-300",
                                    AppointmentStatus.Rejected => "bg-rose-100 text-rose-800 border-rose-300",
                                    _ => "bg-slate-100 text-slate-700"
                                };

                                <div class="p-3 rounded-xl bg-white border border-slate-200 shadow-2xs hover:border-amber-400 transition">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs font-bold text-amber-800">@app.TimeFormatted</span>
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold border @badge capitalize">
                                            @app.StatusString
                                        </span>
                                    </div>
                                    <div class="mt-1 font-bold text-xs text-slate-900">@app.CustomerName</div>
                                    <div class="text-[11px] text-slate-500 flex justify-between mt-0.5">
                                        <span>@app.ServiceName</span>
                                        <span class="font-bold text-slate-800">@app.FormattedPrice</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Low Stock Inventory Alerts (P17, HW-2, INV-05) -->
    @if (Model.LowStockProductsCount > 0)
    {
        <div class="rounded-3xl border border-amber-300 bg-amber-50/70 p-6 sm:p-7 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 rounded-2xl bg-amber-500 text-slate-950 shadow-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    </div>
                    <div>
                        <div class="inline-flex items-center gap-2 text-amber-800 text-xs font-bold uppercase tracking-wider">
                            <span>System Alerts & Notices &bull; Inventory Restock Alert · INV-05</span>
                        </div>
                        <h3 class="text-lg font-serif font-black text-amber-950 mt-0.5">
                            @Model.LowStockProductsCount @(Model.LowStockProductsCount == 1 ? "Product is" : "Products are") At or Below Reorder Level
                        </h3>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/admin/purchases" class="px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm text-center">
                        Record Restock (Buy) &rarr;
                    </a>
                    <a href="/admin/inventory?tab=products" class="px-3 py-2 rounded-xl text-xs font-bold bg-white text-slate-700 border border-amber-200 hover:bg-amber-100 transition shadow-xs text-center">
                        View Products
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 pt-2">
                @foreach (var prod in Model.LowStockProducts)
                {
                    <div class="bg-white rounded-2xl p-4 border border-amber-200/90 shadow-sm flex flex-col justify-between space-y-3">
                        <div class="space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-mono text-[11px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded">
                                    @prod.Sku
                                </span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-100 text-rose-800 border border-rose-200 uppercase">
                                    Stock: @prod.CurrentStock @prod.Unit
                                </span>
                            </div>
                            <h4 class="text-sm font-bold text-slate-900">@prod.Name</h4>
                            <p class="text-[11px] text-slate-500">
                                Reorder Level: <span class="font-semibold text-slate-800">@prod.ReorderLevel @prod.Unit</span> &bull; Category: @prod.Category
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- P13/P16 Requirement: Live "Alerts" area showing flagged equipment (HW-3, INV-02) -->
    @if (Model.FlaggedEquipmentCount > 0)
    {
        <div class="rounded-3xl border border-rose-300 bg-rose-50/70 p-6 sm:p-7 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 rounded-2xl bg-rose-600 text-white shadow-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                    </div>
                    <div>
                        <div class="inline-flex items-center gap-2 text-rose-700 text-xs font-bold uppercase tracking-wider">
                            <span>System Alerts & Notices &bull; Equipment Quality & Maintenance Alert · HW-3 / INV-02</span>
                        </div>
                        <h3 class="text-lg font-serif font-black text-rose-950 mt-0.5">
                            @Model.FlaggedEquipmentCount Equipment @(Model.FlaggedEquipmentCount == 1 ? "Item" : "Items") Require Immediate Attention
                        </h3>
                    </div>
                </div>
                <a href="/admin/inventory?tab=equipment" class="px-4 py-2 rounded-xl text-xs font-bold bg-rose-600 text-white hover:bg-rose-700 transition shadow-sm text-center">
                    Manage Equipment &rarr;
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 pt-2">
                @foreach (var alert in Model.FlaggedEquipmentAlerts)
                {
                    <div class="bg-white rounded-2xl p-4 border border-rose-200/90 shadow-sm flex flex-col justify-between space-y-3">
                        <div class="space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="font-mono text-[11px] font-bold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                                    @alert.AssetTag
                                </span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200 uppercase">
                                    @alert.Condition
                                </span>
                            </div>
                            <h4 class="text-sm font-bold text-slate-900">@alert.Name</h4>
                            <p class="text-[11px] text-slate-500">
                                Assigned to: <span class="font-semibold text-slate-800">@(alert.CurrentBarberName ?? "Unassigned (Shop)")</span>
                            </p>
                        </div>

                        <div class="pt-2 border-t border-slate-100 space-y-1 text-[11px]">
                            @foreach (var r in alert.FlagReasons)
                            {
                                <div class="text-rose-700 font-semibold flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-600 shrink-0"></span>
                                    <span>@r</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    
    @if (Model.FlaggedEquipmentCount == 0 && Model.LowStockProductsCount == 0)
    {
        <div class="rounded-2xl border-2 border-dashed border-slate-300 bg-white/60 p-6 text-center space-y-2">
            <div class="inline-flex p-3 rounded-full bg-slate-100 text-slate-400 mb-1">
                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
            </div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500">System Alerts & Notices</h3>
            <p class="text-xs text-slate-400 max-w-md mx-auto">
                No active equipment or inventory alerts. All registered tools are healthy and products are adequately stocked.
            </p>
        </div>
    }
</div>
