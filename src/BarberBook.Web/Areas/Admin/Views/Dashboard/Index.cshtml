@model BarberBook.Web.Models.Admin.AdminDashboardViewModel
@using BarberBook.Data.Enums
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="space-y-8">
    <!-- Header with Vintage Badge -->
    <div class="sm:flex sm:items-center sm:justify-between pb-6 border-b border-slate-200">
        <div>
            <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
                <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
                <span>BARBERBOOK MANILA · EXECUTIVE DASHBOARD</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Shop Operations & Analytics</h1>
            <p class="mt-1 text-sm text-slate-600 font-sans">Live performance metrics, pending booking reviews, revenue journals, and master barber schedules.</p>
        </div>
        <div class="mt-4 sm:mt-0 flex flex-wrap gap-2.5">
            <a href="/admin/appointments" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-neutral-950 transition shadow-md shadow-amber-500/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                <span>Manage Bookings</span>
            </a>
            <a href="/admin/reports" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-slate-800 hover:bg-slate-700 text-slate-100 transition border border-slate-700">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                <span>Sales Reports</span>
            </a>
        </div>
    </div>

    <!-- Quick Links Bar (P13 Requirement: quick links to Reports, Appointments, Barbers, Services, Customers) -->
    <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-3.5 flex flex-wrap items-center gap-2 sm:gap-3">
        <span class="text-xs uppercase font-extrabold text-slate-400 px-2 tracking-wider">Quick Links:</span>
        <a href="/admin/reports" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
            <span>Sales Reports</span>
        </a>
        <a href="/admin/appointments" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.253 3v12a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 18V7.5A2.25 2.25 0 0018.75 5.25H5.25A2.25 2.25 0 003 7.5v12" /></svg>
            <span>Appointments</span>
        </a>
        <a href="/admin/barbers" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zm-7.518-.267A8.25 8.25 0 1120.25 10.5M8.288 14.212A5.25 5.25 0 1117.25 10.5" /></svg>
            <span>Master Barbers</span>
        </a>
        <a href="/admin/services" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition flex items-center gap-1.5">
            <div class="barber-pole-icon" style="height: 12px; width: 7px;"></div>
            <span>Services Menu</span>
        </a>
        <a href="/admin/customers" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
            <span>Customer Records</span>
        </a>
        <a href="/admin/schedules" class="px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-amber-100 hover:text-amber-900 transition flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>Shop Hours</span>
        </a>
    </div>

    <!-- Stat Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Today's Completed Sales -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Today's Sales</span>
                <span class="p-2 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-emerald-700">@Model.FormattedTodayGrandTotal</span>
            </div>
            <div class="mt-2 text-xs text-slate-500 space-y-0.5">
                <p class="font-medium text-slate-700">@Model.FormattedTodayCompletedSales Services &bull; @Model.TodayCounts.Completed cuts</p>
                @if (Model.TodayProductSales > 0)
                {
                    <p class="text-[11px] font-semibold text-amber-700">
                        + @Model.FormattedTodayProductSales retail counter sales
                    </p>
                }
            </div>
        </div>

        <!-- Month-to-Date Revenue -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Month-to-Date</span>
                <span class="p-2 rounded-xl bg-slate-900 text-amber-300 border border-amber-500/30">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-slate-900">@Model.FormattedMonthToDateGrandTotal</span>
            </div>
            <div class="mt-2 text-xs text-slate-500 space-y-0.5">
                <p class="font-medium text-slate-700">@Model.FormattedMonthToDateCompletedSales Services</p>
                @if (Model.MonthToDateProductSales > 0)
                {
                    <p class="text-[11px] font-semibold text-amber-700">
                        + @Model.FormattedMonthToDateProductSales retail products
                    </p>
                }
            </div>
        </div>

        <!-- Pending Bookings (Actionable) -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Pending Bookings</span>
                <span class="p-2 rounded-xl bg-amber-50 text-amber-700 border border-amber-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-amber-600">@Model.TotalPendingBookingsCount</span>
                <span class="text-xs text-slate-500 font-medium">needs action</span>
            </div>
            <p class="mt-2 text-xs text-slate-500">Requires inline confirm or reject</p>
        </div>

        <!-- Today's Total Appointments -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Today's Total</span>
                <span class="p-2 rounded-xl bg-slate-100 text-slate-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-slate-900">@Model.TodayCounts.Total</span>
                <span class="text-xs text-slate-500 font-medium">appointments</span>
            </div>
            <p class="mt-2 text-xs text-slate-500">@Model.TodayCounts.Confirmed confirmed &bull; @Model.TodayCounts.Pending pending</p>
        </div>
    </div>

    <!-- 2-Column Command Hub (Fresha / Squire / Stripe Enterprise Pattern) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Primary Operations Hub (8 Columns) -->
        <div class="lg:col-span-8 space-y-8">
            <!-- P13 Requirement: "Needs Action" list with inline Confirm and Reject buttons -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div>
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                    <h2 class="text-xl font-serif font-bold text-slate-900 tracking-tight">Needs Action - Pending Bookings</h2>
                </div>
                <p class="text-xs text-slate-500 mt-1">Review incoming booking requests and confirm, reject, or bulk process in one click.</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-amber-100 text-amber-800 border border-amber-300">
                    @Model.TotalPendingBookingsCount pending
                </span>
                <a href="/admin/appointments?status=pending" class="text-xs font-bold text-amber-700 hover:text-amber-800 hidden sm:inline">
                    View All Bookings &rarr;
                </a>
            </div>
        </div>

        <!-- Bulk Action Floating Bar (shown when checkboxes are checked) -->
        <div id="bulkActionBar" class="hidden bg-slate-900 text-white px-6 py-2.5 flex items-center justify-between text-xs animate-in fade-in duration-200">
            <div class="flex items-center gap-2 font-semibold">
                <span id="bulkSelectedCount" class="px-2 py-0.5 rounded-full bg-amber-500 text-slate-950 font-black">0</span>
                <span>bookings selected</span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="executeBulkAction('confirmed')" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold transition flex items-center gap-1 shadow-sm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                    <span>Bulk Confirm</span>
                </button>
                <button type="button" onclick="executeBulkAction('rejected')" class="px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-bold transition flex items-center gap-1 shadow-sm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                    <span>Bulk Reject</span>
                </button>
                <button type="button" onclick="clearBulkSelection()" class="px-2.5 py-1.5 rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 transition">
                    Clear
                </button>
            </div>
        </div>

        @if (!Model.PendingBookings.Any())
        {
            <div class="py-12 text-center text-slate-400 text-sm">
                <div class="inline-flex p-3 rounded-full bg-emerald-50 text-emerald-600 mb-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                </div>
                <p class="font-bold text-slate-700">All caught up! No pending bookings awaiting review.</p>
                <p class="text-xs text-slate-400 mt-1">New online bookings will appear here automatically.</p>
            </div>
        }
        else
        {
            <!-- Desktop Table View wrapped in fixed-height sleek container to prevent scroll fatigue -->
            <div class="hidden md:block overflow-x-auto max-h-[440px] overflow-y-auto divide-y divide-slate-100">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200 sticky top-0 z-10 shadow-2xs">
                        <tr>
                            <th class="py-3 px-4 w-10 text-center">
                                <input type="checkbox" id="selectAllPending" onchange="toggleSelectAllPending(this)" class="w-4 h-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500 cursor-pointer" />
                            </th>
                            <th class="py-3 px-4">Customer</th>
                            <th class="py-3 px-4">Scheduled For</th>
                            <th class="py-3 px-4">Barber</th>
                            <th class="py-3 px-4">Service</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var pending in Model.PendingBookings)
                        {
                            <tr class="hover:bg-amber-50/20 transition">
                                <td class="py-3.5 px-4 text-center">
                                    <input type="checkbox" value="@pending.Id" onchange="updateBulkBar()" class="pending-bulk-chk w-4 h-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500 cursor-pointer" />
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-slate-900 text-xs">@pending.CustomerName</div>
                                    @if (!string.IsNullOrWhiteSpace(pending.CustomerPhone))
                                    {
                                        <div class="text-[11px] text-slate-500 flex items-center gap-1">
                                            <span>@pending.CustomerPhone</span>
                                            <button type="button" class="copy-btn text-slate-400 hover:text-amber-700" onclick="copyToClipboard('@pending.CustomerPhone', this)" title="Copy phone number" aria-label="Copy phone number">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>
                                            </button>
                                        </div>
                                    }
                                    <span class="text-[10px] font-mono text-amber-800">#@pending.ReferenceCode</span>
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <div class="font-bold text-slate-900 text-xs">@pending.ScheduledDateFormatted</div>
                                    <div class="text-[11px] font-semibold text-amber-800">@pending.ScheduledTime</div>
                                </td>
                                <td class="py-3.5 px-4 font-medium text-slate-700 text-xs">
                                    @pending.BarberName
                                </td>
                                <td class="py-3.5 px-4 text-slate-600 text-xs">
                                    <div class="font-medium text-slate-800">@pending.ServiceName</div>
                                    <div class="text-[11px] text-slate-500 font-mono">@pending.FormattedPrice</div>
                                </td>
                                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1.5">
                                        <!-- Inline Confirm Button (Softer tinted/outline style that fills on hover) -->
                                        <form method="post" action="/admin/appointments/@pending.Id/status" class="inline">
                                            <input type="hidden" name="to" value="confirmed" />
                                            <input type="hidden" name="note" value="Confirmed via dashboard action" />
                                            <button type="submit"
                                                    class="px-2.5 py-1.5 rounded-lg text-xs font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-600 hover:text-white border border-emerald-300 transition flex items-center gap-1 shadow-2xs">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                                                <span>Confirm</span>
                                            </button>
                                        </form>

                                        <!-- Inline Reject Button (Softer tinted/outline style that fills on hover) -->
                                        <form method="post" action="/admin/appointments/@pending.Id/status" class="inline" onsubmit="return confirm('Reject booking #@pending.ReferenceCode?');">
                                            <input type="hidden" name="to" value="rejected" />
                                            <input type="hidden" name="note" value="Rejected via dashboard action" />
                                            <button type="submit"
                                                    class="px-2.5 py-1.5 rounded-lg text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-600 hover:text-white border border-rose-300 transition flex items-center gap-1 shadow-2xs">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                                                <span>Reject</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Stacked Cards View -->
            <div class="md:hidden divide-y divide-slate-100">
                @foreach (var pending in Model.PendingBookings)
                {
                    <div class="p-4 space-y-3 hover:bg-amber-50/20 transition">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-100 text-amber-900 border border-amber-200">
                                    #@pending.ReferenceCode
                                </span>
                                <h3 class="font-bold text-slate-900 text-base mt-1">@pending.CustomerName</h3>
                                @if (!string.IsNullOrWhiteSpace(pending.CustomerPhone))
                                {
                                    <p class="text-xs text-slate-500 font-sans">@pending.CustomerPhone</p>
                                }
                            </div>
                            <div class="text-right">
                                <span class="font-serif font-bold text-base text-slate-900">@pending.FormattedPrice</span>
                                <span class="block text-[10px] text-slate-400">Booked @pending.CreatedAtFormatted</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-2 text-xs bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                            <div>
                                <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Date & Time</span>
                                <span class="font-semibold text-slate-900">@pending.ScheduledDateFormatted</span>
                                <span class="block text-amber-800 font-bold">@pending.ScheduledTime</span>
                            </div>
                            <div>
                                <span class="text-slate-400 block text-[10px] uppercase font-bold tracking-wider">Barber & Service</span>
