<script>
    function toggleSelectAllPending(master) {
        document.querySelectorAll('.pending-bulk-chk').forEach(chk => {
            chk.checked = master.checked;
        });
        updateBulkBar();
    }

    function updateBulkBar() {
        const checked = document.querySelectorAll('.pending-bulk-chk:checked');
        const count = checked.length;
        const bar = document.getElementById('bulkActionBar');
        const countEl = document.getElementById('bulkSelectedCount');
        if (countEl) countEl.innerText = count;

        if (count > 0) {
            bar.classList.remove('hidden');
        } else {
            bar.classList.add('hidden');
            const master = document.getElementById('selectAllPending');
            if (master) master.checked = false;
        }
    }

    function clearBulkSelection() {
        document.querySelectorAll('.pending-bulk-chk').forEach(c => c.checked = false);
        const master = document.getElementById('selectAllPending');
        if (master) master.checked = false;
        updateBulkBar();
    }

    async function executeBulkAction(targetStatus) {
        const checked = Array.from(document.querySelectorAll('.pending-bulk-chk:checked')).map(c => parseInt(c.value));
        if (checked.length === 0) return;

        const actionWord = targetStatus === 'confirmed' ? 'confirm' : 'reject';
        if (!confirm(`Are you sure you want to ${actionWord} ${checked.length} selected booking(s)?`)) {
            return;
        }

        try {
            const res = await fetch('/api/admin/appointments/bulk-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    appointmentIds: checked,
                    to: targetStatus,
                    note: `Bulk ${targetStatus} from dashboard`
                })
            });

            if (res.ok) {
                window.location.reload();
            } else {
                const data = await res.json();
                alert(data.error?.message || 'Bulk update failed.');
            }
        } catch (err) {
            alert('Failed to execute bulk update: ' + err.message);
        }
    }
</script>
