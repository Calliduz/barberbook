@model BarberBook.Web.Models.Admin.AdminDashboardViewModel
@using BarberBook.Data.Enums
@{
    ViewData["Title"] = "Dashboard Overview";
}

<div class="space-y-8">
    <!-- Header with Vintage Badge -->
    <div class="sm:flex sm:items-center sm:justify-between pb-6 border-b border-slate-200">
        <div>
            <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
                <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
                <span>BARBERBOOK MANILA · EXECUTIVE DASHBOARD</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Shop Operations & Analytics</h1>
            <p class="mt-1 text-sm text-slate-600 font-sans">Live performance metrics, bookings, revenue tracking, and staff management.</p>
        </div>
        <div class="mt-4 sm:mt-0 flex flex-wrap gap-2.5">
            <a href="/admin/appointments" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-amber-500 hover:bg-amber-400 text-neutral-950 transition shadow-md shadow-amber-500/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                <span>Manage Bookings</span>
            </a>
            <a href="/admin/reports" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-100 transition border border-slate-700">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                <span>Sales Reports</span>
            </a>
        </div>
    </div>

    <!-- Alert Banner for Pending Approvals -->
    @if (Model.PendingApprovalsCount > 0)
    {
        <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-700 flex items-center justify-center font-bold">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
                </div>
                <div>
                    <h4 class="text-sm font-bold text-slate-900">@Model.PendingApprovalsCount Actionable Appointment Request@(Model.PendingApprovalsCount > 1 ? "s" : "")</h4>
                    <p class="text-xs text-slate-600">Pending customer bookings require confirmation or rejection.</p>
                </div>
            </div>
            <a href="/admin/appointments?status=pending" class="px-3.5 py-1.5 rounded-lg text-xs font-bold bg-amber-600 hover:bg-amber-500 text-white transition shadow-sm">
                Review Now →
            </a>
        </div>
    }

    <!-- Stat Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Today's Appointments -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Today's Schedule</span>
                <span class="p-2 rounded-xl bg-slate-100 text-slate-700">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-slate-900">@Model.TodayAppointmentsCount</span>
                <span class="text-xs text-slate-500 font-medium">appointments</span>
            </div>
            <p class="mt-2 text-xs text-slate-500">Booked slots in Asia/Manila zone</p>
        </div>

        <!-- Pending Approvals -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Pending Bookings</span>
                <span class="p-2 rounded-xl bg-amber-50 text-amber-700 border border-amber-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-amber-600">@Model.PendingApprovalsCount</span>
                <span class="text-xs text-slate-500 font-medium">awaiting review</span>
            </div>
            <p class="mt-2 text-xs text-slate-500">Requires administrator action</p>
        </div>

        <!-- Today's Completed Sales (BR-07) -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Today's Sales</span>
                <span class="p-2 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-emerald-700">@Model.FormattedTodayCompletedSales</span>
            </div>
            <p class="mt-2 text-xs text-slate-500">Completed visits settled in-shop</p>
        </div>

        <!-- Month-to-Date Revenue -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Month-to-Date</span>
                <span class="p-2 rounded-xl bg-slate-900 text-amber-300 border border-amber-500/30">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>
                </span>
            </div>
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-slate-900">@Model.FormattedMonthToDateCompletedSales</span>
            </div>
            <p class="mt-2 text-xs text-slate-500">Active month gross revenue (₱)</p>
        </div>
    </div>

    <!-- Secondary Metrics & Master Craftsmen -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Staff & Customer Stats -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
            <h2 class="text-lg font-serif font-bold text-slate-900 tracking-tight mb-4">Shop Entities</h2>
            <div class="space-y-4">
                <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center font-bold">
                            ✂️
                        </div>
                        <div>
                            <span class="text-xs font-bold text-slate-800 block">Master Barbers</span>
                            <span class="text-xs text-slate-500">Active shop craftsmen</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xl font-serif font-black text-slate-900">@Model.ActiveBarbersCount</span>
                        <a href="/admin/barbers" class="text-xs text-amber-700 font-semibold hover:underline">Manage</a>
                    </div>
                </div>

                <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-50 border border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center font-bold">
                            👥
                        </div>
                        <div>
                            <span class="text-xs font-bold text-slate-800 block">Registered Customers</span>
                            <span class="text-xs text-slate-500">Client profile accounts</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xl font-serif font-black text-slate-900">@Model.TotalCustomersCount</span>
                        <a href="/admin/customers" class="text-xs text-amber-700 font-semibold hover:underline">View</a>
                    </div>
                </div>

                <div class="pt-2">
                    <div class="p-3.5 rounded-xl bg-slate-900 text-white flex items-center justify-between">
                        <div>
                            <span class="text-xs uppercase font-bold text-amber-400">Weekly Schedule</span>
                            <p class="text-xs text-slate-300 mt-0.5">Mon–Sat 9:00 AM – 6:00 PM</p>
                        </div>
                        <a href="/admin/schedules" class="px-2.5 py-1 rounded bg-amber-500 hover:bg-amber-400 text-neutral-950 text-xs font-bold transition">
                            Edit Hours
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Barber Performance Summary -->
        <div class="lg:col-span-2 bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-serif font-bold text-slate-900 tracking-tight">Barber Staff Performance</h2>
                <a href="/admin/barbers" class="text-xs font-bold text-amber-700 hover:text-amber-800">View All Staff →</a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                @foreach (var barber in Model.Barbers)
                {
                    <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-white hover:border-amber-500/40 hover:shadow-sm transition">
                        <div class="flex items-center gap-3 mb-2">
                            <div class="w-10 h-10 rounded-full bg-slate-900 text-amber-400 font-serif font-bold flex items-center justify-center text-sm border border-amber-500/30">
                                @barber.DisplayName.Substring(0, 1)
                            </div>
                            <div>
                                <h3 class="text-sm font-bold text-slate-900 leading-tight">@barber.DisplayName</h3>
                                <span class="text-[11px] text-slate-500 truncate block max-w-[130px]">@barber.Specialties</span>
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-t border-slate-200/80 flex justify-between items-baseline">
                            <div>
                                <span class="text-[10px] uppercase font-bold text-slate-400 block">Completed</span>
                                <span class="text-sm font-bold text-slate-800">@barber.CompletedAppointmentsCount</span>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] uppercase font-bold text-slate-400 block">Generated</span>
                                <span class="text-sm font-bold text-amber-700">@barber.FormattedRevenue</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Appointments Live Feed -->
    <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-serif font-bold text-slate-900 tracking-tight">Recent Appointments Activity</h2>
                <p class="text-xs text-slate-500 mt-0.5">Live view of the latest customer bookings across all barbers</p>
            </div>
            <a href="/admin/appointments" class="text-xs font-bold text-amber-700 hover:text-amber-800 flex items-center gap-1">
                <span>View Full Calendar & Schedule</span>
                <span>→</span>
            </a>
        </div>

        @if (!Model.RecentAppointments.Any())
        {
            <div class="p-12 text-center text-slate-400 text-sm">
                No appointment records found yet.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-6">Reference</th>
                            <th class="py-3 px-6">Date & Time</th>
                            <th class="py-3 px-6">Customer</th>
                            <th class="py-3 px-6">Barber</th>
                            <th class="py-3 px-6">Service</th>
                            <th class="py-3 px-6">Amount</th>
                            <th class="py-3 px-6">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var appt in Model.RecentAppointments)
                        {
                            var badgeClass = appt.Status switch
                            {
                                AppointmentStatus.Pending => "bg-amber-100 text-amber-800 border-amber-200",
                                AppointmentStatus.Confirmed => "bg-blue-100 text-blue-800 border-blue-200",
                                AppointmentStatus.Completed => "bg-emerald-100 text-emerald-800 border-emerald-200",
                                AppointmentStatus.Cancelled => "bg-slate-100 text-slate-700 border-slate-200",
                                AppointmentStatus.Rejected => "bg-rose-100 text-rose-800 border-rose-200",
                                _ => "bg-slate-100 text-slate-600"
                            };

                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="py-3.5 px-6 font-mono font-bold text-xs text-slate-900">
                                    @appt.ReferenceCode
                                </td>
                                <td class="py-3.5 px-6 text-xs text-slate-600 whitespace-nowrap">
                                    @appt.StartsAtFormatted
                                </td>
                                <td class="py-3.5 px-6 font-medium text-slate-900">
                                    @appt.CustomerName
                                </td>
                                <td class="py-3.5 px-6 font-medium text-slate-700">
                                    @appt.BarberName
                                </td>
                                <td class="py-3.5 px-6 text-slate-600">
                                    @appt.ServiceName
                                </td>
                                <td class="py-3.5 px-6 font-bold text-slate-900 whitespace-nowrap">
                                    @appt.FormattedPrice
                                </td>
                                <td class="py-3.5 px-6">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold border @badgeClass capitalize">
                                        @appt.Status.ToString().ToLower()
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
