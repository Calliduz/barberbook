<div id="editProductModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 relative animate-in fade-in zoom-in-95">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
            <h3 class="text-lg font-serif font-black text-slate-900">Edit Product</h3>
            <button onclick="closeModal('editProductModal')" class="text-slate-400 hover:text-slate-700 text-lg font-bold">&times;</button>
        </div>
        <form id="editProductForm" method="post" action="" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Product Name *</label>
                <input type="text" id="editProductName" name="name" required placeholder="e.g. Classic Pomade" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Category *</label>
                    <input type="text" id="editProductCategory" name="category" required placeholder="e.g. Styling" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Unit *</label>
                    <input type="text" id="editProductUnit" name="unit" required placeholder="e.g. bottle, jar, can" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
                </div>
            </div>
            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Cost Price (₱) *</label>
                    <input type="number" step="0.01" id="editProductCostPrice" name="costPrice" required placeholder="e.g. 150.00" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Sell Price (₱) *</label>
                    <input type="number" step="0.01" id="editProductSellPrice" name="sellPrice" required placeholder="e.g. 250.00" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Reorder Level *</label>
                    <input type="number" id="editProductReorderLevel" name="reorderLevel" min="0" required placeholder="e.g. 10" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
                </div>
            </div>
            <div class="pt-4 flex justify-end gap-2 border-t border-slate-100">
                <button type="button" onclick="closeModal('editProductModal')" class="py-2 px-4 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100">Cancel</button>
                <button type="submit" class="py-2 px-5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400">Update Product</button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL: ADJUST STOCK                        -->
<!-- ========================================== -->
<div id="adjustStockModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-200 relative animate-in fade-in zoom-in-95">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
            <div>
                <h3 class="text-lg font-serif font-black text-slate-900">Adjust Product Stock</h3>
                <p id="adjustProductTitle" class="text-xs text-slate-500 font-mono mt-0.5"></p>
            </div>
            <button onclick="closeModal('adjustStockModal')" class="text-slate-400 hover:text-slate-700 text-lg font-bold">&times;</button>
        </div>

        <div class="p-3 bg-amber-50 rounded-2xl border border-amber-200/60 text-xs text-amber-900 mb-4 flex items-center justify-between">
            <span class="font-medium">Current Stock Level:</span>
            <span id="adjustCurrentStock" class="font-bold text-sm"></span>
        </div>

        <form id="adjustStockForm" method="post" action="" class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Adjustment Quantity (±) *</label>
                <input type="number" id="adjustQuantityInput" name="quantity" required placeholder="e.g. +5 or -3"
                       class="w-full text-sm font-bold p-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500/20" />
                <p class="text-[10px] text-slate-400 mt-1">Positive number adds stock; negative number deducts stock.</p>
            </div>

            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs flex items-center justify-between">
                <span class="text-slate-500">Projected Resulting Stock:</span>
                <span id="adjustProjectedStock" class="font-bold text-slate-800">0 units</span>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Mandatory Reason *</label>
                <textarea id="adjustReasonInput" name="reason" rows="2" required placeholder="Reason for inventory correction or shrinkage..."
                          class="w-full text-xs p-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500/20"></textarea>
            </div>

            <div id="adjustErrorNotice" class="hidden p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold"></div>

            <div class="pt-4 flex justify-end gap-2 border-t border-slate-100">
                <button type="button" onclick="closeModal('adjustStockModal')" class="py-2 px-4 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100">Cancel</button>
                <button type="submit" id="adjustSubmitButton" class="py-2 px-5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400">Confirm Adjustment</button>
            </div>
        </form>
    </div>
</div>

