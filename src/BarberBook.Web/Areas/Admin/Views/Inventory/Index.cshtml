<!-- ========================================== -->
<!-- DRAWER: EQUIPMENT TIMELINE HISTORY         -->
<!-- ========================================== -->
<div id="eqTimelineBackdrop" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeEqTimeline()"></div>
<div id="eqTimelineDrawer" class="hidden fixed inset-y-0 right-0 z-50 w-full max-w-md bg-white shadow-2xl border-l border-slate-200 flex flex-col transform transition-transform duration-300">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
        <div>
            <h3 class="text-lg font-serif font-black text-slate-900">Equipment History</h3>
            <p id="eqTimelineSubtitle" class="text-xs text-slate-500 font-mono mt-0.5"></p>
        </div>
        <button onclick="closeEqTimeline()" class="text-slate-400 hover:text-slate-700 text-xl font-bold">&times;</button>
    </div>

    <div id="eqTimelineContent" class="flex-1 overflow-y-auto p-5 space-y-4">
        <div class="text-center py-10 text-xs text-slate-400">Loading audit history...</div>
    </div>
</div>

<!-- Scripts for Interactivity -->
<script>
    let currentStockValue = 0;
    let currentUnitValue = 'pcs';

    function openModal(id) {
        document.getElementById(id).classList.remove('hidden');
    }

    function closeModal(id) {
        document.getElementById(id).classList.add('hidden');
    }

    function openAssignModal(id, name, tag, currentBarberId) {
        document.getElementById('assignEquipmentForm').action = '/admin/inventory/equipment/' + id + '/assign';
        document.getElementById('assignModalSubtitle').innerText = name + ' (' + tag + ')';
        if (currentBarberId > 0) {
            document.getElementById('assignBarberSelect').value = currentBarberId;
        } else {
            document.getElementById('assignBarberSelect').selectedIndex = 0;
        }
        openModal('assignEquipmentModal');
    }

    function openAdminInspectModal(id, name, tag) {
        document.getElementById('adminInspectForm').action = '/admin/inventory/equipment/' + id + '/inspect';
        document.getElementById('adminInspectSubtitle').innerText = name + ' (' + tag + ')';
        openModal('adminInspectModal');
    }

    async function openEquipmentTimelineDrawer(id, name, tag) {
        document.getElementById('eqTimelineSubtitle').innerText = name + ' (' + tag + ')';
        document.getElementById('eqTimelineContent').innerHTML = '<div class="text-center py-10 text-xs text-slate-400">Loading history...</div>';

        document.getElementById('eqTimelineBackdrop').classList.remove('hidden');
        document.getElementById('eqTimelineDrawer').classList.remove('hidden');

        try {
            const [assignResp, checksResp] = await Promise.all([
                fetch('/api/admin/equipment/' + id + '/assignments'),
                fetch('/api/admin/equipment/' + id + '/checks')
            ]);

            const assignments = await assignResp.json();
            const checks = await checksResp.json();

            let html = '<div class="space-y-4">';

            html += '<div><h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Assignment History</h4>';
            if (!assignments || assignments.length === 0) {
                html += '<p class="text-xs text-slate-400 italic">No assignments recorded yet.</p>';
            } else {
                html += '<div class="space-y-2">';
                assignments.forEach(a => {
                    const activePill = a.is_active
                        ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800">Active</span>'
                        : '<span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-100 text-slate-600">Returned</span>';

                    html += `
                        <div class="p-3 rounded-xl border border-slate-200 bg-slate-50/50 text-xs space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="font-bold text-slate-800">${a.barber_name}</span>
                                ${activePill}
                            </div>
                            <div class="text-[11px] text-slate-500 font-mono">Assigned: ${a.assigned_at}</div>
                            ${a.returned_at ? `<div class="text-[11px] text-slate-500 font-mono">Returned: ${a.returned_at}</div>` : ''}
                            ${a.notes ? `<div class="text-[11px] text-slate-600 italic">Notes: ${a.notes}</div>` : ''}
                        </div>
                    `;
                });
                html += '</div>';
            }
            html += '</div>';

            html += '<div class="pt-3 border-t border-slate-200"><h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Inspection History</h4>';
            if (!checks || checks.length === 0) {
                html += '<p class="text-xs text-slate-400 italic">No inspection checks recorded yet.</p>';
            } else {
                html += '<div class="space-y-2">';
                checks.forEach(c => {
                    const condClass = c.condition === 'poor' ? 'bg-rose-100 text-rose-800' : (c.condition === 'fair' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800');
                    html += `
                        <div class="p-3 rounded-xl border border-slate-200 bg-slate-50/50 text-xs space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase ${condClass}">${c.condition}</span>
                                <span class="font-mono text-slate-400 text-[11px]">${c.checked_at}</span>
                            </div>
                            <div class="text-[11px] text-slate-600">Audited by: <span class="font-semibold">${c.checked_by_name || 'Staff'}</span></div>
                            <div class="text-[11px] text-slate-500">Next check due: <span class="font-mono font-semibold">${c.next_check_due}</span></div>
                            ${c.notes ? `<div class="text-[11px] text-slate-600 italic">Notes: ${c.notes}</div>` : ''}
                        </div>
                    `;
                });
                html += '</div>';
            }
            html += '</div></div>';

            document.getElementById('eqTimelineContent').innerHTML = html;
        } catch (e) {
            document.getElementById('eqTimelineContent').innerHTML = '<div class="text-rose-600 text-xs text-center py-6">Error loading history: ' + e.message + '</div>';
        }
    }

    function closeEqTimeline() {
        document.getElementById('eqTimelineBackdrop').classList.add('hidden');
        document.getElementById('eqTimelineDrawer').classList.add('hidden');
    }

    function openEditProductModal(arg1, name, category, unit, sellPrice, costPrice, reorderLevel) {
        let id = arg1;
        if (typeof arg1 === 'object' && arg1 !== null && arg1.getAttribute) {
            id = arg1.getAttribute('data-id');
            name = arg1.getAttribute('data-name');
            category = arg1.getAttribute('data-category');
            unit = arg1.getAttribute('data-unit');
            sellPrice = arg1.getAttribute('data-sell-price');
            costPrice = arg1.getAttribute('data-cost-price');
            reorderLevel = arg1.getAttribute('data-reorder-level');
        }
        document.getElementById('editProductForm').action = '/admin/inventory/products/' + id + '/edit';
        document.getElementById('editProductName').value = name;
        document.getElementById('editProductCategory').value = category;
        document.getElementById('editProductUnit').value = unit;
        document.getElementById('editProductSellPrice').value = sellPrice;
        document.getElementById('editProductCostPrice').value = costPrice;
        document.getElementById('editProductReorderLevel').value = reorderLevel;
        openModal('editProductModal');
    }

    function openAdjustModal(arg1, name, sku, currentStock, unit) {
        let id = arg1;
        if (typeof arg1 === 'object' && arg1 !== null && arg1.getAttribute) {
            id = arg1.getAttribute('data-id');
            name = arg1.getAttribute('data-name');
            sku = arg1.getAttribute('data-sku');
            currentStock = parseInt(arg1.getAttribute('data-stock'), 10) || 0;
            unit = arg1.getAttribute('data-unit');
        }
        currentStockValue = currentStock;
        currentUnitValue = unit;

        document.getElementById('adjustStockForm').action = '/admin/inventory/products/' + id + '/adjust';
        document.getElementById('adjustProductTitle').innerText = name + ' (' + sku + ')';
        document.getElementById('adjustCurrentStock').innerText = currentStock + ' ' + unit;
        document.getElementById('adjustQuantityInput').value = '';
        document.getElementById('adjustReasonInput').value = '';
        document.getElementById('adjustProjectedStock').innerText = currentStock + ' ' + unit;
        document.getElementById('adjustErrorNotice').classList.add('hidden');
        document.getElementById('adjustSubmitButton').disabled = false;

        openModal('adjustStockModal');
    }

    const adjustQtyInput = document.getElementById('adjustQuantityInput');
    if (adjustQtyInput) {
        adjustQtyInput.addEventListener('input', function () {
        const val = parseInt(this.value, 10);
        const projectedEl = document.getElementById('adjustProjectedStock');
        const errorEl = document.getElementById('adjustErrorNotice');
        const submitBtn = document.getElementById('adjustSubmitButton');

        if (isNaN(val) || val === 0) {
            projectedEl.innerText = currentStockValue + ' ' + currentUnitValue;
            errorEl.classList.add('hidden');
            submitBtn.disabled = isNaN(val) || val === 0;
            return;
        }

        const projected = currentStockValue + val;
        projectedEl.innerText = projected + ' ' + currentUnitValue;

        if (projected < 0) {
            errorEl.innerText = 'Adjustment would result in negative stock (' + projected + '). Stock cannot go below zero.';
            errorEl.classList.remove('hidden');
            submitBtn.disabled = true;
        } else {
            errorEl.classList.add('hidden');
            submitBtn.disabled = false;
        }
    });

    async function openHistoryDrawer(arg1, name, sku) {
        let id = arg1;
        if (typeof arg1 === 'object' && arg1 !== null && arg1.getAttribute) {
            id = arg1.getAttribute('data-id');
            name = arg1.getAttribute('data-name');
            sku = arg1.getAttribute('data-sku');
        }
        document.getElementById('historyProductSubtitle').innerText = name + ' (' + sku + ')';
        document.getElementById('historyDrawerContent').innerHTML = '<div class="text-center py-10 text-xs text-slate-400">Loading audit log...</div>';

        document.getElementById('historyDrawerBackdrop').classList.remove('hidden');
        document.getElementById('historyDrawer').classList.remove('hidden');

        try {
            const resp = await fetch('/api/admin/inventory/products/' + id + '/movements');
            if (!resp.ok) {
                document.getElementById('historyDrawerContent').innerHTML = '<div class="text-rose-600 text-xs text-center py-6">Failed to load history.</div>';
                return;
            }
            const movements = await resp.json();
            if (!movements || movements.length === 0) {
                document.getElementById('historyDrawerContent').innerHTML = '<div class="text-slate-400 text-xs text-center py-10 italic">No stock movements recorded yet.</div>';
                return;
            }

            let html = '';
            movements.forEach(m => {
                const isPositive = m.quantity > 0;
                const sign = isPositive ? '+' : '';
                const badgeColor = m.type === 'adjustment' ? 'bg-amber-100 text-amber-800' : (m.type === 'purchase' ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-blue-800');

                html += `
                    <div class="p-3.5 rounded-2xl border border-slate-200/80 bg-slate-50/50 space-y-1.5">
                        <div class="flex items-center justify-between text-xs">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${badgeColor}">${m.type}</span>
                            <span class="font-mono text-slate-400 text-[11px]">${m.created_at}</span>
                        </div>
                        <div class="flex items-center justify-between pt-1">
                            <span class="text-xs text-slate-700 font-medium">Quantity change:</span>
                            <span class="font-mono font-bold text-sm ${isPositive ? 'text-emerald-700' : 'text-rose-700'}">${sign}${m.quantity}</span>
                        </div>
                        <div class="text-[11px] text-slate-600">
                            <span class="font-semibold text-slate-700">Reason:</span> ${m.reason || 'None specified'}
                        </div>
                        <div class="text-[10px] text-slate-400 pt-1 border-t border-slate-200/50 flex justify-between">
                            <span>Logged by: ${m.created_by || 'System'}</span>
                            ${m.formatted_unit_amount ? `<span>Unit: ${m.formatted_unit_amount}</span>` : ''}
                        </div>
                    </div>
                `;
            });
            document.getElementById('historyDrawerContent').innerHTML = html;
        } catch (e) {
            document.getElementById('historyDrawerContent').innerHTML = '<div class="text-rose-600 text-xs text-center py-6">Error loading history: ' + e.message + '</div>';
        }
    }

    function closeHistoryDrawer() {
        document.getElementById('historyDrawerBackdrop').classList.add('hidden');
        document.getElementById('historyDrawer').classList.add('hidden');
    }

    function openEditEquipmentModal(id, name, category, brandModel, serialNo, purchaseDate, cost, condition, status, interval, notes) {
        document.getElementById('editEquipmentForm').action = '/admin/inventory/equipment/' + id + '/edit';
        document.getElementById('editEqName').value = name;
        document.getElementById('editEqCategory').value = category;
        document.getElementById('editEqBrandModel').value = brandModel;
        document.getElementById('editEqSerialNo').value = serialNo;
        document.getElementById('editEqCost').value = cost;
        document.getElementById('editEqInterval').value = interval;
        document.getElementById('editEqNotes').value = notes;

        const condSelect = document.getElementById('editEqCondition');
        for (let i = 0; i < condSelect.options.length; i++) {
            if (condSelect.options[i].value.toLowerCase() === condition.toLowerCase()) {
                condSelect.selectedIndex = i;
                break;
            }
        }

        const statSelect = document.getElementById('editEqStatus');
        for (let i = 0; i < statSelect.options.length; i++) {
            const val = statSelect.options[i].value.replace(/([A-Z])/g, '_$1').toLowerCase().replace(/^_/, '');
            if (val === status.toLowerCase() || statSelect.options[i].value.toLowerCase() === status.toLowerCase()) {
                statSelect.selectedIndex = i;
                break;
            }
        }

        openModal('editEquipmentModal');
    }

    function openRetireModal(id, name, tag) {
        document.getElementById('retireEquipmentForm').action = '/admin/inventory/equipment/' + id + '/retire';
        document.getElementById('retireEqTitle').innerText = name + ' (' + tag + ')';
        openModal('retireEquipmentModal');
    }
</script>
