        </div>
        <button onclick="closeHistoryDrawer()" class="text-slate-400 hover:text-slate-700 text-xl font-bold">&times;</button>
    </div>

    <div id="historyDrawerContent" class="flex-1 overflow-y-auto p-5 space-y-3">
        <div class="text-center py-10 text-xs text-slate-400">Loading stock audit movements...</div>
    </div>
</div>

