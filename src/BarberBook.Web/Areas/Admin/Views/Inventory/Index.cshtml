@model BarberBook.Web.Models.Inventory.AdminInventoryViewModel
@{
    ViewData["Title"] = "Shop Inventory & Equipment";
    var isProductsTab = Model.ActiveTab == "products";
}

<div class="space-y-8">
    <!-- Header -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
                <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                <span>SHOP ASSETS & INVENTORY</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Shop Inventory & Equipment</h1>
            <p class="mt-1 text-xs sm:text-sm text-slate-500 font-sans">
                Manage retail grooming products, monitor derived stock levels, execute audited stock adjustments, and maintain equipment assets.
            </p>
        </div>

        <!-- Tab Toggle Buttons -->
        <div class="inline-flex p-1.5 bg-slate-100 rounded-2xl border border-slate-200/80 shadow-inner">
            <a href="/admin/inventory?tab=products"
               class="px-5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 @(isProductsTab ? "bg-white text-slate-950 shadow-sm border border-slate-200/60" : "text-slate-600 hover:text-slate-900")">
                <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                <span>Products (@Model.TotalProducts)</span>
                @if (Model.LowStockCount > 0)
                {
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-600 text-white">@Model.LowStockCount</span>
                }
            </a>
            <a href="/admin/inventory?tab=equipment"
               class="px-5 py-2.5 rounded-xl text-xs font-bold transition flex items-center gap-2 @(!isProductsTab ? "bg-white text-slate-950 shadow-sm border border-slate-200/60" : "text-slate-600 hover:text-slate-900")">
                <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                <span>Equipment (@Model.TotalEquipment)</span>
            </a>
        </div>
    </div>

    <!-- Alert / Flash Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-semibold flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-900 font-bold">&times;</button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 text-xs font-semibold flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-rose-700 hover:text-rose-900 font-bold">&times;</button>
        </div>
    }

    <!-- Sub-Navigation Links for Inventory & Purchasing Modules -->
    <div class="flex flex-wrap items-center gap-2 pb-1 border-b border-slate-200 text-xs font-bold">
        <a href="/admin/inventory?tab=products" class="px-4 py-2 rounded-xl @(isProductsTab ? "bg-slate-900 text-white shadow-xs" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition")">
            Retail Products
        </a>
        <a href="/admin/purchases" class="px-4 py-2 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition">
            Buy (Purchases)
        </a>
        <a href="/admin/product-sales" class="px-4 py-2 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition">
            Sell (Product Sales)
        </a>
        <a href="/admin/inventory?tab=equipment" class="px-4 py-2 rounded-xl @(!isProductsTab ? "bg-slate-900 text-white shadow-xs" : "text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition")">
            Equipment Assets
        </a>
        <a href="/admin/equipment/per-barber" class="px-4 py-2 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition">
            Equipment per Barber
        </a>
        <a href="/admin/equipment/quality" class="px-4 py-2 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition">
            Quality Monitoring
        </a>
    </div>

    <!-- Stat Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
            <span class="text-xs uppercase font-bold text-slate-500 block">Retail Products</span>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-slate-900">@Model.TotalProducts</span>
                <span class="text-xs text-slate-500 font-medium">active SKUs</span>
            </div>
            <p class="mt-1 text-xs text-slate-500">Styling, beard care, and shave essentials</p>
        </div>

        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
            <span class="text-xs uppercase font-bold text-slate-500 block">Low Stock Alerts</span>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black @(Model.LowStockCount > 0 ? "text-rose-600" : "text-slate-900")">@Model.LowStockCount</span>
                <span class="text-xs font-medium @(Model.LowStockCount > 0 ? "text-rose-600" : "text-slate-500")">at or below reorder level</span>
            </div>
            <p class="mt-1 text-xs text-slate-500">Requires restocking purchase</p>
        </div>

        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
            <span class="text-xs uppercase font-bold text-slate-500 block">Equipment Assets</span>
            <div class="mt-2 flex items-baseline gap-2">
                <span class="text-3xl font-serif font-black text-slate-900">@Model.TotalEquipment</span>
                <span class="text-xs text-slate-500 font-medium">registered assets</span>
            </div>
            <p class="mt-1 text-xs text-slate-500">Clippers, shears, trimmers and workstations</p>
        </div>
    </div>

    @if (isProductsTab)
    {
        <!-- ========================================== -->
        <!-- TAB 1: PRODUCTS INVENTORY                 -->
        <!-- ========================================== -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden space-y-4 p-5">
            <!-- Search & Actions Bar -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                <form method="get" action="/admin/inventory" class="flex flex-wrap items-center gap-2.5 flex-1">
                    <input type="hidden" name="tab" value="products" />
                    <div class="relative flex-1 min-w-[200px]">
                        <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Search product name, SKU, category..."
                               class="filter-control w-full pl-9 pr-3 text-xs" />
                        <svg class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                    </div>

                    <select name="category" onchange="this.form.submit()" class="filter-control text-xs">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.ProductCategories)
                        {
                            <option value="@cat" selected="@(Context.Request.Query["category"] == cat)">@cat</option>
                        }
                    </select>

                    @if (!string.IsNullOrEmpty(Context.Request.Query["search"]) || !string.IsNullOrEmpty(Context.Request.Query["category"]))
                    {
                        <a href="/admin/inventory?tab=products" class="h-[38px] px-3 rounded-lg text-xs font-semibold text-slate-500 hover:text-slate-800 border border-slate-200 transition flex items-center whitespace-nowrap">
                            Reset
                        </a>
                    }
                </form>

                <div>
                    <button onclick="openModal('addProductModal')" class="h-[38px] px-4 rounded-lg text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm flex items-center gap-1.5 whitespace-nowrap">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                        <span>Add Product</span>
                    </button>
                </div>
            </div>

            <!-- Mobile Responsive Product Cards (Visible on small screens) -->
            <div class="block lg:hidden space-y-3">
                @if (Model.Products.Count == 0)
                {
                    <div class="py-8 text-center text-slate-400 text-xs italic bg-white rounded-xl border border-slate-200">
                        No products found matching the criteria.
                    </div>
                }
                @foreach (var p in Model.Products)
                {
                    <div class="p-4 rounded-2xl border border-slate-200 bg-white shadow-xs space-y-3 @(p.IsActive && p.IsLowStock ? "border-rose-300 bg-rose-50/20" : (!p.IsActive ? "opacity-60 bg-slate-50/50" : ""))">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <span class="font-mono text-[11px] font-bold text-slate-400">@p.Sku</span>
                                <h4 class="font-bold text-slate-900 text-sm">@p.Name</h4>
                                <span class="inline-block mt-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700">@p.Category</span>
                            </div>
                            <div class="text-right">
                                <span class="font-serif font-black text-slate-900 text-sm">@p.FormattedSellPrice</span>
                                <div class="text-[10px] text-slate-400">Cost: @p.FormattedCostPrice</div>
                            </div>
                        </div>

                        <div class="flex items-center justify-between text-xs p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                            <div>
                                <span class="text-slate-500">Current Stock:</span>
                                <span class="font-bold @(p.IsLowStock ? "text-rose-600" : "text-slate-800")">@p.CurrentStock @p.Unit</span>
                                @if (p.IsLowStock)
                                {
                                    <span class="ml-1 px-1.5 py-0.5 rounded text-[10px] font-black bg-rose-100 text-rose-800">Low</span>
                                }
                            </div>
                            <div class="text-[11px] text-slate-500">
                                Reorder at: @p.ReorderLevel @p.Unit
                            </div>
                        </div>

                        <div class="flex items-center justify-between pt-2 border-t border-slate-100 text-xs">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(p.IsActive ? "bg-emerald-100 text-emerald-800" : "bg-slate-200 text-slate-600")">
                                @(p.IsActive ? "Active" : "Deactivated")
                            </span>
                            <div class="flex items-center gap-1.5">
                                <button type="button"
                                        data-id="@p.Id" data-name="@p.Name" data-sku="@p.Sku" data-stock="@p.CurrentStock" data-unit="@p.Unit"
                                        onclick="openAdjustModal(this)"
                                        class="px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-500/10 text-amber-900 hover:bg-amber-500/20 transition">
                                    Adjust
                                </button>
                                <button type="button"
                                        data-id="@p.Id" data-name="@p.Name" data-category="@p.Category" data-unit="@p.Unit" data-sell-price="@p.SellPrice" data-cost-price="@p.CostPrice" data-reorder-level="@p.ReorderLevel"
                                        onclick="openEditProductModal(this)"
                                        class="px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                                    Edit
                                </button>
                                <form method="post" action="/admin/inventory/products/@p.Id/toggle-status" class="inline"
                                      data-confirm="Are you sure you want to @(p.IsActive ? "deactivate" : "activate") '@p.Name'? @(p.IsActive ? "The product will no longer appear on the customer shop or checkout menus." : "The product will immediately be available for catalog display and sales.")"
                                      data-confirm-title="@(p.IsActive ? "Deactivate Product" : "Activate Product")"
                                      data-confirm-button="@(p.IsActive ? "Deactivate" : "Activate")"
                                      data-confirm-destructive="@(p.IsActive ? "true" : "false")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="isActive" value="@(p.IsActive ? "false" : "true")" />
                                    <button type="submit" class="px-2 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-700">
                                        @(p.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Products Table (Hidden on small screens, visible on desktop) -->
            <div class="hidden lg:block overflow-x-auto rounded-xl border border-slate-200">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-4">SKU</th>
                            <th class="py-3 px-4">Product Name</th>
                            <th class="py-3 px-4">Category</th>
                            <th class="py-3 px-4 text-center">Stock Level</th>
                            <th class="py-3 px-4 text-center">Reorder At</th>
                            <th class="py-3 px-4 text-right">Cost Price</th>
                            <th class="py-3 px-4 text-right">Sell Price</th>
                            <th class="py-3 px-4 text-center">Status</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 bg-white">
                        @if (Model.Products.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="py-8 text-center text-slate-400 text-xs italic">
                                    No products found matching the criteria.
                                </td>
                            </tr>
                        }
                        @foreach (var p in Model.Products)
                        {
                            <tr class="hover:bg-slate-50/80 transition @(p.IsActive && p.IsLowStock ? "bg-rose-50/40" : (!p.IsActive ? "opacity-60 bg-slate-50/50" : ""))">
                                <td class="py-3.5 px-4 font-mono font-bold text-xs text-slate-500">@p.Sku</td>
                                <td class="py-3.5 px-4 font-bold text-slate-900">
                                    <div>@p.Name</div>
                                    <span class="text-[10px] text-slate-400 font-normal">Unit: @p.Unit</span>
                                </td>
                                <td class="py-3.5 px-4 text-xs">
                                    <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-medium">@p.Category</span>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <div class="font-bold text-sm @(p.IsLowStock ? "text-rose-600" : "text-slate-800")">
                                        @p.CurrentStock @p.Unit
                                    </div>
                                    @if (p.IsLowStock)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-100 text-rose-800 border border-rose-200 mt-0.5">
                                            Low Stock
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center text-xs text-slate-500 font-medium">
                                    @p.ReorderLevel @p.Unit
                                </td>
                                <td class="py-3.5 px-4 text-right font-mono text-xs text-slate-500">
                                    @p.FormattedCostPrice
                                </td>
                                <td class="py-3.5 px-4 text-right font-serif font-bold text-slate-900">
                                    @p.FormattedSellPrice
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (p.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-200 text-slate-600">
                                            Deactivated
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right whitespace-nowrap space-x-1">
                                    <button type="button"
                                            data-id="@p.Id" data-name="@p.Name" data-sku="@p.Sku" data-stock="@p.CurrentStock" data-unit="@p.Unit"
                                            onclick="openAdjustModal(this)"
                                            class="py-1 px-2.5 rounded-lg text-xs font-bold bg-amber-500/10 text-amber-900 hover:bg-amber-500/20 transition">
                                        Adjust
                                    </button>
                                    <button type="button"
                                            data-id="@p.Id" data-name="@p.Name" data-sku="@p.Sku"
                                            onclick="openHistoryDrawer(this)"
                                            class="py-1 px-2.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                                        History
                                    </button>
                                    <button type="button"
                                            data-id="@p.Id" data-name="@p.Name" data-category="@p.Category" data-unit="@p.Unit" data-sell-price="@p.SellPrice" data-cost-price="@p.CostPrice" data-reorder-level="@p.ReorderLevel"
                                            onclick="openEditProductModal(this)"
                                            class="py-1 px-2.5 rounded-lg text-xs font-bold text-slate-500 hover:text-slate-900 transition">
                                        Edit
                                    </button>
                                    <form method="post" action="/admin/inventory/products/@p.Id/toggle-status" class="inline"
                                      data-confirm="Are you sure you want to @(p.IsActive ? "deactivate" : "activate") '@p.Name'? @(p.IsActive ? "The product will no longer appear on the customer shop or checkout menus." : "The product will immediately be available for catalog display and sales.")"
                                      data-confirm-title="@(p.IsActive ? "Deactivate Product" : "Activate Product")"
                                      data-confirm-button="@(p.IsActive ? "Deactivate" : "Activate")"
                                      data-confirm-destructive="@(p.IsActive ? "true" : "false")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="isActive" value="@(p.IsActive ? "false" : "true")" />
                                        <button type="submit" class="py-1 px-2 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-700" title="@(p.IsActive ? "Deactivate" : "Activate")">
                                            @(p.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- ========================================== -->
        <!-- TAB 2: EQUIPMENT INVENTORY                -->
        <!-- ========================================== -->
        <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden space-y-4 p-5">
            <!-- Sub-Navigation Links for Equipment Modules -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <span class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 text-white shadow-xs">
                        All Assets Directory
                    </span>
                    <a href="/admin/equipment/per-barber" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                        Equipment per Barber
                    </a>
                    <a href="/admin/equipment/quality" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                        Quality Monitoring
                    </a>
                </div>
                <div>
                    <button onclick="openModal('addEquipmentModal')" class="h-[38px] px-4 rounded-lg text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm flex items-center gap-1.5 whitespace-nowrap">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                        <span>Add Equipment</span>
                    </button>
                </div>
            </div>

            <!-- Search & Actions Bar -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
                <form method="get" action="/admin/inventory" class="flex flex-wrap items-center gap-2.5 flex-1">
                    <input type="hidden" name="tab" value="equipment" />
                    <div class="relative flex-1 min-w-[180px]">
                        <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="Search tag, name, model, serial..."
                               class="filter-control w-full pl-9 pr-3 text-xs" />
                        <svg class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                    </div>

                    <select name="category" onchange="this.form.submit()" class="filter-control text-xs">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.EquipmentCategories)
                        {
                            <option value="@cat" selected="@(Context.Request.Query["category"] == cat)">@cat</option>
                        }
                    </select>

                    <select name="status" onchange="this.form.submit()" class="filter-control text-xs">
                        <option value="">All Statuses</option>
                        <option value="InService" selected="@(Context.Request.Query["status"] == "InService")">In Service</option>
                        <option value="UnderMaintenance" selected="@(Context.Request.Query["status"] == "UnderMaintenance")">Under Maintenance</option>
                        <option value="OutOfService" selected="@(Context.Request.Query["status"] == "OutOfService")">Out of Service</option>
                        <option value="Retired" selected="@(Context.Request.Query["status"] == "Retired")">Retired</option>
                    </select>

                    <select name="condition" onchange="this.form.submit()" class="filter-control text-xs">
                        <option value="">All Conditions</option>
                        <option value="Excellent" selected="@(Context.Request.Query["condition"] == "Excellent")">Excellent</option>
                        <option value="Good" selected="@(Context.Request.Query["condition"] == "Good")">Good</option>
                        <option value="Fair" selected="@(Context.Request.Query["condition"] == "Fair")">Fair</option>
                        <option value="Poor" selected="@(Context.Request.Query["condition"] == "Poor")">Poor</option>
                    </select>

                    @if (!string.IsNullOrEmpty(Context.Request.Query["search"]) || !string.IsNullOrEmpty(Context.Request.Query["category"]) || !string.IsNullOrEmpty(Context.Request.Query["status"]) || !string.IsNullOrEmpty(Context.Request.Query["condition"]))
                    {
                        <a href="/admin/inventory?tab=equipment" class="h-[38px] px-3 rounded-lg text-xs font-semibold text-slate-500 hover:text-slate-800 border border-slate-200 transition flex items-center whitespace-nowrap">
                            Reset
                        </a>
                    }
                </form>
            </div>

            <!-- Equipment Table -->
            <div class="overflow-x-auto rounded-xl border border-slate-200">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-4">Asset Tag</th>
                            <th class="py-3 px-4">Equipment Name</th>
                            <th class="py-3 px-4">Category</th>
                            <th class="py-3 px-4">Assigned Barber</th>
                            <th class="py-3 px-4 text-center">Condition</th>
                            <th class="py-3 px-4 text-center">Status</th>
                            <th class="py-3 px-4 text-center">Next Due</th>
                            <th class="py-3 px-4 text-right">Cost</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 bg-white">
                        @if (Model.Equipment.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="py-8 text-center text-slate-400 text-xs italic">
                                    No equipment records found matching the criteria.
                                </td>
                            </tr>
                        }
                        @foreach (var eq in Model.Equipment)
                        {
                            var isRetired = eq.Status == "retired";
                            <tr class="hover:bg-slate-50/80 transition @(isRetired ? "opacity-60 bg-slate-50/50" : (eq.IsFlagged ? "bg-amber-50/30" : ""))">
                                <td class="py-3.5 px-4 font-mono font-bold text-xs text-amber-700">@eq.AssetTag</td>
                                <td class="py-3.5 px-4 font-bold text-slate-900">
                                    <div>@eq.Name</div>
                                    <div class="text-[10px] text-slate-400 font-normal">
                                        @(eq.BrandModel ?? "Standard") @(string.IsNullOrEmpty(eq.SerialNo) ? "" : $"• SN: {eq.SerialNo}")
                                    </div>
                                </td>
                                <td class="py-3.5 px-4 text-xs">
                                    <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-medium">@eq.Category</span>
                                </td>
                                <td class="py-3.5 px-4 text-xs">
                                    @if (!string.IsNullOrEmpty(eq.CurrentBarberName))
                                    {
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-900 border border-amber-200">
                                            @eq.CurrentBarberName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400 italic">Unassigned (Shop)</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @switch (eq.Condition)
                                    {
                                        case "excellent":
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">Excellent</span>
                                            break;
                                        case "good":
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-800 border border-blue-200">Good</span>
                                            break;
                                        case "fair":
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">Fair</span>
                                            break;
                                        default:
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800 border border-rose-200">Poor</span>
                                            break;
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @switch (eq.Status)
                                    {
                                        case "in_service":
                                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-800">In Service</span>
                                            break;
                                        case "under_maintenance":
                                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-100 text-amber-800">Maintenance</span>
                                            break;
                                        case "out_of_service":
                                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-800">Out of Service</span>
                                            break;
                                        default:
                                            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-200 text-slate-700">Retired</span>
                                            break;
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <div class="font-mono text-xs @(eq.IsOverdue ? "text-rose-600 font-bold" : "text-slate-600")">
                                        @(eq.NextInspectionDue ?? "-")
                                    </div>
                                    @if (eq.IsOverdue)
                                    {
                                        <span class="inline-flex px-1.5 py-0.5 rounded text-[9px] font-black bg-rose-100 text-rose-800">Overdue</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right font-mono text-xs text-slate-700">
                                    @(eq.FormattedPurchaseCost ?? "-")
                                </td>
                                <td class="py-3.5 px-4 text-right whitespace-nowrap space-x-1">
                                    @if (!isRetired)
                                    {
                                        <button onclick="openAssignModal(@eq.Id, '@eq.Name', '@eq.AssetTag', @(eq.CurrentBarberId ?? 0))"
                                                class="py-1 px-2.5 rounded-lg text-xs font-bold bg-amber-500/10 text-amber-900 hover:bg-amber-500/20 transition">
                                            @(eq.CurrentBarberId.HasValue ? "Reassign" : "Assign")
                                        </button>
                                        @if (eq.CurrentBarberId.HasValue)
                                        {
                                            <form method="post" action="/admin/inventory/equipment/@eq.Id/return" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="py-1 px-2.5 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-100 transition" title="Return to Shop Storage">
                                                    Return
                                                </button>
                                            </form>
                                        }
                                        <button onclick="openAdminInspectModal(@eq.Id, '@eq.Name', '@eq.AssetTag')"
                                                class="py-1 px-2.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                                            Inspect
                                        </button>
                                    }
                                    <button onclick="openEquipmentTimelineDrawer(@eq.Id, '@eq.Name', '@eq.AssetTag')"
                                            class="py-1 px-2.5 rounded-lg text-xs font-bold text-slate-500 hover:text-slate-900 transition">
                                        History
                                    </button>
                                    <button onclick="openEditEquipmentModal(@eq.Id, '@eq.Name', '@eq.Category', '@(eq.BrandModel ?? "")', '@(eq.SerialNo ?? "")', '@(eq.PurchaseDate ?? "")', '@(eq.PurchaseCost ?? 0)', '@eq.Condition', '@eq.Status', @eq.InspectionIntervalDays, '@(eq.Notes ?? "")')"
                                            class="py-1 px-2 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-700 transition">
                                        Edit
                                    </button>
                                    @if (!isRetired)
                                    {
                                        <button onclick="openRetireModal(@eq.Id, '@eq.Name', '@eq.AssetTag')"
                                                class="py-1 px-2 rounded-lg text-xs font-medium text-rose-500 hover:text-rose-800 transition">
                                            Retire
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ========================================== -->
<!-- MODAL: ADD PRODUCT                        -->
<!-- ========================================== -->
<div id="addProductModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 relative animate-in fade-in zoom-in-95">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-5">
            <h3 class="text-lg font-serif font-black text-slate-900">Add Retail Product</h3>
            <button onclick="closeModal('addProductModal')" class="text-slate-400 hover:text-slate-700 text-lg font-bold">&times;</button>
        </div>
        <form method="post" action="/admin/inventory/products/create" class="space-y-4">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">SKU *</label>
                    <input type="text" name="sku" required placeholder="e.g. PRD-POM-06" class="w-full text-xs p-2.5 rounded-xl border border-slate-200 uppercase font-mono" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Unit *</label>
                    <input type="text" name="unit" required value="pcs" placeholder="pcs, btl, tub" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Product Name *</label>
                <input type="text" name="name" required placeholder="e.g. Matte Texture Styling Paste (100ml)" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Category *</label>
                <input type="text" name="category" required placeholder="Styling, Beard Care, Shaving, Aftercare" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
            </div>
            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Cost Price (₱) *</label>
                    <input type="number" step="0.01" name="costPrice" required placeholder="200.00" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Sell Price (₱) *</label>
                    <input type="number" step="0.01" name="sellPrice" required placeholder="380.00" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Reorder Level *</label>
                    <input type="number" name="reorderLevel" value="5" min="0" required class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Initial Stock Count</label>
                <input type="number" name="initialStock" value="0" min="0" class="w-full text-xs p-2.5 rounded-xl border border-slate-200" />
                <p class="text-[10px] text-slate-400 mt-1">Creates an initial adjustment movement if greater than zero.</p>
            </div>
            <div class="pt-4 flex justify-end gap-2 border-t border-slate-100">
                <button type="button" onclick="closeModal('addProductModal')" class="py-2 px-4 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100">Cancel</button>
                <button type="submit" class="py-2 px-5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400">Save Product</button>
            </div>
        </form>
    </div>
</div>

