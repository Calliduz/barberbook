@model BarberBook.Web.Models.Admin.AdminCustomerListViewModel
@{
    ViewData["Title"] = "Customer Management";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
                <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                <span>CLIENT DIRECTORY & PROFILES · AF-5, SC-5</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Customer Management</h1>
            <p class="mt-1 text-sm text-slate-500 font-sans">
                Review client dossiers, booking visit histories, lifetime spend, and manage profile records across all branches.
            </p>
        </div>
        <div class="mt-4 sm:mt-0 flex items-center gap-3">
            <span class="text-xs font-bold px-3 py-1.5 rounded-xl bg-slate-100 text-slate-700 border border-slate-200">
                Total: <span class="text-slate-900 font-extrabold">@Model.TotalCustomers</span> clients
            </span>
        </div>
    </div>

    <!-- Unified Customer Management Card (Shopify Polaris / Stripe Pattern) -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden">
        
        <!-- Status Tabs Bar -->
        <div class="border-b border-slate-200 bg-slate-50/70 px-4 sm:px-6 pt-3 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <a href="/admin/customers?q=@Model.SearchQuery" 
                   class="pb-3 px-3 text-xs font-bold border-b-2 transition flex items-center gap-2 @(Model.StatusFilter == "all" ? "border-amber-500 text-amber-900 font-extrabold" : "border-transparent text-slate-500 hover:text-slate-800")">
                    <span>All Clients</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(Model.StatusFilter == "all" ? "bg-amber-100 text-amber-900" : "bg-slate-200 text-slate-600")">
                        @(Model.ActiveCount + Model.InactiveCount)
                    </span>
                </a>
                <a href="/admin/customers?status=active&q=@Model.SearchQuery" 
                   class="pb-3 px-3 text-xs font-bold border-b-2 transition flex items-center gap-2 @(Model.StatusFilter == "active" ? "border-emerald-600 text-emerald-900 font-extrabold" : "border-transparent text-slate-500 hover:text-slate-800")">
                    <span>Active</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(Model.StatusFilter == "active" ? "bg-emerald-100 text-emerald-800" : "bg-slate-200 text-slate-600")">
                        @Model.ActiveCount
                    </span>
                </a>
                <a href="/admin/customers?status=inactive&q=@Model.SearchQuery" 
                   class="pb-3 px-3 text-xs font-bold border-b-2 transition flex items-center gap-2 @(Model.StatusFilter == "inactive" ? "border-rose-600 text-rose-900 font-extrabold" : "border-transparent text-slate-500 hover:text-slate-800")">
                    <span>Inactive</span>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(Model.StatusFilter == "inactive" ? "bg-rose-100 text-rose-800" : "bg-slate-200 text-slate-600")">
                        @Model.InactiveCount
                    </span>
                </a>
            </div>
        </div>

        <!-- Integrated Search Toolbar -->
        <div class="p-4 bg-white border-b border-slate-100">
            <form method="get" action="/admin/customers" class="flex flex-col sm:flex-row items-center gap-3">
                <input type="hidden" name="status" value="@Model.StatusFilter" />
                <div class="relative flex-1 w-full">
                    <input type="text" name="q" value="@Model.SearchQuery" 
                           placeholder="Filter by customer name, email address, or phone number..."
                           class="w-full pl-10 pr-10 py-2.5 text-xs rounded-xl border border-slate-200 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 bg-slate-50/50" />
                    <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <a href="/admin/customers?status=@Model.StatusFilter" class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-700" title="Clear search">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                        </a>
                    }
                </div>
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <button type="submit" class="w-full sm:w-auto py-2.5 px-5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-2xs">
                        Search
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <a href="/admin/customers?status=@Model.StatusFilter" class="py-2.5 px-3.5 rounded-xl text-xs font-semibold text-slate-500 hover:text-slate-800 border border-slate-200 transition text-center">
                            Reset
                        </a>
                    }
                </div>
            </form>
        </div>

        <!-- Table View -->
        @if (!Model.Items.Any())
        {
            <div class="py-16 text-center text-slate-400">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                <p class="text-base font-semibold text-slate-700">No customers found.</p>
                <p class="text-xs text-slate-400 mt-1">Try broadening your search term or clearing active filters.</p>
            </div>
        }
        else
        {
            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 border-b border-slate-200/80 text-slate-500 font-bold uppercase tracking-wider text-[11px]">
                        <tr>
                            <th class="py-3.5 px-6">Client</th>
                            <th class="py-3.5 px-6">Contact Details</th>
                            <th class="py-3.5 px-6">Visits</th>
                            <th class="py-3.5 px-6">Lifetime Spend</th>
                            <th class="py-3.5 px-6">Last Visit</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                        @foreach (var c in Model.Items)
                        {
                            var initials = string.Join("", (c.FullName ?? "Client").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
                            if (string.IsNullOrWhiteSpace(initials)) { initials = "C"; }

                            <tr class="hover:bg-amber-50/20 transition group">
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 font-serif font-black text-xs flex items-center justify-center shrink-0 shadow-2xs">
                                            @initials
                                        </div>
                                        <div>
                                            <a href="/admin/customers/@c.Id" class="font-bold text-slate-900 text-sm group-hover:text-amber-800 transition">
                                                @c.FullName
                                            </a>
                                            <div class="text-[11px] text-slate-400">Member since @c.MemberSince</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="font-medium text-slate-800 flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
                                        <span>@c.Email</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(c.Phone))
                                    {
                                        <div class="text-[11px] text-slate-500 flex items-center gap-1.5 mt-0.5">
                                            <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H3.75A2.25 2.25 0 001.5 4.5v2.25z" /></svg>
                                            <span>@c.Phone</span>
                                        </div>
                                    }
                                </td>
                                <td class="py-4 px-6">
                                    <div class="font-bold text-slate-900">@c.CompletedVisits @(c.CompletedVisits == 1 ? "visit" : "visits")</div>
                                    <div class="text-[10px] text-slate-400">@c.TotalAppointments total booked</div>
                                </td>
                                <td class="py-4 px-6 font-serif font-black text-slate-900 text-sm">
                                    @c.FormattedTotalSpent
                                </td>
                                <td class="py-4 px-6 text-slate-600">
                                    @c.LastVisit
                                </td>
                                <td class="py-4 px-6">
                                    @if (c.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                            Deactivated
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/admin/customers/@c.Id" class="px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-amber-500 hover:text-slate-950 border border-slate-200 transition shadow-2xs flex items-center gap-1">
                                            <span>View Details</span>
                                            <span class="text-slate-400 group-hover:text-slate-900">&rarr;</span>
                                        </a>

                                        <form method="post" action="/admin/customers/@c.Id/toggle-status" class="inline">
                                            @Html.AntiForgeryToken()
                                            @if (c.IsActive)
                                            {
                                                <button type="submit" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-rose-700 hover:bg-rose-50 border border-transparent hover:border-rose-200 transition" title="Deactivate customer account">
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold text-emerald-700 hover:bg-emerald-50 border border-emerald-200 transition" title="Reactivate customer account">
                                                    Reactivate
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Stacked Card View -->
            <div class="md:hidden divide-y divide-slate-100">
                @foreach (var c in Model.Items)
                {
                    var initials = string.Join("", (c.FullName ?? "Client").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
                    if (string.IsNullOrWhiteSpace(initials)) { initials = "C"; }

                    <div class="p-4 space-y-3 hover:bg-amber-50/20 transition">
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 font-serif font-black text-xs flex items-center justify-center shrink-0">
                                    @initials
                                </div>
                                <div>
                                    <h3 class="font-bold text-slate-900 text-base">@c.FullName</h3>
                                    <p class="text-xs text-slate-500">Member since @c.MemberSince</p>
                                </div>
                            </div>
                            <div>
                                @if (c.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                                        Deactivated
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="space-y-0.5 text-xs">
                            <div class="flex items-center gap-1.5 text-slate-700">
                                <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
                                <span class="font-medium truncate">@c.Email</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(c.Phone))
                            {
                                <div class="flex items-center gap-1.5 text-slate-500">
                                    <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H3.75A2.25 2.25 0 001.5 4.5v2.25z" /></svg>
                                    <span>@c.Phone</span>
                                </div>
                            }
                        </div>

                        <div class="grid grid-cols-3 gap-2 text-center bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                            <div>
                                <span class="text-slate-400 block text-[9px] uppercase font-bold tracking-wider">Visits</span>
                                <span class="font-bold text-amber-800 text-xs">@c.CompletedVisits <span class="text-slate-400 font-normal">/ @c.TotalAppointments</span></span>
                            </div>
                            <div>
                                <span class="text-slate-400 block text-[9px] uppercase font-bold tracking-wider">Lifetime Spend</span>
                                <span class="font-serif font-black text-slate-900 text-xs">@c.FormattedTotalSpent</span>
                            </div>
                            <div>
                                <span class="text-slate-400 block text-[9px] uppercase font-bold tracking-wider">Last Visit</span>
                                <span class="font-semibold text-slate-700 text-[11px] truncate block">@c.LastVisit</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 pt-1 border-t border-slate-100">
                            <a href="/admin/customers/@c.Id" class="flex-1 py-2 px-3 rounded-xl text-xs font-bold bg-slate-100 hover:bg-amber-500 hover:text-slate-950 text-slate-800 transition shadow-2xs text-center">
                                View Details &rarr;
                            </a>

                            <form method="post" action="/admin/customers/@c.Id/toggle-status" class="flex-1">
                                @Html.AntiForgeryToken()
                                @if (c.IsActive)
                                {
                                    <button type="submit" class="w-full py-2 px-3 rounded-xl text-xs font-bold text-slate-400 hover:text-rose-700 hover:bg-rose-50 border border-slate-200 transition text-center" title="Deactivate customer account">
                                        Deactivate
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="w-full py-2 px-3 rounded-xl text-xs font-bold text-emerald-700 hover:bg-emerald-50 border border-emerald-200 transition text-center" title="Reactivate customer account">
                                        Reactivate
                                    </button>
                                }
                            </form>
                        </div>
                    </div>
                }
            </div>

            <!-- Windowed Smart Pagination Bar (Shopify / GitHub Benchmark) -->
            <div class="p-4 bg-slate-50/80 border-t border-slate-200/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
                <div>
                    Showing <span class="font-bold text-slate-800">@((Model.Page - 1) * Model.PageSize + 1)</span> to <span class="font-bold text-slate-800">@(Math.Min(Model.Page * Model.PageSize, Model.TotalCustomers))</span> of <span class="font-bold text-slate-800">@Model.TotalCustomers</span> clients
                </div>

                @if (Model.TotalPages > 1)
                {
                    int current = Model.Page;
                    int total = Model.TotalPages;
                    var pageNums = new List<int> { 1 };
                    for (int i = Math.Max(2, current - 2); i <= Math.Min(total - 1, current + 2); i++)
                    {
                        pageNums.Add(i);
                    }
                    if (total > 1 && !pageNums.Contains(total))
                    {
                        pageNums.Add(total);
                    }
                    pageNums = pageNums.Distinct().OrderBy(x => x).ToList();

                    <div class="inline-flex items-center rounded-xl bg-white border border-slate-200 p-1 shadow-2xs space-x-1">
                        @if (Model.Page > 1)
                        {
                            <a href="/admin/customers?q=@Model.SearchQuery&status=@Model.StatusFilter&page=@(Model.Page - 1)" class="px-3 py-1 rounded-lg text-slate-600 hover:bg-slate-100 font-semibold transition">
                                &larr; Prev
                            </a>
                        }
                        else
                        {
                            <span class="px-3 py-1 text-slate-300 font-semibold cursor-not-allowed">
                                &larr; Prev
                            </span>
                        }

                        @{
                            int lastRendered = 0;
                        }
                        @foreach (var p in pageNums)
                        {
                            if (lastRendered > 0 && p - lastRendered > 1)
                            {
                                <span class="px-2 py-1 text-slate-400 font-mono">...</span>
                            }
                            <a href="/admin/customers?q=@Model.SearchQuery&status=@Model.StatusFilter&page=@p" 
                               class="px-3 py-1 rounded-lg font-bold transition @(p == Model.Page ? "bg-amber-500 text-slate-950 shadow-xs" : "text-slate-600 hover:bg-slate-100")">
                                @p
                            </a>
                            lastRendered = p;
                        }

                        @if (Model.Page < Model.TotalPages)
                        {
                            <a href="/admin/customers?q=@Model.SearchQuery&status=@Model.StatusFilter&page=@(Model.Page + 1)" class="px-3 py-1 rounded-lg text-slate-600 hover:bg-slate-100 font-semibold transition">
                                Next &rarr;
                            </a>
                        }
                        else
                        {
                            <span class="px-3 py-1 text-slate-300 font-semibold cursor-not-allowed">
                                Next &rarr;
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
