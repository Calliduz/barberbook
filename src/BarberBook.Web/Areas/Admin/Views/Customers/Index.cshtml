@model BarberBook.Web.Models.Admin.AdminCustomerListViewModel
@{
    ViewData["Title"] = "Customer Management";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-2">
                <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                <span>CLIENT DIRECTORY & PROFILES (AF-5, SC-5)</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Customer Management</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                View customer accounts, booking visit histories, total lifetime spend, and manage profile records.
            </p>
        </div>

        <!-- Quick Status Metrics -->
        <div class="flex flex-wrap items-center gap-2">
            <a href="/admin/customers" class="px-3.5 py-1.5 rounded-xl text-xs font-bold border transition @(Model.StatusFilter == "all" ? "bg-slate-900 text-white border-slate-900 shadow-sm" : "bg-white text-slate-700 border-slate-200 hover:bg-slate-50")">
                All (@(Model.ActiveCount + Model.InactiveCount))
            </a>
            <a href="/admin/customers?status=active" class="px-3.5 py-1.5 rounded-xl text-xs font-bold border transition @(Model.StatusFilter == "active" ? "bg-emerald-600 text-white border-emerald-600 shadow-sm" : "bg-emerald-50 text-emerald-900 border-emerald-200 hover:bg-emerald-100")">
                Active (@Model.ActiveCount)
            </a>
            <a href="/admin/customers?status=inactive" class="px-3.5 py-1.5 rounded-xl text-xs font-bold border transition @(Model.StatusFilter == "inactive" ? "bg-red-600 text-white border-red-600 shadow-sm" : "bg-red-50 text-red-900 border-red-200 hover:bg-red-100")">
                Inactive (@Model.InactiveCount)
            </a>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="bg-white rounded-2xl p-4 border border-slate-200/90 shadow-sm">
        <form method="get" action="/admin/customers" class="grid grid-cols-1 sm:grid-cols-12 gap-3">
            <input type="hidden" name="status" value="@Model.StatusFilter" />

            <div class="sm:col-span-8">
                <div class="relative">
                    <input type="text" name="q" value="@Model.SearchQuery" placeholder="Search by client name, email, or phone number..."
                           class="w-full pl-10 pr-4 py-2 text-xs rounded-xl border border-slate-200 text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500" />
                    <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-2.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                </div>
            </div>

            <div class="sm:col-span-4 flex items-center gap-2">
                <button type="submit" class="flex-1 py-2 px-4 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm">
                    Search
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchQuery))
                {
                    <a href="/admin/customers?status=@Model.StatusFilter" class="py-2 px-3 rounded-xl text-xs font-semibold text-slate-500 hover:text-slate-800 border border-slate-200 transition">
                        Reset
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Customer Directory Table -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden">
        @if (!Model.Items.Any())
        {
            <div class="py-16 text-center text-slate-400">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                <p class="text-base font-semibold text-slate-700">No customers found.</p>
                <p class="text-xs text-slate-400 mt-1">Try broadening your search term or clearing filters.</p>
            </div>
        }
        else
        {
            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 border-b border-slate-100 text-slate-500 font-bold uppercase tracking-wider">
                        <tr>
                            <th class="py-3.5 px-6">Client</th>
                            <th class="py-3.5 px-6">Contact Details</th>
                            <th class="py-3.5 px-6 text-center">Visits</th>
                            <th class="py-3.5 px-6">Lifetime Spend</th>
                            <th class="py-3.5 px-6">Last Visit</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                        @foreach (var c in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/70 transition">
                                <td class="py-4 px-6">
                                    <div class="font-bold text-slate-900 text-sm">@c.FullName</div>
                                    <div class="text-[11px] text-slate-400">Member since @c.MemberSince</div>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="font-medium text-slate-800">@c.Email</div>
                                    <div class="text-[11px] text-slate-500">@c.Phone</div>
                                </td>
                                <td class="py-4 px-6 text-center">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-900 border border-amber-200">
                                        @c.CompletedVisits <span class="text-slate-400 font-normal ml-1">/ @c.TotalAppointments</span>
                                    </span>
                                </td>
                                <td class="py-4 px-6 font-bold text-slate-900">
                                    @c.FormattedTotalSpent
                                </td>
                                <td class="py-4 px-6 text-slate-600">
                                    @c.LastVisit
                                </td>
                                <td class="py-4 px-6">
                                    @if (c.IsActive)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-red-100 text-red-800 border border-red-300">
                                            Deactivated
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/admin/customers/@c.Id" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-xs">
                                            View Details
                                        </a>

                                        <form method="post" action="/admin/customers/@c.Id/toggle-status" class="inline">
                                            @Html.AntiForgeryToken()
                                            @if (c.IsActive)
                                            {
                                                <button type="submit" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold text-red-600 hover:bg-red-50 border border-red-200 transition" title="Deactivate customer account">
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold text-emerald-700 hover:bg-emerald-50 border border-emerald-200 transition" title="Reactivate customer account">
                                                    Reactivate
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Stacked Card View -->
            <div class="md:hidden divide-y divide-slate-100">
                @foreach (var c in Model.Items)
                {
                    <div class="p-4 space-y-3 hover:bg-amber-50/20 transition">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <h3 class="font-bold text-slate-900 text-base">@c.FullName</h3>
                                <p class="text-xs text-slate-500">Member since @c.MemberSince</p>
                            </div>
                            <div>
                                @if (c.IsActive)
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-800 border border-red-300">
                                        Deactivated
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="space-y-0.5 text-xs">
                            <div class="flex items-center gap-1.5 text-slate-700">
                                <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
                                <span class="font-medium truncate">@c.Email</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(c.Phone))
                            {
                                <div class="flex items-center gap-1.5 text-slate-500">
                                    <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H3.75A2.25 2.25 0 001.5 4.5v2.25z" /></svg>
                                    <span>@c.Phone</span>
                                </div>
                            }
                        </div>

                        <div class="grid grid-cols-3 gap-2 text-center bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                            <div>
                                <span class="text-slate-400 block text-[9px] uppercase font-bold tracking-wider">Visits</span>
                                <span class="font-bold text-amber-800 text-xs">@c.CompletedVisits <span class="text-slate-400 font-normal">/ @c.TotalAppointments</span></span>
                            </div>
                            <div>
                                <span class="text-slate-400 block text-[9px] uppercase font-bold tracking-wider">Lifetime Spend</span>
                                <span class="font-serif font-black text-slate-900 text-xs">@c.FormattedTotalSpent</span>
                            </div>
                            <div>
                                <span class="text-slate-400 block text-[9px] uppercase font-bold tracking-wider">Last Visit</span>
                                <span class="font-semibold text-slate-700 text-[11px] truncate block">@c.LastVisit</span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 pt-1 border-t border-slate-100">
                            <a href="/admin/customers/@c.Id" class="flex-1 py-2 px-3 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-2xs text-center active:scale-[0.98]">
                                View Details
                            </a>

                            <form method="post" action="/admin/customers/@c.Id/toggle-status" class="flex-1">
                                @Html.AntiForgeryToken()
                                @if (c.IsActive)
                                {
                                    <button type="submit" class="w-full py-2 px-3 rounded-xl text-xs font-bold text-red-600 hover:bg-red-50 border border-red-200 transition text-center" title="Deactivate customer account">
                                        Deactivate
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="w-full py-2 px-3 rounded-xl text-xs font-bold text-emerald-700 hover:bg-emerald-50 border border-emerald-200 transition text-center" title="Reactivate customer account">
                                        Reactivate
                                    </button>
                                }
                            </form>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination Bar -->
            <div class="p-4 bg-slate-50 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
                <div>
                    Showing <span class="font-bold text-slate-800">@((Model.Page - 1) * Model.PageSize + 1)</span> to <span class="font-bold text-slate-800">@(Math.Min(Model.Page * Model.PageSize, Model.TotalCustomers))</span> of <span class="font-bold text-slate-800">@Model.TotalCustomers</span> clients
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="inline-flex rounded-xl bg-white border border-slate-200 p-1 shadow-xs">
                        @if (Model.Page > 1)
                        {
                            <a href="/admin/customers?q=@Model.SearchQuery&status=@Model.StatusFilter&page=@(Model.Page - 1)" class="px-3 py-1 rounded-lg text-slate-600 hover:bg-slate-100 font-semibold transition">
                                &larr; Prev
                            </a>
                        }

                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <a href="/admin/customers?q=@Model.SearchQuery&status=@Model.StatusFilter&page=@p" class="px-3 py-1 rounded-lg font-bold transition @(p == Model.Page ? "bg-amber-500 text-slate-950" : "text-slate-600 hover:bg-slate-100")">
                                @p
                            </a>
                        }

                        @if (Model.Page < Model.TotalPages)
                        {
                            <a href="/admin/customers?q=@Model.SearchQuery&status=@Model.StatusFilter&page=@(Model.Page + 1)" class="px-3 py-1 rounded-lg text-slate-600 hover:bg-slate-100 font-semibold transition">
                                Next &rarr;
                            </a>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
