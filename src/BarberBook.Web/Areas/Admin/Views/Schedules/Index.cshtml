@model BarberBook.Web.Models.Schedule.AdminBarberScheduleViewModel
@{
    ViewData["Title"] = "Barber Schedules";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Barber Schedules & Availability</h1>
            <p class="mt-1 text-sm text-slate-500">Configure weekly recurring working hours, shift windows, and days off per barber.</p>
        </div>
        <!-- Barber Picker -->
        <div class="mt-4 sm:mt-0 flex items-center space-x-3">
            <label for="barberPicker" class="text-sm font-medium text-slate-700">Barber:</label>
            <select id="barberPicker" onchange="window.location.href='/admin/schedules?barberId=' + this.value" class="rounded-lg border-slate-300 py-2 pl-3 pr-8 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm font-semibold text-slate-900">
                @foreach (var b in Model.Barbers)
                {
                    <option value="@b.Id" selected="@(b.Id == Model.SelectedBarberId)">@b.DisplayName (@b.FullName)</option>
                }
            </select>
        </div>
    </div>

    @if (Model.SelectedBarber == null)
    {
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-12 text-center text-slate-400">
            No active barbers found. Please add a barber account first.
        </div>
    }
    else
    {
        <!-- Schedule Management Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left 2 Cols: Weekly Working Hours Editor -->
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900">Weekly Working Hours</h2>
                            <p class="text-xs text-slate-500">Slots start on 30-minute intervals and must sit fully within a single working window (BR-03, BR-05).</p>
                        </div>
                        <button type="button" onclick="openAddWorkingHourModal()" class="rounded-lg bg-brand-50 text-brand-700 hover:bg-brand-100 border border-brand-200 px-3 py-1.5 text-xs font-semibold transition">
                            + Add Shift Window
                        </button>
                    </div>

                    <div class="divide-y divide-slate-100 mt-4">
                        @{
                            string[] dayNames = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
                        }
                        @for (int dow = 0; dow <= 6; dow++)
                        {
                            var ranges = Model.WeeklyHours.ContainsKey(dow) ? Model.WeeklyHours[dow] : new List<BarberBook.Web.Models.Schedule.WorkingHoursItemDto>();
                            <div class="py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                <div class="w-32 font-semibold text-slate-800 text-sm">
                                    @dayNames[dow]
                                </div>
                                <div class="flex-1 flex flex-wrap gap-2 items-center">
                                    @if (!ranges.Any())
                                    {
                                        <span class="text-xs text-slate-400 italic">Day Off (No working hours)</span>
                                    }
                                    @foreach (var range in ranges)
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3 py-1 text-xs font-medium text-slate-800 border border-slate-200">
                                            <span>@range.StartTime – @range.EndTime</span>
                                            <button type="button" onclick="deleteWorkingHour(@range.Id)" class="text-slate-400 hover:text-rose-600 transition" title="Remove shift">
                                                <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                                                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                                                </svg>
                                            </button>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right 1 Col: Days Off Management -->
            <div class="space-y-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900">Days Off</h2>
                            <p class="text-xs text-slate-500">Dates when @Model.SelectedBarber.DisplayName is unavailable.</p>
                        </div>
                        <button type="button" onclick="openAddDayOffModal()" class="rounded-lg bg-brand-600 hover:bg-brand-500 text-white px-3 py-1.5 text-xs font-semibold shadow-sm transition">
                            + Add Day Off
                        </button>
                    </div>

                    <div class="mt-4 space-y-3">
                        @if (!Model.DaysOff.Any())
                        {
                            <div class="text-center py-8 text-xs text-slate-400">
                                No upcoming days off scheduled for this barber.
                            </div>
                        }
                        @foreach (var dayOff in Model.DaysOff)
                        {
                            <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200 text-sm">
                                <div>
                                    <div class="font-semibold text-slate-900">@dayOff.FormattedDate</div>
                                    <div class="text-xs text-slate-500">@(string.IsNullOrWhiteSpace(dayOff.Reason) ? "Scheduled day off" : dayOff.Reason)</div>
                                </div>
                                <button type="button" onclick="deleteDayOff(@dayOff.Id)" class="text-rose-600 hover:text-rose-800 text-xs font-medium transition" title="Delete day off">
                                    Remove
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Add Shift Window -->
<div id="workingHourModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100">
        <div class="flex justify-between items-center mb-5">
            <h3 class="text-lg font-bold text-slate-900">Add Working Hours Shift</h3>
            <button type="button" onclick="closeModal('workingHourModal')" class="text-slate-400 hover:text-slate-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form id="addWorkingHourForm" onsubmit="submitAddWorkingHour(event)" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700">Day of Week</label>
                <select id="whDayOfWeek" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm">
                    <option value="1">Monday</option>
                    <option value="2">Tuesday</option>
                    <option value="3">Wednesday</option>
                    <option value="4">Thursday</option>
                    <option value="5">Friday</option>
                    <option value="6">Saturday</option>
                    <option value="0">Sunday</option>
                </select>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700">Start Time</label>
                    <input type="time" id="whStartTime" value="09:00" required class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700">End Time</label>
                    <input type="time" id="whEndTime" value="18:00" required class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
                </div>
            </div>
            <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="closeModal('workingHourModal')" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 transition">Cancel</button>
                <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500 transition">Add Shift</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Add Day Off -->
<div id="dayOffModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl border border-slate-100">
        <div class="flex justify-between items-center mb-5">
            <h3 class="text-lg font-bold text-slate-900">Add Day(s) Off</h3>
            <button type="button" onclick="closeModal('dayOffModal')" class="text-slate-400 hover:text-slate-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form id="addDayOffForm" onsubmit="submitAddDayOff(event)" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700">Start Date *</label>
                    <input type="date" id="doStartDate" required class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700">End Date (Optional)</label>
                    <input type="date" id="doEndDate" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" placeholder="Leave empty for single day" />
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700">Reason</label>
                <input type="text" id="doReason" placeholder="e.g. Vacation, Personal, Sick Leave" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
            </div>
            <p class="text-xs text-amber-700 bg-amber-50 p-2.5 rounded-lg border border-amber-200">
                <strong>Appointment Safeguard:</strong> If this day off coincides with existing pending or confirmed bookings, a conflict warning will be displayed. Existing bookings are <strong>never automatically cancelled</strong>.
            </p>
            <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="closeModal('dayOffModal')" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 transition">Cancel</button>
                <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500 transition">Save Day Off</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Conflict Warning Display -->
<div id="conflictWarningModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-xl w-full p-6 shadow-xl border border-amber-200">
        <div class="flex items-center space-x-3 mb-3 text-amber-600">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <h3 class="text-lg font-bold text-slate-900">Appointment Conflict Warning</h3>
        </div>
        <p class="text-sm text-slate-600 mb-4">
            The day(s) off have been saved. However, the following existing appointments are scheduled on these dates. <strong>Per shop policy, they have NOT been auto-cancelled</strong>. Please contact the customers to reschedule.
        </p>
        <div id="conflictListContainer" class="max-h-60 overflow-y-auto divide-y divide-slate-100 bg-slate-50 rounded-xl p-3 border border-slate-200 mb-5">
            <!-- Dynamically populated -->
        </div>
        <div class="flex justify-end">
            <button type="button" onclick="window.location.reload()" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800 transition">Understood, Refresh Schedule</button>
        </div>
    </div>
</div>

<script>
    const currentBarberId = @Model.SelectedBarberId;

    function openAddWorkingHourModal() {
        document.getElementById('workingHourModal').classList.remove('hidden');
    }

    function openAddDayOffModal() {
        document.getElementById('dayOffModal').classList.remove('hidden');
    }

    function closeModal(id) {
        document.getElementById(id).classList.add('hidden');
    }

    async function submitAddWorkingHour(e) {
        e.preventDefault();
        const dow = parseInt(document.getElementById('whDayOfWeek').value);
        const startTime = document.getElementById('whStartTime').value;
        const endTime = document.getElementById('whEndTime').value;

        // Fetch current working hours
        const getRes = await fetch('/api/admin/barbers/' + currentBarberId + '/working-hours');
        const currentHours = await getRes.json();

        const updatedRanges = currentHours.map(h => ({
            dayOfWeek: h.dayOfWeek,
            startTime: h.startTime,
            endTime: h.endTime
        }));

        updatedRanges.push({
            dayOfWeek: dow,
            startTime: startTime,
            endTime: endTime
        });

        const res = await fetch('/api/admin/barbers/' + currentBarberId + '/working-hours', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ranges: updatedRanges })
        });

        if (res.ok) {
            window.location.reload();
        } else {
            const err = await res.json();
            alert(err?.error?.message || 'Failed to add shift window. Check for overlapping hours.');
        }
    }

    async function deleteWorkingHour(id) {
        if (!confirm('Are you sure you want to remove this shift window?')) return;
        const res = await fetch('/api/admin/barbers/' + currentBarberId + '/working-hours/' + id, {
            method: 'DELETE'
        });
        if (res.ok) {
            window.location.reload();
        } else {
            alert('Failed to remove shift window.');
        }
    }

    async function submitAddDayOff(e) {
        e.preventDefault();
        const startDate = document.getElementById('doStartDate').value;
        const endDate = document.getElementById('doEndDate').value;
        const reason = document.getElementById('doReason').value;

        const res = await fetch('/api/admin/barbers/' + currentBarberId + '/days-off', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                startDate: startDate,
                endDate: endDate || null,
                reason: reason || null
            })
        });

        const data = await res.json();
        closeModal('dayOffModal');

        if (res.ok) {
            if (data.hasConflicts && data.conflicts && data.conflicts.length > 0) {
                // Show conflict warning dialog
                const container = document.getElementById('conflictListContainer');
                container.innerHTML = data.conflicts.map(c => `
                    <div class="py-2 text-xs text-slate-700">
                        <div class="flex justify-between font-semibold">
                            <span>Ref: ${c.referenceCode} — ${c.customerName}</span>
                            <span class="uppercase text-amber-700">${c.status}</span>
                        </div>
                        <div class="text-slate-500 mt-0.5">
                            ${c.scheduledDate} at ${c.scheduledTime} (${c.serviceName})
                        </div>
                    </div>
                `).join('');
                document.getElementById('conflictWarningModal').classList.remove('hidden');
            } else {
                window.location.reload();
            }
        } else {
            alert(data?.error?.message || 'Failed to save day off.');
        }
    }

    async function deleteDayOff(id) {
        if (!confirm('Are you sure you want to remove this day off?')) return;
        const res = await fetch('/api/admin/barbers/' + currentBarberId + '/days-off/' + id, {
            method: 'DELETE'
        });
        if (res.ok) {
            window.location.reload();
        } else {
            alert('Failed to remove day off.');
        }
    }
</script>
