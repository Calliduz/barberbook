                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">Monthly</span>
                    </div>
                    <div class="relative h-64 w-full flex items-center justify-center">
                        <canvas id="monthlyServicePieChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Visual Comparative Bar Chart (Cuts vs Products Sales) -->
            @{
                var maxDaySales = Model.MonthlyReport.DailyTotals.Any() ? Model.MonthlyReport.DailyTotals.Max(d => Math.Max(d.ServiceSales, d.ProductSales)) : 0m;
                if (maxDaySales <= 0) maxDaySales = 1000m; // Avoid division by zero
            }
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6 space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-3">
                    <div>
                        <div class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider text-amber-700 mb-0.5">
                            <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                            <span>COMPARATIVE DAILY REVENUE DISTRIBUTION (BAR GRAPH)</span>
                        </div>
                        <h3 class="text-base font-serif font-bold text-slate-900">Cuts Sales vs. Product Sales · @monthNames[Model.SelectedMonth] @Model.SelectedYear</h3>
                        <p class="text-xs text-slate-500">Visual comparison of daily grooming service revenues vs retail counter sales.</p>
                    </div>
                    <!-- Chart Legend -->
                    <div class="flex items-center gap-4 text-xs font-bold">
                        <div class="flex items-center gap-1.5">
                            <span class="w-3.5 h-3.5 rounded bg-amber-500 inline-block shadow-2xs"></span>
                            <span class="text-slate-800">✂ Cuts: @Model.MonthlyReport.FormattedTotalSales</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="w-3.5 h-3.5 rounded bg-emerald-500 inline-block shadow-2xs"></span>
                            <span class="text-slate-800">🧴 Products: @Model.MonthlyReport.FormattedProductSales</span>
                        </div>
                    </div>
                </div>

                <div class="flex items-end gap-1 sm:gap-2 h-44 pt-6 border-b border-slate-200 overflow-x-auto pb-2">
                    @foreach (var d in Model.MonthlyReport.DailyTotals)
                    {
                        var cutsHeightPct = Math.Min(100, (int)Math.Round((d.ServiceSales / maxDaySales) * 100));
                        var prodHeightPct = Math.Min(100, (int)Math.Round((d.ProductSales / maxDaySales) * 100));

                        <div class="flex-1 min-w-[22px] flex flex-col items-center group relative cursor-pointer" onclick="location.href='/admin/reports?tab=daily&date=@d.Date.ToString("yyyy-MM-dd", null)'">
                            <!-- Paired Bars Container -->
                            <div class="w-full flex items-end justify-center gap-0.5 h-32">
                                <!-- Cuts Bar (Amber) -->
                                <div class="w-1/2 max-w-[12px] bg-amber-500 hover:bg-amber-600 rounded-t transition-all" style="height: @(Math.Max(cutsHeightPct, 3))%;"></div>
                                <!-- Products Bar (Emerald) -->
                                <div class="w-1/2 max-w-[12px] bg-emerald-500 hover:bg-emerald-600 rounded-t transition-all" style="height: @(Math.Max(prodHeightPct, 3))%;"></div>
                            </div>
                            <span class="text-[10px] text-slate-500 mt-1 font-semibold group-hover:text-amber-800">@d.Day</span>
                            <!-- Hover Tooltip -->
                            <div class="absolute bottom-full mb-3 hidden group-hover:flex flex-col items-center z-20 whitespace-nowrap pointer-events-none">
                                <div class="bg-slate-900 text-white text-[11px] rounded-xl px-3 py-2 shadow-xl border border-slate-700 space-y-1">
                                    <div class="font-bold border-b border-slate-700 pb-1 text-slate-300">@d.DateFormatted</div>
                                    <div class="flex items-center justify-between gap-3 text-amber-300">
                                        <span>✂ Cuts:</span>
                                        <span class="font-bold font-mono">@d.FormattedTotalSales</span>
                                    </div>
                                    <div class="flex items-center justify-between gap-3 text-emerald-300">
                                        <span>🧴 Products:</span>
                                        <span class="font-bold font-mono">@d.FormattedProductSales</span>
                                    </div>
                                    <div class="border-t border-slate-700 pt-1 font-bold text-white flex items-center justify-between gap-3">
                                        <span>Grand Total:</span>
                                        <span class="font-mono text-amber-400">@d.FormattedGrandTotal</span>
                                    </div>
                                </div>
                                <div class="w-2 h-2 bg-slate-900 rotate-45 -mt-1"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Day-by-Day Table -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-serif font-bold text-slate-900">Day-by-Day Sales Summary (@monthNames[Model.SelectedMonth] @Model.SelectedYear)</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Sum of daily totals equals monthly total: Services @Model.MonthlyReport.FormattedTotalSales &bull; Products @Model.MonthlyReport.FormattedProductSales &bull; Grand @Model.MonthlyReport.FormattedGrandTotal</p>
                    </div>
                    <span class="text-xs text-slate-500 font-medium">@Model.MonthlyReport.CompletedCount total appointments</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                            <tr>
                                <th class="py-3 px-6">Date</th>
                                <th class="py-3 px-6 text-center">Day of Week</th>
                                <th class="py-3 px-6 text-center">Completed Visits</th>
                                <th class="py-3 px-6 text-right">Service Sales</th>
                                <th class="py-3 px-6 text-right">Product Sales</th>
                                <th class="py-3 px-6 text-right font-black">Grand Total</th>
                                <th class="py-3 px-6 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var day in Model.MonthlyReport.DailyTotals)
                            {
                                <tr class="hover:bg-slate-50/80 transition @(day.GrandTotal > 0 ? "bg-amber-50/20" : "")">
                                    <td class="py-3 px-6 font-bold text-slate-900">
                                        @day.DateFormatted
                                    </td>
                                    <td class="py-3 px-6 text-center text-xs font-semibold text-slate-500">
                                        @day.DayOfWeek
                                    </td>
                                    <td class="py-3 px-6 text-center font-medium @(day.CompletedCount > 0 ? "text-slate-900 font-bold" : "text-slate-400")">
                                        @day.CompletedCount
                                    </td>
                                    <td class="py-3 px-6 text-right font-serif font-medium text-slate-800">
                                        @day.FormattedTotalSales
                                    </td>
                                    <td class="py-3 px-6 text-right font-serif font-medium text-amber-800">
                                        @day.FormattedProductSales
                                    </td>
                                    <td class="py-3 px-6 text-right font-serif font-bold text-slate-900">
                                        @day.FormattedGrandTotal
                                    </td>
                                    <td class="py-3 px-6 text-right">
                                        @if (day.GrandTotal > 0)
                                        {
                                            <a href="/admin/reports?tab=daily&date=@day.Date.ToString("yyyy-MM-dd", null)" class="text-xs font-bold text-amber-700 hover:underline">
                                                View Daily →
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">No activity</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-slate-50 font-bold border-t-2 border-slate-200 text-slate-900">
                            <tr>
                                <td colspan="2" class="py-3.5 px-6 uppercase text-xs tracking-wider">Total For @monthNames[Model.SelectedMonth] @Model.SelectedYear:</td>
                                <td class="py-3.5 px-6 text-center font-serif text-base">@Model.MonthlyReport.CompletedCount</td>
                                <td class="py-3.5 px-6 text-right font-serif text-base text-slate-900">@Model.MonthlyReport.FormattedTotalSales</td>
                                <td class="py-3.5 px-6 text-right font-serif text-base text-amber-800">@Model.MonthlyReport.FormattedProductSales</td>
                                <td class="py-3.5 px-6 text-right font-serif text-base text-emerald-800">@Model.MonthlyReport.FormattedGrandTotal</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Monthly Breakdowns: Barber, Service & Retail Product -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Per Barber -->
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Monthly Breakdown by Barber</h3>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 font-bold text-slate-600">Services</span>
                    </div>
                    @if (!Model.MonthlyReport.ByBarber.Any())
                    {
                        <p class="text-xs text-slate-400 italic">No barber sales recorded this month.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var b in Model.MonthlyReport.ByBarber)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                    <div>
                                        <span class="font-bold text-slate-900 block text-sm">@b.Name</span>
                                        <span class="text-xs text-slate-500">@b.Count appointment@(b.Count > 1 ? "s" : "") completed</span>
                                    </div>
                                    <span class="font-serif font-bold text-base text-slate-900">@b.FormattedTotalSales</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Per Service -->
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Monthly Breakdown by Service</h3>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold">Services</span>
                    </div>
                    @if (!Model.MonthlyReport.ByService.Any())
                    {
                        <p class="text-xs text-slate-400 italic">No services rendered this month.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var s in Model.MonthlyReport.ByService)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                    <div>
                                        <span class="font-bold text-slate-900 block text-sm">@s.Name</span>
                                        <span class="text-xs text-slate-500">@s.Count service@(s.Count > 1 ? "s" : "") rendered</span>
                                    </div>
                                    <span class="font-serif font-bold text-base text-slate-900">@s.FormattedTotalSales</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Per Product -->
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Monthly Breakdown by Product</h3>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200 font-bold">Products</span>
                    </div>
                    @if (!Model.MonthlyReport.ProductSalesPerProduct.Any())
                    {
                        <p class="text-xs text-slate-400 italic">No retail product sales recorded this month.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var prod in Model.MonthlyReport.ProductSalesPerProduct)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-amber-50/40 border border-amber-100">
                                    <div>
                                        <span class="font-bold text-slate-900 block text-sm">@prod.Name</span>
                                        <span class="text-xs text-slate-500">@prod.Count unit@(prod.Count > 1 ? "s" : "") sold</span>
                                    </div>
                                    <span class="font-serif font-bold text-base text-amber-800">@prod.FormattedTotalSales</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "yearly")
    {
        <!-- YEARLY SALES VIEW -->
        <div class="space-y-6">
            <!-- Filter Bar: Year Selector -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-4 sm:p-5 flex flex-col sm:flex-row justify-between items-center gap-4">
                <form id="yearlyDateForm" method="get" action="/admin/reports" class="flex items-center gap-3 w-full sm:w-auto">
                    <input type="hidden" name="tab" value="yearly" />
                    <label for="year" class="text-xs font-bold uppercase tracking-wider text-slate-600">Select Calendar Year:</label>
                    <select id="year" name="year" onchange="this.form.submit()" class="rounded-xl border border-slate-300 px-3.5 py-2 text-sm font-bold text-slate-900 shadow-sm">
                        @for (int y = 2025; y <= 2028; y++)
                        {
                            <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                        }
                    </select>
                </form>

                <div class="flex items-center gap-4 sm:gap-6">
                    <div class="text-right">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Annual Cuts Sales</span>
                        <span class="text-base font-serif font-bold text-slate-800">@Model.YearlyReport.FormattedTotalSales</span>
                    </div>
                    <div class="text-right">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Annual Products</span>
                        <span class="text-base font-serif font-bold text-amber-700">@Model.YearlyReport.FormattedProductSales</span>
                    </div>
                    <div class="text-right border-l border-slate-200 pl-4">
                        <span class="text-xs uppercase font-bold text-slate-500 block">Annual Grand Total</span>
                        <span class="text-2xl font-serif font-black text-emerald-700">@Model.YearlyReport.FormattedGrandTotal</span>
                    </div>
                </div>
            </div>

            <!-- Yearly Summary Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-4 gap-5">
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
                    <span class="text-xs uppercase font-bold text-slate-500 block">12-Month Service Sales</span>
                    <h3 class="text-2xl font-serif font-black text-slate-900 mt-1">@Model.YearlyReport.FormattedTotalSales</h3>
                    <p class="text-xs text-slate-500 mt-1">@Model.YearlyReport.CompletedCount Completed Visits</p>
                </div>

                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
                    <span class="text-xs uppercase font-bold text-slate-500 block">12-Month Retail Products</span>
                    <h3 class="text-2xl font-serif font-black text-amber-700 mt-1">@Model.YearlyReport.FormattedProductSales</h3>
                    <p class="text-xs text-slate-500 mt-1">@Model.YearlyReport.ProductSalesCount counter sale(s) recorded</p>
                </div>

                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
                    <span class="text-xs uppercase font-bold text-slate-500 block">Annual Grand Total</span>
                    <h3 class="text-2xl font-serif font-black text-emerald-700 mt-1">@Model.YearlyReport.FormattedGrandTotal</h3>
                    <p class="text-xs text-slate-500 mt-1">In-shop settlement for @Model.YearlyReport.Year</p>
                </div>

                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
                    <span class="text-xs uppercase font-bold text-slate-500 block">Monthly Average Run-Rate</span>
                    @{
                        var monthlyAvg = Model.YearlyReport.GrandTotal / 12m;
                    }
                    <h3 class="text-2xl font-serif font-black text-slate-800 mt-1">₱@monthlyAvg.ToString("N2")</h3>
                    <p class="text-xs text-slate-500 mt-1">Average per month</p>
                </div>
            </div>

            <!-- YEARLY SALES CHARTS (Line Graph + Stacked Bar Graph + Pie Graph) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Line Chart: 12-Month Revenue Curve (7 cols) -->
                <div class="lg:col-span-7 bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5 space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <div>
                            <div class="text-[10px] uppercase font-bold tracking-wider text-amber-700">12-MONTH REVENUE TRAJECTORY</div>
                            <h3 class="text-sm font-serif font-bold text-slate-900">Annual Revenue Trajectory Curve (Line Graph)</h3>
                        </div>
                        <span class="text-[11px] font-mono text-slate-500">Jan &rarr; Dec @Model.YearlyReport.Year</span>
                    </div>
                    <div class="relative h-64 w-full">
                        <canvas id="yearlyTrendLineChart"></canvas>
                    </div>
                </div>

                <!-- Pie / Doughnut Chart: Annual Category Split (5 cols) -->
                <div class="lg:col-span-5 bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5 space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <div>
                            <div class="text-[10px] uppercase font-bold tracking-wider text-emerald-700">ANNUAL PRODUCT & SERVICE MIX</div>
                            <h3 class="text-sm font-serif font-bold text-slate-900">Revenue Distribution (Pie Graph)</h3>
                        </div>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">Annual</span>
                    </div>
                    <div class="relative h-64 w-full flex items-center justify-center">
                        <canvas id="yearlyDistributionPieChart"></canvas>
                    </div>
                </div>

                <!-- Stacked Bar Chart: Monthly Service Cuts vs Products (Full width) -->
                <div class="lg:col-span-12 bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5 space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <div>
                            <div class="text-[10px] uppercase font-bold tracking-wider text-amber-700">MONTH-BY-MONTH REVENUE SPLIT</div>
                            <h3 class="text-sm font-serif font-bold text-slate-900">Monthly Cuts vs Products Breakdown (Stacked Bar Graph)</h3>
                        </div>
                        <div class="flex items-center gap-4 text-xs font-bold">
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-amber-500 inline-block"></span> Cuts (Services)</span>
                            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-emerald-500 inline-block"></span> Retail Products</span>
                        </div>
                    </div>
                    <div class="relative h-56 w-full">
                        <canvas id="yearlyStackedBarChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- 12-Month Table -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-serif font-bold text-slate-900">12-Month Annual Financial Ledger · @Model.YearlyReport.Year</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Sum of 12 monthly totals equals annual total: Services @Model.YearlyReport.FormattedTotalSales &bull; Products @Model.YearlyReport.FormattedProductSales &bull; Grand Total @Model.YearlyReport.FormattedGrandTotal</p>
                    </div>
                    <span class="text-xs text-slate-500 font-medium">@Model.YearlyReport.CompletedCount total completed visits</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                            <tr>
                                <th class="py-3 px-6">Month</th>
                                <th class="py-3 px-6 text-center">Completed Visits</th>
                                <th class="py-3 px-6 text-right">Service Sales</th>
                                <th class="py-3 px-6 text-right">Product Sales</th>
                                <th class="py-3 px-6 text-right font-black">Grand Total</th>
                                <th class="py-3 px-6 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var m in Model.YearlyReport.MonthlyTotals)
                            {
                                <tr class="hover:bg-slate-50/80 transition @(m.GrandTotal > 0 ? "bg-amber-50/20" : "")">
                                    <td class="py-3 px-6 font-bold text-slate-900">
                                        @m.MonthName @Model.YearlyReport.Year
                                    </td>
                                    <td class="py-3 px-6 text-center font-medium @(m.CompletedCount > 0 ? "text-slate-900 font-bold" : "text-slate-400")">
                                        @m.CompletedCount
                                    </td>
                                    <td class="py-3 px-6 text-right font-serif font-medium text-slate-800">
                                        @m.FormattedTotalSales
                                    </td>
                                    <td class="py-3 px-6 text-right font-serif font-medium text-amber-800">
                                        @m.FormattedProductSales
                                    </td>
                                    <td class="py-3 px-6 text-right font-serif font-bold text-slate-900">
                                        @m.FormattedGrandTotal
                                    </td>
                                    <td class="py-3 px-6 text-right">
                                        @if (m.GrandTotal > 0)
                                        {
                                            <a href="/admin/reports?tab=monthly&year=@Model.YearlyReport.Year&month=@m.Month" class="text-xs font-bold text-amber-700 hover:underline">
                                                View Month →
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">No activity</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-slate-50 font-bold border-t-2 border-slate-200 text-slate-900">
                            <tr>
                                <td class="py-3.5 px-6 uppercase text-xs tracking-wider">Annual Total (@Model.YearlyReport.Year):</td>
                                <td class="py-3.5 px-6 text-center font-serif text-base">@Model.YearlyReport.CompletedCount</td>
                                <td class="py-3.5 px-6 text-right font-serif text-base text-slate-900">@Model.YearlyReport.FormattedTotalSales</td>
                                <td class="py-3.5 px-6 text-right font-serif text-base text-amber-800">@Model.YearlyReport.FormattedProductSales</td>
                                <td class="py-3.5 px-6 text-right font-serif text-base text-emerald-800">@Model.YearlyReport.FormattedGrandTotal</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Yearly Breakdowns: Barber, Service & Retail Product -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Per Barber -->
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Annual Breakdown by Barber</h3>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 font-bold text-slate-600">Services</span>
                    </div>
                    @if (!Model.YearlyReport.ByBarber.Any())
                    {
                        <p class="text-xs text-slate-400 italic">No barber sales recorded this year.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var b in Model.YearlyReport.ByBarber)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                    <div>
                                        <span class="font-bold text-slate-900 block text-sm">@b.Name</span>
                                        <span class="text-xs text-slate-500">@b.Count appointment@(b.Count > 1 ? "s" : "") completed</span>
                                    </div>
                                    <span class="font-serif font-bold text-base text-slate-900">@b.FormattedTotalSales</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Per Service -->
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Annual Breakdown by Service</h3>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold">Services</span>
                    </div>
                    @if (!Model.YearlyReport.ByService.Any())
                    {
                        <p class="text-xs text-slate-400 italic">No services rendered this year.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var s in Model.YearlyReport.ByService)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                    <div>
                                        <span class="font-bold text-slate-900 block text-sm">@s.Name</span>
                                        <span class="text-xs text-slate-500">@s.Count service@(s.Count > 1 ? "s" : "") rendered</span>
                                    </div>
                                    <span class="font-serif font-bold text-base text-slate-900">@s.FormattedTotalSales</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Per Product -->
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Annual Breakdown by Product</h3>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200 font-bold">Products</span>
                    </div>
                    @if (!Model.YearlyReport.ProductSalesPerProduct.Any())
                    {
                        <p class="text-xs text-slate-400 italic">No retail product sales recorded this year.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var prod in Model.YearlyReport.ProductSalesPerProduct)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-amber-50/40 border border-amber-100">
                                    <div>
                                        <span class="font-bold text-slate-900 block text-sm">@prod.Name</span>
                                        <span class="text-xs text-slate-500">@prod.Count unit@(prod.Count > 1 ? "s" : "") sold</span>
                                    </div>
                                    <span class="font-serif font-bold text-base text-amber-800">@prod.FormattedTotalSales</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "customers")
    {
        <!-- CUSTOMER TRANSACTIONS VIEW -->
        <div class="space-y-6">
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-4 sm:p-5 flex flex-col md:flex-row justify-between items-center gap-4">
                <form method="get" action="/admin/reports" class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    <input type="hidden" name="tab" value="customers" />
                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">Select Client:</label>
                        <select name="customerId" onchange="this.form.submit()" class="rounded-xl border border-slate-300 px-3.5 py-2 text-sm font-bold text-slate-900 shadow-sm">
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.SelectedCustomerId)">@c.FullName (@c.Email)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">From:</label>
                        <input type="date" name="startDate" value="@Model.StartDateString"
                               class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-800" />
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">To:</label>
                        <input type="date" name="endDate" value="@Model.EndDateString"
                               class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-800" />
                    </div>

                    <div class="pt-5">
                        <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm">
                            Apply Filter
                        </button>
                    </div>
                </form>

                <div class="text-right">
                    <span class="text-xs uppercase font-bold text-slate-500 block">Total Spent</span>
                    <span class="text-2xl font-serif font-black text-amber-700">@Model.CustomerReport.FormattedTotalSpent</span>
                    <span class="text-xs text-slate-500">@Model.CustomerReport.CompletedCount transactions</span>
                </div>
            </div>

            <!-- Customer Transaction Record -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-serif font-bold text-slate-900">Transaction Record · @Model.CustomerReport.CustomerName</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Completed appointments (newest first)</p>
                    </div>
                    @if (Model.SelectedCustomerId > 0)
                    {
                        <a href="/admin/customers/@Model.SelectedCustomerId" class="text-xs font-bold text-amber-700 hover:underline">
                            View Customer Profile →
                        </a>
                    }
                </div>

                @if (!Model.CustomerReport.Transactions.Any())
                {
                    <div class="p-12 text-center text-slate-400 text-sm">
                        No completed transactions recorded for @Model.CustomerReport.CustomerName.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-slate-600">
                            <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                                <tr>
                                    <th class="py-3 px-6">Date</th>
                                    <th class="py-3 px-6">Service</th>
                                    <th class="py-3 px-6">Barber</th>
                                    <th class="py-3 px-6">Status</th>
                                    <th class="py-3 px-6 text-right">Amount (₱)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var tx in Model.CustomerReport.Transactions)
                                {
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3.5 px-6 font-medium text-slate-900 whitespace-nowrap">
                                            @tx.DateFormatted
                                            <span class="block text-[11px] font-mono text-amber-800">@tx.ReferenceCode &bull; @tx.TimeFormatted</span>
                                        </td>
                                        <td class="py-3.5 px-6 font-semibold text-slate-800">@tx.Service</td>
                                        <td class="py-3.5 px-6 text-slate-700">@tx.Barber</td>
                                        <td class="py-3.5 px-6">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                                                @tx.Status
                                            </span>
                                        </td>
                                        <td class="py-3.5 px-6 text-right font-serif font-bold text-slate-900">@tx.FormattedAmount</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-slate-50 font-bold border-t-2 border-slate-200 text-slate-900">
                                <tr>
                                    <td colspan="4" class="py-3.5 px-6 text-right uppercase text-xs tracking-wider">Total Spent</td>
                                    <td class="py-3.5 px-6 text-right font-serif text-base text-amber-700">@Model.CustomerReport.FormattedTotalSpent</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else if (Model.ActiveTab == "barbers")
    {
        <!-- BARBER TRANSACTIONS VIEW -->
        <div class="space-y-6">
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-4 sm:p-5 flex flex-col md:flex-row justify-between items-center gap-4">
                <form method="get" action="/admin/reports" class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    <input type="hidden" name="tab" value="barbers" />
                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">Select Barber:</label>
                        <select name="barberId" onchange="this.form.submit()" class="rounded-xl border border-slate-300 px-3.5 py-2 text-sm font-bold text-slate-900 shadow-sm">
                            @foreach (var b in Model.Barbers)
                            {
                                <option value="@b.Id" selected="@(b.Id == Model.SelectedBarberId)">@b.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">From:</label>
                        <input type="date" name="startDate" value="@Model.StartDateString"
                               class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-800" />
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">To:</label>
                        <input type="date" name="endDate" value="@Model.EndDateString"
                               class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-800" />
                    </div>

                    <div class="pt-5">
                        <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm">
                            Apply Filter
                        </button>
                    </div>
                </form>

                <div class="flex items-center gap-4 sm:gap-6">
                    <div class="text-right">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Gross Sales</span>
                        <span class="text-base font-serif font-bold text-slate-800">@Model.BarberReport.FormattedTotalSales</span>
                    </div>
                    <div class="text-right border-l border-slate-200 pl-4">
                        <span class="text-[10px] uppercase font-bold text-emerald-600 block">Barber Commission (50%)</span>
                        <span class="text-base font-serif font-bold text-emerald-700">@Model.BarberReport.FormattedTotalCommission</span>
                    </div>
                    <div class="text-right border-l border-slate-200 pl-4">
                        <span class="text-xs uppercase font-bold text-slate-500 block">Shop Net Share</span>
                        <span class="text-2xl font-serif font-black text-amber-700">@Model.BarberReport.FormattedShopNetShare</span>
                        <span class="text-[11px] text-slate-500 block">@Model.BarberReport.CompletedCount transactions</span>
                    </div>
                </div>
            </div>

            <!-- Barber Transaction Record -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-serif font-bold text-slate-900">Transaction Record · Master Barber @Model.BarberReport.BarberName</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Completed services (newest first) with 50% commission split</p>
                    </div>
                </div>

                @if (!Model.BarberReport.Transactions.Any())
                {
                    <div class="p-12 text-center text-slate-400 text-sm">
                        No completed transactions recorded for @Model.BarberReport.BarberName.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-slate-600">
                            <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                                <tr>
                                    <th class="py-3 px-6">Date</th>
                                    <th class="py-3 px-6">Customer</th>
                                    <th class="py-3 px-6">Service</th>
                                    <th class="py-3 px-6 text-right">Service Amount</th>
                                    <th class="py-3 px-6 text-right text-emerald-800">Barber Cut (50%)</th>
                                    <th class="py-3 px-6 text-right">Shop Share (50%)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var tx in Model.BarberReport.Transactions)
                                {
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3.5 px-6 font-medium text-slate-900 whitespace-nowrap">
                                            @tx.DateFormatted
                                            <span class="block text-[11px] font-mono text-amber-800">@tx.ReferenceCode &bull; @tx.TimeFormatted</span>
                                        </td>
                                        <td class="py-3.5 px-6 font-bold text-slate-900">@tx.Customer</td>
                                        <td class="py-3.5 px-6 text-slate-700">@tx.Service</td>
                                        <td class="py-3.5 px-6 text-right font-serif font-bold text-slate-900">@tx.FormattedAmount</td>
                                        <td class="py-3.5 px-6 text-right font-serif font-bold text-emerald-700">@tx.FormattedCommissionAmount</td>
                                        <td class="py-3.5 px-6 text-right font-serif font-bold text-slate-700">@tx.FormattedShopShare</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-slate-50 font-bold border-t-2 border-slate-200 text-slate-900">
                                <tr>
                                    <td colspan="3" class="py-3.5 px-6 text-right uppercase text-xs tracking-wider">Totals:</td>
                                    <td class="py-3.5 px-6 text-right font-serif text-base text-slate-900">@Model.BarberReport.FormattedTotalSales</td>
                                    <td class="py-3.5 px-6 text-right font-serif text-base text-emerald-700">@Model.BarberReport.FormattedTotalCommission</td>
                                    <td class="py-3.5 px-6 text-right font-serif text-base text-amber-700">@Model.BarberReport.FormattedShopNetShare</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    function getTodayStr() {
        return new Date().toISOString().split('T')[0];
    }

    function getYesterdayStr() {
        const d = new Date();
        d.setDate(d.getDate() - 1);
        return d.toISOString().split('T')[0];
    }

    function setDailyDate(dateStr) {
        const input = document.getElementById('date');
        if (input) {
            input.value = dateStr;
            document.getElementById('dailyDateForm').submit();
        }
    }

    function filterSalesJournal(type) {
        const rows = document.querySelectorAll('#salesJournalTable tbody tr');
        rows.forEach(row => {
            const rowType = row.getAttribute('data-sale-type');
            if (type === 'all') {
                row.classList.remove('hidden');
            } else if (type === 'service') {
                if (rowType === 'Service') {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            } else if (type === 'product') {
                if (rowType === 'Retail Product') {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            }
        });

        document.querySelectorAll('.sales-type-pill').forEach(btn => {
            btn.classList.remove('bg-slate-900', 'text-white', 'shadow-xs');
            btn.classList.add('text-slate-600');
        });
        const activeBtn = document.getElementById('filterBtn' + type.charAt(0).toUpperCase() + type.slice(1));
        if (activeBtn) {
            activeBtn.classList.remove('text-slate-600');
            activeBtn.classList.add('bg-slate-900', 'text-white', 'shadow-xs');
        }

        const labelEl = document.getElementById('journalFooterLabel');
        const totalEl = document.getElementById('journalFooterTotal');
        if (labelEl && totalEl) {
            if (type === 'service') {
                labelEl.innerText = 'Service Appointments Subtotal:';
                totalEl.innerText = '@Model.DailyReport.FormattedTotalSales';
            } else if (type === 'product') {
                labelEl.innerText = 'Retail Products Subtotal:';
                totalEl.innerText = '@Model.DailyReport.ProductSales.FormattedTotal';
            } else {
                labelEl.innerText = 'Grand Total Combined Revenue:';
                totalEl.innerText = '@Model.DailyReport.FormattedGrandTotal';
            }
        }
    }

    // Chart.js Palette & Tooltip Formatter
    const currencyFormatter = (val) => '₱' + Number(val || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const chartPalette = [
        '#f59e0b', // Amber-500
        '#10b981', // Emerald-500
        '#6366f1', // Indigo-500
        '#f43f5e', // Rose-500
        '#0ea5e9', // Sky-500
        '#8b5cf6', // Violet-500
        '#eab308', // Yellow-500
        '#64748b'  // Slate-500
    ];

    document.addEventListener('DOMContentLoaded', function () {
        if (typeof Chart === 'undefined') return;

        const payloadEl = document.getElementById('reportChartsPayload');
        if (!payloadEl) return;

        let payload;
        try {
            payload = JSON.parse(payloadEl.textContent);
        } catch (e) {
            console.error('Failed to parse chart payload JSON:', e);
            return;
        }

        if (payload.activeTab === 'daily') {
            // --- DAILY SALES CHARTS ---
            // 1. Hourly Line Chart
            const hourlyCanvas = document.getElementById('dailyHourlyChart');
            if (hourlyCanvas && payload.daily) {
                new Chart(hourlyCanvas, {
                    type: 'line',
                    data: {
                        labels: payload.daily.hourlyLabels,
                        datasets: [{
                            label: 'Hourly Sales (₱)',
                            data: payload.daily.hourlyAmounts,
                            borderColor: '#f59e0b',
                            backgroundColor: 'rgba(245, 158, 11, 0.12)',
                            fill: true,
                            tension: 0.35,
                            borderWidth: 2.5,
                            pointBackgroundColor: '#f59e0b',
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: (ctx) => ' Revenue: ' + currencyFormatter(ctx.raw)
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { callback: (v) => '₱' + v }
                            }
                        }
                    }
                });
            }

            // 2. Category / Service Revenue Pie / Doughnut Chart
            const catCanvas = document.getElementById('dailyCategoryPieChart');
            if (catCanvas && payload.daily) {
                new Chart(catCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: payload.daily.catLabels,
                        datasets: [{
                            data: payload.daily.catValues,
                            backgroundColor: chartPalette.slice(0, payload.daily.catLabels.length),
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '62%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, font: { size: 10, weight: 'bold' } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: (ctx) => ' ' + ctx.label + ': ' + currencyFormatter(ctx.raw)
                                }
                            }
                        }
                    }
                });
            }

            // 3. Daily Barber Bar Chart
            const barberBarCanvas = document.getElementById('dailyBarberBarChart');
            if (barberBarCanvas && payload.daily) {
                new Chart(barberBarCanvas, {
                    type: 'bar',
                    data: {
                        labels: payload.daily.barberLabels,
                        datasets: [{
                            label: 'Service Cuts (₱)',
                            data: payload.daily.barberValues,
                            backgroundColor: '#f59e0b',
                            borderRadius: 8,
                            maxBarThickness: 48
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: (ctx) => ' ' + ctx.dataset.label + ': ' + currencyFormatter(ctx.raw)
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { callback: (v) => '₱' + v }
                            }
                        }
                    }
                });
            }
        }
        else if (payload.activeTab === 'weekly') {
            // --- WEEKLY SALES CHARTS ---
            // 1. 7-Day Revenue Trend Line Chart
            const wTrendCanvas = document.getElementById('weeklyTrendLineChart');
            if (wTrendCanvas && payload.weekly) {
                new Chart(wTrendCanvas, {
                    type: 'line',
                    data: {
                        labels: payload.weekly.days,
                        datasets: [
                            {
                                label: 'Grand Total (₱)',
                                data: payload.weekly.grand,
                                borderColor: '#10b981',
                                backgroundColor: 'rgba(16, 185, 129, 0.10)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 3,
                                pointBackgroundColor: '#10b981',
                                pointRadius: 4
                            },
                            {
                                label: 'Service Cuts (₱)',
                                data: payload.weekly.cuts,
                                borderColor: '#f59e0b',
                                borderWidth: 2,
                                borderDash: [4, 4],
                                fill: false,
                                tension: 0.35,
                                pointBackgroundColor: '#f59e0b',
                                pointRadius: 3
                            },
                            {
                                label: 'Retail Products (₱)',
                                data: payload.weekly.prod,
                                borderColor: '#0ea5e9',
                                borderWidth: 2,
                                borderDash: [2, 2],
                                fill: false,
                                tension: 0.35,
                                pointBackgroundColor: '#0ea5e9',
                                pointRadius: 3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { boxWidth: 12, font: { size: 11, weight: 'bold' } }
                            },
                            tooltip: {
                                callbacks: {
                                    label: (ctx) => ' ' + ctx.dataset.label + ': ' + currencyFormatter(ctx.raw)
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { callback: (v) => '₱' + v }
                            }
                        }
                    }
                });
            }

            // 2. Weekly Barber Revenue Pie / Doughnut Chart
            const wBarberPieCanvas = document.getElementById('weeklyBarberPieChart');
            if (wBarberPieCanvas && payload.weekly) {
                new Chart(wBarberPieCanvas, {
                    type: 'pie',
                    data: {
                        labels: payload.weekly.barberLabels,
                        datasets: [{
                            data: payload.weekly.barberValues,
                            backgroundColor: chartPalette.slice(0, payload.weekly.barberLabels.length),
                            borderWidth: 2,
                            borderColor: '#ffffff'
