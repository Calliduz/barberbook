@model BarberBook.Web.Areas.Admin.Controllers.AdminReportsViewModel
@{
    ViewData["Title"] = "Sales & Transaction Reports";
    string[] monthNames = new[] { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };

    // --- Prepare Chart Payloads in C# ---
    // 1. Daily Chart Payload
    var dailyHourlyLabels = new[] { "9 AM", "10 AM", "11 AM", "12 PM", "1 PM", "2 PM", "3 PM", "4 PM", "5 PM", "6 PM", "7 PM" };
    var dailyHourlyAmounts = new decimal[11];
    foreach (var item in Model.DailyReport.CombinedJournal)
    {
        if (DateTime.TryParse(item.Time, out var dt))
        {
            int idx = dt.Hour - 9;
            if (idx >= 0 && idx < dailyHourlyAmounts.Length)
            {
                dailyHourlyAmounts[idx] += item.Amount;
            }
        }
    }

    var dailyCatLabels = new List<string>();
    var dailyCatValues = new List<decimal>();
    foreach (var s in Model.DailyReport.ByService)
    {
        dailyCatLabels.Add(s.Name);
        dailyCatValues.Add(s.TotalSales);
    }
    if (Model.DailyReport.ProductSales.Total > 0)
    {
        dailyCatLabels.Add("Retail Products");
        dailyCatValues.Add(Model.DailyReport.ProductSales.Total);
    }
    if (dailyCatLabels.Count == 0)
    {
        dailyCatLabels.Add("No Sales Recorded");
        dailyCatValues.Add(0);
    }

    var dailyBarberLabels = Model.DailyReport.ByBarber.Select(b => b.Name).ToList();
    var dailyBarberValues = Model.DailyReport.ByBarber.Select(b => b.TotalSales).ToList();
    if (dailyBarberLabels.Count == 0)
    {
        dailyBarberLabels.Add("No Active Barbers");
        dailyBarberValues.Add(0);
    }

    // 2. Weekly Chart Payload
    var weeklyDays = Model.WeeklyReport.DailyTotals.Select(d => $"{d.DayOfWeek} ({d.Date.Month}/{d.Date.Day})").ToList();
    var weeklyGrand = Model.WeeklyReport.DailyTotals.Select(d => d.GrandTotal).ToList();
    var weeklyCuts = Model.WeeklyReport.DailyTotals.Select(d => d.ServiceSales).ToList();
    var weeklyProd = Model.WeeklyReport.DailyTotals.Select(d => d.ProductSales).ToList();
    var weeklyBarberLabels = Model.WeeklyReport.ByBarber.Select(b => b.Name).ToList();
    var weeklyBarberValues = Model.WeeklyReport.ByBarber.Select(b => b.TotalSales).ToList();
    if (weeklyBarberLabels.Count == 0)
    {
        weeklyBarberLabels.Add("No Barber Activity");
        weeklyBarberValues.Add(0);
    }

    // 3. Monthly Chart Payload
    var monthlyDays = Model.MonthlyReport.DailyTotals.Select(d => $"Day {d.Day}").ToList();
    var monthlyDaily = Model.MonthlyReport.DailyTotals.Select(d => d.GrandTotal).ToList();
    var monthlyCumul = new List<decimal>();
    decimal runTotal = 0m;
    foreach (var d in Model.MonthlyReport.DailyTotals)
    {
        runTotal += d.GrandTotal;
        monthlyCumul.Add(runTotal);
    }
    var monthlyCatLabels = new List<string>();
    var monthlyCatValues = new List<decimal>();
    foreach (var s in Model.MonthlyReport.ByService)
    {
        monthlyCatLabels.Add(s.Name);
        monthlyCatValues.Add(s.TotalSales);
    }
    if (Model.MonthlyReport.ProductSales > 0)
    {
        monthlyCatLabels.Add("Retail Products");
        monthlyCatValues.Add(Model.MonthlyReport.ProductSales);
    }
    if (monthlyCatLabels.Count == 0)
    {
        monthlyCatLabels.Add("No Sales This Month");
        monthlyCatValues.Add(0);
    }

    // 4. Yearly Chart Payload
    var yearlyMonths = Model.YearlyReport.MonthlyTotals.Select(m => m.MonthShort).ToList();
    var yearlyTotals = Model.YearlyReport.MonthlyTotals.Select(m => m.GrandTotal).ToList();
    var yearlyCuts = Model.YearlyReport.MonthlyTotals.Select(m => m.ServiceSales).ToList();
    var yearlyProducts = Model.YearlyReport.MonthlyTotals.Select(m => m.ProductSales).ToList();
    var yearlyCatLabels = new List<string>();
    var yearlyCatValues = new List<decimal>();
    foreach (var s in Model.YearlyReport.ByService)
    {
        yearlyCatLabels.Add(s.Name);
        yearlyCatValues.Add(s.TotalSales);
    }
    if (Model.YearlyReport.ProductSales > 0)
    {
        yearlyCatLabels.Add("Retail Grooming");
        yearlyCatValues.Add(Model.YearlyReport.ProductSales);
    }
    if (yearlyCatLabels.Count == 0)
    {
        yearlyCatLabels.Add("No Sales Recorded");
        yearlyCatValues.Add(0);
    }

    var chartDataJson = System.Text.Json.JsonSerializer.Serialize(new {
        activeTab = Model.ActiveTab,
        daily = new {
            hourlyLabels = dailyHourlyLabels,
            hourlyAmounts = dailyHourlyAmounts,
            catLabels = dailyCatLabels,
            catValues = dailyCatValues,
            barberLabels = dailyBarberLabels,
            barberValues = dailyBarberValues
        },
        weekly = new {
            days = weeklyDays,
            grand = weeklyGrand,
            cuts = weeklyCuts,
            prod = weeklyProd,
            barberLabels = weeklyBarberLabels,
            barberValues = weeklyBarberValues
        },
        monthly = new {
            days = monthlyDays,
            daily = monthlyDaily,
            cumul = monthlyCumul,
            catLabels = monthlyCatLabels,
            catValues = monthlyCatValues
        },
        yearly = new {
            months = yearlyMonths,
            totals = yearlyTotals,
            cuts = yearlyCuts,
            prod = yearlyProducts,
            catLabels = yearlyCatLabels,
            catValues = yearlyCatValues
        }
    });
}

<!-- Embedded Chart Data JSON Payload -->
<script id="reportChartsPayload" type="application/json">
@Html.Raw(chartDataJson)
</script>

<div class="space-y-6">
    <!-- Header -->
    <div class="sm:flex sm:items-center sm:justify-between pb-4 border-b border-slate-200">
        <div>
            <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
                <div class="barber-pole-icon" style="height: 16px; width: 9px;"></div>
                <span>AUDIT & REVENUE JOURNALS</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Sales & Transaction Reports</h1>
            <p class="mt-1 text-sm text-slate-600 font-sans">Automated financial journals generated strictly from completed customer appointments and counter sales.</p>
        </div>
        <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
            <a href="/admin/reports/export?tab=@Model.ActiveTab&date=@Model.SelectedDateString&weekDate=@Model.SelectedWeekDateString&year=@Model.SelectedYear&month=@Model.SelectedMonth" 
               class="h-[38px] px-4 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-sm flex items-center gap-1.5 transition whitespace-nowrap">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                <span>Export to CSV / Excel</span>
            </a>
            <button type="button" onclick="window.print()" class="h-[38px] px-4 rounded-xl text-xs font-bold bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 shadow-sm flex items-center gap-1.5 transition whitespace-nowrap">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24-1.076-.673-2.684-.673-4.008 0-3.26 2.37-5.821 5.953-5.821 3.582 0 5.953 2.561 5.953 5.821 0 1.324-.433 2.932-.673 4.008m-10.56 0h11.12m-11.12 0A2.25 2.25 0 004.5 16.079v3.171A2.25 2.25 0 006.75 21.5h10.5a2.25 2.25 0 002.25-2.25v-3.171a2.25 2.25 0 00-1.68-2.25" /></svg>
                <span>Print Report</span>
            </button>
        </div>
    </div>

    <!-- Navigation Tabs: Daily, Weekly, Monthly, Yearly, Customers, Barbers -->
    <div class="flex border-b border-slate-200 gap-2 sm:gap-4 overflow-x-auto">
        <a href="/admin/reports?tab=daily&date=@Model.SelectedDateString"
           class="py-3 px-4 border-b-2 text-sm font-bold whitespace-nowrap transition flex items-center gap-2 @(Model.ActiveTab == "daily" ? "border-amber-600 text-amber-700 bg-amber-50/50" : "border-transparent text-slate-600 hover:text-slate-900")">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.253 3v12a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 18V7.5A2.25 2.25 0 0018.75 5.25H5.25A2.25 2.25 0 003 7.5v12" /></svg>
            <span>Daily Sales</span>
        </a>
        <a href="/admin/reports?tab=weekly&weekDate=@Model.SelectedWeekDateString"
           class="py-3 px-4 border-b-2 text-sm font-bold whitespace-nowrap transition flex items-center gap-2 @(Model.ActiveTab == "weekly" ? "border-amber-600 text-amber-700 bg-amber-50/50" : "border-transparent text-slate-600 hover:text-slate-900")">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" /></svg>
            <span>Weekly Sales</span>
        </a>
        <a href="/admin/reports?tab=monthly&year=@Model.SelectedYear&month=@Model.SelectedMonth"
           class="py-3 px-4 border-b-2 text-sm font-bold whitespace-nowrap transition flex items-center gap-2 @(Model.ActiveTab == "monthly" ? "border-amber-600 text-amber-700 bg-amber-50/50" : "border-transparent text-slate-600 hover:text-slate-900")">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
            <span>Monthly Sales</span>
        </a>
        <a href="/admin/reports?tab=yearly&year=@Model.SelectedYear"
           class="py-3 px-4 border-b-2 text-sm font-bold whitespace-nowrap transition flex items-center gap-2 @(Model.ActiveTab == "yearly" ? "border-amber-600 text-amber-700 bg-amber-50/50" : "border-transparent text-slate-600 hover:text-slate-900")">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>
            <span>Yearly Sales</span>
        </a>
        <a href="/admin/reports?tab=customers&customerId=@Model.SelectedCustomerId"
           class="py-3 px-4 border-b-2 text-sm font-bold whitespace-nowrap transition flex items-center gap-2 @(Model.ActiveTab == "customers" ? "border-amber-600 text-amber-700 bg-amber-50/50" : "border-transparent text-slate-600 hover:text-slate-900")">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
            <span>Customer Transactions</span>
        </a>
        <a href="/admin/reports?tab=barbers&barberId=@Model.SelectedBarberId"
           class="py-3 px-4 border-b-2 text-sm font-bold whitespace-nowrap transition flex items-center gap-2 @(Model.ActiveTab == "barbers" ? "border-amber-600 text-amber-700 bg-amber-50/50" : "border-transparent text-slate-600 hover:text-slate-900")">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zm-7.518-.267A8.25 8.25 0 1120.25 10.5M8.288 14.212A5.25 5.25 0 1117.25 10.5" /></svg>
            <span>Barber Transactions</span>
        </a>
    </div>

    @if (Model.ActiveTab == "daily")
    {
        <!-- DAILY SALES VIEW -->
        <div class="space-y-6">
            <!-- Filter & Preset Bar -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-3.5 sm:p-4 flex flex-col sm:flex-row justify-between items-center gap-3">
                <form id="dailyDateForm" method="get" action="/admin/reports" class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
                    <input type="hidden" name="tab" value="daily" />
                    <label for="date" class="text-xs font-bold uppercase tracking-wider text-slate-600">Select Date:</label>
                    <input type="date" id="date" name="date" value="@Model.SelectedDateString" onchange="this.form.submit()"
                           class="filter-control h-[38px] text-xs font-bold text-slate-900" />
                </form>

                <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mr-1">Presets:</span>
                    <button type="button" onclick="setDailyDate(getTodayStr())" class="h-[32px] px-3 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">Today</button>
                    <button type="button" onclick="setDailyDate(getYesterdayStr())" class="h-[32px] px-3 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">Yesterday</button>
                    <button type="button" onclick="setDailyDate('2026-09-14')" class="h-[32px] px-3 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">Sep 14, 2026</button>
                </div>
            </div>

            <!-- Daily Summary Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
                    <span class="text-xs uppercase font-bold text-slate-500 block">Service Sales (Completed)</span>
                    <h3 class="text-2xl font-serif font-black text-slate-900 mt-1">@Model.DailyReport.FormattedTotalSales</h3>
                    <p class="text-xs text-slate-500 mt-1">@Model.DailyReport.CompletedCount Completed Appointments</p>
                </div>

                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
                    <span class="text-xs uppercase font-bold text-slate-500 block">Product Sales (Retail)</span>
                    <h3 class="text-2xl font-serif font-black text-amber-700 mt-1">@Model.DailyReport.ProductSales.FormattedTotal</h3>
                    <p class="text-xs text-slate-500 mt-1">@Model.DailyReport.ProductSales.Count counter sale(s) recorded</p>
                </div>

                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
                    <span class="text-xs uppercase font-bold text-slate-500 block">Grand Total Revenue</span>
                    <h3 class="text-2xl font-serif font-black text-emerald-700 mt-1">@Model.DailyReport.FormattedGrandTotal</h3>
                    <p class="text-xs text-slate-500 mt-1">In-shop settlement (Service + Products)</p>
                </div>
            </div>

            <!-- Daily Revenue Split Visual Bar (Cuts vs Products) -->
            @{
                var dailyGrand = Model.DailyReport.GrandTotal > 0 ? Model.DailyReport.GrandTotal : 1m;
                var dailyCutsPct = (int)Math.Round((Model.DailyReport.TotalSales / dailyGrand) * 100);
                var dailyProdPct = 100 - dailyCutsPct;
            }
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-4 space-y-2">
                <div class="flex items-center justify-between text-xs font-bold">
                    <span class="text-amber-800 flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded bg-amber-500 inline-block"></span>
                        <span>Cuts & Services: @Model.DailyReport.FormattedTotalSales (@dailyCutsPct%)</span>
                    </span>
                    <span class="text-emerald-800 flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded bg-emerald-500 inline-block"></span>
                        <span>Retail Products: @Model.DailyReport.ProductSales.FormattedTotal (@dailyProdPct%)</span>
                    </span>
                </div>
                <div class="h-3 w-full bg-slate-100 rounded-full overflow-hidden flex shadow-inner">
                    <div class="bg-amber-500 h-full transition-all" style="width: @dailyCutsPct%;"></div>
                    <div class="bg-emerald-500 h-full transition-all" style="width: @dailyProdPct%;"></div>
                </div>
            </div>

            <!-- DAILY SALES CHARTS (Line Graph + Pie Graph + Bar Graph) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Line Chart: Hourly Revenue Trajectory (7 cols) -->
                <div class="lg:col-span-7 bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5 space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <div>
                            <div class="text-[10px] uppercase font-bold tracking-wider text-amber-700">INTRADAY TRAJECTORY</div>
                            <h3 class="text-sm font-serif font-bold text-slate-900">Hourly Revenue Stream (Line Graph)</h3>
                        </div>
                        <span class="text-[11px] font-mono text-slate-500">9:00 AM – 7:00 PM</span>
                    </div>
                    <div class="relative h-64 w-full">
                        <canvas id="dailyHourlyChart"></canvas>
                    </div>
                </div>

                <!-- Pie / Doughnut Chart: Category & Revenue Share (5 cols) -->
                <div class="lg:col-span-5 bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5 space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <div>
                            <div class="text-[10px] uppercase font-bold tracking-wider text-emerald-700">REVENUE DISTRIBUTION</div>
                            <h3 class="text-sm font-serif font-bold text-slate-900">Sales by Category & Service (Pie Graph)</h3>
                        </div>
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">Mix</span>
                    </div>
                    <div class="relative h-64 w-full flex items-center justify-center">
                        <canvas id="dailyCategoryPieChart"></canvas>
                    </div>
                </div>

                <!-- Bar Chart: Sales per Master Barber (Full width) -->
                <div class="lg:col-span-12 bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5 space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-100">
                        <div>
                            <div class="text-[10px] uppercase font-bold tracking-wider text-amber-700">BARBER PERFORMANCE</div>
                            <h3 class="text-sm font-serif font-bold text-slate-900">Completed Service Sales by Master Barber (Bar Graph)</h3>
                        </div>
                        <span class="text-xs text-slate-500 font-semibold">@Model.DailyReport.ByBarber.Count active barber(s)</span>
                    </div>
                    <div class="relative h-56 w-full">
                        <canvas id="dailyBarberBarChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Daily Journal Table matching paper sample: No., Time, Customer, Barber, Service, Amount -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-base font-serif font-bold text-slate-900">Daily Sales Journal · @Model.DailyReport.DateFormatted</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Line-item journal including completed cuts and retail product sales</p>
                    </div>

                    <!-- Type Filter Tabs: All, Service, Product -->
                    <div class="inline-flex p-1 bg-slate-100 rounded-2xl border border-slate-200/80 shadow-inner">
                        <button type="button" onclick="filterSalesJournal('all')" id="filterBtnAll"
                                class="sales-type-pill px-3.5 py-1.5 rounded-xl text-xs font-bold transition bg-slate-900 text-white shadow-xs">
                            All Sales (@Model.DailyReport.CombinedJournal.Count)
                        </button>
                        <button type="button" onclick="filterSalesJournal('service')" id="filterBtnService"
                                class="sales-type-pill px-3.5 py-1.5 rounded-xl text-xs font-bold transition text-slate-600 hover:text-slate-900">
                            Service Cuts (@Model.DailyReport.Items.Count · @Model.DailyReport.FormattedTotalSales)
                        </button>
                        <button type="button" onclick="filterSalesJournal('product')" id="filterBtnProduct"
                                class="sales-type-pill px-3.5 py-1.5 rounded-xl text-xs font-bold transition text-slate-600 hover:text-slate-900">
                            Retail Products (@Model.DailyReport.ProductSales.Count · @Model.DailyReport.ProductSales.FormattedTotal)
                        </button>
                    </div>
                </div>

                @if (!Model.DailyReport.CombinedJournal.Any())
                {
                    <div class="p-12 text-center text-slate-400 text-sm">
                        <div class="inline-flex p-3 rounded-full bg-slate-100 mb-2">
                            <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        </div>
                        <p class="font-semibold text-slate-600">No completed sales recorded for @Model.DailyReport.DateFormatted.</p>
                        <p class="text-xs text-slate-400 mt-1">Only completed appointments and settled retail counter sales generate financial records.</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table id="salesJournalTable" class="w-full text-left text-sm text-slate-600">
                            <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                                <tr>
                                    <th class="py-3 px-6 w-12 text-center">No.</th>
                                    <th class="py-3 px-6">Time</th>
                                    <th class="py-3 px-6">Customer</th>
                                    <th class="py-3 px-6">Barber / Counter</th>
                                    <th class="py-3 px-6">Service / Item</th>
                                    <th class="py-3 px-6 text-center">Type</th>
                                    <th class="py-3 px-6 text-right">Amount (₱)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
