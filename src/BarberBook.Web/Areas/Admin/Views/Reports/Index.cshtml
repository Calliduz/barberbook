@model BarberBook.Web.Areas.Admin.Controllers.AdminReportsViewModel
@{
    ViewData["Title"] = "Sales & Transaction Reports";
    string[] monthNames = new[] { "", "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
}

<div class="space-y-6">
    <!-- Header -->
    <div class="sm:flex sm:items-center sm:justify-between pb-4 border-b border-slate-200">
        <div>
            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Sales & Transaction Reports</h1>
            <p class="mt-1 text-sm text-slate-600 font-sans">Automated financial journals generated strictly from completed customer appointments and counter sales.</p>
        </div>
        <div class="mt-4 sm:mt-0 flex flex-wrap gap-2">
            <a href="/admin/reports/export?tab=@Model.ActiveTab&date=@Model.SelectedDateString&year=@Model.SelectedYear&month=@Model.SelectedMonth" 
               class="h-[38px] px-4 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-sm flex items-center gap-1.5 transition whitespace-nowrap">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                <span>Export to CSV / Excel</span>
            </a>
            <button type="button" onclick="window.print()" class="h-[38px] px-4 rounded-xl text-xs font-bold bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 shadow-sm flex items-center gap-1.5 transition whitespace-nowrap">
                <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24-1.076-.673-2.684-.673-4.008 0-3.26 2.37-5.821 5.953-5.821 3.582 0 5.953 2.561 5.953 5.821 0 1.324-.433 2.932-.673 4.008m-10.56 0h11.12m-11.12 0A2.25 2.25 0 004.5 16.079v3.171A2.25 2.25 0 006.75 21.5h10.5a2.25 2.25 0 002.25-2.25v-3.171a2.25 2.25 0 00-1.68-2.25" /></svg>
                <span>Print Report</span>
            </button>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="flex border-b border-slate-200 gap-2 sm:gap-4 overflow-x-auto">
        <a href="/admin/reports?tab=daily&date=@Model.SelectedDateString"
           class="py-3 px-4 border-b-2 text-sm font-bold whitespace-nowrap transition flex items-center gap-2 @(Model.ActiveTab == "daily" ? "border-amber-600 text-amber-700 bg-amber-50/50" : "border-transparent text-slate-600 hover:text-slate-900")">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.253 3v12a2.25 2.25 0 002.25 2.25h13.5A2.25 2.25 0 0021 18V7.5A2.25 2.25 0 0018.75 5.25H5.25A2.25 2.25 0 003 7.5v12" /></svg>
            <span>Daily Sales</span>
        </a>
        <a href="/admin/reports?tab=monthly&year=@Model.SelectedYear&month=@Model.SelectedMonth"
           class="py-3 px-4 border-b-2 text-sm font-bold whitespace-nowrap transition flex items-center gap-2 @(Model.ActiveTab == "monthly" ? "border-amber-600 text-amber-700 bg-amber-50/50" : "border-transparent text-slate-600 hover:text-slate-900")">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
            <span>Monthly Sales</span>
        </a>
        <a href="/admin/reports?tab=customers&customerId=@Model.SelectedCustomerId"
           class="py-3 px-4 border-b-2 text-sm font-bold whitespace-nowrap transition flex items-center gap-2 @(Model.ActiveTab == "customers" ? "border-amber-600 text-amber-700 bg-amber-50/50" : "border-transparent text-slate-600 hover:text-slate-900")">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
            <span>Customer Transactions</span>
        </a>
        <a href="/admin/reports?tab=barbers&barberId=@Model.SelectedBarberId"
           class="py-3 px-4 border-b-2 text-sm font-bold whitespace-nowrap transition flex items-center gap-2 @(Model.ActiveTab == "barbers" ? "border-amber-600 text-amber-700 bg-amber-50/50" : "border-transparent text-slate-600 hover:text-slate-900")">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672L13.684 16.6m0 0l-2.51 2.225.569-9.47 5.227 7.917-3.286-.672zm-7.518-.267A8.25 8.25 0 1120.25 10.5M8.288 14.212A5.25 5.25 0 1117.25 10.5" /></svg>
            <span>Barber Transactions</span>
        </a>
    </div>

    @if (Model.ActiveTab == "daily")
    {
        <!-- DAILY SALES VIEW -->
        <div class="space-y-6">
            <!-- Filter & Preset Bar -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-3.5 sm:p-4 flex flex-col sm:flex-row justify-between items-center gap-3">
                <form id="dailyDateForm" method="get" action="/admin/reports" class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
                    <input type="hidden" name="tab" value="daily" />
                    <label for="date" class="text-xs font-bold uppercase tracking-wider text-slate-600">Select Date:</label>
                    <input type="date" id="date" name="date" value="@Model.SelectedDateString" onchange="this.form.submit()"
                           class="filter-control h-[38px] text-xs font-bold text-slate-900" />
                </form>

                <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mr-1">Presets:</span>
                    <button type="button" onclick="setDailyDate(getTodayStr())" class="h-[32px] px-3 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">Today</button>
                    <button type="button" onclick="setDailyDate(getYesterdayStr())" class="h-[32px] px-3 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition">Yesterday</button>
                    <a href="/admin/reports?tab=monthly" class="h-[32px] px-3 rounded-lg text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 transition inline-flex items-center">This Month</a>
                </div>
            </div>

            <!-- Daily Summary Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div class="kpi-accent-card bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
                    <span class="text-xs uppercase font-bold text-slate-500 block">Service Sales (Completed)</span>
                    <h3 class="text-2xl kpi-value font-sans font-black tabular-nums text-slate-900 mt-1">@Model.DailyReport.FormattedTotalSales</h3>
                    <p class="text-xs text-slate-500 mt-1">@Model.DailyReport.CompletedCount Completed Appointments</p>
                </div>

                <div class="kpi-accent-card bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
                    <span class="text-xs uppercase font-bold text-slate-500 block">Product Sales (Retail)</span>
                    <h3 class="text-2xl kpi-value font-sans font-black tabular-nums text-amber-700 mt-1">@Model.DailyReport.ProductSales.FormattedTotal</h3>
                    <p class="text-xs text-slate-500 mt-1">@Model.DailyReport.ProductSales.Count counter sale(s) recorded</p>
                </div>

                <div class="kpi-accent-card bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-5">
                    <span class="text-xs uppercase font-bold text-slate-500 block">Grand Total Revenue</span>
                    <h3 class="text-2xl kpi-value font-sans font-black tabular-nums text-emerald-700 mt-1">@Model.DailyReport.FormattedGrandTotal</h3>
                    <p class="text-xs text-slate-500 mt-1">In-shop settlement (Service + Products)</p>
                </div>
            </div>

            <!-- Daily Visual Analytics Row (Chart.js) -->
            @if (Model.DailyReport.GrandTotal > 0)
            {
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    <!-- Revenue Split: Services vs Retail (5 cols) -->
                    <div class="md:col-span-5 bg-white/95 rounded-2xl border border-slate-200/90 shadow-sm p-6 flex flex-col justify-between">
                        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                            <div>
                                <h3 class="font-serif font-bold text-slate-900 text-sm">Revenue Mix</h3>
                                <p class="text-xs text-slate-500 mt-0.5">Services vs. Retail Product Sales</p>
                            </div>
                            <span class="text-xs font-bold text-emerald-700">@Model.DailyReport.FormattedGrandTotal</span>
                        </div>
                        <div class="mt-3 relative h-48 w-full flex items-center justify-center">
                            <canvas id="dailyRevenueSplitChart"></canvas>
                        </div>
                        <div class="mt-3 grid grid-cols-2 gap-2 text-xs border-t border-slate-100 pt-3">
                            <div class="p-2 rounded-lg bg-slate-50 border border-slate-200">
                                <span class="text-slate-400 block text-[10px] uppercase font-bold">Services</span>
                                <span class="font-bold text-slate-900">@Model.DailyReport.FormattedTotalSales</span>
                            </div>
                            <div class="p-2 rounded-lg bg-amber-50 border border-amber-200">
                                <span class="text-amber-700 block text-[10px] uppercase font-bold">Retail</span>
                                <span class="font-bold text-amber-900">@Model.DailyReport.ProductSales.FormattedTotal</span>
                            </div>
                        </div>
                    </div>

                    <!-- Revenue by Barber Horizontal Bar (7 cols) -->
                    <div class="md:col-span-7 bg-white/95 rounded-2xl border border-slate-200/90 shadow-sm p-6">
                        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                            <div>
                                <h3 class="font-serif font-bold text-slate-900 text-sm">Barber Revenue Distribution</h3>
                                <p class="text-xs text-slate-500 mt-0.5">Sales contribution per master barber</p>
                            </div>
                            <span class="text-xs font-bold text-slate-400">@Model.DailyReport.ByBarber.Count active</span>
                        </div>
                        <div class="mt-4 relative h-56 w-full">
                            <canvas id="dailyBarberBarChart"></canvas>
                        </div>
                    </div>
                </div>
            }

            <!-- Daily Journal Table matching paper sample: No., Time, Customer, Barber, Service, Amount -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-serif font-bold text-slate-900">Daily Sales Journal · @Model.DailyReport.DateFormatted</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Line-item journal including completed cuts and retail product sales</p>
                    </div>
                    <span class="text-xs text-slate-500 font-medium">@Model.DailyReport.CombinedJournal.Count entries logged</span>
                </div>

                @if (!Model.DailyReport.CombinedJournal.Any())
                {
                    <div class="p-12 text-center text-slate-400 text-sm">
                        <div class="inline-flex p-3 rounded-full bg-slate-100 mb-2">
                            <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        </div>
                        <p class="font-semibold text-slate-600">No completed sales recorded for @Model.DailyReport.DateFormatted.</p>
                        <p class="text-xs text-slate-400 mt-1">Only completed appointments and settled retail counter sales generate financial records.</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-slate-600">
                            <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                                <tr>
                                    <th class="py-3 px-6 w-12 text-center">No.</th>
                                    <th class="py-3 px-6">Time</th>
                                    <th class="py-3 px-6">Customer</th>
                                    <th class="py-3 px-6">Barber / Counter</th>
                                    <th class="py-3 px-6">Service / Item</th>
                                    <th class="py-3 px-6 text-center">Type</th>
                                    <th class="py-3 px-6 text-right">Amount (₱)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var row in Model.DailyReport.CombinedJournal)
                                {
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3.5 px-6 text-center font-bold text-slate-400">
                                            @row.No
                                        </td>
                                        <td class="py-3.5 px-6 font-semibold text-slate-900 whitespace-nowrap">
                                            @row.Time
                                        </td>
                                        <td class="py-3.5 px-6 font-medium text-slate-900">
                                            @row.Customer
                                            <span class="block text-[11px] font-mono text-amber-800">@row.ReferenceCode</span>
                                        </td>
                                        <td class="py-3.5 px-6 font-medium text-slate-700">
                                            @row.Barber
                                        </td>
                                        <td class="py-3.5 px-6 text-slate-800 font-medium">
                                            @row.Service
                                        </td>
                                        <td class="py-3.5 px-6 text-center whitespace-nowrap">
                                            @if (row.ItemType == "Retail Product")
                                            {
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200">Retail Product</span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">Service</span>
                                            }
                                        </td>
                                        <td class="py-3.5 px-6 text-right font-serif font-bold text-slate-900 whitespace-nowrap">
                                            @row.FormattedAmount
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-slate-50/90 font-bold border-t-2 border-slate-200 text-slate-900">
                                <tr>
                                    <td colspan="6" class="py-3.5 px-6 text-right uppercase text-xs tracking-wider">Grand Total Revenue</td>
                                    <td class="py-3.5 px-6 text-right font-serif text-base text-emerald-700">@Model.DailyReport.FormattedGrandTotal</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>

            <!-- Breakdown By Barber & Service -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Per Barber -->
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 mb-4">Breakdown by Master Barber</h3>
                    @if (!Model.DailyReport.ByBarber.Any())
                    {
                        <p class="text-xs text-slate-400 italic">No barber activity on this date.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var b in Model.DailyReport.ByBarber)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                    <div>
                                        <span class="font-bold text-slate-900 block text-sm">@b.Name</span>
                                        <span class="text-xs text-slate-500">@b.Count appointment@(b.Count > 1 ? "s" : "") completed</span>
                                    </div>
                                    <span class="font-serif font-bold text-base text-slate-900">@b.FormattedTotalSales</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Per Service -->
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 mb-4">Breakdown by Service</h3>
                    @if (!Model.DailyReport.ByService.Any())
                    {
                        <p class="text-xs text-slate-400 italic">No services rendered on this date.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var s in Model.DailyReport.ByService)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                    <div>
                                        <span class="font-bold text-slate-900 block text-sm">@s.Name</span>
                                        <span class="text-xs text-slate-500">@s.Count service@(s.Count > 1 ? "s" : "") rendered</span>
                                    </div>
                                    <span class="font-serif font-bold text-base text-slate-900">@s.FormattedTotalSales</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "monthly")
    {
        <!-- MONTHLY SALES VIEW -->
        <div class="space-y-6">
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-4 sm:p-5 flex flex-col sm:flex-row justify-between items-center gap-4">
                <form method="get" action="/admin/reports" class="flex items-center gap-3 w-full sm:w-auto">
                    <input type="hidden" name="tab" value="monthly" />
                    <label class="text-xs font-bold uppercase tracking-wider text-slate-600">Select Month & Year:</label>
                    <select name="month" onchange="this.form.submit()" class="rounded-xl border border-slate-300 px-3 py-2 text-sm font-bold text-slate-900 shadow-sm">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == Model.SelectedMonth)">@monthNames[m]</option>
                        }
                    </select>
                    <select name="year" onchange="this.form.submit()" class="rounded-xl border border-slate-300 px-3 py-2 text-sm font-bold text-slate-900 shadow-sm">
                        @for (int y = 2025; y <= 2028; y++)
                        {
                            <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                        }
                    </select>
                </form>

                <div class="flex items-center gap-4 sm:gap-6">
                    <div class="text-right">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Service Sales</span>
                        <span class="text-base kpi-value font-sans font-bold tabular-nums text-slate-800">@Model.MonthlyReport.FormattedTotalSales</span>
                    </div>
                    <div class="text-right">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Product Sales</span>
                        <span class="text-base kpi-value font-sans font-bold tabular-nums text-amber-700">@Model.MonthlyReport.FormattedProductSales</span>
                    </div>
                    <div class="text-right border-l border-slate-200 pl-4">
                        <span class="text-xs uppercase font-bold text-slate-500 block">Grand Total</span>
                        <span class="text-2xl kpi-value font-sans font-black tabular-nums text-emerald-700">@Model.MonthlyReport.FormattedGrandTotal</span>
                    </div>
                </div>
            </div>

            <!-- Monthly Visual Trend Chart (Chart.js Interactive) -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                    <div>
                        <h3 class="text-base font-serif font-bold text-slate-900">Income Distribution · @monthNames[Model.SelectedMonth] @Model.SelectedYear</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Daily breakdown of Service revenue and Retail product counter sales</p>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-900 border border-amber-200">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                        Full Month Trend
                    </span>
                </div>
                <div class="mt-4 relative h-64 sm:h-72 w-full">
                    <canvas id="monthlySalesTrendChart"></canvas>
                </div>
            </div>

            <!-- Day-by-Day Table -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-serif font-bold text-slate-900">Day-by-Day Sales Summary (@monthNames[Model.SelectedMonth] @Model.SelectedYear)</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Sum of daily totals equals monthly total: Services @Model.MonthlyReport.FormattedTotalSales &bull; Products @Model.MonthlyReport.FormattedProductSales &bull; Grand @Model.MonthlyReport.FormattedGrandTotal</p>
                    </div>
                    <span class="text-xs text-slate-500 font-medium">@Model.MonthlyReport.CompletedCount total appointments</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                            <tr>
                                <th class="py-3 px-6">Date</th>
                                <th class="py-3 px-6 text-center">Day of Week</th>
                                <th class="py-3 px-6 text-center">Completed Visits</th>
                                <th class="py-3 px-6 text-right">Service Sales</th>
                                <th class="py-3 px-6 text-right">Product Sales</th>
                                <th class="py-3 px-6 text-right font-black">Grand Total</th>
                                <th class="py-3 px-6 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var day in Model.MonthlyReport.DailyTotals)
                            {
                                <tr class="hover:bg-slate-50/80 transition @(day.GrandTotal > 0 ? "bg-amber-50/20" : "")">
                                    <td class="py-3 px-6 font-bold text-slate-900">
                                        @day.DateFormatted
                                    </td>
                                    <td class="py-3 px-6 text-center text-xs font-semibold text-slate-500">
                                        @day.DayOfWeek
                                    </td>
                                    <td class="py-3 px-6 text-center font-medium @(day.CompletedCount > 0 ? "text-slate-900 font-bold" : "text-slate-400")">
                                        @day.CompletedCount
                                    </td>
                                    <td class="py-3 px-6 text-right font-serif font-medium text-slate-800">
                                        @day.FormattedTotalSales
                                    </td>
                                    <td class="py-3 px-6 text-right font-serif font-medium text-amber-800">
                                        @day.FormattedProductSales
                                    </td>
                                    <td class="py-3 px-6 text-right font-serif font-bold text-slate-900">
                                        @day.FormattedGrandTotal
                                    </td>
                                    <td class="py-3 px-6 text-right">
                                        @if (day.GrandTotal > 0)
                                        {
                                            <a href="/admin/reports?tab=daily&date=@day.Date.ToString("yyyy-MM-dd", null)" class="text-xs font-bold text-amber-700 hover:underline">
                                                View Daily →
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-slate-400">No activity</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-slate-50 font-bold border-t-2 border-slate-200 text-slate-900">
                            <tr>
                                <td colspan="2" class="py-3.5 px-6 uppercase text-xs tracking-wider">Total For @monthNames[Model.SelectedMonth] @Model.SelectedYear:</td>
                                <td class="py-3.5 px-6 text-center font-serif text-base">@Model.MonthlyReport.CompletedCount</td>
                                <td class="py-3.5 px-6 text-right font-serif text-base text-slate-900">@Model.MonthlyReport.FormattedTotalSales</td>
                                <td class="py-3.5 px-6 text-right font-serif text-base text-amber-800">@Model.MonthlyReport.FormattedProductSales</td>
                                <td class="py-3.5 px-6 text-right font-serif text-base text-emerald-800">@Model.MonthlyReport.FormattedGrandTotal</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Monthly Breakdowns -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Per Barber -->
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 mb-4">Monthly Breakdown by Barber</h3>
                    @if (!Model.MonthlyReport.ByBarber.Any())
                    {
                        <p class="text-xs text-slate-400 italic">No barber sales recorded this month.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var b in Model.MonthlyReport.ByBarber)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                    <div>
                                        <span class="font-bold text-slate-900 block text-sm">@b.Name</span>
                                        <span class="text-xs text-slate-500">@b.Count appointment@(b.Count > 1 ? "s" : "") completed</span>
                                    </div>
                                    <span class="font-serif font-bold text-base text-slate-900">@b.FormattedTotalSales</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Per Service -->
                <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-6">
                    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-700 mb-4">Monthly Breakdown by Service</h3>
                    @if (!Model.MonthlyReport.ByService.Any())
                    {
                        <p class="text-xs text-slate-400 italic">No services rendered this month.</p>
                    }
                    else
                    {
                        <div class="space-y-3">
                            @foreach (var s in Model.MonthlyReport.ByService)
                            {
                                <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-100">
                                    <div>
                                        <span class="font-bold text-slate-900 block text-sm">@s.Name</span>
                                        <span class="text-xs text-slate-500">@s.Count service@(s.Count > 1 ? "s" : "") rendered</span>
                                    </div>
                                    <span class="font-serif font-bold text-base text-slate-900">@s.FormattedTotalSales</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "customers")
    {
        <!-- CUSTOMER TRANSACTIONS VIEW -->
        <div class="space-y-6">
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-4 sm:p-5 flex flex-col md:flex-row justify-between items-center gap-4">
                <form method="get" action="/admin/reports" class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    <input type="hidden" name="tab" value="customers" />
                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">Select Client:</label>
                        <select name="customerId" onchange="this.form.submit()" class="rounded-xl border border-slate-300 px-3.5 py-2 text-sm font-bold text-slate-900 shadow-sm">
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Id" selected="@(c.Id == Model.SelectedCustomerId)">@c.FullName (@c.Email)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">From:</label>
                        <input type="date" name="startDate" value="@Model.StartDateString"
                               class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-800" />
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">To:</label>
                        <input type="date" name="endDate" value="@Model.EndDateString"
                               class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-800" />
                    </div>

                    <div class="pt-5">
                        <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm">
                            Apply Filter
                        </button>
                    </div>
                </form>

                <div class="text-right">
                    <span class="text-xs uppercase font-bold text-slate-500 block">Total Spent</span>
                    <span class="text-2xl kpi-value font-sans font-black tabular-nums text-amber-700">@Model.CustomerReport.FormattedTotalSpent</span>
                    <span class="text-xs text-slate-500">@Model.CustomerReport.CompletedCount transactions</span>
                </div>
            </div>

            <!-- Customer Transaction Record -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-serif font-bold text-slate-900">Transaction Record · @Model.CustomerReport.CustomerName</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Completed appointments (newest first)</p>
                    </div>
                    @if (Model.SelectedCustomerId > 0)
                    {
                        <a href="/admin/customers/@Model.SelectedCustomerId" class="text-xs font-bold text-amber-700 hover:underline">
                            View Customer Profile →
                        </a>
                    }
                </div>

                @if (!Model.CustomerReport.Transactions.Any())
                {
                    <div class="p-12 text-center text-slate-400 text-sm">
                        No completed transactions recorded for @Model.CustomerReport.CustomerName.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-slate-600">
                            <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                                <tr>
                                    <th class="py-3 px-6">Date</th>
                                    <th class="py-3 px-6">Service</th>
                                    <th class="py-3 px-6">Barber</th>
                                    <th class="py-3 px-6">Status</th>
                                    <th class="py-3 px-6 text-right">Amount (₱)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var tx in Model.CustomerReport.Transactions)
                                {
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3.5 px-6 font-medium text-slate-900 whitespace-nowrap">
                                            @tx.DateFormatted
                                            <span class="block text-[11px] font-mono text-amber-800">@tx.ReferenceCode &bull; @tx.TimeFormatted</span>
                                        </td>
                                        <td class="py-3.5 px-6 font-semibold text-slate-800">@tx.Service</td>
                                        <td class="py-3.5 px-6 text-slate-700">@tx.Barber</td>
                                        <td class="py-3.5 px-6">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
                                                @tx.Status
                                            </span>
                                        </td>
                                        <td class="py-3.5 px-6 text-right font-serif font-bold text-slate-900">@tx.FormattedAmount</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-slate-50 font-bold border-t-2 border-slate-200 text-slate-900">
                                <tr>
                                    <td colspan="4" class="py-3.5 px-6 text-right uppercase text-xs tracking-wider">Total Spent</td>
                                    <td class="py-3.5 px-6 text-right font-serif text-base text-amber-700">@Model.CustomerReport.FormattedTotalSpent</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else if (Model.ActiveTab == "barbers")
    {
        <!-- BARBER TRANSACTIONS VIEW -->
        <div class="space-y-6">
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm p-4 sm:p-5 flex flex-col md:flex-row justify-between items-center gap-4">
                <form method="get" action="/admin/reports" class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    <input type="hidden" name="tab" value="barbers" />
                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">Select Barber:</label>
                        <select name="barberId" onchange="this.form.submit()" class="rounded-xl border border-slate-300 px-3.5 py-2 text-sm font-bold text-slate-900 shadow-sm">
                            @foreach (var b in Model.Barbers)
                            {
                                <option value="@b.Id" selected="@(b.Id == Model.SelectedBarberId)">@b.DisplayName</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">From:</label>
                        <input type="date" name="startDate" value="@Model.StartDateString"
                               class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-800" />
                    </div>

                    <div>
                        <label class="text-xs font-bold uppercase tracking-wider text-slate-600 block mb-1">To:</label>
                        <input type="date" name="endDate" value="@Model.EndDateString"
                               class="rounded-xl border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-800" />
                    </div>

                    <div class="pt-5">
                        <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm">
                            Apply Filter
                        </button>
                    </div>
                </form>

                <div class="flex items-center gap-4 sm:gap-6">
                    <div class="text-right">
                        <span class="text-[10px] uppercase font-bold text-slate-400 block">Gross Sales</span>
                        <span class="text-base font-serif font-bold text-slate-800">@Model.BarberReport.FormattedTotalSales</span>
                    </div>
                    <div class="text-right border-l border-slate-200 pl-4">
                        <span class="text-[10px] uppercase font-bold text-emerald-600 block">Barber Commission (50%)</span>
                        <span class="text-base kpi-value font-sans font-bold tabular-nums text-emerald-700">@Model.BarberReport.FormattedTotalCommission</span>
                    </div>
                    <div class="text-right border-l border-slate-200 pl-4">
                        <span class="text-xs uppercase font-bold text-slate-500 block">Shop Net Share</span>
                        <span class="text-2xl kpi-value font-sans font-black tabular-nums text-amber-700">@Model.BarberReport.FormattedShopNetShare</span>
                        <span class="text-[11px] text-slate-500 block">@Model.BarberReport.CompletedCount transactions</span>
                    </div>
                </div>
            </div>

            <!-- Barber Transaction Record -->
            <div class="bg-white/95 rounded-2xl border border-amber-900/10 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h2 class="text-base font-serif font-bold text-slate-900">Transaction Record · Master Barber @Model.BarberReport.BarberName</h2>
                        <p class="text-xs text-slate-500 mt-0.5">Completed services (newest first) with 50% commission split</p>
                    </div>
                </div>

                @if (!Model.BarberReport.Transactions.Any())
                {
                    <div class="p-12 text-center text-slate-400 text-sm">
                        No completed transactions recorded for @Model.BarberReport.BarberName.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-slate-600">
                            <thead class="bg-slate-50 text-[11px] uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                                <tr>
                                    <th class="py-3 px-6">Date</th>
                                    <th class="py-3 px-6">Customer</th>
                                    <th class="py-3 px-6">Service</th>
                                    <th class="py-3 px-6 text-right">Service Amount</th>
                                    <th class="py-3 px-6 text-right text-emerald-800">Barber Cut (50%)</th>
                                    <th class="py-3 px-6 text-right">Shop Share (50%)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var tx in Model.BarberReport.Transactions)
                                {
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3.5 px-6 font-medium text-slate-900 whitespace-nowrap">
                                            @tx.DateFormatted
                                            <span class="block text-[11px] font-mono text-amber-800">@tx.ReferenceCode &bull; @tx.TimeFormatted</span>
                                        </td>
                                        <td class="py-3.5 px-6 font-bold text-slate-900">@tx.Customer</td>
                                        <td class="py-3.5 px-6 text-slate-700">@tx.Service</td>
                                        <td class="py-3.5 px-6 text-right font-serif font-bold text-slate-900">@tx.FormattedAmount</td>
                                        <td class="py-3.5 px-6 text-right font-serif font-bold text-emerald-700">@tx.FormattedCommissionAmount</td>
                                        <td class="py-3.5 px-6 text-right font-serif font-bold text-slate-700">@tx.FormattedShopShare</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-slate-50 font-bold border-t-2 border-slate-200 text-slate-900">
                                <tr>
                                    <td colspan="3" class="py-3.5 px-6 text-right uppercase text-xs tracking-wider">Totals:</td>
                                    <td class="py-3.5 px-6 text-right font-serif text-base text-slate-900">@Model.BarberReport.FormattedTotalSales</td>
                                    <td class="py-3.5 px-6 text-right font-serif text-base text-emerald-700">@Model.BarberReport.FormattedTotalCommission</td>
                                    <td class="py-3.5 px-6 text-right font-serif text-base text-amber-700">@Model.BarberReport.FormattedShopNetShare</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    function getTodayStr() {
        return new Date().toISOString().split('T')[0];
    }

    function getYesterdayStr() {
        const d = new Date();
        d.setDate(d.getDate() - 1);
        return d.toISOString().split('T')[0];
    }

    function setDailyDate(dateStr) {
        const input = document.getElementById('date');
        if (input) {
            input.value = dateStr;
            document.getElementById('dailyDateForm').submit();
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        if (typeof Chart === 'undefined') {
            console.warn('Chart.js is not loaded.');
            return;
        }

        // 1. Daily Revenue Mix Doughnut
        const dailySplitCtx = document.getElementById('dailyRevenueSplitChart');
        if (dailySplitCtx) {
            const serviceSales = @Model.DailyReport.TotalSales;
            const productSales = @Model.DailyReport.ProductSales.Total;
            new Chart(dailySplitCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Service Sales', 'Retail Products'],
                    datasets: [{
                        data: [serviceSales, productSales],
                        backgroundColor: ['#1e293b', '#d97706'],
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ` ${ctx.label}: ₱${Number(ctx.raw).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // 2. Daily Barber Revenue Horizontal Bar Chart
        const dailyBarberCtx = document.getElementById('dailyBarberBarChart');
        if (dailyBarberCtx) {
            const barberLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyReport.ByBarber.Select(b => b.Name)));
            const barberSales = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DailyReport.ByBarber.Select(b => b.TotalSales)));

            new Chart(dailyBarberCtx, {
                type: 'bar',
                data: {
                    labels: barberLabels,
                    datasets: [{
                        label: 'Sales Revenue',
                        data: barberSales,
                        backgroundColor: '#d97706',
                        borderRadius: 6,
                        maxBarThickness: 24
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                font: { family: 'Plus Jakarta Sans', size: 11 },
                                color: '#64748b',
                                callback: function (v) { return '₱' + Number(v).toLocaleString(); }
                            }
                        },
                        y: {
                            grid: { display: false },
                            ticks: { font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' }, color: '#1e293b' }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ` Revenue: ₱${Number(ctx.raw).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // 3. Monthly Sales Trend Multi-Bar Chart
        const monthlyTrendCtx = document.getElementById('monthlySalesTrendChart');
        if (monthlyTrendCtx) {
            const days = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyReport.DailyTotals.Select(d => d.Day.ToString())));
            const services = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyReport.DailyTotals.Select(d => d.TotalSales)));
            const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyReport.DailyTotals.Select(d => d.ProductSales)));

            new Chart(monthlyTrendCtx, {
                type: 'bar',
                data: {
                    labels: days,
                    datasets: [
                        {
                            label: 'Services',
                            data: services,
                            backgroundColor: '#1e293b',
                            borderRadius: 4,
                            maxBarThickness: 16
                        },
                        {
                            label: 'Retail Products',
                            data: products,
                            backgroundColor: '#d97706',
                            borderRadius: 4,
                            maxBarThickness: 16
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            stacked: true,
                            grid: { display: false },
                            ticks: { font: { family: 'Plus Jakarta Sans', size: 10 }, color: '#64748b' }
                        },
                        y: {
                            stacked: true,
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                font: { family: 'Plus Jakarta Sans', size: 11 },
                                color: '#64748b',
                                callback: function (v) { return '₱' + Number(v).toLocaleString(); }
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'top',
                            align: 'end',
                            labels: {
                                boxWidth: 12,
                                boxHeight: 12,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                font: { family: 'Plus Jakarta Sans', size: 11, weight: 'bold' },
                                color: '#475569'
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ` ${ctx.dataset.label}: ₱${Number(ctx.raw).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
                                }
                            }
                        }
                    }
                }
            });
        }
    });
</script>
}
