@model BarberBook.Web.Models.Admin.ServiceListViewModel
@{
    ViewData["Title"] = "Services & Prices";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 font-serif">Services & Prices</h1>
            <p class="mt-1 text-sm text-slate-500">Configure barber services, fixed pricing in Philippine Pesos (₱), and durations in 30-minute intervals.</p>
        </div>
        <div class="mt-4 sm:mt-0">
            <button type="button" onclick="openCreateModal()" class="inline-flex items-center justify-center h-[38px] rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 px-4 text-xs font-bold shadow-sm transition active:scale-[0.98] whitespace-nowrap">
                <svg class="-ml-1 mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Add New Service
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-md bg-emerald-50 p-4 border border-emerald-200">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-emerald-800">@TempData["SuccessMessage"]</p>
                </div>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-md bg-rose-50 p-4 border border-rose-200">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-rose-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-rose-800">@TempData["ErrorMessage"]</p>
                </div>
            </div>
        </div>
    }

    <!-- Search & Filters -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-3.5">
        <form method="get" action="/admin/services" class="flex flex-col sm:flex-row gap-3 justify-between items-center">
            <div class="w-full sm:w-80 relative">
                <input type="text" name="q" value="@Model.SearchQuery" placeholder="Search by service name or description..." class="filter-control w-full pl-9 pr-4 text-xs" />
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <label for="statusFilter" class="text-xs font-bold text-slate-600 whitespace-nowrap uppercase tracking-wider">Status:</label>
                <select id="statusFilter" name="status" onchange="this.form.submit()" class="filter-control text-xs">
                    <option value="all" selected="@(Model.StatusFilter == "all")">All Statuses</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active Only</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive Only</option>
                </select>
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || Model.StatusFilter != "all")
                {
                    <a href="/admin/services" class="h-[38px] px-3 rounded-lg text-xs font-semibold text-slate-500 hover:text-slate-800 border border-slate-200 transition flex items-center whitespace-nowrap">
                        Reset
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Services Table -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <!-- Desktop Table View -->
        <div class="hidden sm:block overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                <thead class="bg-slate-50 text-slate-600 font-semibold">
                    <tr>
                        <th class="py-3.5 pl-6 pr-3">Service Name</th>
                        <th class="px-3 py-3.5">Description</th>
                        <th class="px-3 py-3.5">Duration</th>
                        <th class="px-3 py-3.5">Price</th>
                        <th class="px-3 py-3.5">Completed Bookings</th>
                        <th class="px-3 py-3.5">Status</th>
                        <th class="py-3.5 pl-3 pr-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 text-slate-700">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                No services found matching the criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var service in Model.Items)
                    {
                        <tr class="hover:bg-slate-50 transition">
                            <td class="py-4 pl-6 pr-3 font-semibold text-slate-900">
                                @service.Name
                            </td>
                            <td class="px-3 py-4 text-slate-500">
                                <span class="cell-truncate-lg block" title="@service.Description">@(string.IsNullOrWhiteSpace(service.Description) ? "-" : service.Description)</span>
                            </td>
                            <td class="px-3 py-4 text-slate-600">
                                <span class="inline-flex items-center rounded-md bg-blue-50 px-2.5 py-0.5 text-xs font-medium text-blue-700 border border-blue-200">
                                    @service.DurationMinutes mins
                                </span>
                            </td>
                            <td class="px-3 py-4 font-serif font-black text-slate-900 tabular-nums">
                                @FormattingHelpers.FormatPeso(service.Price)
                            </td>
                            <td class="px-3 py-4">
                                <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-800">
                                    @service.CompletedBookingsCount appointments
                                </span>
                            </td>
                            <td class="px-3 py-4">
                                @if (service.IsActive)
                                {
                                    <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 border border-emerald-200">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-1 text-xs font-medium text-rose-700 border border-rose-200">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="py-4 pl-3 pr-6 text-right whitespace-nowrap space-x-2">
                                <button type="button" onclick="openEditModal(@service.Id, '@Html.Raw(Html.Encode(service.Name))', '@Html.Raw(Html.Encode(service.Description ?? ""))', @service.Price, @service.DurationMinutes)" class="text-brand-600 hover:text-brand-900 font-medium text-xs">Edit</button>
                                <span class="text-slate-300">|</span>
                                <button type="button" onclick="confirmToggleStatus(@service.Id, '@Html.Raw(Html.Encode(service.Name))', @(service.IsActive ? "true" : "false"))" class="@(service.IsActive ? "text-rose-600 hover:text-rose-800" : "text-emerald-600 hover:text-emerald-800") font-medium text-xs">
                                    @(service.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Stacked Card View -->
        <div class="sm:hidden divide-y divide-slate-100">
            @if (!Model.Items.Any())
            {
                <div class="py-12 text-center text-slate-400 text-xs">
                    No services found matching the criteria.
                </div>
            }
            @foreach (var service in Model.Items)
            {
                <div class="p-4 space-y-3 hover:bg-amber-50/20 transition">
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="font-bold text-slate-900 text-base">@service.Name</h3>
                                @if (service.IsActive)
                                {
                                    <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700 border border-emerald-200">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-rose-50 px-2 py-0.5 text-[10px] font-bold text-rose-700 border border-rose-200">
                                        Inactive
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(service.Description))
                            {
                                <p class="text-xs text-slate-500 mt-1 line-clamp-2">@service.Description</p>
                            }
                        </div>
                        <div class="text-right">
                            <span class="font-serif font-black text-lg text-slate-900">
                                @FormattingHelpers.FormatPeso(service.Price)
                            </span>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 text-xs">
                        <span class="inline-flex items-center gap-1 rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 border border-blue-200">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            @service.DurationMinutes mins
                        </span>
                        <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
                            @service.CompletedBookingsCount bookings completed
                        </span>
                    </div>

                    <div class="flex items-center gap-2 pt-1 border-t border-slate-100">
                        <button type="button"
                                onclick="openEditModal(@service.Id, '@Html.Raw(Html.Encode(service.Name))', '@Html.Raw(Html.Encode(service.Description ?? ""))', @service.Price, @service.DurationMinutes)"
                                class="flex-1 py-2 px-3 rounded-xl text-xs font-bold bg-white text-slate-700 border border-slate-300 hover:bg-slate-50 shadow-2xs transition text-center">
                            Edit Service
                        </button>
                        <button type="button"
                                onclick="confirmToggleStatus(@service.Id, '@Html.Raw(Html.Encode(service.Name))', @(service.IsActive ? "true" : "false"))"
                                class="flex-1 py-2 px-3 rounded-xl text-xs font-bold @(service.IsActive ? "bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100" : "bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100") transition text-center">
                            @(service.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex flex-col sm:flex-row items-center justify-between border-t border-slate-200 bg-slate-50/80 px-4 py-3 sm:px-6 gap-3">
                <div class="text-xs text-slate-500">
                    Showing <span class="font-bold text-slate-800">@((Model.Page - 1) * Model.PageSize + 1)</span> to <span class="font-bold text-slate-800">@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))</span> of <span class="font-bold text-slate-800">@Model.TotalCount</span> services
                </div>
                <div class="inline-flex items-center rounded-xl bg-white border border-slate-200 p-1 shadow-2xs space-x-1 text-xs">
                    @if (Model.Page > 1)
                    {
                        <a href="/admin/services?page=@(Model.Page - 1)&q=@Model.SearchQuery&status=@Model.StatusFilter" class="px-3 py-1 rounded-lg text-slate-600 hover:bg-slate-100 font-semibold transition">&larr; Prev</a>
                    }
                    else
                    {
                        <span class="px-3 py-1 text-slate-300 font-semibold cursor-not-allowed opacity-50">&larr; Prev</span>
                    }

                    <span class="px-3 py-1 rounded-lg bg-amber-500 text-slate-950 font-bold shadow-xs">@Model.Page</span>

                    @if (Model.Page < Model.TotalPages)
                    {
                        <a href="/admin/services?page=@(Model.Page + 1)&q=@Model.SearchQuery&status=@Model.StatusFilter" class="px-3 py-1 rounded-lg text-slate-600 hover:bg-slate-100 font-semibold transition">Next &rarr;</a>
                    }
                    else
                    {
                        <span class="px-3 py-1 text-slate-300 font-semibold cursor-not-allowed opacity-50">Next &rarr;</span>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Service Modal -->
<div id="createModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="modal-dialog bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200">
        <div class="flex justify-between items-center mb-5 pb-3 border-b border-slate-100">
            <div>
                <h3 class="text-lg font-serif font-bold text-slate-900">Add New Service</h3>
                <p class="text-xs text-slate-500 mt-0.5">Define fixed-rate grooming service item and duration</p>
            </div>
            <button type="button" onclick="closeModal('createModal')" class="text-slate-400 hover:text-slate-600 transition p-1 rounded-lg hover:bg-slate-100">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form method="post" action="/admin/services" class="modal-body space-y-4">
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Service Name *</label>
                <input type="text" name="Name" required class="modal-input mt-1" placeholder="e.g. Skin Fade" />
            </div>
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Description</label>
                <textarea name="Description" rows="2" class="modal-input mt-1" placeholder="Short description of the service..."></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="min-w-0">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Price (₱) *</label>
                    <input type="number" step="0.01" min="0" name="Price" required class="modal-input mt-1" placeholder="150.00" />
                </div>
                <div class="min-w-0">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Duration *</label>
                    <select name="DurationMinutes" required class="modal-input mt-1">
                        <option value="30">30 minutes</option>
                        <option value="60">60 minutes</option>
                        <option value="90">90 minutes</option>
                        <option value="120">120 minutes</option>
                    </select>
                </div>
            </div>
            <p class="text-xs text-slate-400 font-medium">Durations must be in multiples of 30 minutes to match the shop scheduling grid.</p>
            <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="closeModal('createModal')" class="rounded-xl bg-slate-100 px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-200 transition">Cancel</button>
                <button type="submit" class="rounded-xl bg-amber-500 px-4 py-2 text-xs font-bold text-slate-950 hover:bg-amber-400 transition shadow-sm">Create Service</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Service Modal -->
<div id="editModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="modal-dialog bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-200">
        <div class="flex justify-between items-center mb-5 pb-3 border-b border-slate-100">
            <div>
                <h3 class="text-lg font-serif font-bold text-slate-900">Edit Service</h3>
                <p class="text-xs text-slate-500 mt-0.5">Modify pricing or duration parameters</p>
            </div>
            <button type="button" onclick="closeModal('editModal')" class="text-slate-400 hover:text-slate-600 transition p-1 rounded-lg hover:bg-slate-100">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form id="editServiceForm" method="post" action="" class="modal-body space-y-4">
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Service Name *</label>
                <input type="text" id="editName" name="Name" required class="modal-input mt-1" />
            </div>
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Description</label>
                <textarea id="editDescription" name="Description" rows="2" class="modal-input mt-1"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div class="min-w-0">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Price (₱) *</label>
                    <input type="number" step="0.01" min="0" id="editPrice" name="Price" required class="modal-input mt-1" />
                </div>
                <div class="min-w-0">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Duration *</label>
                    <select id="editDurationMinutes" name="DurationMinutes" required class="modal-input mt-1">
                        <option value="30">30 minutes</option>
                        <option value="60">60 minutes</option>
                        <option value="90">90 minutes</option>
                        <option value="120">120 minutes</option>
                    </select>
                </div>
            </div>
            <p class="text-xs text-amber-800 bg-amber-50 p-2.5 rounded-xl border border-amber-200">
                <strong>Price Integrity:</strong> Price updates only affect future bookings. Historical completed appointments retain their price snapshot.
            </p>
            <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="closeModal('editModal')" class="rounded-xl bg-slate-100 px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-200 transition">Cancel</button>
                <button type="submit" class="rounded-xl bg-amber-500 px-4 py-2 text-xs font-bold text-slate-950 hover:bg-amber-400 transition shadow-sm">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Toggle Status Confirmation Dialog -->
<div id="confirmStatusModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100">
        <h3 id="confirmStatusTitle" class="text-lg font-bold text-slate-900 mb-2">Confirm Action</h3>
        <p id="confirmStatusMessage" class="text-sm text-slate-600 mb-6"></p>
        <form id="toggleStatusForm" method="post" action="" class="flex justify-end space-x-3">
            <button type="button" onclick="closeModal('confirmStatusModal')" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 transition">Cancel</button>
            <button type="submit" id="confirmStatusBtn" class="rounded-lg px-4 py-2 text-sm font-semibold text-white transition"></button>
        </form>
    </div>
</div>

<script>
    function openCreateModal() {
        document.getElementById('createModal').classList.remove('hidden');
    }

    function openEditModal(id, name, description, price, durationMinutes) {
        document.getElementById('editServiceForm').action = '/admin/services/' + id + '/edit';
        document.getElementById('editName').value = name;
        document.getElementById('editDescription').value = description;
        document.getElementById('editPrice').value = price;
        document.getElementById('editDurationMinutes').value = durationMinutes;
        document.getElementById('editModal').classList.remove('hidden');
    }

    function confirmToggleStatus(id, name, isActive) {
        document.getElementById('toggleStatusForm').action = '/admin/services/' + id + '/toggle-status';
        const title = isActive ? 'Deactivate Service' : 'Activate Service';
        const msg = isActive
            ? 'Are you sure you want to deactivate "' + name + '"? It will be removed from customer booking and service lists, but will remain visible in past appointment histories and sales reports.'
            : 'Are you sure you want to activate "' + name + '"? It will immediately become available for customer bookings.';
        const btnClass = isActive ? 'bg-rose-600 hover:bg-rose-500' : 'bg-emerald-600 hover:bg-emerald-500';
        const btnText = isActive ? 'Deactivate' : 'Activate';

        document.getElementById('confirmStatusTitle').innerText = title;
        document.getElementById('confirmStatusMessage').innerText = msg;
        const confirmBtn = document.getElementById('confirmStatusBtn');
        confirmBtn.className = 'rounded-lg px-4 py-2 text-sm font-semibold text-white transition ' + btnClass;
        confirmBtn.innerText = btnText;

        document.getElementById('confirmStatusModal').classList.remove('hidden');
    }

    function closeModal(id) {
        document.getElementById(id).classList.add('hidden');
    }
</script>

