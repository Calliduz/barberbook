@model BarberBook.Web.Models.Admin.AdminAppointmentsViewModel
@{
    ViewData["Title"] = "Bookings Management";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <div class="inline-flex items-center gap-2 mb-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold shadow-inner">
                <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                <span>BOOKINGS & APPOINTMENT WORKSTATION</span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 font-serif">Bookings Management</h1>
            <p class="mt-1 text-sm text-slate-500">Review, confirm, reject, complete, or cancel shop appointments across all barbers.</p>
        </div>
        <div class="mt-4 sm:mt-0 flex flex-wrap items-center gap-2">
            <button type="button" onclick="openWalkInModal()" class="inline-flex items-center justify-center h-[38px] px-3.5 rounded-lg text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 shadow-sm transition whitespace-nowrap">
                <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Quick Walk-In
            </button>

            <!-- View Switcher -->
            <div class="inline-flex rounded-lg border border-slate-300 bg-white p-0.5 shadow-sm h-[38px] items-center">
                <button type="button" id="viewBtnList" onclick="switchView('list')" class="px-3 h-full text-xs font-semibold rounded-md transition text-slate-700 hover:text-slate-900 flex items-center">
                    List View
                </button>
                <button type="button" id="viewBtnDay" onclick="switchView('day')" class="px-3 h-full text-xs font-semibold rounded-md transition text-slate-700 hover:text-slate-900 flex items-center">
                    Day Calendar
                </button>
                <button type="button" id="viewBtnWeek" onclick="switchView('week')" class="px-3 h-full text-xs font-semibold rounded-md transition text-slate-700 hover:text-slate-900 flex items-center">
                    Week Calendar
                </button>
            </div>

            <button type="button" onclick="loadAppointments()" class="inline-flex items-center justify-center h-[38px] px-3 border border-slate-300 shadow-sm text-xs font-bold rounded-lg text-slate-700 bg-white hover:bg-slate-50 transition whitespace-nowrap">
                <svg class="h-3.5 w-3.5 mr-1.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh
            </button>
        </div>
    </div>

    <!-- Modern SaaS Standardized Filter Architecture -->
    <div class="bg-slate-50/90 rounded-2xl border border-slate-300 p-4 sm:p-5 shadow-xs space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <!-- 3 Clean Top Tabs -->
            <div class="flex items-center gap-2">
                <button type="button" onclick="setQuickStatus('')" id="statusPillAll" class="status-pill px-3.5 py-1.5 rounded-lg text-xs font-bold border transition bg-slate-900 text-white border-slate-900">
                    All Bookings
                </button>
                <button type="button" onclick="setQuickStatus('pending')" id="statusPillPending" class="status-pill px-3.5 py-1.5 rounded-lg text-xs font-bold border transition bg-white text-amber-800 border-amber-300 hover:bg-amber-50 flex items-center">
                    <span class="inline-block w-2 h-2 rounded-full bg-amber-500 mr-1.5 animate-pulse"></span>
                    Needs Action
                </button>
                <button type="button" onclick="setQuickStatus('completed')" id="statusPillCompleted" class="status-pill px-3.5 py-1.5 rounded-lg text-xs font-bold border transition bg-white text-slate-700 border-slate-300 hover:bg-slate-100">
                    Completed
                </button>
            </div>

            <!-- Search Field -->
            <div class="w-full sm:w-80 relative">
                <input type="text" id="filterSearch" placeholder="Search reference, customer, phone..." onkeydown="if(event.key==='Enter') applyFilters()" class="filter-control w-full pl-9 pr-4 text-xs font-medium" />
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Filter Dropdowns & Date Controls (6-Column Grid) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 pt-3 border-t border-slate-200 text-sm">
            <div>
                <label for="filterBranch" class="filter-label">Branch</label>
                <select id="filterBranch" onchange="applyFilters()" class="filter-control w-full text-xs">
                    <option value="">All Branches</option>
                    @foreach (var br in Model.Branches)
                    {
                        <option value="@br.Id">@br.Name</option>
                    }
                </select>
            </div>

            <div>
                <label for="filterBarber" class="filter-label">Barber</label>
                <select id="filterBarber" onchange="applyFilters()" class="filter-control w-full text-xs">
                    <option value="">All Barbers</option>
                    @foreach (var b in Model.Barbers)
                    {
                        <option value="@b.Id">@b.DisplayName</option>
                    }
                </select>
            </div>

            <div>
                <label for="statusFilterDropdown" class="filter-label">Status</label>
                <select id="statusFilterDropdown" onchange="setQuickStatus(this.value)" class="filter-control w-full text-xs font-semibold">
                    <option value="">All Statuses</option>
                    <option value="pending">Pending (Needs Action)</option>
                    <option value="confirmed">Confirmed</option>
                    <option value="completed">Completed</option>
                    <option value="noshow">No-Show</option>
                    <option value="cancelled">Cancelled</option>
                    <option value="rejected">Rejected</option>
                </select>
            </div>

            <div>
                <label for="filterService" class="filter-label">Service</label>
                <select id="filterService" onchange="applyFilters()" class="filter-control w-full text-xs">
                    <option value="">All Services</option>
                    @foreach (var s in Model.Services)
                    {
                        <option value="@s.Id">@s.Name (@s.FormattedPrice)</option>
                    }
                </select>
            </div>

            <div>
                <label for="filterStartDate" class="filter-label">From Date</label>
                <input type="date" id="filterStartDate" onchange="applyFilters()" class="filter-control w-full text-xs font-medium" />
            </div>

            <div>
                <label for="filterEndDate" class="filter-label">To Date</label>
                <input type="date" id="filterEndDate" onchange="applyFilters()" class="filter-control w-full text-xs font-medium" />
            </div>
        </div>

        <!-- 1-Click Date Presets -->
        <div class="flex items-center gap-1.5 pt-2 border-t border-slate-200 flex-wrap text-xs">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mr-1">Date Presets:</span>
            <button type="button" onclick="setDatePreset('today')" class="px-2.5 py-1 rounded-lg font-semibold bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 shadow-2xs transition">Today</button>
            <button type="button" onclick="setDatePreset('tomorrow')" class="px-2.5 py-1 rounded-lg font-semibold bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 shadow-2xs transition">Tomorrow</button>
            <button type="button" onclick="setDatePreset('this_week')" class="px-2.5 py-1 rounded-lg font-semibold bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 shadow-2xs transition">This Week</button>
            <button type="button" onclick="setDatePreset('this_month')" class="px-2.5 py-1 rounded-lg font-semibold bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 shadow-2xs transition">This Month</button>
            <button type="button" onclick="setDatePreset('clear')" class="px-2.5 py-1 rounded-lg font-semibold text-slate-500 hover:text-slate-800 transition">Clear Dates</button>
        </div>
    </div>

    <!-- 1. LIST VIEW CONTAINER -->
    <div id="listViewContainer" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <!-- Desktop Table View -->
        <div class="hidden sm:block overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider font-semibold">
                    <tr>
                        <th scope="col" class="px-4 py-3.5 text-left">Reference</th>
                        <th scope="col" class="px-4 py-3.5 text-left">Customer</th>
                        <th scope="col" class="px-4 py-3.5 text-left">Barber</th>
                        <th scope="col" class="px-4 py-3.5 text-left">Service</th>
                        <th scope="col" class="px-4 py-3.5 text-left">Date & Time</th>
                        <th scope="col" class="px-4 py-3.5 text-right">Price</th>
                        <th scope="col" class="px-4 py-3.5 text-center">Status</th>
                        <th scope="col" class="px-4 py-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="appointmentTableBody" class="divide-y divide-slate-200 bg-white">
                    <tr>
                        <td colspan="8" class="px-6 py-12 text-center text-slate-500">
                            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div>
                            <p class="mt-2 text-sm">Loading bookings...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Mobile Stacked Card View -->
        <div id="appointmentCardList" class="sm:hidden divide-y divide-slate-100">
            <div class="p-8 text-center text-slate-500">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div>
                <p class="mt-2 text-xs">Loading bookings...</p>
            </div>
        </div>

        <!-- Pagination Bar -->
        <div id="paginationBar" class="px-6 py-3.5 bg-slate-50/80 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between text-xs gap-3">
            <div class="text-slate-500" id="paginationInfo">Showing 0 bookings</div>
            <div class="inline-flex items-center rounded-xl bg-white border border-slate-200 p-1 shadow-2xs space-x-1 text-xs">
                <button type="button" id="prevPageBtn" onclick="changePage(-1)" class="px-3 py-1 rounded-lg text-slate-600 hover:bg-slate-100 font-semibold transition disabled:opacity-40 disabled:cursor-not-allowed">
                    &larr; Prev
                </button>
                <span id="pageIndicator" class="px-3 py-1 rounded-lg bg-amber-500 text-slate-950 font-bold shadow-xs">1</span>
                <button type="button" id="nextPageBtn" onclick="changePage(1)" class="px-3 py-1 rounded-lg text-slate-600 hover:bg-slate-100 font-semibold transition disabled:opacity-40 disabled:cursor-not-allowed">
                    Next &rarr;
                </button>
            </div>
        </div>
    </div>

    <!-- 2. DAY CALENDAR VIEW CONTAINER -->
    <div id="dayViewContainer" class="hidden space-y-4">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <button type="button" onclick="navigateDay(-1)" class="p-2 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <input type="date" id="selectedCalendarDay" onchange="renderDayView()" class="rounded-lg border-slate-300 py-1.5 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 font-semibold" />
                <button type="button" onclick="navigateDay(1)" class="p-2 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
                <button type="button" onclick="goToTodayDay()" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300">Today</button>
            </div>
            <div class="text-sm font-medium text-slate-600" id="dayViewTitle"></div>
        </div>

        <div id="dayGridContent" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 min-h-[400px]">
            <!-- Dynamic columns per barber -->
        </div>
    </div>

    <!-- 3. WEEK CALENDAR VIEW CONTAINER -->
    <div id="weekViewContainer" class="hidden space-y-4">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <button type="button" onclick="navigateWeek(-1)" class="p-2 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <button type="button" onclick="navigateWeek(1)" class="p-2 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
                <button type="button" onclick="goToCurrentWeek()" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300">Current Week</button>
            </div>
            <div class="text-sm font-semibold text-slate-800" id="weekViewTitle"></div>
        </div>

        <div id="weekGridContent" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-x-auto p-4 min-h-[450px]">
            <!-- Dynamic 7-day columns -->
        </div>
    </div>
</div>

<!-- APPOINTMENT DETAIL & TIMELINE DRAWER -->
<div id="detailDrawerBackdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden transition-opacity" onclick="closeDrawer()"></div>
<div id="detailDrawer" class="fixed inset-y-0 right-0 max-w-lg w-full bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
        <h2 class="text-lg font-bold">Appointment Details</h2>
        <button type="button" onclick="closeDrawer()" class="text-slate-400 hover:text-white p-1 rounded-md">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
    </div>

    <div class="flex-1 overflow-y-auto p-6 space-y-6" id="drawerContent">
        <!-- Rendered via JS -->
    </div>

    <div class="p-4 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-end gap-2" id="drawerActions">
        <!-- Action buttons rendered via JS based on current status -->
    </div>
</div>

<!-- STATUS ACTION MODAL (Confirm / Reject / Complete / Cancel / NoShow) -->
<div id="statusActionModal" class="fixed inset-0 bg-slate-900/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-md w-full shadow-2xl overflow-hidden border border-slate-200 animate-in fade-in zoom-in-95 duration-150">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
            <h3 class="font-bold text-slate-900" id="modalTitle">Update Appointment Status</h3>
            <button type="button" onclick="closeActionModal()" class="text-slate-400 hover:text-slate-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>

        <form id="statusActionForm" onsubmit="submitStatusAction(event)" class="p-6 space-y-4">
            <input type="hidden" id="modalAppointmentId" />
            <input type="hidden" id="modalTargetStatus" />

            <div id="modalDescription" class="text-sm text-slate-600"></div>

            <div>
                <label for="modalNote" class="block text-xs font-semibold text-slate-700 mb-1">
                    Note / Reason <span id="noteRequiredLabel" class="text-rose-500 font-bold hidden">* (Required for reject/cancel)</span>
                </label>
                <textarea id="modalNote" rows="3" placeholder="Provide an optional note or state the cancellation/rejection reason..." class="w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm"></textarea>
                <p id="modalNoteError" class="mt-1 text-xs text-rose-600 hidden font-medium">Please enter a reason before proceeding.</p>
            </div>

            <div class="flex items-center justify-end space-x-3 pt-3 border-t border-slate-100">
                <button type="button" onclick="closeActionModal()" class="px-4 py-2 rounded-lg border border-slate-300 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" id="modalSubmitBtn" class="px-4 py-2 rounded-lg text-sm font-semibold text-white shadow-sm transition">Confirm Action</button>
            </div>
        </form>
    </div>
</div>

<!-- EXPRESS WALK-IN BOOKING MODAL -->
<div id="walkInModal" class="fixed inset-0 bg-slate-900/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl overflow-hidden border border-slate-200 animate-in fade-in zoom-in-95 duration-150">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-900 text-white">
            <div class="flex items-center space-x-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
                <h3 class="font-bold text-base">Express Walk-In Booking</h3>
            </div>
            <button type="button" onclick="closeWalkInModal()" class="text-slate-400 hover:text-white">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>

        <form id="walkInForm" onsubmit="submitWalkIn(event)" class="p-6 space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="walkInBranch" class="block text-xs font-semibold text-slate-700 mb-1">Branch Station <span class="text-rose-500">*</span></label>
                    <select id="walkInBranch" required class="w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500">
                        @foreach (var br in Model.Branches)
                        {
                            <option value="@br.Id">@br.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="walkInBarber" class="block text-xs font-semibold text-slate-700 mb-1">Assigned Barber <span class="text-rose-500">*</span></label>
                    <select id="walkInBarber" required class="w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500">
                        @foreach (var b in Model.Barbers)
                        {
                            <option value="@b.Id">@b.DisplayName</option>
                        }
                    </select>
                </div>
            </div>

            <div>
                <label for="walkInService" class="block text-xs font-semibold text-slate-700 mb-1">Service <span class="text-rose-500">*</span></label>
                <select id="walkInService" required class="w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500">
                    @foreach (var s in Model.Services)
                    {
                        <option value="@s.Id">@s.Name (@s.FormattedPrice - @s.DurationMinutes mins)</option>
                    }
                </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="walkInCustomerName" class="block text-xs font-semibold text-slate-700 mb-1">Client Name <span class="text-rose-500">*</span></label>
                    <input type="text" id="walkInCustomerName" required placeholder="e.g. John Doe / Walk-in Guest" value="Walk-in Guest" class="w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500" />
                </div>
                <div>
                    <label for="walkInCustomerPhone" class="block text-xs font-semibold text-slate-700 mb-1">Phone Number (Optional)</label>
                    <input type="text" id="walkInCustomerPhone" placeholder="0917XXXXXXX" class="w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label for="walkInDate" class="block text-xs font-semibold text-slate-700 mb-1">Date <span class="text-rose-500">*</span></label>
                    <input type="date" id="walkInDate" required class="w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500" />
                </div>
                <div>
                    <label for="walkInTime" class="block text-xs font-semibold text-slate-700 mb-1">Start Time <span class="text-rose-500">*</span></label>
                    <input type="time" id="walkInTime" required class="w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500" />
                </div>
            </div>

            <div>
                <label for="walkInNotes" class="block text-xs font-semibold text-slate-700 mb-1">Notes / Requests</label>
                <input type="text" id="walkInNotes" placeholder="e.g. Quick fade, beard trim" class="w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500" />
            </div>

            <div class="p-3 rounded-lg bg-amber-50 border border-amber-200 text-xs text-amber-800 flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>Express walk-ins are immediately saved and confirmed without requiring a pre-registered account.</span>
            </div>

            <div class="flex items-center justify-end space-x-3 pt-3 border-t border-slate-100">
                <button type="button" onclick="closeWalkInModal()" class="px-4 py-2 rounded-lg border border-slate-300 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" id="walkInSubmitBtn" class="px-4 py-2 rounded-lg text-sm font-bold text-slate-950 bg-amber-500 hover:bg-amber-400 shadow-sm transition">Create & Lock Slot</button>
            </div>
        </form>
    </div>
</div>

<!-- CHECKOUT & SETTLEMENT MODAL -->
<div id="checkoutModal" class="fixed inset-0 bg-slate-900/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl overflow-hidden border border-slate-200 animate-in fade-in zoom-in-95 duration-150">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-900 text-white">
            <div class="flex items-center space-x-2">
                <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <h3 class="font-bold text-base">Complete Appointment & Checkout</h3>
            </div>
            <button type="button" onclick="closeCheckoutModal()" class="text-slate-400 hover:text-white">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>

        <form id="checkoutForm" onsubmit="submitCheckout(event)" class="p-6 space-y-4">
            <input type="hidden" id="checkoutAppId" />

            <!-- Summary Card -->
            <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200/80 space-y-1.5 text-xs">
                <div class="flex justify-between items-center">
                    <span class="text-slate-500 uppercase tracking-wider font-semibold text-[10px]" id="checkoutRefCode">REF</span>
                    <span class="font-bold text-slate-900 text-sm" id="checkoutServicePrice">₱0.00</span>
                </div>
                <div class="font-bold text-slate-900 text-sm" id="checkoutCustomerAndService">Customer & Service</div>
                <div class="text-slate-500" id="checkoutBarberAndSchedule">Barber & Schedule</div>
            </div>

            <!-- Payment Method -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-2">Counter Payment Method <span class="text-rose-500">*</span></label>
                <div class="grid grid-cols-4 gap-2">
                    <label class="cursor-pointer border rounded-xl p-2.5 text-center flex flex-col items-center justify-center space-y-1 transition border-amber-500 bg-amber-50 text-slate-900 payment-method-opt" data-method="Cash">
                        <input type="radio" name="checkoutPaymentMethod" value="Cash" checked class="sr-only" onchange="selectPaymentMethod('Cash')" />
                        <span class="text-xs font-bold">💵 Cash</span>
                    </label>
                    <label class="cursor-pointer border rounded-xl p-2.5 text-center flex flex-col items-center justify-center space-y-1 transition border-slate-200 bg-white text-slate-700 hover:bg-slate-50 payment-method-opt" data-method="GCash">
                        <input type="radio" name="checkoutPaymentMethod" value="GCash" class="sr-only" onchange="selectPaymentMethod('GCash')" />
                        <span class="text-xs font-bold text-blue-600">📱 GCash</span>
                    </label>
                    <label class="cursor-pointer border rounded-xl p-2.5 text-center flex flex-col items-center justify-center space-y-1 transition border-slate-200 bg-white text-slate-700 hover:bg-slate-50 payment-method-opt" data-method="Maya">
                        <input type="radio" name="checkoutPaymentMethod" value="Maya" class="sr-only" onchange="selectPaymentMethod('Maya')" />
                        <span class="text-xs font-bold text-emerald-600">💳 Maya</span>
                    </label>
                    <label class="cursor-pointer border rounded-xl p-2.5 text-center flex flex-col items-center justify-center space-y-1 transition border-slate-200 bg-white text-slate-700 hover:bg-slate-50 payment-method-opt" data-method="Card">
                        <input type="radio" name="checkoutPaymentMethod" value="Card" class="sr-only" onchange="selectPaymentMethod('Card')" />
                        <span class="text-xs font-bold text-indigo-600">💳 Card</span>
                    </label>
                </div>
            </div>

            <!-- Retail Add-Ons -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label class="block text-xs font-semibold text-slate-700">Retail Add-Ons (Optional)</label>
                    <button type="button" onclick="addCheckoutProductRow()" class="text-xs font-bold text-brand-600 hover:text-brand-800 transition">+ Add Product</button>
                </div>
                <div id="checkoutAddOnsList" class="space-y-2 max-h-36 overflow-y-auto">
                    <!-- Dynamic Product Add-On Rows -->
                </div>
            </div>

            <!-- Settlement Grand Total -->
            <div class="p-3 rounded-xl bg-slate-900 text-white flex items-center justify-between">
                <div>
                    <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold block">Total Amount Settled</span>
                    <span class="text-xs text-slate-300" id="checkoutBreakdownText">Service only</span>
                </div>
                <div class="text-xl font-mono font-bold text-amber-400" id="checkoutGrandTotal">₱0.00</div>
            </div>

            <div>
                <label for="checkoutNote" class="block text-xs font-semibold text-slate-700 mb-1">Settlement Note (Optional)</label>
                <input type="text" id="checkoutNote" placeholder="e.g. Paid exact amount / Bought pomade" class="w-full rounded-lg border-slate-300 py-1.5 px-3 text-sm focus:border-brand-500 focus:ring-brand-500" />
            </div>

            <div class="flex items-center justify-end space-x-3 pt-3 border-t border-slate-100">
                <button type="button" onclick="closeCheckoutModal()" class="px-4 py-2 rounded-lg border border-slate-300 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" id="checkoutSubmitBtn" class="px-5 py-2 rounded-lg text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-sm transition">Settle & Mark Completed</button>
            </div>
        </form>
    </div>
</div>

<script>
    const INITIAL_VIEW = '@Model.InitialView';
    const INITIAL_STATUS = '@Model.InitialStatus';
    const TODAY_DATE = '@Model.TodayDateString';
    const RETAIL_PRODUCTS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Products));
    const ALL_BARBERS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Barbers));

    let currentView = INITIAL_VIEW || 'list';
    let currentStatus = INITIAL_STATUS || '';
    let currentPage = 1;
    let pageSize = 15;
    let cachedAppointments = [];
    let currentSelectedApp = null;
    let currentCheckoutProductRows = [];

    let selectedDay = TODAY_DATE;
    let selectedWeekStart = getMonday(new Date(TODAY_DATE));

    function getMonday(d) {
        d = new Date(d);
        let day = d.getDay();
        let diff = d.getDate() - day + (day === 0 ? -6 : 1);
        return new Date(d.setDate(diff));
    }

    function formatDateYMD(d) {
        let month = '' + (d.getMonth() + 1);
        let day = '' + d.getDate();
        let year = d.getFullYear();
        if (month.length < 2) month = '0' + month;
        if (day.length < 2) day = '0' + day;
        return [year, month, day].join('-');
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('selectedCalendarDay').value = selectedDay;
        if (INITIAL_STATUS) {
            setQuickStatus(INITIAL_STATUS);
        } else {
            switchView(currentView);
        }
    });

    function setQuickStatus(status) {
        currentStatus = status;
        const dropdown = document.getElementById('statusFilterDropdown');
        if (dropdown && dropdown.value !== (status || '')) {
            dropdown.value = status || '';
        }

        document.querySelectorAll('.status-pill').forEach(btn => {
            btn.classList.remove('bg-slate-900', 'text-white', 'border-slate-900', 'filter-btn-active');
            btn.classList.add('bg-white', 'text-slate-700', 'border-slate-300');
        });

        let targetId = !status ? 'statusPillAll' : (status === 'pending' ? 'statusPillPending' : (status === 'completed' ? 'statusPillCompleted' : null));
        let el = targetId ? document.getElementById(targetId) : null;
        if (el) {
            el.classList.remove('bg-white', 'text-slate-700', 'border-slate-300');
            el.classList.add('bg-slate-900', 'text-white', 'border-slate-900', 'filter-btn-active');
        }

        currentPage = 1;
        loadAppointments();
    }

    function switchView(view) {
        currentView = view;
        const listBtn = document.getElementById('viewBtnList');
        const dayBtn = document.getElementById('viewBtnDay');
        const weekBtn = document.getElementById('viewBtnWeek');

        const listContainer = document.getElementById('listViewContainer');
        const dayContainer = document.getElementById('dayViewContainer');
        const weekContainer = document.getElementById('weekViewContainer');

        [listBtn, dayBtn, weekBtn].forEach(b => {
            if (b) {
                b.classList.remove('bg-slate-900', 'text-white', 'view-btn-active', 'shadow-xs');
                b.classList.add('text-slate-700', 'hover:text-slate-900');
            }
        });

        listContainer.classList.add('hidden');
        dayContainer.classList.add('hidden');
        weekContainer.classList.add('hidden');

        const activeBtn = view === 'list' ? listBtn : (view === 'day' ? dayBtn : weekBtn);
        if (activeBtn) {
            activeBtn.classList.remove('text-slate-700', 'hover:text-slate-900');
            activeBtn.classList.add('bg-slate-900', 'text-white', 'view-btn-active', 'shadow-xs');
        }

        if (view === 'list') {
            listContainer.classList.remove('hidden');
            loadAppointments();
        } else if (view === 'day') {
            dayContainer.classList.remove('hidden');
            renderDayView();
        } else if (view === 'week') {
            weekContainer.classList.remove('hidden');
            renderWeekView();
        }
    }

    function applyFilters() {
        currentPage = 1;
        if (currentView === 'list') {
            loadAppointments();
        } else if (currentView === 'day') {
            renderDayView();
        } else if (currentView === 'week') {
            renderWeekView();
        }
    }

    function setDatePreset(preset) {
        const today = new Date(TODAY_DATE + 'T00:00:00');
        let start = '';
        let end = '';
        if (preset === 'today') {
            start = TODAY_DATE;
            end = TODAY_DATE;
        } else if (preset === 'tomorrow') {
            const tom = new Date(today);
            tom.setDate(tom.getDate() + 1);
            start = formatDateYMD(tom);
            end = formatDateYMD(tom);
        } else if (preset === 'this_week') {
            const mon = getMonday(today);
            const sun = new Date(mon);
            sun.setDate(sun.getDate() + 6);
            start = formatDateYMD(mon);
            end = formatDateYMD(sun);
        } else if (preset === 'this_month') {
            const first = new Date(today.getFullYear(), today.getMonth(), 1);
            const last = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            start = formatDateYMD(first);
            end = formatDateYMD(last);
        } else if (preset === 'clear') {
            start = '';
            end = '';
        }
        document.getElementById('filterStartDate').value = start;
        document.getElementById('filterEndDate').value = end;
        applyFilters();
    }

    async function loadAppointments() {
        const tbody = document.getElementById('appointmentTableBody');
        const cardList = document.getElementById('appointmentCardList');
        tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-12 text-center text-slate-500">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div>
            <p class="mt-2 text-sm">Loading bookings...</p>
        </td></tr>`;
        if (cardList) {
            cardList.innerHTML = `<div class="p-8 text-center text-slate-500">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div>
                <p class="mt-2 text-xs">Loading bookings...</p>
            </div>`;
        }

        let url = `/api/admin/appointments?page=${currentPage}&pageSize=${pageSize}&sortOrder=desc`;
        if (currentStatus) url += `&status=${encodeURIComponent(currentStatus)}`;
        const barberId = document.getElementById('filterBarber').value;
        if (barberId) url += `&barberId=${barberId}`;
        const serviceId = document.getElementById('filterService').value;
        if (serviceId) url += `&serviceId=${serviceId}`;
        const branchSelect = document.getElementById('filterBranch');
        if (branchSelect && branchSelect.value) url += `&branchId=${branchSelect.value}`;
        const search = document.getElementById('filterSearch').value.trim();
        if (search) url += `&search=${encodeURIComponent(search)}`;
        const start = document.getElementById('filterStartDate').value;
        if (start) url += `&startDate=${start}`;
        const end = document.getElementById('filterEndDate').value;
        if (end) url += `&endDate=${end}`;

        try {
            const res = await fetch(url);
            if (!res.ok) throw new Error('Failed to load appointments');
            const data = await res.json();
            cachedAppointments = data.items || [];
            renderTable(cachedAppointments, data.totalCount);
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-8 text-center text-rose-600 font-medium">${err.message}</td></tr>`;
            if (cardList) cardList.innerHTML = `<div class="p-6 text-center text-rose-600 text-xs font-medium">${err.message}</div>`;
        }
    }

    function renderTable(items, totalCount) {
        const tbody = document.getElementById('appointmentTableBody');
        const cardList = document.getElementById('appointmentCardList');
        if (!items || items.length === 0) {
            tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-12 text-center text-slate-500">
                <p class="text-base font-semibold text-slate-700">No bookings found</p>
                <p class="text-sm mt-1">Try adjusting your filters or date range.</p>
            </td></tr>`;
            if (cardList) {
                cardList.innerHTML = `<div class="p-8 text-center text-slate-500">
                    <p class="text-base font-semibold text-slate-700">No bookings found</p>
                    <p class="text-xs mt-1 text-slate-400">Try adjusting your filters or date range.</p>
                </div>`;
            }
            document.getElementById('paginationInfo').innerText = 'Showing 0 bookings';
            document.getElementById('prevPageBtn').disabled = true;
            document.getElementById('nextPageBtn').disabled = true;
            return;
        }

        let html = '';
        let cardHtml = '';
        items.forEach(app => {
            const badge = getStatusBadgeHtml(app.status, app.statusDisplay);
            html += `<tr class="hover:bg-slate-50/80 transition cursor-pointer" onclick="openDrawer(${app.id})">
                <td class="px-4 py-3 whitespace-nowrap font-mono text-xs font-bold text-amber-700">
                    <div class="flex items-center gap-1.5">
                        <span>${app.referenceCode}</span>
                        <button type="button" class="copy-btn" onclick="event.stopPropagation(); copyToClipboard('${app.referenceCode}', this)" title="Copy reference code" aria-label="Copy reference code">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>
                        </button>
                    </div>
                    ${app.branchName ? `<div class="text-[10px] text-slate-400 font-sans font-normal truncate max-w-[130px]">${escapeHtml(app.branchName)}</div>` : ''}
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                    <div class="font-medium text-slate-900 text-sm">${escapeHtml(app.customerName)}</div>
                    <div class="text-xs text-slate-500 flex items-center gap-1">
                        <span class="max-w-[180px] truncate block" title="${escapeHtml(app.customerPhone || app.customerEmail || '')}">${escapeHtml(app.customerPhone || app.customerEmail || 'None recorded')}</span>
                        ${(app.customerPhone || app.customerEmail) ? `<button type="button" class="copy-btn" onclick="event.stopPropagation(); copyToClipboard('${escapeHtml(app.customerPhone || app.customerEmail)}', this)" title="Copy contact" aria-label="Copy contact"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg></button>` : ''}
                    </div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-slate-700 font-medium text-xs sm:text-sm">${escapeHtml(app.barberName)}</td>
                <td class="px-4 py-3 whitespace-nowrap text-slate-700 text-xs sm:text-sm">
                    <div class="font-medium">${escapeHtml(app.serviceName)}</div>
                    <div class="text-[11px] text-slate-400">${app.durationMinutes} mins</div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-xs sm:text-sm">
                    <div class="font-medium text-slate-900">${app.formattedDate}</div>
                    <div class="text-[11px] text-slate-500 font-mono">${app.formattedTime}</div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap text-right font-semibold text-slate-900 text-xs sm:text-sm">${app.formattedPrice}</td>
                <td class="px-4 py-3 whitespace-nowrap text-center">${badge}</td>
                <td class="px-4 py-3 whitespace-nowrap text-right text-xs" onclick="event.stopPropagation()">
                    <div class="flex items-center justify-end gap-1">
                        ${renderInlineRowActions(app)}
                    </div>
                </td>
            </tr>`;

            cardHtml += `
            <div class="p-4 space-y-3 hover:bg-slate-50/60 transition cursor-pointer" onclick="openDrawer(${app.id})">
                <div class="flex items-start justify-between gap-2">
                    <div>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="font-mono text-xs font-bold text-amber-700">${app.referenceCode}</span>
                            <button type="button" class="copy-btn" onclick="event.stopPropagation(); copyToClipboard('${app.referenceCode}', this)" title="Copy reference code" aria-label="Copy reference code">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>
                            </button>
                            ${app.branchName ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">${escapeHtml(app.branchName)}</span>` : ''}
                        </div>
                        <div class="font-bold text-slate-900 text-sm mt-0.5">${escapeHtml(app.customerName)}</div>
                        <div class="text-xs text-slate-500">${escapeHtml(app.customerPhone || app.customerEmail || 'None recorded')}</div>
                    </div>
                    <div class="shrink-0">
                        ${badge}
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2 text-xs text-slate-600 bg-slate-50/80 p-2.5 rounded-xl border border-slate-200/60">
                    <div>
                        <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400">Barber & Service</span>
                        <span class="font-semibold text-slate-800">${escapeHtml(app.barberName)}</span>
                        <span class="block text-[11px] text-slate-500">${escapeHtml(app.serviceName)} (${app.durationMinutes}m)</span>
                    </div>
                    <div class="text-right">
                        <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400">Schedule</span>
                        <span class="font-semibold text-slate-900">${app.formattedDate}</span>
                        <span class="block text-[11px] text-slate-500 font-mono">${app.formattedTime}</span>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-1">
                    <span class="text-sm font-bold text-slate-900">${app.formattedPrice}</span>
                    <div class="flex items-center gap-1.5" onclick="event.stopPropagation()">
                        ${renderInlineRowActions(app)}
                    </div>
                </div>
            </div>`;
        });
        tbody.innerHTML = html;
        if (cardList) cardList.innerHTML = cardHtml;

        // Pagination
        const startItem = (currentPage - 1) * pageSize + 1;
        const endItem = Math.min(currentPage * pageSize, totalCount);
        document.getElementById('paginationInfo').innerText = `Showing ${startItem}–${endItem} of ${totalCount} bookings`;
        document.getElementById('pageIndicator').innerText = currentPage;
        document.getElementById('prevPageBtn').disabled = currentPage <= 1;
        document.getElementById('nextPageBtn').disabled = endItem >= totalCount;
    }

    function renderInlineRowActions(app) {
        const status = (app.status || '').toLowerCase();
        let html = '';
        if (status === 'pending') {
            html += `
                <button type="button" onclick="openActionModal(${app.id}, 'confirmed')" title="Confirm Booking" class="h-[28px] px-2.5 rounded-md text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 inline-flex items-center gap-1 shadow-2xs transition">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    Confirm
                </button>
                <button type="button" onclick="openActionModal(${app.id}, 'rejected')" title="Reject Booking" class="h-[28px] px-2.5 rounded-md text-xs font-bold text-rose-800 bg-rose-50 hover:bg-rose-100 border border-rose-300 inline-flex items-center gap-1 shadow-2xs transition">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                    Reject
                </button>
            `;
        } else if (status === 'confirmed') {
            html += `
                <button type="button" onclick="openCheckoutModal(${app.id})" title="Settle & Complete Checkout" class="h-[28px] px-2.5 rounded-md text-xs font-bold text-amber-900 bg-amber-50 hover:bg-amber-100 border border-amber-300 inline-flex items-center gap-1 shadow-2xs transition">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Checkout
                </button>
                <button type="button" onclick="openActionModal(${app.id}, 'noshow')" title="Mark as No-Show" class="h-[28px] px-2 rounded-md text-xs font-medium text-slate-700 bg-slate-50 hover:bg-slate-100 border border-slate-300 inline-flex items-center gap-1 shadow-2xs transition">
                    No-Show
                </button>
            `;
        }
        html += `
            <button type="button" onclick="openDrawer(${app.id})" title="View Details" class="h-[28px] px-2 rounded-md text-xs font-medium text-slate-700 hover:text-slate-900 bg-white hover:bg-slate-50 border border-slate-300 inline-flex items-center gap-1 shadow-2xs transition">
                <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                Details
            </button>
        `;
        return html;
    }

    function changePage(delta) {
        currentPage += delta;
        loadAppointments();
    }

    function getStatusBadgeHtml(status, label) {
        status = (status || '').toLowerCase();
        if (status === 'pending') {
            return `<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold border bg-amber-50 text-amber-800 border-amber-300"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>Pending</span>`;
        } else if (status === 'confirmed') {
            return `<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold border bg-sky-50 text-sky-800 border-sky-300"><span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>Confirmed</span>`;
        } else if (status === 'completed') {
            return `<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold border bg-emerald-50 text-emerald-800 border-emerald-300"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Completed</span>`;
        } else if (status === 'noshow' || status === 'no_show') {
            return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border bg-purple-50 text-purple-800 border-purple-300">No-Show</span>`;
        } else if (status === 'cancelled') {
            return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border bg-slate-100 text-slate-700 border-slate-300">Cancelled</span>`;
        } else if (status === 'rejected') {
            return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border bg-rose-50 text-rose-800 border-rose-300">Rejected</span>`;
        }
        return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border bg-slate-100 text-slate-800 border-slate-300">${label || status}</span>`;
    }

    // DAY CALENDAR VIEW (Interactive Visual Time-Slot Grid)
    async function renderDayView() {
        selectedDay = document.getElementById('selectedCalendarDay').value || TODAY_DATE;
        const dateObj = new Date(selectedDay + 'T00:00:00');
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('dayViewTitle').innerText = dateObj.toLocaleDateString('en-US', options);

        const container = document.getElementById('dayGridContent');
        container.innerHTML = `<div class="py-12 text-center text-slate-500"><div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div><p class="mt-2 text-sm">Loading day schedule grid...</p></div>`;

        let url = `/api/admin/appointments?startDate=${selectedDay}&endDate=${selectedDay}&pageSize=200`;
        const barberId = document.getElementById('filterBarber').value;
        if (barberId) url += `&barberId=${barberId}`;
        const serviceId = document.getElementById('filterService').value;
        if (serviceId) url += `&serviceId=${serviceId}`;
        const branchSelect = document.getElementById('filterBranch');
        if (branchSelect && branchSelect.value) url += `&branchId=${branchSelect.value}`;

        try {
            const res = await fetch(url);
            const data = await res.json();
            const items = data.items || [];
            cachedAppointments = items;

            // Determine active barbers list
            let barbersToShow = ALL_BARBERS;
            if (barberId) {
                barbersToShow = ALL_BARBERS.filter(b => b.Id == barberId);
            }
            if (!barbersToShow || barbersToShow.length === 0) {
                const uniqueBarberNames = [...new Set(items.map(a => a.barberName))];
                barbersToShow = uniqueBarberNames.map((name, idx) => ({ Id: idx + 1, DisplayName: name }));
            }

            if (barbersToShow.length === 0) {
                container.innerHTML = `<div class="py-12 text-center text-slate-500"><p class="text-base font-semibold text-slate-700">No active barbers configured</p></div>`;
                return;
            }

            // 30-minute time intervals from 09:00 to 19:00
            const TIME_SLOTS = [
                '09:00', '09:30', '10:00', '10:30', '11:00', '11:30',
                '12:00', '12:30', '13:00', '13:30', '14:00', '14:30',
                '15:00', '15:30', '16:00', '16:30', '17:00', '17:30',
                '18:00', '18:30', '19:00'
            ];

            let html = `<div class="overflow-x-auto"><table class="w-full border-collapse border border-slate-200 min-w-[700px]">`;
            
            // Header Row (Barbers)
            html += `<thead class="bg-slate-50 sticky top-0 z-10"><tr>
                <th class="w-20 p-3 text-xs font-bold text-slate-500 uppercase tracking-wider text-center border-b border-r border-slate-200">Time</th>`;
            barbersToShow.forEach(b => {
                html += `<th class="p-3 text-xs font-bold text-slate-800 text-left border-b border-r border-slate-200">
                    <div class="flex items-center space-x-2">
                        <div class="w-6 h-6 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center text-[10px] font-bold">${b.DisplayName.charAt(0)}</div>
                        <span>${escapeHtml(b.DisplayName)}</span>
                    </div>
                </th>`;
            });
            html += `</tr></thead><tbody class="divide-y divide-slate-100">`;

            // Time Slot Rows
            TIME_SLOTS.forEach(slot => {
                html += `<tr><td class="p-2 text-center font-mono text-xs text-slate-500 font-semibold bg-slate-50/60 border-r border-slate-200 whitespace-nowrap">${slot}</td>`;
                
                barbersToShow.forEach(barber => {
                    // Match appointments for this barber and time slot
                    const app = items.find(a => 
                        (a.barberName === barber.DisplayName || a.barberId === barber.Id) &&
                        (a.scheduledTimeString.startsWith(slot) || a.scheduledTimeString === slot)
                    );

                    html += `<td class="p-1.5 border-r border-slate-200 align-top min-w-[170px] max-w-[240px]">`;
                    if (app) {
                        const status = (app.status || '').toLowerCase();
                        let borderClass = 'border-amber-300 bg-amber-50/70 hover:bg-amber-100/60';
                        if (status === 'confirmed') borderClass = 'border-sky-300 bg-sky-50/70 hover:bg-sky-100/60';
                        else if (status === 'completed') borderClass = 'border-emerald-300 bg-emerald-50/70 hover:bg-emerald-100/60';
                        else if (status === 'noshow') borderClass = 'border-purple-300 bg-purple-50/70 hover:bg-purple-100/60';
                        else if (status === 'cancelled' || status === 'rejected') borderClass = 'border-slate-200 bg-slate-100/80 opacity-60';

                        html += `<div onclick="openDrawer(${app.id})" class="p-2 rounded-lg border ${borderClass} transition cursor-pointer shadow-xs text-xs space-y-1">
                            <div class="flex items-center justify-between gap-1">
                                <span class="font-mono text-[10px] font-bold text-slate-700">${app.referenceCode}</span>
                                ${getStatusBadgeHtml(app.status, app.status.substring(0,4).toUpperCase())}
                            </div>
                            <div class="font-bold text-slate-900 truncate">${escapeHtml(app.customerName)}</div>
                            <div class="text-[11px] text-slate-600 truncate">${escapeHtml(app.serviceName)} (${app.durationMinutes}m)</div>
                            <div class="text-[11px] font-semibold text-slate-900">${app.formattedPrice}</div>
                        </div>`;
                    } else {
                        html += `<div onclick="openWalkInModal(${barber.Id}, '${slot}')" class="h-12 rounded-lg border border-dashed border-transparent hover:border-amber-300 hover:bg-amber-50/40 flex items-center justify-center text-slate-300 hover:text-amber-700 transition cursor-pointer group">
                            <span class="text-[11px] font-semibold opacity-0 group-hover:opacity-100">+ Walk-in</span>
                        </div>`;
                    }
                    html += `</td>`;
                });
                html += `</tr>`;
            });

            html += `</tbody></table></div>`;
            container.innerHTML = html;
        } catch (err) {
            container.innerHTML = `<div class="py-8 text-center text-rose-600 font-medium">${err.message}</div>`;
        }
    }

    function navigateDay(delta) {
        const d = new Date(selectedDay + 'T00:00:00');
        d.setDate(d.getDate() + delta);
        selectedDay = formatDateYMD(d);
        document.getElementById('selectedCalendarDay').value = selectedDay;
        renderDayView();
    }

    function goToTodayDay() {
        selectedDay = TODAY_DATE;
        document.getElementById('selectedCalendarDay').value = selectedDay;
        renderDayView();
    }

    // WEEK CALENDAR VIEW
    async function renderWeekView() {
        const weekEnd = new Date(selectedWeekStart);
        weekEnd.setDate(weekEnd.getDate() + 6);

        const startStr = formatDateYMD(selectedWeekStart);
        const endStr = formatDateYMD(weekEnd);

        document.getElementById('weekViewTitle').innerText = `${startStr} to ${endStr}`;

        const container = document.getElementById('weekGridContent');
        container.innerHTML = `<div class="py-12 text-center text-slate-500"><div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div><p class="mt-2 text-sm">Loading week schedule...</p></div>`;

        let url = `/api/admin/appointments?startDate=${startStr}&endDate=${endStr}&pageSize=200`;
        const barberId = document.getElementById('filterBarber').value;
        if (barberId) url += `&barberId=${barberId}`;
        const serviceId = document.getElementById('filterService').value;
        if (serviceId) url += `&serviceId=${serviceId}`;
        const branchSelect = document.getElementById('filterBranch');
        if (branchSelect && branchSelect.value) url += `&branchId=${branchSelect.value}`;

        try {
            const res = await fetch(url);
            const data = await res.json();
            const items = data.items || [];
            cachedAppointments = items;

            // Generate 7 days
            const days = [];
            for (let i = 0; i < 7; i++) {
                let d = new Date(selectedWeekStart);
                d.setDate(d.getDate() + i);
                days.push({
                    dateStr: formatDateYMD(d),
                    dayName: d.toLocaleDateString('en-US', { weekday: 'short' }),
                    displayDate: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
                });
            }

            let html = `<div class="grid grid-cols-7 gap-3 min-w-[900px]">`;
            days.forEach(day => {
                const dayApps = items.filter(a => a.scheduledDateString === day.dateStr);
                const isToday = day.dateStr === TODAY_DATE;

                html += `<div class="border rounded-xl p-3 flex flex-col ${isToday ? 'border-amber-500 bg-amber-50/20' : 'border-slate-200 bg-slate-50'}">
                    <div class="border-b pb-2 mb-2 text-center ${isToday ? 'border-amber-300 font-bold text-amber-900' : 'border-slate-200 font-semibold text-slate-800'}">
                        <div class="text-xs uppercase">${day.dayName}</div>
                        <div class="text-sm">${day.displayDate}</div>
                        <div class="text-[10px] text-slate-500 mt-0.5">${dayApps.length} bookings</div>
                    </div>
                    <div class="space-y-2 flex-1 overflow-y-auto max-h-[500px]">`;

                if (dayApps.length === 0) {
                    html += `<div class="text-[11px] text-slate-400 text-center py-6">No bookings</div>`;
                } else {
                    dayApps.sort((a,b) => a.scheduledTimeString.localeCompare(b.scheduledTimeString)).forEach(app => {
                        const badge = getStatusBadgeHtml(app.status, app.status.substring(0,4).toUpperCase());
                        html += `<div onclick="openDrawer(${app.id})" class="p-2 bg-white rounded-lg border border-slate-200 shadow-sm hover:border-amber-500 cursor-pointer text-xs">
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-mono text-[10px] font-bold text-amber-700">${app.referenceCode}</span>
                                <span>${badge}</span>
                            </div>
                            <div class="font-bold text-slate-900 truncate">${escapeHtml(app.customerName)}</div>
                            <div class="text-slate-500 truncate text-[11px]">${escapeHtml(app.barberName)}</div>
                            <div class="text-slate-600 font-medium text-[10px] mt-1">${app.scheduledTimeString} (${app.durationMinutes}m)</div>
                        </div>`;
                    });
                }

                html += `</div></div>`;
            });
            html += `</div>`;
            container.innerHTML = html;
        } catch (err) {
            container.innerHTML = `<div class="py-8 text-center text-rose-600 font-medium">${err.message}</div>`;
        }
    }

    function navigateWeek(delta) {
        selectedWeekStart.setDate(selectedWeekStart.getDate() + (delta * 7));
        renderWeekView();
    }

    function goToCurrentWeek() {
        selectedWeekStart = getMonday(new Date(TODAY_DATE));
        renderWeekView();
    }

    // DRAWER & ACTIONS
    async function openDrawer(appointmentId) {
        let app = cachedAppointments.find(a => a.id === appointmentId);
        if (!app) {
            try {
                const res = await fetch(`/api/appointments/${appointmentId}`);
                if (res.ok) app = await res.json();
            } catch {}
        }

        if (!app) return;
        currentSelectedApp = app;

        const content = document.getElementById('drawerContent');
        const badge = getStatusBadgeHtml(app.status, app.statusDisplay);

        let timelineHtml = '<div class="space-y-3 mt-4">';
        if (app.timeline && app.timeline.length > 0) {
            app.timeline.forEach(t => {
                timelineHtml += `<div class="relative pl-6 pb-2 border-l-2 border-slate-200 last:border-transparent">
                    <span class="absolute -left-1.5 top-1 w-3 h-3 rounded-full bg-amber-500 ring-4 ring-white"></span>
                    <div class="text-xs font-semibold text-slate-800 flex items-center justify-between">
                        <span>${t.toStatus ? t.toStatus.toUpperCase() : 'EVENT'} <span class="text-slate-400 font-normal">by ${escapeHtml(t.changedByRole)}</span></span>
                        <span class="text-[10px] text-slate-500">${t.formattedChangedAt || ''}</span>
                    </div>
                    <div class="text-xs text-slate-600 mt-0.5">${escapeHtml(t.note || '')}</div>
                </div>`;
            });
        } else {
            timelineHtml += '<p class="text-xs text-slate-500">No status events recorded.</p>';
        }
        timelineHtml += '</div>';

        content.innerHTML = `
            <div class="border-b border-slate-200 pb-4">
                <div class="flex items-center justify-between">
                    <span class="font-mono text-sm font-bold text-amber-700">${app.referenceCode}</span>
                    <span>${badge}</span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mt-1">${escapeHtml(app.serviceName)}</h3>
                <div class="text-lg font-semibold text-slate-800 mt-1">${app.formattedPrice} <span class="text-xs text-slate-500 font-normal">(${app.durationMinutes} minutes)</span></div>
            </div>

            <div class="space-y-3 text-sm">
                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Customer</span>
                    <div class="font-medium text-slate-900">${escapeHtml(app.customerName)}</div>
                    <div class="text-xs text-slate-500">${escapeHtml(app.customerPhone || 'No phone')} · ${escapeHtml(app.customerEmail || 'No email')}</div>
                </div>

                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Assigned Barber</span>
                    <div class="font-medium text-slate-900">${escapeHtml(app.barberName)}</div>
                </div>

                ${app.branchName ? `<div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Branch Station</span>
                    <div class="font-medium text-slate-900 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        <span>${escapeHtml(app.branchName)}</span>
                    </div>
                </div>` : ''}

                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Schedule</span>
                    <div class="font-medium text-slate-900">${app.formattedDate}</div>
                    <div class="text-xs text-slate-600 font-medium">${app.formattedTime}</div>
                </div>

                ${app.notes ? `<div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Customer Notes</span>
                    <div class="text-xs bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-slate-700 mt-1">${escapeHtml(app.notes)}</div>
