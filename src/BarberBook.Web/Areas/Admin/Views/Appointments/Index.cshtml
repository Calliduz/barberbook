    function renderDrawerActionButtons(app) {
        const actionsContainer = document.getElementById('drawerActions');
        const status = (app.status || '').toLowerCase();

        let buttons = '';
        if (status === 'pending') {
            buttons = `
                <button type="button" onclick="openActionModal(${app.id}, 'confirmed')" class="px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs shadow-sm">
                    Confirm Booking
                </button>
                <button type="button" onclick="openActionModal(${app.id}, 'rejected')" class="px-3.5 py-2 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-semibold text-xs shadow-sm">
                    Reject Booking
                </button>
                <button type="button" onclick="openActionModal(${app.id}, 'cancelled')" class="px-3.5 py-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-sm">
                    Cancel Booking
                </button>
            `;
        } else if (status === 'confirmed') {
            buttons = `
                <button type="button" onclick="openCheckoutModal(${app.id})" class="px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs shadow-sm flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    Settle & Checkout
                </button>
                <button type="button" onclick="openActionModal(${app.id}, 'noshow')" class="px-3.5 py-2 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs shadow-sm">
                    Mark as No-Show
                </button>
                <button type="button" onclick="openActionModal(${app.id}, 'cancelled')" class="px-3.5 py-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-rose-700 font-semibold text-xs shadow-sm">
                    Cancel Booking
                </button>
            `;
        } else {
            buttons = `<span class="text-xs text-slate-400 italic">Terminal Status · No further transitions allowed</span>`;
        }

        actionsContainer.innerHTML = buttons;
    }

    function closeDrawer() {
        document.getElementById('detailDrawerBackdrop').classList.add('hidden');
        document.getElementById('detailDrawer').classList.add('translate-x-full');
        currentSelectedApp = null;
    }

    function openActionModal(appointmentId, targetStatus) {
        document.getElementById('modalAppointmentId').value = appointmentId;
        document.getElementById('modalTargetStatus').value = targetStatus;
        document.getElementById('modalNote').value = '';
        document.getElementById('modalNoteError').classList.add('hidden');

        const title = document.getElementById('modalTitle');
        const desc = document.getElementById('modalDescription');
        const btn = document.getElementById('modalSubmitBtn');
        const reqLabel = document.getElementById('noteRequiredLabel');

        const isReq = (targetStatus === 'rejected' || targetStatus === 'cancelled');
        if (isReq) {
            reqLabel.classList.remove('hidden');
        } else {
            reqLabel.classList.add('hidden');
        }

        btn.className = 'px-4 py-2 rounded-lg text-sm font-semibold text-white shadow-sm transition';

        if (targetStatus === 'confirmed') {
            title.innerText = 'Confirm Appointment';
            desc.innerText = 'Are you sure you want to confirm this booking? The slot will remain locked for the customer.';
            btn.classList.add('bg-emerald-600', 'hover:bg-emerald-500');
            btn.innerText = 'Confirm Booking';
        } else if (targetStatus === 'rejected') {
            title.innerText = 'Reject Appointment';
            desc.innerText = 'Please state the reason for rejecting this booking. The slot will be released immediately.';
            btn.classList.add('bg-rose-600', 'hover:bg-rose-500');
            btn.innerText = 'Reject Booking';
        } else if (targetStatus === 'completed') {
            title.innerText = 'Complete Appointment';
            desc.innerText = 'Confirm that the service has been rendered in the shop. This will be recorded into transaction reports.';
            btn.classList.add('bg-emerald-600', 'hover:bg-emerald-500');
            btn.innerText = 'Complete Appointment';
        } else if (targetStatus === 'noshow' || targetStatus === 'no_show') {
            title.innerText = 'Mark Appointment as No-Show';
            desc.innerText = 'Are you sure you want to mark this client as a No-Show? The time slot will be released and their profile will record this incident.';
            btn.classList.add('bg-purple-600', 'hover:bg-purple-500');
            btn.innerText = 'Mark as No-Show';
        } else if (targetStatus === 'cancelled') {
            title.innerText = 'Cancel Appointment';
            desc.innerText = 'Please state the reason for cancellation. The slot will be released for other bookings.';
            btn.classList.add('bg-slate-800', 'hover:bg-slate-700');
            btn.innerText = 'Cancel Booking';
        }

        document.getElementById('statusActionModal').classList.remove('hidden');
    }

    function closeActionModal() {
        document.getElementById('statusActionModal').classList.add('hidden');
    }

    async function submitStatusAction(e) {
        e.preventDefault();
        const id = document.getElementById('modalAppointmentId').value;
        const targetStatus = document.getElementById('modalTargetStatus').value;
        const note = document.getElementById('modalNote').value.trim();

        if ((targetStatus === 'rejected' || targetStatus === 'cancelled') && !note) {
            document.getElementById('modalNoteError').classList.remove('hidden');
            return;
        }

        try {
            const res = await fetch(`/api/admin/appointments/${id}/status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ to: targetStatus, note: note || null })
            });

            if (!res.ok) {
                const err = await res.json();
                alert(err.error ? err.error.message : 'Error updating status');
                return;
            }

            closeActionModal();
            closeDrawer();

            if (currentView === 'list') loadAppointments();
            else if (currentView === 'day') renderDayView();
            else if (currentView === 'week') renderWeekView();
        } catch (err) {
            alert('Request failed: ' + err.message);
        }
    }

    // EXPRESS WALK-IN MODAL HANDLERS
    function openWalkInModal(prefillBarberId, prefillTime) {
        const now = new Date();
        const ymd = formatDateYMD(now);
        document.getElementById('walkInDate').value = selectedDay || ymd;
        
        if (prefillTime) {
            document.getElementById('walkInTime').value = prefillTime;
        } else {
            let hours = now.getHours().toString().padStart(2, '0');
            let mins = now.getMinutes() < 30 ? '00' : '30';
            document.getElementById('walkInTime').value = `${hours}:${mins}`;
        }

        if (prefillBarberId) {
            document.getElementById('walkInBarber').value = prefillBarberId;
        }

        document.getElementById('walkInModal').classList.remove('hidden');
    }

    function closeWalkInModal() {
        document.getElementById('walkInModal').classList.add('hidden');
    }

    async function submitWalkIn(e) {
        e.preventDefault();
        const submitBtn = document.getElementById('walkInSubmitBtn');
        submitBtn.disabled = true;
        submitBtn.innerText = 'Creating...';

        const payload = {
            branchId: parseInt(document.getElementById('walkInBranch').value, 10),
            barberId: parseInt(document.getElementById('walkInBarber').value, 10),
            serviceId: parseInt(document.getElementById('walkInService').value, 10),
            customerName: document.getElementById('walkInCustomerName').value.trim(),
            customerPhone: document.getElementById('walkInCustomerPhone').value.trim() || null,
            date: document.getElementById('walkInDate').value,
            time: document.getElementById('walkInTime').value,
            notes: document.getElementById('walkInNotes').value.trim() || null
        };

        try {
            const res = await fetch('/api/admin/appointments/walk-in', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                const err = await res.json();
                alert(err.error ? err.error.message : 'Error creating walk-in booking');
                return;
            }

            closeWalkInModal();
            if (currentView === 'list') loadAppointments();
            else if (currentView === 'day') renderDayView();
            else if (currentView === 'week') renderWeekView();
        } catch (err) {
            alert('Request failed: ' + err.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerText = 'Create & Lock Slot';
        }
    }

    // CHECKOUT MODAL HANDLERS
    let checkoutBasePrice = 0;
    let selectedPaymentMethod = 'Cash';

    async function openCheckoutModal(appointmentId) {
        let app = cachedAppointments.find(a => a.id === appointmentId);
        if (!app) {
            try {
                const res = await fetch(`/api/appointments/${appointmentId}`);
                if (res.ok) app = await res.json();
            } catch {}
        }
        if (!app) return;

        document.getElementById('checkoutAppId').value = app.id;
        document.getElementById('checkoutRefCode').innerText = app.referenceCode;
        document.getElementById('checkoutServicePrice').innerText = app.formattedPrice;
        document.getElementById('checkoutCustomerAndService').innerText = `${app.customerName} · ${app.serviceName}`;
        document.getElementById('checkoutBarberAndSchedule').innerText = `${app.barberName} · ${app.formattedDate} at ${app.formattedTime}`;
        document.getElementById('checkoutNote').value = '';

        checkoutBasePrice = app.price || 0;
        currentCheckoutProductRows = [];
        renderCheckoutProductRows();
        selectPaymentMethod('Cash');

        document.getElementById('checkoutModal').classList.remove('hidden');
    }

    function closeCheckoutModal() {
        document.getElementById('checkoutModal').classList.add('hidden');
    }

    function selectPaymentMethod(method) {
        selectedPaymentMethod = method;
        document.querySelectorAll('.payment-method-opt').forEach(el => {
            if (el.dataset.method === method) {
                el.classList.remove('border-slate-200', 'bg-white', 'text-slate-700');
                el.classList.add('border-amber-500', 'bg-amber-50', 'text-slate-900');
            } else {
                el.classList.add('border-slate-200', 'bg-white', 'text-slate-700');
                el.classList.remove('border-amber-500', 'bg-amber-50', 'text-slate-900');
            }
        });
    }

    function addCheckoutProductRow() {
        if (!RETAIL_PRODUCTS || RETAIL_PRODUCTS.length === 0) {
            alert('No active retail products available in inventory.');
            return;
        }
        currentCheckoutProductRows.push({
            productId: RETAIL_PRODUCTS[0].Id,
            quantity: 1
        });
        renderCheckoutProductRows();
    }

    function removeCheckoutProductRow(index) {
        currentCheckoutProductRows.splice(index, 1);
        renderCheckoutProductRows();
    }

    function updateCheckoutProduct(index, productId) {
        currentCheckoutProductRows[index].productId = parseInt(productId, 10);
        renderCheckoutProductRows();
    }

    function updateCheckoutQuantity(index, qty) {
        const q = parseInt(qty, 10);
        currentCheckoutProductRows[index].quantity = isNaN(q) || q < 1 ? 1 : q;
        renderCheckoutProductRows();
    }

    function renderCheckoutProductRows() {
        const container = document.getElementById('checkoutAddOnsList');
        if (currentCheckoutProductRows.length === 0) {
            container.innerHTML = `<p class="text-xs text-slate-400 italic">No retail add-ons attached.</p>`;
            calculateCheckoutGrandTotal(0);
            return;
        }

        let html = '';
        let addOnsTotal = 0;

        currentCheckoutProductRows.forEach((row, idx) => {
            const prod = RETAIL_PRODUCTS.find(p => p.Id === row.productId) || RETAIL_PRODUCTS[0];
            const rowTotal = (prod ? prod.SellingPrice : 0) * row.quantity;
            addOnsTotal += rowTotal;

            html += `<div class="flex items-center gap-2 text-xs bg-slate-50 p-2 rounded-lg border border-slate-200">
                <select onchange="updateCheckoutProduct(${idx}, this.value)" class="flex-1 rounded-md border-slate-300 py-1 text-xs">
                    ${RETAIL_PRODUCTS.map(p => `<option value="${p.Id}" ${p.Id === row.productId ? 'selected' : ''}>${escapeHtml(p.Name)} (₱${p.SellingPrice.toFixed(2)})</option>`).join('')}
                </select>
                <input type="number" min="1" max="50" value="${row.quantity}" onchange="updateCheckoutQuantity(${idx}, this.value)" class="w-16 rounded-md border-slate-300 py-1 text-xs text-center" />
                <span class="font-bold text-slate-800 w-20 text-right">₱${rowTotal.toFixed(2)}</span>
                <button type="button" onclick="removeCheckoutProductRow(${idx})" class="p-1 text-rose-500 hover:text-rose-700">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>`;
        });

        container.innerHTML = html;
        calculateCheckoutGrandTotal(addOnsTotal);
    }

    function calculateCheckoutGrandTotal(addOnsTotal) {
        const grandTotal = checkoutBasePrice + addOnsTotal;
        document.getElementById('checkoutGrandTotal').innerText = `₱${grandTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        document.getElementById('checkoutBreakdownText').innerText = addOnsTotal > 0 
            ? `Service (₱${checkoutBasePrice.toFixed(2)}) + Add-ons (₱${addOnsTotal.toFixed(2)})`
            : `Service only`;
    }

    async function submitCheckout(e) {
        e.preventDefault();
        const submitBtn = document.getElementById('checkoutSubmitBtn');
        submitBtn.disabled = true;
        submitBtn.innerText = 'Processing...';

        const appId = document.getElementById('checkoutAppId').value;
        const note = document.getElementById('checkoutNote').value.trim();

        const addOns = currentCheckoutProductRows.map(r => ({
            productId: r.productId,
            quantity: r.quantity
        }));

        try {
            const res = await fetch(`/api/admin/appointments/${appId}/status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    to: 'completed',
                    paymentMethod: selectedPaymentMethod,
                    addOns: addOns.length > 0 ? addOns : null,
                    note: note || null
                })
            });

            if (!res.ok) {
                const err = await res.json();
                alert(err.error ? err.error.message : 'Error settling checkout');
                return;
            }

            closeCheckoutModal();
            closeDrawer();

            if (currentView === 'list') loadAppointments();
            else if (currentView === 'day') renderDayView();
            else if (currentView === 'week') renderWeekView();
        } catch (err) {
            alert('Request failed: ' + err.message);
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerText = 'Settle & Mark Completed';
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
</script>

