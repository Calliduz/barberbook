@model BarberBook.Web.Models.Admin.AdminAppointmentsViewModel
@{
    ViewData["Title"] = "Bookings Management";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Bookings Management</h1>
            <p class="mt-1 text-sm text-slate-500">Review, confirm, reject, complete, or cancel shop appointments across all barbers.</p>
        </div>
        <div class="mt-4 sm:mt-0 flex items-center space-x-3">
            <!-- View Switcher -->
            <div class="inline-flex rounded-lg border border-slate-300 bg-white p-1 shadow-sm">
                <button type="button" id="viewBtnList" onclick="switchView('list')" class="px-3 py-1.5 text-xs font-semibold rounded-md transition text-slate-700 hover:text-slate-900">
                    List View
                </button>
                <button type="button" id="viewBtnDay" onclick="switchView('day')" class="px-3 py-1.5 text-xs font-semibold rounded-md transition text-slate-700 hover:text-slate-900">
                    Day Calendar
                </button>
                <button type="button" id="viewBtnWeek" onclick="switchView('week')" class="px-3 py-1.5 text-xs font-semibold rounded-md transition text-slate-700 hover:text-slate-900">
                    Week Calendar
                </button>
            </div>

            <button type="button" onclick="loadAppointments()" class="inline-flex items-center px-3 py-2 border border-slate-300 shadow-sm text-sm font-medium rounded-lg text-slate-700 bg-white hover:bg-slate-50">
                <svg class="h-4 w-4 mr-1.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh
            </button>
        </div>
    </div>

    <!-- Quick Filter & Search Bar -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <!-- Quick Filter Tabs -->
            <div class="flex flex-wrap items-center gap-2">
                <button type="button" onclick="setQuickStatus('')" id="statusPillAll" class="status-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-slate-900 text-white border-slate-900">
                    All Bookings
                </button>
                <button type="button" onclick="setQuickStatus('pending')" id="statusPillPending" class="status-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-amber-50 text-amber-800 border-amber-300 hover:bg-amber-100 flex items-center">
                    <span class="inline-block w-2 h-2 rounded-full bg-amber-500 mr-1.5 animate-pulse"></span>
                    Pending (Needs Action)
                </button>
                <button type="button" onclick="setQuickStatus('confirmed')" id="statusPillConfirmed" class="status-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-slate-50 text-slate-700 border-slate-300 hover:bg-slate-100">
                    Confirmed
                </button>
                <button type="button" onclick="setQuickStatus('completed')" id="statusPillCompleted" class="status-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-slate-50 text-slate-700 border-slate-300 hover:bg-slate-100">
                    Completed
                </button>
                <button type="button" onclick="setQuickStatus('cancelled')" id="statusPillCancelled" class="status-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-slate-50 text-slate-700 border-slate-300 hover:bg-slate-100">
                    Cancelled
                </button>
                <button type="button" onclick="setQuickStatus('rejected')" id="statusPillRejected" class="status-pill px-3 py-1.5 rounded-full text-xs font-semibold border transition bg-slate-50 text-slate-700 border-slate-300 hover:bg-slate-100">
                    Rejected
                </button>
            </div>

            <div class="w-full sm:w-72 relative">
                <input type="text" id="filterSearch" placeholder="Search reference, customer, phone..." onkeydown="if(event.key==='Enter') applyFilters()" class="w-full rounded-lg border-slate-300 pl-10 pr-4 py-2 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Filter Dropdowns & Date Controls -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 pt-3 border-t border-slate-100 text-sm">
            <div>
                <label for="filterBarber" class="block text-xs font-medium text-slate-600 mb-1">Barber</label>
                <select id="filterBarber" onchange="applyFilters()" class="w-full rounded-lg border-slate-300 py-1.5 px-3 text-sm focus:border-brand-500 focus:ring-brand-500">
                    <option value="">All Barbers</option>
                    @foreach (var b in Model.Barbers)
                    {
                        <option value="@b.Id">@b.DisplayName</option>
                    }
                </select>
            </div>

            <div>
                <label for="filterService" class="block text-xs font-medium text-slate-600 mb-1">Service</label>
                <select id="filterService" onchange="applyFilters()" class="w-full rounded-lg border-slate-300 py-1.5 px-3 text-sm focus:border-brand-500 focus:ring-brand-500">
                    <option value="">All Services</option>
                    @foreach (var s in Model.Services)
                    {
                        <option value="@s.Id">@s.Name (@s.FormattedPrice)</option>
                    }
                </select>
            </div>

            <div id="dateFilterRangeWrapper" class="contents">
                <div>
                    <label for="filterStartDate" class="block text-xs font-medium text-slate-600 mb-1">From Date</label>
                    <input type="date" id="filterStartDate" onchange="applyFilters()" class="w-full rounded-lg border-slate-300 py-1.5 px-3 text-sm focus:border-brand-500 focus:ring-brand-500" />
                </div>
                <div>
                    <label for="filterEndDate" class="block text-xs font-medium text-slate-600 mb-1">To Date</label>
                    <input type="date" id="filterEndDate" onchange="applyFilters()" class="w-full rounded-lg border-slate-300 py-1.5 px-3 text-sm focus:border-brand-500 focus:ring-brand-500" />
                </div>
            </div>
        </div>
    </div>

    <!-- 1. LIST VIEW CONTAINER -->
    <div id="listViewContainer" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider font-semibold">
                    <tr>
                        <th scope="col" class="px-6 py-3.5 text-left">Reference</th>
                        <th scope="col" class="px-6 py-3.5 text-left">Customer</th>
                        <th scope="col" class="px-6 py-3.5 text-left">Barber</th>
                        <th scope="col" class="px-6 py-3.5 text-left">Service</th>
                        <th scope="col" class="px-6 py-3.5 text-left">Date & Time</th>
                        <th scope="col" class="px-6 py-3.5 text-right">Price</th>
                        <th scope="col" class="px-6 py-3.5 text-center">Status</th>
                        <th scope="col" class="px-6 py-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="appointmentTableBody" class="divide-y divide-slate-200 bg-white">
                    <tr>
                        <td colspan="8" class="px-6 py-12 text-center text-slate-500">
                            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div>
                            <p class="mt-2 text-sm">Loading bookings...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        <div id="paginationBar" class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-sm">
            <div class="text-slate-600" id="paginationInfo">Showing 0 bookings</div>
            <div class="flex items-center space-x-2">
                <button type="button" id="prevPageBtn" onclick="changePage(-1)" class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">
                    Previous
                </button>
                <span id="pageIndicator" class="px-2 font-semibold text-slate-800">1</span>
                <button type="button" id="nextPageBtn" onclick="changePage(1)" class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">
                    Next
                </button>
            </div>
        </div>
    </div>

    <!-- 2. DAY CALENDAR VIEW CONTAINER -->
    <div id="dayViewContainer" class="hidden space-y-4">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <button type="button" onclick="navigateDay(-1)" class="p-2 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <input type="date" id="selectedCalendarDay" onchange="renderDayView()" class="rounded-lg border-slate-300 py-1.5 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 font-semibold" />
                <button type="button" onclick="navigateDay(1)" class="p-2 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
                <button type="button" onclick="goToTodayDay()" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300">Today</button>
            </div>
            <div class="text-sm font-medium text-slate-600" id="dayViewTitle"></div>
        </div>

        <div id="dayGridContent" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 min-h-[400px]">
            <!-- Dynamic columns per barber -->
        </div>
    </div>

    <!-- 3. WEEK CALENDAR VIEW CONTAINER -->
    <div id="weekViewContainer" class="hidden space-y-4">
        <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <button type="button" onclick="navigateWeek(-1)" class="p-2 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
                </button>
                <button type="button" onclick="navigateWeek(1)" class="p-2 rounded-lg border border-slate-300 hover:bg-slate-50 text-slate-700">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                </button>
                <button type="button" onclick="goToCurrentWeek()" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300">Current Week</button>
            </div>
            <div class="text-sm font-semibold text-slate-800" id="weekViewTitle"></div>
        </div>

        <div id="weekGridContent" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-x-auto p-4 min-h-[450px]">
            <!-- Dynamic 7-day columns -->
        </div>
    </div>
</div>

<!-- APPOINTMENT DETAIL & TIMELINE DRAWER -->
<div id="detailDrawerBackdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden transition-opacity" onclick="closeDrawer()"></div>
<div id="detailDrawer" class="fixed inset-y-0 right-0 max-w-lg w-full bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
        <h2 class="text-lg font-bold">Appointment Details</h2>
        <button type="button" onclick="closeDrawer()" class="text-slate-400 hover:text-white p-1 rounded-md">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
    </div>

    <div class="flex-1 overflow-y-auto p-6 space-y-6" id="drawerContent">
        <!-- Rendered via JS -->
    </div>

    <div class="p-4 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-end gap-2" id="drawerActions">
        <!-- Action buttons rendered via JS based on current status -->
    </div>
</div>

<!-- STATUS ACTION MODAL (Confirm / Reject / Complete / Cancel) -->
<div id="statusActionModal" class="fixed inset-0 bg-slate-900/60 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-xl max-w-md w-full shadow-2xl overflow-hidden border border-slate-200 animate-in fade-in zoom-in-95 duration-150">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
            <h3 class="font-bold text-slate-900" id="modalTitle">Update Appointment Status</h3>
            <button type="button" onclick="closeActionModal()" class="text-slate-400 hover:text-slate-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>

        <form id="statusActionForm" onsubmit="submitStatusAction(event)" class="p-6 space-y-4">
            <input type="hidden" id="modalAppointmentId" />
            <input type="hidden" id="modalTargetStatus" />

            <div id="modalDescription" class="text-sm text-slate-600"></div>

            <div>
                <label for="modalNote" class="block text-xs font-semibold text-slate-700 mb-1">
                    Note / Reason <span id="noteRequiredLabel" class="text-rose-500 font-bold hidden">* (Required for reject/cancel)</span>
                </label>
                <textarea id="modalNote" rows="3" placeholder="Provide an optional note or state the cancellation/rejection reason..." class="w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm"></textarea>
                <p id="modalNoteError" class="mt-1 text-xs text-rose-600 hidden font-medium">Please enter a reason before proceeding.</p>
            </div>

            <div class="flex items-center justify-end space-x-3 pt-3 border-t border-slate-100">
                <button type="button" onclick="closeActionModal()" class="px-4 py-2 rounded-lg border border-slate-300 text-sm font-semibold text-slate-700 hover:bg-slate-50">Cancel</button>
                <button type="submit" id="modalSubmitBtn" class="px-4 py-2 rounded-lg text-sm font-semibold text-white shadow-sm transition">Confirm Action</button>
            </div>
        </form>
    </div>
</div>

<script>
    const INITIAL_VIEW = '@Model.InitialView';
    const INITIAL_STATUS = '@Model.InitialStatus';
    const TODAY_DATE = '@Model.TodayDateString';

    let currentView = INITIAL_VIEW || 'list';
    let currentStatus = INITIAL_STATUS || '';
    let currentPage = 1;
    let pageSize = 15;
    let cachedAppointments = [];
    let currentSelectedApp = null;

    let selectedDay = TODAY_DATE;
    let selectedWeekStart = getMonday(new Date(TODAY_DATE));

    function getMonday(d) {
        d = new Date(d);
        let day = d.getDay();
        let diff = d.getDate() - day + (day === 0 ? -6 : 1);
        return new Date(d.setDate(diff));
    }

    function formatDateYMD(d) {
        let month = '' + (d.getMonth() + 1);
        let day = '' + d.getDate();
        let year = d.getFullYear();
        if (month.length < 2) month = '0' + month;
        if (day.length < 2) day = '0' + day;
        return [year, month, day].join('-');
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('selectedCalendarDay').value = selectedDay;
        if (INITIAL_STATUS) {
            setQuickStatus(INITIAL_STATUS);
        } else {
            switchView(currentView);
        }
    });

    function setQuickStatus(status) {
        currentStatus = status;
        document.querySelectorAll('.status-pill').forEach(btn => {
            btn.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
            btn.classList.add('bg-slate-50', 'text-slate-700', 'border-slate-300');
        });

        if (!status) {
            let el = document.getElementById('statusPillAll');
            el.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
        } else if (status === 'pending') {
            let el = document.getElementById('statusPillPending');
            el.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
        } else if (status === 'confirmed') {
            let el = document.getElementById('statusPillConfirmed');
            el.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
        } else if (status === 'completed') {
            let el = document.getElementById('statusPillCompleted');
            el.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
        } else if (status === 'cancelled') {
            let el = document.getElementById('statusPillCancelled');
            el.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
        } else if (status === 'rejected') {
            let el = document.getElementById('statusPillRejected');
            el.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
        }

        currentPage = 1;
        loadAppointments();
    }

    function switchView(view) {
        currentView = view;
        const listBtn = document.getElementById('viewBtnList');
        const dayBtn = document.getElementById('viewBtnDay');
        const weekBtn = document.getElementById('viewBtnWeek');

        const listContainer = document.getElementById('listViewContainer');
        const dayContainer = document.getElementById('dayViewContainer');
        const weekContainer = document.getElementById('weekViewContainer');

        [listBtn, dayBtn, weekBtn].forEach(b => {
            b.classList.remove('bg-slate-900', 'text-white');
            b.classList.add('text-slate-700');
        });

        listContainer.classList.add('hidden');
        dayContainer.classList.add('hidden');
        weekContainer.classList.add('hidden');

        if (view === 'list') {
            listBtn.classList.add('bg-slate-900', 'text-white');
            listContainer.classList.remove('hidden');
            loadAppointments();
        } else if (view === 'day') {
            dayBtn.classList.add('bg-slate-900', 'text-white');
            dayContainer.classList.remove('hidden');
            renderDayView();
        } else if (view === 'week') {
            weekBtn.classList.add('bg-slate-900', 'text-white');
            weekContainer.classList.remove('hidden');
            renderWeekView();
        }
    }

    function applyFilters() {
        currentPage = 1;
        if (currentView === 'list') {
            loadAppointments();
        } else if (currentView === 'day') {
            renderDayView();
        } else if (currentView === 'week') {
            renderWeekView();
        }
    }

    async function loadAppointments() {
        const tbody = document.getElementById('appointmentTableBody');
        tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-12 text-center text-slate-500">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div>
            <p class="mt-2 text-sm">Loading bookings...</p>
        </td></tr>`;

        let url = `/api/admin/appointments?page=${currentPage}&pageSize=${pageSize}&sortOrder=desc`;
        if (currentStatus) url += `&status=${encodeURIComponent(currentStatus)}`;
        const barberId = document.getElementById('filterBarber').value;
        if (barberId) url += `&barberId=${barberId}`;
        const serviceId = document.getElementById('filterService').value;
        if (serviceId) url += `&serviceId=${serviceId}`;
        const search = document.getElementById('filterSearch').value.trim();
        if (search) url += `&search=${encodeURIComponent(search)}`;
        const start = document.getElementById('filterStartDate').value;
        if (start) url += `&startDate=${start}`;
        const end = document.getElementById('filterEndDate').value;
        if (end) url += `&endDate=${end}`;

        try {
            const res = await fetch(url);
            if (!res.ok) throw new Error('Failed to load appointments');
            const data = await res.json();
            cachedAppointments = data.items || [];
            renderTable(cachedAppointments, data.totalCount);
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-8 text-center text-rose-600 font-medium">${err.message}</td></tr>`;
        }
    }

    function renderTable(items, totalCount) {
        const tbody = document.getElementById('appointmentTableBody');
        if (!items || items.length === 0) {
            tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-12 text-center text-slate-500">
                <p class="text-base font-semibold text-slate-700">No bookings found</p>
                <p class="text-sm mt-1">Try adjusting your filters or date range.</p>
            </td></tr>`;
            document.getElementById('paginationInfo').innerText = 'Showing 0 bookings';
            document.getElementById('prevPageBtn').disabled = true;
            document.getElementById('nextPageBtn').disabled = true;
            return;
        }

        let html = '';
        items.forEach(app => {
            const badge = getStatusBadgeHtml(app.status, app.statusDisplay);
            html += `<tr class="hover:bg-slate-50 transition cursor-pointer" onclick="openDrawer(${app.id})">
                <td class="px-6 py-4 whitespace-nowrap font-mono text-xs font-bold text-brand-700">${app.referenceCode}</td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="font-medium text-slate-900">${escapeHtml(app.customerName)}</div>
                    <div class="text-xs text-slate-500">${escapeHtml(app.customerPhone || app.customerEmail)}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-slate-700 font-medium">${escapeHtml(app.barberName)}</td>
                <td class="px-6 py-4 whitespace-nowrap text-slate-700">
                    <div>${escapeHtml(app.serviceName)}</div>
                    <div class="text-xs text-slate-400">${app.durationMinutes} mins</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="font-medium text-slate-900">${app.formattedDate}</div>
                    <div class="text-xs text-slate-500">${app.formattedTime}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right font-semibold text-slate-900">${app.formattedPrice}</td>
                <td class="px-6 py-4 whitespace-nowrap text-center">${badge}</td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-xs" onclick="event.stopPropagation()">
                    <button type="button" onclick="openDrawer(${app.id})" class="text-brand-600 hover:text-brand-800 font-semibold px-2 py-1 rounded bg-brand-50 hover:bg-brand-100">
                        View
                    </button>
                </td>
            </tr>`;
        });
        tbody.innerHTML = html;

        // Pagination
        const startItem = (currentPage - 1) * pageSize + 1;
        const endItem = Math.min(currentPage * pageSize, totalCount);
        document.getElementById('paginationInfo').innerText = `Showing ${startItem}–${endItem} of ${totalCount} bookings`;
        document.getElementById('pageIndicator').innerText = currentPage;
        document.getElementById('prevPageBtn').disabled = currentPage <= 1;
        document.getElementById('nextPageBtn').disabled = endItem >= totalCount;
    }

    function changePage(delta) {
        currentPage += delta;
        loadAppointments();
    }

    function getStatusBadgeHtml(status, label) {
        status = (status || '').toLowerCase();
        let bg = 'bg-slate-100 text-slate-800 border-slate-300';
        if (status === 'pending') bg = 'bg-amber-100 text-amber-800 border-amber-300';
        else if (status === 'confirmed') bg = 'bg-sky-100 text-sky-800 border-sky-300';
        else if (status === 'completed') bg = 'bg-emerald-100 text-emerald-800 border-emerald-300';
        else if (status === 'cancelled') bg = 'bg-slate-100 text-slate-800 border-slate-300';
        else if (status === 'rejected') bg = 'bg-rose-100 text-rose-800 border-rose-300';

        return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${bg}">${label || status}</span>`;
    }

    // DAY CALENDAR VIEW
    async function renderDayView() {
        selectedDay = document.getElementById('selectedCalendarDay').value || TODAY_DATE;
        const dateObj = new Date(selectedDay + 'T00:00:00');
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('dayViewTitle').innerText = dateObj.toLocaleDateString('en-US', options);

        const container = document.getElementById('dayGridContent');
        container.innerHTML = `<div class="py-12 text-center text-slate-500"><div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div><p class="mt-2 text-sm">Loading day schedule...</p></div>`;

        let url = `/api/admin/appointments?startDate=${selectedDay}&endDate=${selectedDay}&pageSize=100`;
        const barberId = document.getElementById('filterBarber').value;
        if (barberId) url += `&barberId=${barberId}`;
        const serviceId = document.getElementById('filterService').value;
        if (serviceId) url += `&serviceId=${serviceId}`;

        try {
            const res = await fetch(url);
            const data = await res.json();
            const items = data.items || [];
            cachedAppointments = items;

            if (items.length === 0) {
                container.innerHTML = `<div class="py-12 text-center text-slate-500">
                    <p class="text-base font-semibold text-slate-700">No appointments scheduled for this day</p>
                    <p class="text-xs text-slate-400 mt-1">Select another day or adjust your filters.</p>
                </div>`;
                return;
            }

            // Group by Barber
            const barbersMap = {};
            items.forEach(a => {
                if (!barbersMap[a.barberName]) barbersMap[a.barberName] = [];
                barbersMap[a.barberName].push(a);
            });

            let html = `<div class="grid grid-cols-1 md:grid-cols-${Math.min(Object.keys(barbersMap).length, 3)} gap-6">`;
            for (const [barber, appList] of Object.entries(barbersMap)) {
                html += `<div class="border border-slate-200 rounded-xl p-4 bg-slate-50 flex flex-col">
                    <div class="font-bold text-slate-900 border-b border-slate-200 pb-2 mb-3 flex items-center justify-between">
                        <span>${escapeHtml(barber)}</span>
                        <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-200 text-slate-700">${appList.length}</span>
                    </div>
                    <div class="space-y-3 flex-1 overflow-y-auto max-h-[500px]">`;
                
                appList.sort((x, y) => x.scheduledTimeString.localeCompare(y.scheduledTimeString)).forEach(app => {
                    const badge = getStatusBadgeHtml(app.status, app.status.toUpperCase());
                    html += `<div onclick="openDrawer(${app.id})" class="p-3 bg-white rounded-lg border border-slate-200 shadow-sm hover:border-brand-500 transition cursor-pointer">
                        <div class="flex items-center justify-between text-xs mb-1">
                            <span class="font-mono font-bold text-brand-700">${app.referenceCode}</span>
                            <span>${badge}</span>
                        </div>
                        <div class="font-semibold text-sm text-slate-800">${escapeHtml(app.customerName)}</div>
                        <div class="text-xs text-slate-500">${escapeHtml(app.serviceName)} (${app.formattedPrice})</div>
                        <div class="mt-2 text-xs font-medium text-slate-600 flex items-center">
                            <svg class="h-3.5 w-3.5 mr-1 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            ${app.formattedTime}
                        </div>
                    </div>`;
                });

                html += `</div></div>`;
            }
            html += `</div>`;
            container.innerHTML = html;
        } catch (err) {
            container.innerHTML = `<div class="py-8 text-center text-rose-600 font-medium">${err.message}</div>`;
        }
    }

    function navigateDay(delta) {
        const d = new Date(selectedDay + 'T00:00:00');
        d.setDate(d.getDate() + delta);
        selectedDay = formatDateYMD(d);
        document.getElementById('selectedCalendarDay').value = selectedDay;
        renderDayView();
    }

    function goToTodayDay() {
        selectedDay = TODAY_DATE;
        document.getElementById('selectedCalendarDay').value = selectedDay;
        renderDayView();
    }

    // WEEK CALENDAR VIEW
    async function renderWeekView() {
        const weekEnd = new Date(selectedWeekStart);
        weekEnd.setDate(weekEnd.getDate() + 6);

        const startStr = formatDateYMD(selectedWeekStart);
        const endStr = formatDateYMD(weekEnd);

        document.getElementById('weekViewTitle').innerText = `${startStr} to ${endStr}`;

        const container = document.getElementById('weekGridContent');
        container.innerHTML = `<div class="py-12 text-center text-slate-500"><div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div><p class="mt-2 text-sm">Loading week schedule...</p></div>`;

        let url = `/api/admin/appointments?startDate=${startStr}&endDate=${endStr}&pageSize=200`;
        const barberId = document.getElementById('filterBarber').value;
        if (barberId) url += `&barberId=${barberId}`;
        const serviceId = document.getElementById('filterService').value;
        if (serviceId) url += `&serviceId=${serviceId}`;

        try {
            const res = await fetch(url);
            const data = await res.json();
            const items = data.items || [];
            cachedAppointments = items;

            // Generate 7 days
            const days = [];
            for (let i = 0; i < 7; i++) {
                let d = new Date(selectedWeekStart);
                d.setDate(d.getDate() + i);
                days.push({
                    dateStr: formatDateYMD(d),
                    dayName: d.toLocaleDateString('en-US', { weekday: 'short' }),
                    displayDate: d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
                });
            }

            let html = `<div class="grid grid-cols-7 gap-3 min-w-[900px]">`;
            days.forEach(day => {
                const dayApps = items.filter(a => a.scheduledDateString === day.dateStr);
                const isToday = day.dateStr === TODAY_DATE;

                html += `<div class="border rounded-xl p-3 flex flex-col ${isToday ? 'border-brand-500 bg-brand-50/20' : 'border-slate-200 bg-slate-50'}">
                    <div class="border-b pb-2 mb-2 text-center ${isToday ? 'border-brand-300 font-bold text-brand-900' : 'border-slate-200 font-semibold text-slate-800'}">
                        <div class="text-xs uppercase">${day.dayName}</div>
                        <div class="text-sm">${day.displayDate}</div>
                        <div class="text-[10px] text-slate-500 mt-0.5">${dayApps.length} bookings</div>
                    </div>
                    <div class="space-y-2 flex-1 overflow-y-auto max-h-[500px]">`;

                if (dayApps.length === 0) {
                    html += `<div class="text-[11px] text-slate-400 text-center py-6">No bookings</div>`;
                } else {
                    dayApps.sort((a,b) => a.scheduledTimeString.localeCompare(b.scheduledTimeString)).forEach(app => {
                        const badge = getStatusBadgeHtml(app.status, app.status.substring(0,4).toUpperCase());
                        html += `<div onclick="openDrawer(${app.id})" class="p-2 bg-white rounded-lg border border-slate-200 shadow-sm hover:border-brand-500 cursor-pointer text-xs">
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-mono text-[10px] font-bold text-brand-700">${app.referenceCode}</span>
                                <span>${badge}</span>
                            </div>
                            <div class="font-bold text-slate-900 truncate">${escapeHtml(app.customerName)}</div>
                            <div class="text-slate-500 truncate text-[11px]">${escapeHtml(app.barberName)}</div>
                            <div class="text-slate-600 font-medium text-[10px] mt-1">${app.scheduledTimeString} (${app.durationMinutes}m)</div>
                        </div>`;
                    });
                }

                html += `</div></div>`;
            });
            html += `</div>`;
            container.innerHTML = html;
        } catch (err) {
            container.innerHTML = `<div class="py-8 text-center text-rose-600 font-medium">${err.message}</div>`;
        }
    }

    function navigateWeek(delta) {
        selectedWeekStart.setDate(selectedWeekStart.getDate() + (delta * 7));
        renderWeekView();
    }

    function goToCurrentWeek() {
        selectedWeekStart = getMonday(new Date(TODAY_DATE));
        renderWeekView();
    }

    // DRAWER & ACTIONS
    async function openDrawer(appointmentId) {
        let app = cachedAppointments.find(a => a.id === appointmentId);
        if (!app) {
            try {
                const res = await fetch(`/api/appointments/${appointmentId}`);
                if (res.ok) app = await res.json();
            } catch {}
        }

        if (!app) return;
        currentSelectedApp = app;

        const content = document.getElementById('drawerContent');
        const badge = getStatusBadgeHtml(app.status, app.statusDisplay);

        let timelineHtml = '<div class="space-y-3 mt-4">';
        if (app.timeline && app.timeline.length > 0) {
            app.timeline.forEach(t => {
                timelineHtml += `<div class="relative pl-6 pb-2 border-l-2 border-slate-200 last:border-transparent">
                    <span class="absolute -left-1.5 top-1 w-3 h-3 rounded-full bg-brand-500 ring-4 ring-white"></span>
                    <div class="text-xs font-semibold text-slate-800 flex items-center justify-between">
                        <span>${t.toStatus ? t.toStatus.toUpperCase() : 'EVENT'} <span class="text-slate-400 font-normal">by ${escapeHtml(t.changedByRole)}</span></span>
                        <span class="text-[10px] text-slate-500">${t.formattedChangedAt || ''}</span>
                    </div>
                    <div class="text-xs text-slate-600 mt-0.5">${escapeHtml(t.note || '')}</div>
                </div>`;
            });
        } else {
            timelineHtml += '<p class="text-xs text-slate-500">No status events recorded.</p>';
        }
        timelineHtml += '</div>';

        content.innerHTML = `
            <div class="border-b border-slate-200 pb-4">
                <div class="flex items-center justify-between">
                    <span class="font-mono text-sm font-bold text-brand-700">${app.referenceCode}</span>
                    <span>${badge}</span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mt-1">${escapeHtml(app.serviceName)}</h3>
                <div class="text-lg font-semibold text-slate-800 mt-1">${app.formattedPrice} <span class="text-xs text-slate-500 font-normal">(${app.durationMinutes} minutes)</span></div>
            </div>

            <div class="space-y-3 text-sm">
                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Customer</span>
                    <div class="font-medium text-slate-900">${escapeHtml(app.customerName)}</div>
                    <div class="text-xs text-slate-500">${escapeHtml(app.customerPhone || 'No phone')} · ${escapeHtml(app.customerEmail || 'No email')}</div>
                </div>

                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Assigned Barber</span>
                    <div class="font-medium text-slate-900">${escapeHtml(app.barberName)}</div>
                </div>

                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Schedule</span>
                    <div class="font-medium text-slate-900">${app.formattedDate}</div>
                    <div class="text-xs text-slate-600 font-medium">${app.formattedTime}</div>
                </div>

                ${app.notes ? `<div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Customer Notes</span>
                    <div class="text-xs bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-slate-700 mt-1">${escapeHtml(app.notes)}</div>
                </div>` : ''}
            </div>

            <div class="pt-4 border-t border-slate-200">
                <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Status History & Audit Trail</h4>
                ${timelineHtml}
            </div>
        `;

        renderDrawerActionButtons(app);

        document.getElementById('detailDrawerBackdrop').classList.remove('hidden');
        document.getElementById('detailDrawer').classList.remove('translate-x-full');
    }

    function renderDrawerActionButtons(app) {
        const actionsContainer = document.getElementById('drawerActions');
        const status = (app.status || '').toLowerCase();

        let buttons = '';
        if (status === 'pending') {
            buttons = `
                <button type="button" onclick="openActionModal(${app.id}, 'confirmed')" class="px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs shadow-sm">
                    Confirm Booking
                </button>
                <button type="button" onclick="openActionModal(${app.id}, 'rejected')" class="px-3.5 py-2 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-semibold text-xs shadow-sm">
                    Reject Booking
                </button>
                <button type="button" onclick="openActionModal(${app.id}, 'cancelled')" class="px-3.5 py-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs shadow-sm">
                    Cancel Booking
                </button>
            `;
        } else if (status === 'confirmed') {
            buttons = `
                <button type="button" onclick="openActionModal(${app.id}, 'completed')" class="px-3.5 py-2 rounded-lg bg-brand-600 hover:bg-brand-500 text-white font-semibold text-xs shadow-sm">
                    Mark as Completed
                </button>
                <button type="button" onclick="openActionModal(${app.id}, 'cancelled')" class="px-3.5 py-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-rose-700 font-semibold text-xs shadow-sm">
                    Cancel Booking
                </button>
            `;
        } else {
            buttons = `<span class="text-xs text-slate-400 italic">Terminal Status — No further transitions allowed</span>`;
        }

        actionsContainer.innerHTML = buttons;
    }

    function closeDrawer() {
        document.getElementById('detailDrawerBackdrop').classList.add('hidden');
        document.getElementById('detailDrawer').classList.add('translate-x-full');
        currentSelectedApp = null;
    }

    function openActionModal(appointmentId, targetStatus) {
        document.getElementById('modalAppointmentId').value = appointmentId;
        document.getElementById('modalTargetStatus').value = targetStatus;
        document.getElementById('modalNote').value = '';
        document.getElementById('modalNoteError').classList.add('hidden');

        const title = document.getElementById('modalTitle');
        const desc = document.getElementById('modalDescription');
        const btn = document.getElementById('modalSubmitBtn');
        const reqLabel = document.getElementById('noteRequiredLabel');

        const isReq = (targetStatus === 'rejected' || targetStatus === 'cancelled');
        if (isReq) {
            reqLabel.classList.remove('hidden');
        } else {
            reqLabel.classList.add('hidden');
        }

        btn.className = 'px-4 py-2 rounded-lg text-sm font-semibold text-white shadow-sm transition';

        if (targetStatus === 'confirmed') {
            title.innerText = 'Confirm Appointment';
            desc.innerText = 'Are you sure you want to confirm this booking? The slot will remain locked for the customer.';
            btn.classList.add('bg-emerald-600', 'hover:bg-emerald-500');
            btn.innerText = 'Confirm Booking';
        } else if (targetStatus === 'rejected') {
            title.innerText = 'Reject Appointment';
            desc.innerText = 'Please state the reason for rejecting this booking. The slot will be released immediately.';
            btn.classList.add('bg-rose-600', 'hover:bg-rose-500');
            btn.innerText = 'Reject Booking';
        } else if (targetStatus === 'completed') {
            title.innerText = 'Complete Appointment';
            desc.innerText = 'Confirm that the service has been rendered in the shop. This will be recorded into transaction reports.';
            btn.classList.add('bg-brand-600', 'hover:bg-brand-500');
            btn.innerText = 'Complete Appointment';
        } else if (targetStatus === 'cancelled') {
            title.innerText = 'Cancel Appointment';
            desc.innerText = 'Please state the reason for cancellation. The slot will be released for other bookings.';
            btn.classList.add('bg-slate-800', 'hover:bg-slate-700');
            btn.innerText = 'Cancel Booking';
        }

        document.getElementById('statusActionModal').classList.remove('hidden');
    }

    function closeActionModal() {
        document.getElementById('statusActionModal').classList.add('hidden');
    }

    async function submitStatusAction(e) {
        e.preventDefault();
        const id = document.getElementById('modalAppointmentId').value;
        const targetStatus = document.getElementById('modalTargetStatus').value;
        const note = document.getElementById('modalNote').value.trim();

        // Check if note is required for reject / cancel
        if ((targetStatus === 'rejected' || targetStatus === 'cancelled') && !note) {
            document.getElementById('modalNoteError').classList.remove('hidden');
            return;
        }

        try {
            const res = await fetch(`/api/admin/appointments/${id}/status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ to: targetStatus, note: note || null })
            });

            if (!res.ok) {
                const err = await res.json();
                alert(err.error ? err.error.message : 'Error updating status');
                return;
            }

            closeActionModal();
            closeDrawer();

            // Refresh current view
            if (currentView === 'list') loadAppointments();
            else if (currentView === 'day') renderDayView();
            else if (currentView === 'week') renderWeekView();
        } catch (err) {
            alert('Request failed: ' + err.message);
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
</script>
