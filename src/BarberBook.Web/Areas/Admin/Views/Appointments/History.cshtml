@model BarberBook.Web.Models.Admin.AdminAppointmentsViewModel
@{
    ViewData["Title"] = "Appointment History & Audit Trail";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Appointment History</h1>
            <p class="mt-1 text-sm text-slate-500">Historical records of all appointments across every status, with complete status transition timelines and audit trails.</p>
        </div>
        <div class="mt-4 sm:mt-0">
            <button type="button" onclick="loadHistory()" class="inline-flex items-center px-3.5 py-2 border border-slate-300 shadow-sm text-sm font-semibold rounded-lg text-slate-700 bg-white hover:bg-slate-50">
                <svg class="h-4 w-4 mr-1.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh Records
            </button>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200/90 p-4 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-3 text-sm">
            <!-- Search -->
            <div class="lg:col-span-2">
                <label for="historySearch" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Search Records</label>
                <div class="relative">
                    <input type="text" id="historySearch" placeholder="Reference code, customer, phone..." onkeydown="if(event.key==='Enter') applyFilters()" class="filter-control w-full pl-9 pr-3 text-xs font-semibold" />
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5">
                        <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    </div>
                </div>
            </div>

            <!-- Branch Filter -->
            <div>
                <label for="historyBranch" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Branch</label>
                <select id="historyBranch" onchange="applyFilters()" class="filter-control w-full text-xs font-semibold">
                    <option value="">All Branches</option>
                    @foreach (var br in Model.Branches)
                    {
                        <option value="@br.Id">@br.Name</option>
                    }
                </select>
            </div>

            <!-- Status Filter -->
            <div>
                <label for="historyStatus" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Status</label>
                <select id="historyStatus" onchange="applyFilters()" class="filter-control w-full text-xs font-semibold">
                    <option value="">All Statuses</option>
                    <option value="pending">Pending</option>
                    <option value="confirmed">Confirmed</option>
                    <option value="completed">Completed</option>
                    <option value="cancelled">Cancelled</option>
                    <option value="rejected">Rejected</option>
                </select>
            </div>

            <!-- Barber Filter -->
            <div>
                <label for="historyBarber" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Barber</label>
                <select id="historyBarber" onchange="applyFilters()" class="filter-control w-full text-xs font-semibold">
                    <option value="">All Barbers</option>
                    @foreach (var b in Model.Barbers)
                    {
                        <option value="@b.Id">@b.DisplayName</option>
                    }
                </select>
            </div>

            <!-- Service Filter -->
            <div>
                <label for="historyService" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Service</label>
                <select id="historyService" onchange="applyFilters()" class="filter-control w-full text-xs font-semibold">
                    <option value="">All Services</option>
                    @foreach (var s in Model.Services)
                    {
                        <option value="@s.Id">@s.Name</option>
                    }
                </select>
            </div>

            <!-- Sort By -->
            <div>
                <label for="historySortBy" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Sort By</label>
                <select id="historySortBy" onchange="applyFilters()" class="filter-control w-full text-xs font-semibold">
                    <option value="date">Date & Time</option>
                    <option value="customer">Customer Name</option>
                    <option value="price">Price</option>
                    <option value="status">Status</option>
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 pt-3 border-t border-slate-100 text-sm">
            <div>
                <label for="historyStartDate" class="block text-xs font-semibold text-slate-600 mb-1">From Date</label>
                <input type="date" id="historyStartDate" onchange="applyFilters()" class="w-full rounded-lg border-slate-300 py-1.5 px-3 text-sm focus:border-brand-500 focus:ring-brand-500" />
            </div>
            <div>
                <label for="historyEndDate" class="block text-xs font-semibold text-slate-600 mb-1">To Date</label>
                <input type="date" id="historyEndDate" onchange="applyFilters()" class="w-full rounded-lg border-slate-300 py-1.5 px-3 text-sm focus:border-brand-500 focus:ring-brand-500" />
            </div>
            <div>
                <label for="historySortOrder" class="block text-xs font-semibold text-slate-600 mb-1">Order</label>
                <select id="historySortOrder" onchange="applyFilters()" class="w-full rounded-lg border-slate-300 py-1.5 px-3 text-sm focus:border-brand-500 focus:ring-brand-500">
                    <option value="desc">Newest First (Descending)</option>
                    <option value="asc">Oldest First (Ascending)</option>
                </select>
            </div>
            <div class="flex items-end">
                <button type="button" onclick="resetFilters()" class="w-full py-1.5 px-3 text-sm font-semibold rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-50 transition">
                    Reset Filters
                </button>
            </div>
        </div>
    </div>

    <!-- History Table & Mobile Cards -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <!-- Desktop Table View -->
        <div class="hidden sm:block overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider font-semibold">
                    <tr>
                        <th scope="col" class="px-6 py-3.5 text-left">Reference Code</th>
                        <th scope="col" class="px-6 py-3.5 text-left">Customer</th>
                        <th scope="col" class="px-6 py-3.5 text-left">Barber</th>
                        <th scope="col" class="px-6 py-3.5 text-left">Service</th>
                        <th scope="col" class="px-6 py-3.5 text-left">Date & Time</th>
                        <th scope="col" class="px-6 py-3.5 text-right">Price Snapshot</th>
                        <th scope="col" class="px-6 py-3.5 text-center">Status</th>
                        <th scope="col" class="px-6 py-3.5 text-right">Timeline</th>
                    </tr>
                </thead>
                <tbody id="historyTableBody" class="divide-y divide-slate-200 bg-white">
                    <tr>
                        <td colspan="8" class="px-6 py-12 text-center text-slate-500">
                            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div>
                            <p class="mt-2 text-sm">Loading appointment history...</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Mobile Stacked Card View -->
        <div id="historyCardList" class="sm:hidden divide-y divide-slate-100">
            <div class="p-8 text-center text-slate-500">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div>
                <p class="mt-2 text-xs">Loading records...</p>
            </div>
        </div>

        <!-- Pagination -->
        <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-sm">
            <div class="text-slate-600" id="paginationInfo">Showing 0 records</div>
            <div class="flex items-center space-x-2">
                <button type="button" id="prevPageBtn" onclick="changePage(-1)" class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">
                    Previous
                </button>
                <span id="pageIndicator" class="px-2 font-semibold text-slate-800">1</span>
                <button type="button" id="nextPageBtn" onclick="changePage(1)" class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">
                    Next
                </button>
            </div>
        </div>
    </div>
</div>

<!-- HISTORY DETAIL & TIMELINE DRAWER -->
<div id="detailDrawerBackdrop" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden transition-opacity" onclick="closeDrawer()"></div>
<div id="detailDrawer" class="fixed inset-y-0 right-0 max-w-lg w-full bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
        <h2 class="text-lg font-bold">Appointment Audit Trail</h2>
        <button type="button" onclick="closeDrawer()" class="text-slate-400 hover:text-white p-1 rounded-md">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
    </div>

    <div class="flex-1 overflow-y-auto p-6 space-y-6" id="drawerContent">
        <!-- Rendered via JS -->
    </div>

    <div class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-end">
        <button type="button" onclick="closeDrawer()" class="px-4 py-2 rounded-lg border border-slate-300 bg-white text-slate-700 font-semibold text-sm hover:bg-slate-50">
            Close
        </button>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 20;
    let cachedRecords = [];

    document.addEventListener('DOMContentLoaded', () => {
        loadHistory();
    });

    function applyFilters() {
        currentPage = 1;
        loadHistory();
    }

    function resetFilters() {
        document.getElementById('historySearch').value = '';
        if (document.getElementById('historyBranch')) document.getElementById('historyBranch').value = '';
        document.getElementById('historyStatus').value = '';
        document.getElementById('historyBarber').value = '';
        document.getElementById('historyService').value = '';
        document.getElementById('historyStartDate').value = '';
        document.getElementById('historyEndDate').value = '';
        document.getElementById('historySortBy').value = 'date';
        document.getElementById('historySortOrder').value = 'desc';
        currentPage = 1;
        loadHistory();
    }

    async function loadHistory() {
        const tbody = document.getElementById('historyTableBody');
        const cardList = document.getElementById('historyCardList');
        tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-12 text-center text-slate-500">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div>
            <p class="mt-2 text-sm">Loading appointment history...</p>
        </td></tr>`;
        if (cardList) {
            cardList.innerHTML = `<div class="p-8 text-center text-slate-500">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-slate-300 border-t-brand-600"></div>
                <p class="mt-2 text-xs">Loading records...</p>
            </div>`;
        }

        const search = document.getElementById('historySearch').value.trim();
        const branchSelect = document.getElementById('historyBranch');
        const branchId = branchSelect ? branchSelect.value : '';
        const status = document.getElementById('historyStatus').value;
        const barberId = document.getElementById('historyBarber').value;
        const serviceId = document.getElementById('historyService').value;
        const start = document.getElementById('historyStartDate').value;
        const end = document.getElementById('historyEndDate').value;
        const sortBy = document.getElementById('historySortBy').value;
        const sortOrder = document.getElementById('historySortOrder').value;

        let url = `/api/admin/appointments?page=${currentPage}&pageSize=${pageSize}&sortBy=${sortBy}&sortOrder=${sortOrder}`;
        if (search) url += `&search=${encodeURIComponent(search)}`;
        if (branchId) url += `&branchId=${branchId}`;
        if (status) url += `&status=${encodeURIComponent(status)}`;
        if (barberId) url += `&barberId=${barberId}`;
        if (serviceId) url += `&serviceId=${serviceId}`;
        if (start) url += `&startDate=${start}`;
        if (end) url += `&endDate=${end}`;

        try {
            const res = await fetch(url);
            if (!res.ok) throw new Error('Failed to retrieve history');
            const data = await res.json();
            cachedRecords = data.items || [];
            renderTable(cachedRecords, data.totalCount);
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-8 text-center text-rose-600 font-medium">${err.message}</td></tr>`;
            if (cardList) cardList.innerHTML = `<div class="p-6 text-center text-rose-600 text-xs font-medium">${err.message}</div>`;
        }
    }

    function renderTable(items, totalCount) {
        const tbody = document.getElementById('historyTableBody');
        const cardList = document.getElementById('historyCardList');
        if (!items || items.length === 0) {
            tbody.innerHTML = `<tr><td colspan="8" class="px-6 py-12 text-center text-slate-500">
                <p class="text-base font-semibold text-slate-700">No appointments found</p>
                <p class="text-xs text-slate-400 mt-1">Try broadening your search or date criteria.</p>
            </td></tr>`;
            if (cardList) {
                cardList.innerHTML = `<div class="p-8 text-center text-slate-500">
                    <p class="text-base font-semibold text-slate-700">No appointments found</p>
                    <p class="text-xs text-slate-400 mt-1">Try broadening your search or date criteria.</p>
                </div>`;
            }
            document.getElementById('paginationInfo').innerText = 'Showing 0 records';
            document.getElementById('prevPageBtn').disabled = true;
            document.getElementById('nextPageBtn').disabled = true;
            return;
        }

        let html = '';
        let cardHtml = '';
        items.forEach(app => {
            const badge = getStatusBadgeHtml(app.status, app.statusDisplay);
            html += `<tr class="hover:bg-slate-50 transition cursor-pointer" onclick="openDrawer(${app.id})">
                <td class="px-6 py-4 whitespace-nowrap font-mono text-xs font-bold text-brand-700">
                    <div class="flex items-center gap-1.5">
                        <span>${app.referenceCode}</span>
                        <button type="button" class="copy-btn" onclick="event.stopPropagation(); copyToClipboard('${app.referenceCode}', this)" title="Copy reference code" aria-label="Copy reference code">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>
                        </button>
                    </div>
                    ${app.branchName ? `<div class="text-[10px] text-slate-400 font-sans font-normal">${escapeHtml(app.branchName)}</div>` : ''}
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="font-medium text-slate-900">${escapeHtml(app.customerName)}</div>
                    <div class="text-xs text-slate-500">${escapeHtml(app.customerPhone || app.customerEmail)}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-slate-700 font-medium">${escapeHtml(app.barberName)}</td>
                <td class="px-6 py-4 whitespace-nowrap text-slate-700">
                    <div>${escapeHtml(app.serviceName)}</div>
                    <div class="text-xs text-slate-400">${app.durationMinutes} mins</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="font-medium text-slate-900">${app.formattedDate}</div>
                    <div class="text-xs text-slate-500">${app.formattedTime}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right font-semibold text-slate-900">${app.formattedPrice}</td>
                <td class="px-6 py-4 whitespace-nowrap text-center">${badge}</td>
                <td class="px-6 py-4 whitespace-nowrap text-right" onclick="event.stopPropagation()">
                    <button type="button" onclick="openDrawer(${app.id})" class="inline-flex items-center text-xs font-semibold text-brand-600 hover:text-brand-800 bg-brand-50 hover:bg-brand-100 px-2.5 py-1 rounded-md">
                        <svg class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Timeline
                    </button>
                </td>
            </tr>`;

            cardHtml += `
            <div class="p-4 space-y-3 hover:bg-slate-50/60 transition cursor-pointer" onclick="openDrawer(${app.id})">
                <div class="flex items-start justify-between gap-2">
                    <div>
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="font-mono text-xs font-bold text-brand-700">${app.referenceCode}</span>
                            <button type="button" class="copy-btn" onclick="event.stopPropagation(); copyToClipboard('${app.referenceCode}', this)" title="Copy reference code" aria-label="Copy reference code">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>
                            </button>
                            ${app.branchName ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">${escapeHtml(app.branchName)}</span>` : ''}
                        </div>
                        <div class="font-bold text-slate-900 text-sm mt-0.5">${escapeHtml(app.customerName)}</div>
                        <div class="text-xs text-slate-500">${escapeHtml(app.customerPhone || app.customerEmail)}</div>
                    </div>
                    <div class="shrink-0">
                        ${badge}
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2 text-xs text-slate-600 bg-slate-50/80 p-2.5 rounded-xl border border-slate-200/60">
                    <div>
                        <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400">Barber & Service</span>
                        <span class="font-semibold text-slate-800">${escapeHtml(app.barberName)}</span>
                        <span class="block text-[11px] text-slate-500">${escapeHtml(app.serviceName)} (${app.durationMinutes}m)</span>
                    </div>
                    <div class="text-right">
                        <span class="block text-[10px] font-bold uppercase tracking-wider text-slate-400">Schedule</span>
                        <span class="font-semibold text-slate-900">${app.formattedDate}</span>
                        <span class="block text-[11px] text-slate-500 font-mono">${app.formattedTime}</span>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-1">
                    <span class="text-sm font-bold text-slate-900">${app.formattedPrice}</span>
                    <button type="button" onclick="event.stopPropagation(); openDrawer(${app.id})" class="inline-flex items-center text-xs font-bold text-brand-600 hover:text-brand-800 bg-brand-50 hover:bg-brand-100 px-3 py-1.5 rounded-lg transition">
                        <svg class="h-3.5 w-3.5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Timeline &rarr;
                    </button>
                </div>
            </div>`;
        });
        tbody.innerHTML = html;
        if (cardList) cardList.innerHTML = cardHtml;

        // Pagination
        const startItem = (currentPage - 1) * pageSize + 1;
        const endItem = Math.min(currentPage * pageSize, totalCount);
        document.getElementById('paginationInfo').innerText = `Showing ${startItem}–${endItem} of ${totalCount} records`;
        document.getElementById('pageIndicator').innerText = currentPage;
        document.getElementById('prevPageBtn').disabled = currentPage <= 1;
        document.getElementById('nextPageBtn').disabled = endItem >= totalCount;
    }

    function changePage(delta) {
        currentPage += delta;
        loadHistory();
    }

    function getStatusBadgeHtml(status, label) {
        status = (status || '').toLowerCase();
        let bg = 'bg-slate-100 text-slate-800 border-slate-300';
        if (status === 'pending') bg = 'bg-amber-100 text-amber-800 border-amber-300';
        else if (status === 'confirmed') bg = 'bg-sky-100 text-sky-800 border-sky-300';
        else if (status === 'completed') bg = 'bg-emerald-100 text-emerald-800 border-emerald-300';
        else if (status === 'cancelled') bg = 'bg-slate-100 text-slate-800 border-slate-300';
        else if (status === 'rejected') bg = 'bg-rose-100 text-rose-800 border-rose-300';

        return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${bg}">${label || status}</span>`;
    }

    async function openDrawer(appointmentId) {
        let app = cachedRecords.find(a => a.id === appointmentId);
        if (!app) {
            try {
                const res = await fetch(`/api/appointments/${appointmentId}`);
                if (res.ok) app = await res.json();
            } catch {}
        }
        if (!app) return;

        const content = document.getElementById('drawerContent');
        const badge = getStatusBadgeHtml(app.status, app.statusDisplay);

        let timelineHtml = '<div class="space-y-4 mt-4">';
        if (app.timeline && app.timeline.length > 0) {
            app.timeline.forEach(t => {
                timelineHtml += `<div class="relative pl-6 pb-2 border-l-2 border-slate-200 last:border-transparent">
                    <span class="absolute -left-1.5 top-1 w-3 h-3 rounded-full bg-brand-500 ring-4 ring-white"></span>
                    <div class="text-xs font-bold text-slate-900 flex items-center justify-between">
                        <span>${t.toStatus ? t.toStatus.toUpperCase() : 'EVENT'} <span class="text-slate-400 font-normal">by ${escapeHtml(t.changedByRole)}</span></span>
                        <span class="text-[10px] text-slate-500">${t.formattedChangedAt || ''}</span>
                    </div>
                    <div class="text-xs text-slate-600 mt-1 bg-slate-50 p-2 rounded border border-slate-100">${escapeHtml(t.note || '')}</div>
                </div>`;
            });
        } else {
            timelineHtml += '<p class="text-xs text-slate-500">No status timeline events recorded.</p>';
        }
        timelineHtml += '</div>';

        content.innerHTML = `
            <div class="border-b border-slate-200 pb-4">
                <div class="flex items-center justify-between">
                    <span class="font-mono text-sm font-bold text-brand-700">${app.referenceCode}</span>
                    <span>${badge}</span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mt-1">${escapeHtml(app.serviceName)}</h3>
                <div class="text-lg font-semibold text-slate-800 mt-1">${app.formattedPrice} <span class="text-xs text-slate-500 font-normal">(${app.durationMinutes} minutes)</span></div>
            </div>

            <div class="space-y-3 text-sm">
                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Customer</span>
                    <div class="font-medium text-slate-900">${escapeHtml(app.customerName)}</div>
                    <div class="text-xs text-slate-500">${escapeHtml(app.customerPhone || 'No phone')} · ${escapeHtml(app.customerEmail || 'No email')}</div>
                </div>

                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Assigned Barber</span>
                    <div class="font-medium text-slate-900">${escapeHtml(app.barberName)}</div>
                </div>

                ${app.branchName ? `<div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Branch Station</span>
                    <div class="font-medium text-slate-900 flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        <span>${escapeHtml(app.branchName)}</span>
                    </div>
                </div>` : ''}

                <div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Scheduled Time</span>
                    <div class="font-medium text-slate-900">${app.formattedDate}</div>
                    <div class="text-xs text-slate-600 font-medium">${app.formattedTime}</div>
                </div>

                ${app.notes ? `<div>
                    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Customer Notes</span>
                    <div class="text-xs bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-slate-700 mt-1">${escapeHtml(app.notes)}</div>
                </div>` : ''}
            </div>

            <div class="pt-4 border-t border-slate-200">
                <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Complete Status Timeline (Audit Trail)</h4>
                ${timelineHtml}
            </div>
        `;

        document.getElementById('detailDrawerBackdrop').classList.remove('hidden');
        document.getElementById('detailDrawer').classList.remove('translate-x-full');
    }

    function closeDrawer() {
        document.getElementById('detailDrawerBackdrop').classList.add('hidden');
        document.getElementById('detailDrawer').classList.add('translate-x-full');
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
</script>

