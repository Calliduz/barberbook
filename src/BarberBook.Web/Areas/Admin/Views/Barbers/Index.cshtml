@model BarberBook.Web.Models.Admin.BarberListViewModel
@{
    ViewData["Title"] = "Barber Accounts";
}

<div class="space-y-6">
    <!-- Header Section -->
    <div class="sm:flex sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Barber Accounts</h1>
            <p class="mt-1 text-sm text-slate-500">Manage barber shop staff profiles, credentials, specialties, and active statuses.</p>
        </div>
        <div class="mt-4 sm:mt-0">
            <button type="button" onclick="openCreateModal()" class="inline-flex items-center justify-center rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600 transition">
                <svg class="-ml-1 mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Add New Barber
            </button>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-md bg-emerald-50 p-4 border border-emerald-200">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-emerald-800">@TempData["SuccessMessage"]</p>
                </div>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-md bg-rose-50 p-4 border border-rose-200">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-rose-400" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="ml-3">
                    <p class="text-sm font-medium text-rose-800">@TempData["ErrorMessage"]</p>
                </div>
            </div>
        </div>
    }

    <!-- Search & Filters -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4">
        <form method="get" action="/admin/barbers" class="flex flex-col sm:flex-row gap-4 justify-between items-center">
            <div class="w-full sm:w-80 relative">
                <input type="text" name="q" value="@Model.SearchQuery" placeholder="Search by name, email, specialty..." class="w-full rounded-lg border-slate-300 pl-10 pr-4 py-2 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </div>
            <div class="flex items-center gap-3 w-full sm:w-auto">
                <label for="statusFilter" class="text-sm font-medium text-slate-600 whitespace-nowrap">Status:</label>
                <select id="statusFilter" name="status" onchange="this.form.submit()" class="rounded-lg border-slate-300 py-2 pl-3 pr-8 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm">
                    <option value="all" selected="@(Model.StatusFilter == "all")">All Barbers</option>
                    <option value="active" selected="@(Model.StatusFilter == "active")">Active Only</option>
                    <option value="inactive" selected="@(Model.StatusFilter == "inactive")">Inactive Only</option>
                </select>
                <button type="submit" class="rounded-lg bg-slate-100 hover:bg-slate-200 px-3.5 py-2 text-sm font-medium text-slate-700 shadow-sm transition">Filter</button>
            </div>
        </form>
    </div>

    <!-- Barbers Table -->
    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <!-- Desktop Table View -->
        <div class="hidden sm:block overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                <thead class="bg-slate-50 text-slate-600 font-semibold">
                    <tr>
                        <th class="py-3.5 pl-6 pr-3">Barber</th>
                        <th class="px-3 py-3.5">Email</th>
                        <th class="px-3 py-3.5">Specialties</th>
                        <th class="px-3 py-3.5">Completed Bookings</th>
                        <th class="px-3 py-3.5">Status</th>
                        <th class="py-3.5 pl-3 pr-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 text-slate-700">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-400">
                                No barber accounts found matching the criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var barber in Model.Items)
                    {
                        <tr class="hover:bg-slate-50 transition">
                            <td class="py-4 pl-6 pr-3">
                                <div class="flex items-center space-x-3">
                                    @if (!string.IsNullOrWhiteSpace(barber.PhotoUrl))
                                    {
                                        <img src="@barber.PhotoUrl" alt="@barber.DisplayName" class="h-10 w-10 flex-shrink-0 rounded-full object-cover border border-slate-200" />
                                    }
                                    else
                                    {
                                        <div class="h-10 w-10 flex-shrink-0 rounded-full bg-brand-100 text-brand-800 flex items-center justify-center font-bold text-base">
                                            @barber.DisplayName.Substring(0, Math.Min(1, barber.DisplayName.Length)).ToUpperInvariant()
                                        </div>
                                    }
                                    <div>
                                        <div class="font-semibold text-slate-900">@barber.DisplayName</div>
                                        <div class="text-xs text-slate-500">@barber.FullName</div>
                                        @if (!string.IsNullOrWhiteSpace(barber.BranchName))
                                        {
                                            <span class="inline-flex items-center gap-1 mt-0.5 px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                                                <svg class="w-2.5 h-2.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                                @barber.BranchName
                                            </span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-3 py-4 text-slate-600">@barber.Email</td>
                            <td class="px-3 py-4 text-slate-600">
                                @(string.IsNullOrWhiteSpace(barber.Specialties) ? "General Grooming" : barber.Specialties)
                            </td>
                            <td class="px-3 py-4">
                                <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-800">
                                    @barber.CompletedAppointmentsCount appointments
                                </span>
                            </td>
                            <td class="px-3 py-4">
                                @if (barber.IsActive)
                                {
                                    <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 border border-emerald-200">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-1 text-xs font-medium text-rose-700 border border-rose-200">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="py-4 pl-3 pr-6 text-right whitespace-nowrap space-x-2">
                                <button type="button" onclick="openEditModal(@barber.Id, '@Html.Raw(Html.Encode(barber.FullName))', '@Html.Raw(Html.Encode(barber.DisplayName))', '@Html.Raw(Html.Encode(barber.Specialties ?? ""))', '@Html.Raw(Html.Encode(barber.Bio ?? ""))', '@Html.Raw(Html.Encode(barber.PhotoUrl ?? ""))', '@(barber.BranchId?.ToString() ?? "")')" class="text-brand-600 hover:text-brand-900 font-medium text-xs">Edit</button>
                                <span class="text-slate-300">|</span>
                                <button type="button" onclick="openResetPasswordModal(@barber.Id, '@Html.Raw(Html.Encode(barber.DisplayName))')" class="text-slate-600 hover:text-slate-900 font-medium text-xs">Reset Password</button>
                                <span class="text-slate-300">|</span>
                                <button type="button" onclick="confirmToggleStatus(@barber.Id, '@Html.Raw(Html.Encode(barber.DisplayName))', @(barber.IsActive ? "true" : "false"))" class="@(barber.IsActive ? "text-rose-600 hover:text-rose-800" : "text-emerald-600 hover:text-emerald-800") font-medium text-xs">
                                    @(barber.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Stacked Card View -->
        <div class="sm:hidden divide-y divide-slate-100">
            @if (!Model.Items.Any())
            {
                <div class="py-12 text-center text-slate-400 text-xs">
                    No barber accounts found matching the criteria.
                </div>
            }
            @foreach (var barber in Model.Items)
            {
                <div class="p-4 space-y-3">
                    <div class="flex items-start justify-between">
                        <div class="flex items-center space-x-3">
                            @if (!string.IsNullOrWhiteSpace(barber.PhotoUrl))
                            {
                                <img src="@barber.PhotoUrl" alt="@barber.DisplayName" class="h-10 w-10 flex-shrink-0 rounded-full object-cover border border-slate-200" />
                            }
                            else
                            {
                                <div class="h-10 w-10 flex-shrink-0 rounded-full bg-brand-100 text-brand-800 flex items-center justify-center font-bold text-sm">
                                    @barber.DisplayName.Substring(0, Math.Min(1, barber.DisplayName.Length)).ToUpperInvariant()
                                </div>
                            }
                            <div>
                                <h3 class="font-bold text-slate-900 text-sm">@barber.DisplayName</h3>
                                <p class="text-xs text-slate-500">@barber.FullName</p>
                            </div>
                        </div>
                        @if (barber.IsActive)
                        {
                            <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700 border border-emerald-200">
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center rounded-full bg-rose-50 px-2 py-0.5 text-[10px] font-bold text-rose-700 border border-rose-200">
                                Inactive
                            </span>
                        }
                    </div>

                    <div class="space-y-1 text-xs text-slate-600">
                        <p><span class="text-slate-400">Email:</span> @barber.Email</p>
                        <p><span class="text-slate-400">Specialties:</span> @(string.IsNullOrWhiteSpace(barber.Specialties) ? "General Grooming" : barber.Specialties)</p>
                    </div>

                    <div class="flex items-center gap-2 pt-1">
                        @if (!string.IsNullOrWhiteSpace(barber.BranchName))
                        {
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">
                                <svg class="w-2.5 h-2.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                @barber.BranchName
                            </span>
                        }
                        <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-800">
                            @barber.CompletedAppointmentsCount cuts
                        </span>
                    </div>

                    <div class="pt-2 border-t border-slate-100 flex items-center justify-end gap-2 text-xs">
                        <button type="button" onclick="openEditModal(@barber.Id, '@Html.Raw(Html.Encode(barber.FullName))', '@Html.Raw(Html.Encode(barber.DisplayName))', '@Html.Raw(Html.Encode(barber.Specialties ?? ""))', '@Html.Raw(Html.Encode(barber.Bio ?? ""))', '@Html.Raw(Html.Encode(barber.PhotoUrl ?? ""))', '@(barber.BranchId?.ToString() ?? "")')" class="px-2.5 py-1 rounded bg-amber-50 text-amber-900 border border-amber-200 font-bold hover:bg-amber-100 transition">
                            Edit
                        </button>
                        <button type="button" onclick="openResetPasswordModal(@barber.Id, '@Html.Raw(Html.Encode(barber.DisplayName))')" class="px-2.5 py-1 rounded bg-slate-100 text-slate-700 hover:bg-slate-200 transition font-medium">
                            Reset Pass
                        </button>
                        <button type="button" onclick="confirmToggleStatus(@barber.Id, '@Html.Raw(Html.Encode(barber.DisplayName))', @(barber.IsActive ? "true" : "false"))" class="px-2.5 py-1 rounded @(barber.IsActive ? "bg-rose-50 text-rose-700 border border-rose-200" : "bg-emerald-50 text-emerald-700 border border-emerald-200") font-bold transition">
                            @(barber.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex items-center justify-between border-t border-slate-200 bg-white px-4 py-3 sm:px-6">
                <div class="text-sm text-slate-500">
                    Showing <span class="font-medium">@((Model.Page - 1) * Model.PageSize + 1)</span> to <span class="font-medium">@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))</span> of <span class="font-medium">@Model.TotalCount</span> barbers
                </div>
                <div class="flex space-x-2">
                    @if (Model.Page > 1)
                    {
                        <a href="/admin/barbers?page=@(Model.Page - 1)&q=@Model.SearchQuery&status=@Model.StatusFilter" class="rounded-md border border-slate-300 bg-white px-3 py-1 text-sm font-medium text-slate-700 hover:bg-slate-50">Previous</a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a href="/admin/barbers?page=@(Model.Page + 1)&q=@Model.SearchQuery&status=@Model.StatusFilter" class="rounded-md border border-slate-300 bg-white px-3 py-1 text-sm font-medium text-slate-700 hover:bg-slate-50">Next</a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Barber Modal / Drawer -->
<div id="createModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl border border-slate-100">
        <div class="flex justify-between items-center mb-5">
            <h3 class="text-lg font-bold text-slate-900">Add New Barber Account</h3>
            <button type="button" onclick="closeModal('createModal')" class="text-slate-400 hover:text-slate-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form method="post" action="/admin/barbers" enctype="multipart/form-data" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">First Name *</label>
                    <input type="text" name="FirstName" id="createFirstName" required class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" placeholder="Ramon" oninput="updateCreateNamePreview()" />
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Middle Name</label>
                    <input type="text" name="MiddleName" id="createMiddleName" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" placeholder="Santos" oninput="updateCreateNamePreview()" />
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Last Name *</label>
                    <input type="text" name="LastName" id="createLastName" required class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" placeholder="Bautista" oninput="updateCreateNamePreview()" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Display Name / Nickname *</label>
                <input type="text" name="DisplayName" id="createDisplayName" required class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" placeholder="e.g. Master Ramon" oninput="this.dataset.manuallyEdited='true'" />
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Email Address *</label>
                <input type="email" name="Email" required class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" placeholder="e.g. ramon@barberbook.local" />
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Temporary Password *</label>
                <input type="password" name="Password" required minlength="6" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" placeholder="Set temporary password" />
                <p class="text-xs text-slate-400 mt-1">Admin provides this password to the barber. Barbers cannot self-register (LM-4).</p>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Assigned Branch</label>
                <select name="BranchId" id="createBranchId" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm">
                    <option value="">-- No Branch Assigned --</option>
                    @foreach (var br in Model.Branches)
                    {
                        <option value="@br.Id">@br.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Specialties</label>
                <input type="text" name="Specialties" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" placeholder="e.g. Classic Taper, Pompadour, Beard Fade" />
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Bio</label>
                <textarea name="Bio" rows="2" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" placeholder="Short introduction for customers..."></textarea>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Barber Photo</label>
                <input type="file" name="photoFile" accept="image/*" class="mt-1 block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 shadow-sm" />
                <p class="text-[11px] text-slate-400 mt-1">Upload a portrait image (PNG, JPG, SVG). Stored locally in /uploads/barbers/.</p>
            </div>
            <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="closeModal('createModal')" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 transition">Cancel</button>
                <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500 transition">Create Account</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Barber Modal -->
<div id="editModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl border border-slate-100">
        <div class="flex justify-between items-center mb-5">
            <h3 class="text-lg font-bold text-slate-900">Edit Barber Profile</h3>
            <button type="button" onclick="closeModal('editModal')" class="text-slate-400 hover:text-slate-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <form id="editBarberForm" method="post" action="" enctype="multipart/form-data" class="space-y-4">
            <input type="hidden" id="editPhotoUrl" name="PhotoUrl" />
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">First Name *</label>
                    <input type="text" id="editFirstName" name="FirstName" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Middle Name</label>
                    <input type="text" id="editMiddleName" name="MiddleName" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Last Name *</label>
                    <input type="text" id="editLastName" name="LastName" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Display Name *</label>
                <input type="text" id="editDisplayName" name="DisplayName" required class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Assigned Branch</label>
                <select name="BranchId" id="editBranchId" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm">
                    <option value="">-- No Branch Assigned --</option>
                    @foreach (var br in Model.Branches)
                    {
                        <option value="@br.Id">@br.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Specialties</label>
                <input type="text" id="editSpecialties" name="Specialties" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" />
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Bio</label>
                <textarea id="editBio" name="Bio" rows="2" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm"></textarea>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Change Barber Photo</label>
                <input type="file" name="photoFile" accept="image/*" class="mt-1 block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 shadow-sm" />
                <p class="text-[11px] text-slate-400 mt-1">Leave empty to keep current photo. Stored locally in /uploads/barbers/.</p>
            </div>
            <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="closeModal('editModal')" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 transition">Cancel</button>
                <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500 transition">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Reset Password Modal -->
<div id="resetPasswordModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100">
        <div class="flex justify-between items-center mb-5">
            <h3 class="text-lg font-bold text-slate-900">Reset Password</h3>
            <button type="button" onclick="closeModal('resetPasswordModal')" class="text-slate-400 hover:text-slate-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <p class="text-sm text-slate-600 mb-4">Set a new password for <span id="resetBarberName" class="font-semibold text-slate-900"></span>. Direct password override managed by shop administrator.</p>
        <form id="resetPasswordForm" method="post" action="" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700">New Password *</label>
                <input type="password" name="NewPassword" required minlength="6" class="mt-1 block w-full rounded-lg border-slate-300 py-2 px-3 text-sm focus:border-brand-500 focus:ring-brand-500 shadow-sm" placeholder="Minimum 6 characters" />
            </div>
            <div class="flex justify-end space-x-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="closeModal('resetPasswordModal')" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 transition">Cancel</button>
                <button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500 transition">Update Password</button>
            </div>
        </form>
    </div>
</div>

<!-- Toggle Status Confirmation Dialog -->
<div id="confirmStatusModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100">
        <div class="flex items-center space-x-3 mb-4">
            <div id="confirmIconContainer" class="p-2 rounded-full">
                <!-- Icon inserted via JS -->
            </div>
            <h3 id="confirmStatusTitle" class="text-lg font-bold text-slate-900">Confirm Action</h3>
        </div>
        <p id="confirmStatusMessage" class="text-sm text-slate-600 mb-6"></p>
        <form id="toggleStatusForm" method="post" action="" class="flex justify-end space-x-3">
            <button type="button" onclick="closeModal('confirmStatusModal')" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200 transition">Cancel</button>
            <button type="submit" id="confirmStatusBtn" class="rounded-lg px-4 py-2 text-sm font-semibold text-white transition"></button>
        </form>
    </div>
</div>

<script>
    function openCreateModal() {
        document.getElementById('createFirstName').value = '';
        document.getElementById('createMiddleName').value = '';
        document.getElementById('createLastName').value = '';
        document.getElementById('createBranchId').value = '';
        const dn = document.getElementById('createDisplayName');
        dn.value = '';
        delete dn.dataset.manuallyEdited;
        document.getElementById('createModal').classList.remove('hidden');
    }

    function updateCreateNamePreview() {
        const fn = document.getElementById('createFirstName').value.trim();
        const dn = document.getElementById('createDisplayName');
        if (!dn.dataset.manuallyEdited && fn) {
            dn.value = fn;
        }
    }

    function openEditModal(id, fullName, displayName, specialties, bio, photoUrl, branchId) {
        document.getElementById('editBarberForm').action = '/admin/barbers/' + id + '/edit';
        const parts = (fullName || '').trim().split(/\s+/);
        if (parts.length === 1) {
            document.getElementById('editFirstName').value = parts[0] || '';
            document.getElementById('editMiddleName').value = '';
            document.getElementById('editLastName').value = '';
        } else if (parts.length === 2) {
            document.getElementById('editFirstName').value = parts[0] || '';
            document.getElementById('editMiddleName').value = '';
            document.getElementById('editLastName').value = parts[1] || '';
        } else {
            document.getElementById('editFirstName').value = parts[0] || '';
            document.getElementById('editMiddleName').value = parts.slice(1, -1).join(' ');
            document.getElementById('editLastName').value = parts[parts.length - 1] || '';
        }
        document.getElementById('editDisplayName').value = displayName;
        document.getElementById('editSpecialties').value = specialties;
        document.getElementById('editBio').value = bio;
        document.getElementById('editPhotoUrl').value = photoUrl;
        document.getElementById('editBranchId').value = branchId || '';
        document.getElementById('editModal').classList.remove('hidden');
    }

    function openResetPasswordModal(id, displayName) {
        document.getElementById('resetPasswordForm').action = '/admin/barbers/' + id + '/reset-password';
        document.getElementById('resetBarberName').innerText = displayName;
        document.getElementById('resetPasswordModal').classList.remove('hidden');
    }

    function confirmToggleStatus(id, displayName, isActive) {
        document.getElementById('toggleStatusForm').action = '/admin/barbers/' + id + '/toggle-status';
        const title = isActive ? 'Deactivate Barber Account' : 'Activate Barber Account';
        const msg = isActive
            ? 'Are you sure you want to deactivate ' + displayName + '? The barber will not be able to log in and will be hidden from customer bookings. Existing historical appointments remain safely preserved.'
            : 'Are you sure you want to activate ' + displayName + '? The barber will be visible for customer bookings and able to log in.';
        const btnClass = isActive ? 'bg-rose-600 hover:bg-rose-500' : 'bg-emerald-600 hover:bg-emerald-500';
        const btnText = isActive ? 'Deactivate' : 'Activate';

        document.getElementById('confirmStatusTitle').innerText = title;
        document.getElementById('confirmStatusMessage').innerText = msg;
        const confirmBtn = document.getElementById('confirmStatusBtn');
        confirmBtn.className = 'rounded-lg px-4 py-2 text-sm font-semibold text-white transition ' + btnClass;
        confirmBtn.innerText = btnText;

        document.getElementById('confirmStatusModal').classList.remove('hidden');
    }

    function closeModal(id) {
        document.getElementById(id).classList.add('hidden');
    }
</script>

