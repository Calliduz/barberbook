@model BarberBook.Web.Models.Barber.BarberAvailabilityViewModel
@{
    ViewData["Title"] = "Availability & Days Off";
}

<div class="space-y-8">
    <!-- Header -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-2">
                <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                <span>SCHEDULE & WORKING HOURS</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">Availability & Days Off</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Barber: <span class="font-bold text-slate-800">@Model.BarberName</span> &bull; Configure recurring weekly shifts and schedule personal days off.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Weekly Working Hours Column -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm space-y-6">
            <div class="border-b border-slate-100 pb-4">
                <h2 class="text-xl font-serif font-bold text-slate-900">Weekly Shift Schedule</h2>
                <p class="text-xs text-slate-500 mt-0.5">Define your regular hours of service for client bookings.</p>
            </div>

            <form method="post" action="/barber/availability/working-hours" class="space-y-4">
                @Html.AntiForgeryToken()

                <div class="space-y-3">
                    @for (int i = 0; i < Model.WorkingHours.Count; i++)
                    {
                        var item = Model.WorkingHours[i];
                        <div class="p-4 rounded-2xl border @(item.IsWorking ? "border-amber-500/40 bg-amber-500/5" : "border-slate-200 bg-slate-50/50") flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 transition">
                            <input type="hidden" name="hours[@i].DayOfWeek" value="@item.DayOfWeek" />
                            <input type="hidden" name="hours[@i].DayName" value="@item.DayName" />

                            <div class="flex items-center gap-3">
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" name="hours[@i].IsWorking" value="true" class="sr-only peer" @(item.IsWorking ? "checked" : "") />
                                    <div class="w-10 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-500"></div>
                                </label>
                                <span class="font-bold text-sm text-slate-900">@item.DayName</span>
                            </div>

                            <div class="flex items-center gap-2 w-full sm:w-auto">
                                <div class="flex items-center gap-1.5 text-xs text-slate-600">
                                    <span>From</span>
                                    <input type="time" name="hours[@i].StartTime" value="@item.StartTime"
                                           class="px-2.5 py-1.5 rounded-lg border border-slate-300 text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20" />
                                </div>
                                <div class="flex items-center gap-1.5 text-xs text-slate-600">
                                    <span>To</span>
                                    <input type="time" name="hours[@i].EndTime" value="@item.EndTime"
                                           class="px-2.5 py-1.5 rounded-lg border border-slate-300 text-xs font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="pt-4 border-t border-slate-100 flex justify-end">
                    <button type="submit" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-md">
                        Save Weekly Shifts
                    </button>
                </div>
            </form>
        </div>

        <!-- Scheduled Days Off Column -->
        <div class="lg:col-span-5 space-y-6">
            <!-- Add Day Off Form -->
            <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm space-y-4">
                <div class="border-b border-slate-100 pb-3">
                    <h2 class="text-xl font-serif font-bold text-slate-900">Schedule Day Off</h2>
                    <p class="text-xs text-slate-500 mt-0.5">Mark a calendar date unavailable for customer booking.</p>
                </div>

                <form method="post" action="/barber/availability/days-off" class="space-y-3">
                    @Html.AntiForgeryToken()

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Date</label>
                        <input type="date" name="date" required min="@DateTime.UtcNow.ToString("yyyy-MM-dd")"
                               class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Reason (optional)</label>
                        <input type="text" name="reason" placeholder="e.g. Personal rest, holiday, training..."
                               class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20" />
                    </div>

                    <button type="submit" class="w-full py-2.5 px-4 rounded-xl text-xs font-bold bg-slate-900 text-white hover:bg-slate-800 transition shadow-sm">
                        Add Day Off
                    </button>
                </form>
            </div>

            <!-- List of Upcoming Days Off -->
            <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm space-y-4">
                <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-serif font-bold text-slate-900">Upcoming Days Off</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Scheduled upcoming rest days</p>
                    </div>
                    <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700">
                        @Model.DaysOff.Count
                    </span>
                </div>

                @if (!Model.DaysOff.Any())
                {
                    <div class="py-8 text-center text-slate-400">
                        <p class="text-xs font-semibold text-slate-600">No scheduled days off.</p>
                        <p class="text-[11px] text-slate-400 mt-0.5">You are available according to your weekly shift hours.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var day in Model.DaysOff)
                        {
                            <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between gap-3">
                                <div>
                                    <div class="font-bold text-xs text-slate-900">@day.FormattedDate</div>
                                    <div class="text-[11px] text-slate-500">@day.Reason</div>
                                </div>
                                <form method="post" action="/barber/availability/days-off/@day.Id/delete" class="inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="p-1.5 rounded-lg text-red-500 hover:text-red-700 hover:bg-red-50 transition" title="Remove day off">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

