@model BarberBook.Web.Models.Barber.BarberDashboardViewModel
@{
    ViewData["Title"] = "Barber Dashboard";
}

<div class="space-y-8">
    <!-- Header Hero Banner -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl text-white relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 opacity-5 pointer-events-none">
            <div class="barber-pole-icon" style="height: 220px; width: 110px;"></div>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 relative z-10">
            <div class="space-y-1.5">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold">
                    <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                    <span>MASTER CRAFTSMAN STATION</span>
                </div>
                <h1 class="text-3xl sm:text-4xl font-serif font-black tracking-tight text-white">
                    Welcome back, <span class="text-amber-400">@Model.BarberName</span>
                </h1>
                <p class="text-xs sm:text-sm text-slate-300 font-light flex items-center gap-2">
                    <span>@Model.BarberSpecialty</span>
                    <span class="text-slate-600">&bull;</span>
                    <span class="text-amber-300 font-medium">@Model.TodayFormattedDate</span>
                </p>
            </div>

            <div class="flex items-center gap-3">
                <a href="/barber/schedule" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 active:scale-[0.98] transition-all duration-150 shadow-md flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-amber-500">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                    <span>View Today's Schedule</span>
                </a>
                <a href="/barber/appointments" class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-200 hover:text-white hover:bg-slate-700 active:scale-[0.98] border border-slate-700 transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-slate-500">
                    Manage Bookings
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <article class="card bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm flex items-center justify-between hover:-translate-y-0.5 transition-transform duration-150">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Today's Bookings</p>
                <p class="text-3xl font-serif font-black text-slate-900 dark:text-white mt-1">@Model.TodayAppointmentsCount</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Scheduled for today</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-400 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </article>

        <article class="card bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm flex items-center justify-between hover:-translate-y-0.5 transition-transform duration-150">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Pending Actions</p>
                <p class="text-3xl font-serif font-black @(Model.PendingAppointmentsCount > 0 ? "text-amber-600 dark:text-amber-400" : "text-slate-900 dark:text-white") mt-1">@Model.PendingAppointmentsCount</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Awaiting confirmation</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-amber-100 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
            </div>
        </article>

        <article class="card bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm flex items-center justify-between hover:-translate-y-0.5 transition-transform duration-150">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Completed Today</p>
                <p class="text-3xl font-serif font-black text-emerald-600 dark:text-emerald-400 mt-1">@Model.CompletedAppointmentsCount</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">Finished services</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </article>

        <article class="card bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-200/90 dark:border-slate-800 shadow-sm flex items-center justify-between hover:-translate-y-0.5 transition-transform duration-150">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Today's Sales</p>
                <p class="text-2xl font-serif font-black text-slate-900 dark:text-white mt-1">@Model.FormattedTodayEarnings</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">From completed cuts today</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </article>
    </div>

    <!-- Next Up Card (if any upcoming appointment) -->
    @if (Model.NextAppointment != null)
    {
        <div class="bg-amber-500/10 dark:bg-amber-950/30 border border-amber-500/30 dark:border-amber-800/60 rounded-3xl p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-amber-500 text-slate-950 flex items-center justify-center font-bold shrink-0 shadow-md">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                    <span class="text-[11px] uppercase tracking-wider font-extrabold text-amber-900 dark:text-amber-300 bg-amber-200/70 dark:bg-amber-900/60 px-2 py-0.5 rounded-md border border-amber-300 dark:border-amber-700">UP NEXT TODAY</span>
                    <h3 class="text-lg font-serif font-bold text-slate-900 dark:text-white mt-1">
                        @Model.NextAppointment.ServiceName with @Model.NextAppointment.CustomerName
                    </h3>
                    <p class="text-xs text-slate-600 dark:text-slate-300 mt-0.5">
                        Time: <span class="font-bold text-slate-800 dark:text-slate-100">@Model.NextAppointment.ScheduledTime12h</span> &bull; Ref: <code class="text-amber-800 dark:text-amber-400 font-mono font-bold">@Model.NextAppointment.ReferenceCode</code> &bull; Fee: <span class="font-extrabold text-slate-900 dark:text-white">@Model.NextAppointment.FormattedPrice</span>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <a href="/barber/appointments" class="px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 active:scale-[0.98] transition-all duration-150 shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
                    Open Action Panel &rarr;
                </a>
            </div>
        </div>
    }

    <!-- Today's Appointment Schedule Table -->
    <article class="card bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden">
        <header class="p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-serif font-bold text-slate-900 dark:text-white">Today's Appointment Schedule</h2>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Real-time schedule for @Model.TodayFormattedDate</p>
            </div>
            <a href="/barber/schedule" class="text-xs font-bold text-amber-800 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 transition flex items-center gap-1">
                <span>View Full Day/Week Grid</span>
                <span>&rarr;</span>
            </a>
        </header>

        @if (!Model.TodayAppointments.Any())
        {
            <div class="py-12 text-center text-slate-400 dark:text-slate-500">
                <svg class="w-12 h-12 mx-auto text-slate-300 dark:text-slate-600 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                <p class="text-sm font-semibold text-slate-600 dark:text-slate-300">No appointments scheduled for today.</p>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Enjoy your prep time or check upcoming bookings.</p>
            </div>
        }
        else
        {
            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-100 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider">
                        <tr>
                            <th class="py-3.5 px-6">Time</th>
                            <th class="py-3.5 px-6">Reference</th>
                            <th class="py-3.5 px-6">Customer</th>
                            <th class="py-3.5 px-6">Service</th>
                            <th class="py-3.5 px-6">Price</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6 text-right">Quick Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-700 dark:text-slate-300">
                        @foreach (var app in Model.TodayAppointments)
                        {
                            var badgeClass = app.Status switch
                            {
                                BarberBook.Data.Enums.AppointmentStatus.Pending => "bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border-amber-300 dark:border-amber-800",
                                BarberBook.Data.Enums.AppointmentStatus.Confirmed => "bg-blue-100 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 border-blue-300 dark:border-blue-800",
                                BarberBook.Data.Enums.AppointmentStatus.Completed => "bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800",
                                BarberBook.Data.Enums.AppointmentStatus.Cancelled => "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border-slate-300 dark:border-slate-700",
                                BarberBook.Data.Enums.AppointmentStatus.Rejected => "bg-rose-100 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border-rose-300 dark:border-rose-800",
                                _ => "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"
                            };

                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition">
                                <td class="py-4 px-6 font-bold text-slate-900 dark:text-white whitespace-nowrap">
                                    @app.ScheduledTime12h
                                </td>
                                <td class="py-4 px-6 font-mono text-xs font-semibold text-amber-800 dark:text-amber-300">
                                    @app.ReferenceCode
                                </td>
                                <td class="py-4 px-6 text-slate-900 dark:text-white font-bold">
                                    <div>@app.CustomerName</div>
                                    <div class="text-[11px] font-normal text-slate-400 dark:text-slate-500">@app.CustomerPhone</div>
                                </td>
                                <td class="py-4 px-6 font-semibold text-slate-800 dark:text-slate-200">
                                    @app.ServiceName
                                </td>
                                <td class="py-4 px-6 font-bold text-slate-900 dark:text-white">
                                    @app.FormattedPrice
                                </td>
                                <td class="py-4 px-6">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold border @badgeClass capitalize">
                                        @app.StatusString
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right whitespace-nowrap">
                                    @if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Pending)
                                    {
                                        <div class="flex items-center justify-end gap-1.5">
                                            <form method="post" action="/barber/appointments/@app.Id/status" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="to" value="confirmed" />
                                                <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white hover:bg-blue-500 active:scale-95 transition shadow-xs">
                                                    Confirm
                                                </button>
                                            </form>
                                            <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'rejected')" class="px-2.5 py-1.5 rounded-lg text-xs font-bold bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200 dark:border-rose-800 active:scale-95 transition">
                                                Reject
                                            </button>
                                            <a href="/barber/appointments/@app.Id" class="p-1.5 text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition" title="View Details">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                                            </a>
                                        </div>
                                    }
                                    else if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Confirmed)
                                    {
                                        <div class="flex items-center justify-end gap-1.5">
                                            <form method="post" action="/barber/appointments/@app.Id/status" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="to" value="completed" />
                                                <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-500 active:scale-95 transition shadow-xs">
                                                    Complete
                                                </button>
                                            </form>
                                            <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'cancelled')" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 active:scale-95 transition">
                                                Cancel
                                            </button>
                                            <a href="/barber/appointments/@app.Id" class="p-1.5 text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 transition" title="View Details">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <a href="/barber/appointments/@app.Id" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                                            Details &rarr;
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="md:hidden divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var app in Model.TodayAppointments)
                {
                    var badgeClass = app.Status switch
                    {
                        BarberBook.Data.Enums.AppointmentStatus.Pending => "bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border-amber-300 dark:border-amber-800",
                        BarberBook.Data.Enums.AppointmentStatus.Confirmed => "bg-blue-100 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 border-blue-300 dark:border-blue-800",
                        BarberBook.Data.Enums.AppointmentStatus.Completed => "bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800",
                        BarberBook.Data.Enums.AppointmentStatus.Cancelled => "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border-slate-300 dark:border-slate-700",
                        BarberBook.Data.Enums.AppointmentStatus.Rejected => "bg-rose-100 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border-rose-300 dark:border-rose-800",
                        _ => "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"
                    };

                    <div class="p-4 space-y-2.5 hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                        <div class="flex items-center justify-between">
                            <span class="font-mono text-xs font-bold text-amber-800 dark:text-amber-300">@app.ReferenceCode</span>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border @badgeClass capitalize">
                                @app.StatusString
                            </span>
                        </div>

                        <div>
                            <div class="font-bold text-slate-900 dark:text-white text-sm">@app.CustomerName</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400">@app.ServiceName</div>
                        </div>

                        <div class="flex items-center justify-between text-xs pt-1 border-t border-slate-100 dark:border-slate-800">
                            <div>
                                <span class="text-slate-500 dark:text-slate-400">Time:</span>
                                <span class="font-bold text-slate-800 dark:text-slate-200 ml-1">@app.ScheduledTime12h</span>
                            </div>
                            <div class="font-bold text-amber-800 dark:text-amber-400">@app.FormattedPrice</div>
                        </div>

                        <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                            @if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Pending)
                            {
                                <div class="grid grid-cols-3 gap-2">
                                    <form method="post" action="/barber/appointments/@app.Id/status" class="w-full">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="to" value="confirmed" />
                                        <button type="submit" class="w-full py-2 px-2 rounded-lg text-xs font-bold bg-blue-600 text-white hover:bg-blue-500 active:scale-95 transition shadow-xs text-center">
                                            Confirm
                                        </button>
                                    </form>
                                    <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'rejected')" class="w-full py-2 px-2 rounded-lg text-xs font-bold bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200 dark:border-rose-800 active:scale-95 transition text-center">
                                        Reject
                                    </button>
                                    <a href="/barber/appointments/@app.Id" class="w-full py-2 px-2 rounded-lg text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 active:scale-95 transition text-center">
                                        Details
                                    </a>
                                </div>
                            }
                            else if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Confirmed)
                            {
                                <div class="grid grid-cols-3 gap-2">
                                    <form method="post" action="/barber/appointments/@app.Id/status" class="w-full col-span-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="to" value="completed" />
                                        <button type="submit" class="w-full py-2 px-3 rounded-lg text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-500 active:scale-95 transition shadow-xs text-center">
                                            Complete Cut
                                        </button>
                                    </form>
                                    <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'cancelled')" class="w-full py-2 px-2 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 active:scale-95 transition text-center">
                                        Cancel
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center justify-between text-xs text-slate-400 dark:text-slate-500 italic">
                                    <span>Finished record</span>
                                    <a href="/barber/appointments/@app.Id" class="text-amber-800 dark:text-amber-400 hover:underline font-semibold not-italic">View Details &rarr;</a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </article>

    <!-- Quick Navigation Hub -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <a href="/barber/schedule" class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm hover:border-amber-500/60 dark:hover:border-amber-500/60 hover:-translate-y-0.5 hover:shadow-md transition-all duration-150 group">
            <div class="w-10 h-10 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-400 flex items-center justify-center font-bold mb-4 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
            </div>
            <h3 class="font-serif font-bold text-slate-900 dark:text-white text-lg group-hover:text-amber-800 dark:group-hover:text-amber-300 transition">My Schedule Grid</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Day and week calendar views for seamless slot visibility.</p>
        </a>

        <a href="/barber/availability" class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm hover:border-amber-500/60 dark:hover:border-amber-500/60 hover:-translate-y-0.5 hover:shadow-md transition-all duration-150 group">
            <div class="w-10 h-10 rounded-2xl bg-blue-500/10 border border-blue-500/20 text-blue-700 dark:text-blue-400 flex items-center justify-center font-bold mb-4 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="font-serif font-bold text-slate-900 dark:text-white text-lg group-hover:text-amber-800 dark:group-hover:text-amber-300 transition">Availability & Days Off</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Configure weekly service hours and schedule upcoming days off.</p>
