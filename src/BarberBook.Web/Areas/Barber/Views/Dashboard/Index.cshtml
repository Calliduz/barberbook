</div>

<style>
    dialog:modal {
        overscroll-behavior: contain;
    }
    dialog::backdrop {
        overflow: hidden;
        overscroll-behavior: contain;
    }
</style>

<!-- Modal for Reason / Note (Reject / Cancel) -->
<dialog id="actionModal" closedby="any" class="hidden m-auto rounded-3xl p-0 bg-transparent backdrop:bg-slate-950/70 backdrop:backdrop-blur-xs max-w-md w-[calc(100%-2rem)] shadow-2xl focus:outline-none">
    <div class="bg-white dark:bg-slate-900 rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-slate-200 dark:border-slate-800 space-y-4">
        <h3 id="modalTitle" class="text-xl font-serif font-black text-slate-900 dark:text-white">Update Status</h3>
        <p id="modalDescription" class="text-xs text-slate-600 dark:text-slate-400 mt-1">Please provide an optional reason or note for this status change.</p>

        <form id="actionForm" method="post" action="" class="mt-4 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalTargetStatus" name="to" value="" />

            <div>
                <label for="modal-note-input" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Reason / Note <span class="text-slate-400 font-normal lowercase">(optional)</span></label>
                <textarea id="modal-note-input" name="note" rows="3" placeholder="e.g. Scheduling conflict, station maintenance, or client request..."
                          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-xs text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeActionModal()" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 active:scale-95 transition">
                    Dismiss
                </button>
                <button type="submit" id="modalSubmitBtn" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 active:scale-95 transition shadow-sm">
                    Confirm
                </button>
            </div>
        </form>
    </div>
</dialog>

<script>
    function openActionModal(id, refCode, targetStatus) {
        const form = document.getElementById('actionForm');
        form.action = '/barber/appointments/' + id + '/status';
        document.getElementById('modalTargetStatus').value = targetStatus;

        const title = targetStatus === 'rejected' ? 'Reject Appointment #' + refCode : 'Cancel Appointment #' + refCode;
        const desc = targetStatus === 'rejected'
            ? 'State why this appointment cannot be accepted (e.g. station maintenance, off-duty).'
            : 'Provide an operational reason for cancelling this booking.';
        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalDescription').innerText = desc;

        const btn = document.getElementById('modalSubmitBtn');
        if (targetStatus === 'rejected') {
            btn.className = 'px-5 py-2.5 rounded-xl text-xs font-bold bg-rose-600 text-white hover:bg-rose-500 active:scale-95 transition shadow-sm';
            btn.innerText = 'Reject Booking';
        } else {
            btn.className = 'px-5 py-2.5 rounded-xl text-xs font-bold bg-slate-900 dark:bg-slate-800 text-white hover:bg-slate-800 dark:hover:bg-slate-700 active:scale-95 transition shadow-sm border border-slate-700';
            btn.innerText = 'Cancel Booking';
        }

        const modal = document.getElementById('actionModal');
        modal.classList.remove('hidden');
        if (typeof modal.showModal === 'function') {
            try { modal.showModal(); } catch (_) {}
        }
    }

    function closeActionModal() {
        const modal = document.getElementById('actionModal');
        if (typeof modal.close === 'function') {
            try { modal.close(); } catch (_) {}
        }
        modal.classList.add('hidden');
    }

    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('actionModal');
        if (!modal) return;
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeActionModal();
            }
        });
    });
</script>
