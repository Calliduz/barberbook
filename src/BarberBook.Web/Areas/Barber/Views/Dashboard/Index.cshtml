@model BarberBook.Web.Models.Barber.BarberDashboardViewModel
@{
    ViewData["Title"] = "Barber Dashboard";
}

<div class="space-y-8">
    <!-- Header Hero Banner -->
    <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-xl text-white relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 opacity-5 pointer-events-none">
            <div class="barber-pole-icon" style="height: 220px; width: 110px;"></div>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 relative z-10">
            <div class="space-y-1.5">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold">
                    <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                    <span>MASTER CRAFTSMAN STATION</span>
                </div>
                <h1 class="text-3xl sm:text-4xl font-serif font-black tracking-tight text-white">
                    Welcome back, <span class="text-amber-400">@Model.BarberName</span>
                </h1>
                <p class="text-xs sm:text-sm text-slate-300 font-light flex items-center gap-2">
                    <span>@Model.BarberSpecialty</span>
                    <span class="text-slate-600">&bull;</span>
                    <span class="text-amber-300 font-medium">@Model.TodayFormattedDate</span>
                </p>
            </div>

            <div class="flex items-center gap-3">
                <a href="/barber/schedule" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-md flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.253 3.75m-18 0h24m-24 0v11.25A2.25 2.25 0 004.5 21h15a2.25 2.25 0 002.25-2.25V7.5" /></svg>
                    <span>View Today's Schedule</span>
                </a>
                <a href="/barber/appointments" class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-200 hover:text-white hover:bg-slate-700 border border-slate-700 transition">
                    Manage Bookings
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Today's Bookings</p>
                <p class="text-3xl font-serif font-black text-slate-900 mt-1">@Model.TodayAppointmentsCount</p>
                <p class="text-[11px] text-slate-500 mt-1">Scheduled for today</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-600 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Pending Actions</p>
                <p class="text-3xl font-serif font-black @(Model.PendingAppointmentsCount > 0 ? "text-amber-600" : "text-slate-900") mt-1">@Model.PendingAppointmentsCount</p>
                <p class="text-[11px] text-slate-500 mt-1">Awaiting confirmation</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Completed Today</p>
                <p class="text-3xl font-serif font-black text-emerald-600 mt-1">@Model.CompletedAppointmentsCount</p>
                <p class="text-[11px] text-slate-500 mt-1">Finished services</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Today's Sales</p>
                <p class="text-2xl font-serif font-black text-slate-900 mt-1">@Model.FormattedTodayEarnings</p>
                <p class="text-[11px] text-slate-500 mt-1">From completed cuts today</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </div>
    </div>

    <!-- Next Up Card (if any upcoming appointment) -->
    @if (Model.NextAppointment != null)
    {
        <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-bold shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                    <span class="text-[11px] uppercase tracking-wider font-extrabold text-amber-800 bg-amber-200/70 px-2 py-0.5 rounded">UP NEXT TODAY</span>
                    <h3 class="text-lg font-bold text-slate-900 mt-1">
                        @Model.NextAppointment.ServiceName with @Model.NextAppointment.CustomerName
                    </h3>
                    <p class="text-xs text-slate-600 mt-0.5">
                        Time: <span class="font-semibold text-slate-800">@Model.NextAppointment.ScheduledTime12h</span> &bull; Ref: <code class="text-amber-800 font-mono font-bold">@Model.NextAppointment.ReferenceCode</code> &bull; Fee: <span class="font-bold text-slate-900">@Model.NextAppointment.FormattedPrice</span>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <a href="/barber/appointments" class="px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm">
                    Open Action Panel
                </a>
            </div>
        </div>
    }

    <!-- Today's Appointment Schedule Table -->
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-serif font-bold text-slate-900">Today's Appointment Schedule</h2>
                <p class="text-xs text-slate-500 mt-0.5">Real-time schedule for @Model.TodayFormattedDate</p>
            </div>
            <a href="/barber/schedule" class="text-xs font-bold text-amber-700 hover:text-amber-800 transition flex items-center gap-1">
                <span>View Full Day/Week Grid</span>
                <span>&rarr;</span>
            </a>
        </div>

        @if (!Model.TodayAppointments.Any())
        {
            <div class="py-12 text-center text-slate-400">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.253 3.75m-18 0h24m-24 0v11.25A2.25 2.25 0 004.5 21h15a2.25 2.25 0 002.25-2.25V7.5" /></svg>
                <p class="text-sm font-semibold text-slate-600">No appointments scheduled for today.</p>
                <p class="text-xs text-slate-400 mt-1">Enjoy your prep time or check upcoming bookings.</p>
            </div>
        }
        else
        {
            <!-- Desktop Table View -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 border-b border-slate-100 text-slate-500 font-bold uppercase tracking-wider">
                        <tr>
                            <th class="py-3.5 px-6">Time</th>
                            <th class="py-3.5 px-6">Reference</th>
                            <th class="py-3.5 px-6">Customer</th>
                            <th class="py-3.5 px-6">Service</th>
                            <th class="py-3.5 px-6">Price</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6 text-right">Quick Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                        @foreach (var app in Model.TodayAppointments)
                        {
                            var badgeClass = app.Status switch
                            {
                                BarberBook.Data.Enums.AppointmentStatus.Pending => "bg-amber-100 text-amber-800 border-amber-300",
                                BarberBook.Data.Enums.AppointmentStatus.Confirmed => "bg-blue-100 text-blue-800 border-blue-300",
                                BarberBook.Data.Enums.AppointmentStatus.Completed => "bg-emerald-100 text-emerald-800 border-emerald-300",
                                BarberBook.Data.Enums.AppointmentStatus.Cancelled => "bg-slate-100 text-slate-600 border-slate-300",
                                BarberBook.Data.Enums.AppointmentStatus.Rejected => "bg-red-100 text-red-800 border-red-300",
                                _ => "bg-slate-100 text-slate-700"
                            };

                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="py-4 px-6 font-bold text-slate-900 whitespace-nowrap">
                                    @app.ScheduledTime12h
                                </td>
                                <td class="py-4 px-6 font-mono text-xs font-semibold text-amber-800">
                                    @app.ReferenceCode
                                </td>
                                <td class="py-4 px-6 text-slate-900 font-bold">
                                    <div>@app.CustomerName</div>
                                    <div class="text-[11px] font-normal text-slate-400">@app.CustomerPhone</div>
                                </td>
                                <td class="py-4 px-6 font-semibold text-slate-800">
                                    @app.ServiceName
                                </td>
                                <td class="py-4 px-6 font-bold text-slate-900">
                                    @app.FormattedPrice
                                </td>
                                <td class="py-4 px-6">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold border @badgeClass capitalize">
                                        @app.StatusString
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right whitespace-nowrap">
                                    @if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Pending)
                                    {
                                        <div class="flex items-center justify-end gap-1.5">
                                            <form method="post" action="/barber/appointments/@app.Id/status" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="to" value="confirmed" />
                                                <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white hover:bg-blue-500 transition shadow-xs">
                                                    Confirm
                                                </button>
                                            </form>
                                            <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'rejected')" class="px-2.5 py-1.5 rounded-lg text-xs font-bold bg-red-50 text-red-700 hover:bg-red-100 border border-red-200 transition">
                                                Reject
                                            </button>
                                            <a href="/barber/appointments/@app.Id" class="p-1.5 text-slate-400 hover:text-slate-800 transition" title="View Details">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                                            </a>
                                        </div>
                                    }
                                    else if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Confirmed)
                                    {
                                        <div class="flex items-center justify-end gap-1.5">
                                            <form method="post" action="/barber/appointments/@app.Id/status" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="to" value="completed" />
                                                <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-500 transition shadow-xs">
                                                    Complete
                                                </button>
                                            </form>
                                            <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'cancelled')" class="px-2.5 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:bg-slate-100 border border-slate-200 transition">
                                                Cancel
                                            </button>
                                            <a href="/barber/appointments/@app.Id" class="p-1.5 text-slate-400 hover:text-slate-800 transition" title="View Details">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <a href="/barber/appointments/@app.Id" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition">
                                            Details &rarr;
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="md:hidden divide-y divide-slate-100">
                @foreach (var app in Model.TodayAppointments)
                {
                    var badgeClass = app.Status switch
                    {
                        BarberBook.Data.Enums.AppointmentStatus.Pending => "bg-amber-100 text-amber-800 border-amber-300",
                        BarberBook.Data.Enums.AppointmentStatus.Confirmed => "bg-blue-100 text-blue-800 border-blue-300",
                        BarberBook.Data.Enums.AppointmentStatus.Completed => "bg-emerald-100 text-emerald-800 border-emerald-300",
                        BarberBook.Data.Enums.AppointmentStatus.Cancelled => "bg-slate-100 text-slate-600 border-slate-300",
                        BarberBook.Data.Enums.AppointmentStatus.Rejected => "bg-red-100 text-red-800 border-red-300",
                        _ => "bg-slate-100 text-slate-700"
                    };

                    <div class="p-4 space-y-2.5 hover:bg-slate-50/50 transition">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <span class="font-mono text-xs font-bold text-amber-800">@app.ReferenceCode</span>
                                <div class="font-bold text-slate-900 text-sm mt-0.5">@app.CustomerName</div>
                                <div class="text-[11px] text-slate-500">@app.CustomerPhone</div>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold border @badgeClass capitalize shrink-0">
                                @app.StatusString
                            </span>
                        </div>

                        <div class="flex items-center justify-between text-xs pt-1 border-t border-slate-100">
                            <div>
                                <span class="text-slate-500">Time:</span>
                                <span class="font-bold text-slate-800 ml-1">@app.ScheduledTime12h</span>
                            </div>
                            <div class="font-bold text-amber-800">@app.FormattedPrice</div>
                        </div>

                        <div class="pt-2 border-t border-slate-100">
                            @if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Pending)
                            {
                                <div class="grid grid-cols-3 gap-2">
                                    <form method="post" action="/barber/appointments/@app.Id/status" class="w-full">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="to" value="confirmed" />
                                        <button type="submit" class="w-full py-2 px-2 rounded-lg text-xs font-bold bg-blue-600 text-white hover:bg-blue-500 transition shadow-xs text-center">
                                            Confirm
                                        </button>
                                    </form>
                                    <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'rejected')" class="w-full py-2 px-2 rounded-lg text-xs font-bold bg-red-50 text-red-700 hover:bg-red-100 border border-red-200 transition text-center">
                                        Reject
                                    </button>
                                    <a href="/barber/appointments/@app.Id" class="w-full py-2 px-2 rounded-lg text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition text-center">
                                        Details
                                    </a>
                                </div>
                            }
                            else if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Confirmed)
                            {
                                <div class="grid grid-cols-3 gap-2">
                                    <form method="post" action="/barber/appointments/@app.Id/status" class="w-full col-span-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="to" value="completed" />
                                        <button type="submit" class="w-full py-2 px-3 rounded-lg text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-500 transition shadow-xs text-center">
                                            Complete Cut
                                        </button>
                                    </form>
                                    <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'cancelled')" class="w-full py-2 px-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100 border border-slate-200 transition text-center">
                                        Cancel
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center justify-between text-xs text-slate-400 italic">
                                    <span>Finished record</span>
                                    <a href="/barber/appointments/@app.Id" class="text-amber-800 hover:underline font-semibold not-italic">View Details &rarr;</a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Quick Navigation Hub -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <a href="/barber/schedule" class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:border-amber-500/60 hover:shadow-md transition group">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold mb-4 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.253 3.75m-18 0h24m-24 0v11.25A2.25 2.25 0 004.5 21h15a2.25 2.25 0 002.25-2.25V7.5" /></svg>
            </div>
            <h3 class="font-serif font-bold text-slate-900 text-lg group-hover:text-amber-800 transition">My Schedule Grid</h3>
            <p class="text-xs text-slate-500 mt-1">Day and week calendar views for seamless slot visibility.</p>
        </a>

        <a href="/barber/availability" class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:border-amber-500/60 hover:shadow-md transition group">
            <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center font-bold mb-4 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="font-serif font-bold text-slate-900 text-lg group-hover:text-amber-800 transition">Availability & Days Off</h3>
            <p class="text-xs text-slate-500 mt-1">Configure weekly service hours and schedule upcoming days off.</p>
        </a>

        <a href="/barber/equipment" class="p-6 rounded-2xl bg-white border border-slate-200/90 shadow-sm hover:border-amber-500/60 hover:shadow-md transition group">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center font-bold mb-4 group-hover:scale-110 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.07a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.118.58.094 1.193-.07 1.743" /></svg>
            </div>
            <h3 class="font-serif font-bold text-slate-900 text-lg group-hover:text-amber-800 transition">Assigned Equipment</h3>
            <p class="text-xs text-slate-500 mt-1">Monitor clippers, shears, and razor condition and log checks.</p>
        </a>
    </div>
</div>

<!-- Modal for Reason / Note (Reject / Cancel) -->
<div id="actionModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-200 relative animate-in fade-in zoom-in-95">
        <h3 id="modalTitle" class="text-xl font-serif font-bold text-slate-900">Update Status</h3>
        <p id="modalDescription" class="text-xs text-slate-600 mt-1">Please provide an optional reason or note for this status change.</p>

        <form id="actionForm" method="post" action="" class="mt-4 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalTargetStatus" name="to" value="" />

            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Reason / Note (optional)</label>
                <textarea name="note" rows="3" placeholder="e.g. Scheduling conflict or client request..."
                          class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                <button type="button" onclick="closeActionModal()" class="px-4 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">
                    Dismiss
                </button>
                <button type="submit" id="modalSubmitBtn" class="px-4 py-2 rounded-lg text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm">
                    Confirm
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openActionModal(id, refCode, targetStatus) {
        const form = document.getElementById('actionForm');
        form.action = '/barber/appointments/' + id + '/status';
        document.getElementById('modalTargetStatus').value = targetStatus;

        const title = targetStatus === 'rejected' ? 'Reject Appointment #' + refCode : 'Cancel Appointment #' + refCode;
        const desc = targetStatus === 'rejected'
            ? 'State why this appointment cannot be accepted (e.g. station maintenance, off-duty).'
            : 'Provide an operational reason for cancelling this booking.';
        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalDescription').innerText = desc;

        const btn = document.getElementById('modalSubmitBtn');
        if (targetStatus === 'rejected') {
            btn.className = 'px-4 py-2 rounded-lg text-xs font-bold bg-rose-600 text-white hover:bg-rose-500 transition shadow-sm';
            btn.innerText = 'Reject Booking';
        } else {
            btn.className = 'px-4 py-2 rounded-lg text-xs font-bold bg-slate-800 text-white hover:bg-slate-700 transition shadow-sm';
            btn.innerText = 'Cancel Booking';
        }

        document.getElementById('actionModal').classList.remove('hidden');
    }

    function closeActionModal() {
        document.getElementById('actionModal').classList.add('hidden');
    }
</script>
