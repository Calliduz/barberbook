@model BarberBook.Web.Models.Barber.BarberTransactionsViewModel
@{
    ViewData["Title"] = "My Transactions";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-2">
                <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                <span>FINANCIAL SNAPSHOT (RP-4, BF-5)</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 tracking-tight">My Transactions</h1>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">
                Barber: <span class="font-bold text-slate-800">@Model.BarberName</span> &bull; Scoped strictly to your own completed appointments (T-13, BR-07).
            </p>
        </div>

        <!-- Filter Form -->
        <form method="get" action="/barber/transactions" class="flex flex-wrap items-center gap-2">
            <div class="flex items-center gap-1.5 text-xs text-slate-600">
                <span>From</span>
                <input type="date" name="startDate" value="@Model.StartDate"
                       class="px-3 py-1.5 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20" />
            </div>
            <div class="flex items-center gap-1.5 text-xs text-slate-600">
                <span>To</span>
                <input type="date" name="endDate" value="@Model.EndDate"
                       class="px-3 py-1.5 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500/20" />
            </div>
            <button type="submit" class="px-4 py-1.5 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 transition shadow-sm">
                Filter
            </button>
            @if (!string.IsNullOrEmpty(Model.StartDate) || !string.IsNullOrEmpty(Model.EndDate))
            {
                <a href="/barber/transactions" class="px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-500 hover:text-slate-800 border border-slate-200 transition">
                    Reset
                </a>
            }
        </form>
    </div>

    <!-- Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Completed Services</p>
                <p class="text-3xl font-serif font-black text-slate-900 mt-1">@Model.TotalCompletedCount</p>
                <p class="text-[11px] text-slate-500 mt-1">Total finished client cuts</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Service Sales</p>
                <p class="text-3xl font-serif font-black text-slate-900 mt-1">@Model.FormattedTotalRevenue</p>
                <p class="text-[11px] text-slate-500 mt-1">Gross client billings (BR-07)</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-emerald-200 shadow-sm flex items-center justify-between bg-gradient-to-br from-white to-emerald-50/30">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-emerald-800">My Commission (50%)</p>
                <p class="text-3xl font-serif font-black text-emerald-700 mt-1">@Model.FormattedTotalCommission</p>
                <p class="text-[11px] text-emerald-600 mt-1">Your take-home earnings</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" /></svg>
            </div>
        </div>

        <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-sm flex items-center justify-between">
            <div>
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Shop Share (50%)</p>
                <p class="text-3xl font-serif font-black text-slate-700 mt-1">@Model.FormattedShopShare</p>
                <p class="text-[11px] text-slate-500 mt-1">Average ticket: @Model.FormattedAverageTicket</p>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-600 flex items-center justify-center font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>
            </div>
        </div>
    </div>

    <!-- Completed Transactions Table -->
    <div class="bg-white rounded-3xl border border-slate-200/90 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-serif font-bold text-slate-900">Completed Service Records</h2>
                <p class="text-xs text-slate-500 mt-0.5">Historical ledger of all services performed and settled in-shop (LM-1, LM-2).</p>
            </div>
        </div>

        @if (!Model.Transactions.Any())
        {
            <div class="py-16 text-center text-slate-400">
                <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <p class="text-base font-semibold text-slate-700">No completed transactions found for the selected period.</p>
                <p class="text-xs text-slate-400 mt-1">Pending and in-progress appointments will appear here once marked completed.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 border-b border-slate-100 text-slate-500 font-bold uppercase tracking-wider">
                        <tr>
                            <th class="py-3.5 px-6">Reference Code</th>
                            <th class="py-3.5 px-6">Completed Date & Time</th>
                            <th class="py-3.5 px-6">Customer Name</th>
                            <th class="py-3.5 px-6">Service Rendered</th>
                            <th class="py-3.5 px-6 text-right">Settled Amount</th>
                            <th class="py-3.5 px-6 text-right text-emerald-800">My Commission (50%)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                        @foreach (var tr in Model.Transactions)
                        {
                            <tr class="hover:bg-slate-50/70 transition">
                                <td class="py-4 px-6 font-mono font-bold text-amber-800 text-xs">
                                    @tr.ReferenceCode
                                </td>
                                <td class="py-4 px-6">
                                    <div class="font-bold text-slate-900">@tr.DateFormatted</div>
                                    <div class="text-[11px] text-slate-400">@tr.TimeFormatted</div>
                                </td>
                                <td class="py-4 px-6 font-bold text-slate-900">
                                    @tr.CustomerName
                                </td>
                                <td class="py-4 px-6 font-semibold text-slate-800">
                                    @tr.ServiceName
                                </td>
                                <td class="py-4 px-6 font-bold text-slate-900 text-right text-sm">
                                    @tr.FormattedPrice
                                </td>
                                <td class="py-4 px-6 font-bold text-emerald-700 text-right text-sm">
                                    @tr.FormattedCommissionAmount
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-slate-50 border-t border-slate-200 font-bold text-slate-900 divide-y divide-slate-200">
                        <tr>
                            <td colspan="4" class="py-3 px-6 text-right uppercase tracking-wider text-xs text-slate-500">
                                Gross Service Sales:
                            </td>
                            <td class="py-3 px-6 text-right text-sm text-slate-900 font-black">
                                @Model.FormattedTotalRevenue
                            </td>
                            <td class="py-3 px-6 text-right text-sm text-emerald-700 font-black">
                                @Model.FormattedTotalCommission
                            </td>
                        </tr>
                        <tr class="bg-amber-50/40">
                            <td colspan="5" class="py-3.5 px-6 text-right uppercase tracking-wider text-xs text-slate-700 font-bold">
                                Total Barber Commission (50% Take-Home Pay):
                            </td>
                            <td class="py-3.5 px-6 text-right text-base text-emerald-700 font-black">
                                @Model.FormattedTotalCommission
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

