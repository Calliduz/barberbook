@model BarberBook.Web.Models.Barber.BarberAppointmentsViewModel
@{
    ViewData["Title"] = "Barber Appointments";
}

<div class="space-y-6">
    <!-- Header -->
    <article class="card bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200/90 dark:border-slate-800 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-2 shadow-inner">
                <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                <span>STATUS WORKFLOW & TRANSITIONS</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 dark:text-white tracking-tight">Barber Appointments</h1>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                Barber: <span class="font-bold text-slate-800 dark:text-slate-100">@Model.BarberName</span> &bull; Manage your clients and update appointment statuses.
            </p>
        </div>

        <!-- Quick Status Pills -->
        <div class="flex flex-wrap items-center gap-2">
            <a href="/barber/appointments" class="px-3.5 py-1.5 rounded-xl text-xs font-bold border active:scale-95 transition-all duration-150 @(string.IsNullOrEmpty(Model.StatusFilter) ? "bg-slate-900 dark:bg-amber-500 text-white dark:text-slate-950 border-slate-900 dark:border-amber-500 shadow-sm" : "bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700")">
                All (@Model.TotalCount)
            </a>
            <a href="/barber/appointments?status=pending" class="px-3.5 py-1.5 rounded-xl text-xs font-bold border active:scale-95 transition-all duration-150 @(Model.StatusFilter == "pending" ? "bg-amber-500 text-slate-950 border-amber-500 shadow-sm" : "bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-300 border-amber-200 dark:border-amber-800 hover:bg-amber-100 dark:hover:bg-amber-900/60")">
                Pending (@Model.PendingCount)
            </a>
            <a href="/barber/appointments?status=confirmed" class="px-3.5 py-1.5 rounded-xl text-xs font-bold border active:scale-95 transition-all duration-150 @(Model.StatusFilter == "confirmed" ? "bg-blue-600 text-white border-blue-600 shadow-sm" : "bg-blue-50 dark:bg-blue-950/40 text-blue-900 dark:text-blue-300 border-blue-200 dark:border-blue-800 hover:bg-blue-100 dark:hover:bg-blue-900/60")">
                Confirmed (@Model.ConfirmedCount)
            </a>
            <a href="/barber/appointments?status=completed" class="px-3.5 py-1.5 rounded-xl text-xs font-bold border active:scale-95 transition-all duration-150 @(Model.StatusFilter == "completed" ? "bg-emerald-600 text-white border-emerald-600 shadow-sm" : "bg-emerald-50 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900/60")">
                Completed (@Model.CompletedCount)
            </a>
        </div>
    </article>

    <!-- Filter & Search Bar -->
    <article class="card bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-200/90 dark:border-slate-800 shadow-sm">
        <form method="get" action="/barber/appointments" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
            <div class="sm:col-span-2">
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Search by customer name, ref code (BB-...), or service..."
                       class="w-full px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 text-xs text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 shadow-xs" />
            </div>
            <div>
                <select name="status" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 text-xs text-slate-700 dark:text-slate-300 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500 shadow-xs">
                    <option value="">All Statuses</option>
                    <option value="pending" selected="@(Model.StatusFilter == "pending")">Pending</option>
                    <option value="confirmed" selected="@(Model.StatusFilter == "confirmed")">Confirmed</option>
                    <option value="completed" selected="@(Model.StatusFilter == "completed")">Completed</option>
                    <option value="cancelled" selected="@(Model.StatusFilter == "cancelled")">Cancelled</option>
                    <option value="rejected" selected="@(Model.StatusFilter == "rejected")">Rejected</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="flex-1 py-2 px-4 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 active:scale-95 transition-all duration-150 shadow-sm">
                    Filter
                </button>
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || !string.IsNullOrEmpty(Model.StatusFilter))
                {
                    <a href="/barber/appointments" class="py-2 px-3 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 transition active:scale-95">
                        Reset
                    </a>
                }
            </div>
        </form>
    </article>

    <!-- Appointments Table -->
    <article class="card bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm overflow-hidden">
        @if (!Model.Appointments.Any())
        {
            <div class="py-16 text-center text-slate-400 dark:text-slate-500">
                <svg class="w-12 h-12 mx-auto text-slate-300 dark:text-slate-600 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                <p class="text-base font-semibold text-slate-700 dark:text-slate-300">No appointments found matching your criteria.</p>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Try resetting the status filter or search parameters.</p>
            </div>
        }
        else
        {
            <!-- Desktop Table View (hidden on mobile) -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-100 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wider">
                        <tr>
                            <th class="py-3.5 px-6">Reference / Date</th>
                            <th class="py-3.5 px-6">Customer</th>
                            <th class="py-3.5 px-6">Service</th>
                            <th class="py-3.5 px-6">Fee</th>
                            <th class="py-3.5 px-6">Status</th>
                            <th class="py-3.5 px-6 text-right">Workflow Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-700 dark:text-slate-300">
                        @foreach (var app in Model.Appointments)
                        {
                            var badgeClass = app.Status switch
                            {
                                BarberBook.Data.Enums.AppointmentStatus.Pending => "bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border-amber-300 dark:border-amber-800",
                                BarberBook.Data.Enums.AppointmentStatus.Confirmed => "bg-blue-100 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 border-blue-300 dark:border-blue-800",
                                BarberBook.Data.Enums.AppointmentStatus.Completed => "bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800",
                                BarberBook.Data.Enums.AppointmentStatus.Cancelled => "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border-slate-300 dark:border-slate-700",
                                BarberBook.Data.Enums.AppointmentStatus.Rejected => "bg-rose-100 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border-rose-300 dark:border-rose-800",
                                _ => "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"
                            };

                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition">
                                <td class="py-4 px-6 whitespace-nowrap">
                                    <div class="font-mono text-xs font-bold text-amber-800 dark:text-amber-300">@app.ReferenceCode</div>
                                    <div class="text-[11px] font-semibold text-slate-900 dark:text-white mt-0.5">@app.ScheduledDateFormatted</div>
                                    <div class="text-[10px] text-slate-400 dark:text-slate-500">@app.ScheduledTime12h</div>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="font-bold text-slate-900 dark:text-white">@app.CustomerName</div>
                                    <div class="text-[11px] text-slate-500 dark:text-slate-400 font-mono">@app.CustomerPhone</div>
                                </td>
                                <td class="py-4 px-6 font-semibold text-slate-800 dark:text-slate-200">
                                    <div>@app.ServiceName</div>
                                    <div class="text-[11px] text-slate-400">@app.DurationMinutes mins</div>
                                </td>
                                <td class="py-4 px-6 font-mono font-bold text-slate-900 dark:text-white">
                                    @app.FormattedPrice
                                </td>
                                <td class="py-4 px-6">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold border @badgeClass capitalize">
                                        @app.StatusString
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1.5">
                                        @if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Pending)
                                        {
                                            <form method="post" action="/barber/appointments/@app.Id/status" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="to" value="confirmed" />
                                                <button type="submit" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white hover:bg-blue-500 active:scale-95 transition shadow-xs">
                                                    Confirm
                                                </button>
                                            </form>
                                            <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'rejected')" class="px-2.5 py-1.5 rounded-xl text-xs font-bold bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200 dark:border-rose-800 active:scale-95 transition">
                                                Reject
                                            </button>
                                        }
                                        else if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Confirmed)
                                        {
                                            <form method="post" action="/barber/appointments/@app.Id/status" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="to" value="completed" />
                                                <button type="submit" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-500 active:scale-95 transition shadow-xs">
                                                    Complete
                                                </button>
                                            </form>
                                            <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'cancelled')" class="px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 active:scale-95 transition">
                                                Cancel
                                            </button>
                                        }

                                        <!-- History button -->
                                        <button type="button" onclick="openHistoryModal(@app.Id)" class="p-1.5 rounded-xl text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95 transition" title="Status History Audit">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                        </button>

                                        <!-- Detail Link -->
                                        <a href="/barber/appointments/@app.Id" class="p-1.5 rounded-xl text-slate-400 hover:text-slate-800 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95 transition" title="View Full Details">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="md:hidden divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var app in Model.Appointments)
                {
                    var badgeClass = app.Status switch
                    {
                        BarberBook.Data.Enums.AppointmentStatus.Pending => "bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border-amber-300 dark:border-amber-800",
                        BarberBook.Data.Enums.AppointmentStatus.Confirmed => "bg-blue-100 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 border-blue-300 dark:border-blue-800",
                        BarberBook.Data.Enums.AppointmentStatus.Completed => "bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800",
                        BarberBook.Data.Enums.AppointmentStatus.Cancelled => "bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border-slate-300 dark:border-slate-700",
                        BarberBook.Data.Enums.AppointmentStatus.Rejected => "bg-rose-100 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border-rose-300 dark:border-rose-800",
                        _ => "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"
                    };

                    <div class="p-4 space-y-3 hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition">
                        <div class="flex items-center justify-between">
                            <span class="font-mono text-xs font-bold text-amber-800 dark:text-amber-300">@app.ReferenceCode</span>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold border @badgeClass capitalize">
                                @app.StatusString
                            </span>
                        </div>

                        <div>
                            <div class="font-bold text-slate-900 dark:text-white text-sm">@app.CustomerName</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400">@app.ServiceName &bull; @app.FormattedPrice</div>
                        </div>

                        <div class="flex items-center justify-between text-xs pt-1 border-t border-slate-100 dark:border-slate-800 text-slate-600 dark:text-slate-300">
                            <div>
                                <span class="text-slate-400">Date:</span>
                                <span class="font-bold text-slate-800 dark:text-slate-100 ml-1">@app.ScheduledDateFormatted</span>
                            </div>
                            <div>
                                <span class="text-slate-400">Time:</span>
                                <span class="font-bold text-slate-800 dark:text-slate-100 ml-1">@app.ScheduledTime12h</span>
                            </div>
                        </div>

                        <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                            @if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Pending)
                            {
                                <div class="grid grid-cols-2 gap-2">
                                    <form method="post" action="/barber/appointments/@app.Id/status" class="w-full">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="to" value="confirmed" />
                                        <button type="submit" class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-blue-600 text-white hover:bg-blue-500 active:scale-95 transition shadow-sm text-center">
                                            Confirm
                                        </button>
                                    </form>
                                    <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'rejected')" class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 hover:bg-rose-100 dark:hover:bg-rose-900/60 border border-rose-200 dark:border-rose-800 active:scale-95 transition text-center">
                                        Reject
                                    </button>
                                </div>
                            }
                            else if (app.Status == BarberBook.Data.Enums.AppointmentStatus.Confirmed)
                            {
                                <div class="grid grid-cols-2 gap-2">
                                    <form method="post" action="/barber/appointments/@app.Id/status" class="w-full">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="to" value="completed" />
                                        <button type="submit" class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-500 active:scale-95 transition shadow-sm text-center">
                                            Complete Service
                                        </button>
                                    </form>
                                    <button type="button" onclick="openActionModal(@app.Id, '@app.ReferenceCode', 'cancelled')" class="w-full py-2.5 px-3 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 active:scale-95 transition text-center">
                                        Cancel
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center justify-between text-xs text-slate-400 dark:text-slate-500 italic py-1">
                                    <span>Terminal state &bull; Recorded in log</span>
                                    <a href="/barber/appointments/@app.Id" class="text-amber-800 dark:text-amber-400 hover:underline font-semibold not-italic">View Details &rarr;</a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </article>
</div>

<style>
    dialog:modal {
        overscroll-behavior: contain;
    }
    dialog::backdrop {
        overflow: hidden;
        overscroll-behavior: contain;
    }
</style>

<!-- Modal for Reason / Note (Reject / Cancel) -->
<dialog id="actionModal" closedby="any" class="hidden m-auto rounded-3xl p-0 bg-transparent backdrop:bg-slate-950/70 backdrop:backdrop-blur-xs max-w-md w-[calc(100%-2rem)] shadow-2xl focus:outline-none">
    <div class="bg-white dark:bg-slate-900 rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-slate-200 dark:border-slate-800 space-y-4">
        <h3 id="modalTitle" class="text-xl font-serif font-black text-slate-900 dark:text-white">Update Status</h3>
        <p id="modalDescription" class="text-xs text-slate-600 dark:text-slate-400 mt-1">Please provide an optional reason or note for this status change.</p>

        <form id="actionForm" method="post" action="" class="mt-4 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modalTargetStatus" name="to" value="" />

            <div>
                <label for="barber-action-note" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">Reason / Note <span class="text-slate-400 font-normal lowercase">(optional)</span></label>
                <textarea id="barber-action-note" name="note" rows="3" placeholder="e.g. Client requested cancellation or scheduling conflict..."
                          class="w-full px-3.5 py-2.5 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeActionModal()" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95 transition">
                    Back
                </button>
                <button type="submit" id="modalSubmitBtn" class="px-5 py-2.5 rounded-xl text-xs font-bold text-white active:scale-95 transition shadow-sm">
                    Confirm Action
                </button>
            </div>
        </form>
    </div>
</dialog>

<!-- Modal for Audit Timeline -->
<dialog id="historyModal" closedby="any" class="hidden m-auto rounded-3xl p-0 bg-transparent backdrop:bg-slate-950/70 backdrop:backdrop-blur-xs max-w-lg w-[calc(100%-2rem)] shadow-2xl focus:outline-none">
    <div class="bg-white dark:bg-slate-900 rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 dark:border-slate-800 flex flex-col max-h-[85vh]">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800">
            <div>
                <h3 class="text-xl font-serif font-black text-slate-900 dark:text-white">Status History Timeline</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Audit log of all transitions on this appointment</p>
            </div>
            <button type="button" onclick="closeHistoryModal()" class="p-2 rounded-xl text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-90 transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>

        <div id="historyTimelineContent" class="py-6 overflow-y-auto flex-1 space-y-4">
            <!-- Dynamically populated via JS -->
        </div>

        <div class="pt-4 border-t border-slate-100 dark:border-slate-800 text-right">
            <button type="button" onclick="closeHistoryModal()" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-slate-900 dark:bg-slate-800 text-white hover:bg-slate-800 dark:hover:bg-slate-700 active:scale-95 transition border border-slate-700">
                Close
            </button>
        </div>
    </div>
</dialog>

<script>
    const appointmentsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Appointments.Select(a => new {
        id = a.Id,
        refCode = a.ReferenceCode,
        histories = a.StatusHistories
    })));

    function openActionModal(id, refCode, targetStatus) {
        const form = document.getElementById('actionForm');
        form.action = `/barber/appointments/${id}/status`;
        document.getElementById('modalTargetStatus').value = targetStatus;

        const title = document.getElementById('modalTitle');
        const submitBtn = document.getElementById('modalSubmitBtn');

        if (targetStatus === 'rejected') {
            title.textContent = `Reject Appointment #${refCode}`;
            submitBtn.textContent = 'Reject Booking';
            submitBtn.className = 'px-5 py-2.5 rounded-xl text-xs font-bold bg-rose-600 hover:bg-rose-500 text-white shadow-sm active:scale-95 transition';
        } else if (targetStatus === 'cancelled') {
            title.textContent = `Cancel Appointment #${refCode}`;
            submitBtn.textContent = 'Cancel Booking';
            submitBtn.className = 'px-5 py-2.5 rounded-xl text-xs font-bold bg-slate-900 dark:bg-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 text-white shadow-sm active:scale-95 transition border border-slate-700';
        }

        const modal = document.getElementById('actionModal');
        modal.classList.remove('hidden');
        if (typeof modal.showModal === 'function') {
            try { modal.showModal(); } catch (_) {}
        }
    }

    function closeActionModal() {
        const modal = document.getElementById('actionModal');
        if (typeof modal.close === 'function') {
            try { modal.close(); } catch (_) {}
        }
        modal.classList.add('hidden');
    }

    function openHistoryModal(id) {
        const app = appointmentsData.find(a => a.id === id);
        const container = document.getElementById('historyTimelineContent');
        container.innerHTML = '';

        if (!app || !app.histories || app.histories.length === 0) {
            container.innerHTML = '<p class="text-xs text-slate-400 dark:text-slate-500 text-center py-4">No historical status records found.</p>';
        } else {
            let html = '<div class="space-y-4 relative border-l-2 border-slate-200 dark:border-slate-800 ml-4 pl-4">';
            app.histories.forEach(h => {
                html += `
                    <div class="relative">
                        <div class="absolute -left-[23px] top-1 w-3 h-3 rounded-full bg-amber-500 border-2 border-white dark:border-slate-900 shadow-xs"></div>
                        <div class="text-xs font-bold text-slate-900 dark:text-white">
                            Transition: <span class="capitalize text-slate-600 dark:text-slate-400">${h.FromStatus}</span> &rarr; <span class="capitalize text-amber-800 dark:text-amber-400 font-extrabold">${h.ToStatus}</span>
                        </div>
                        <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                            By ${h.ChangedByRole} &bull; ${h.TimestampFormatted}
                        </div>
                        ${h.Note ? `<div class="mt-1 text-xs text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-xl p-2.5 italic">"${h.Note}"</div>` : ''}
                    </div>
                `;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        const modal = document.getElementById('historyModal');
        modal.classList.remove('hidden');
        if (typeof modal.showModal === 'function') {
            try { modal.showModal(); } catch (_) {}
        }
    }

    function closeHistoryModal() {
        const modal = document.getElementById('historyModal');
        if (typeof modal.close === 'function') {
            try { modal.close(); } catch (_) {}
        }
        modal.classList.add('hidden');
    }

    document.addEventListener('DOMContentLoaded', () => {
        ['actionModal', 'historyModal'].forEach(id => {
            const modal = document.getElementById(id);
            if (!modal) return;
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    if (id === 'actionModal') closeActionModal();
                    else closeHistoryModal();
                }
            });
        });
    });
</script>
