@model BarberBook.Web.Models.Barber.BarberEquipmentViewModel
@{
    ViewData["Title"] = "My Equipment";
}

<div class="space-y-6">
    <!-- Header -->
    <article class="card bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-200/90 dark:border-slate-800 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6 transition">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 dark:bg-slate-800 border border-amber-500/30 text-amber-300 text-xs font-semibold mb-2">
                <div class="barber-pole-icon" style="height: 14px; width: 8px;"></div>
                <span>EQUIPMENT MONITORING</span>
            </div>
            <h1 class="text-3xl font-serif font-black text-slate-900 dark:text-slate-100 tracking-tight">My Assigned Equipment</h1>
            <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                Barber: <span class="font-bold text-slate-800 dark:text-slate-200">@Model.BarberName</span> &bull; Monitor your workstation clippers, shears, and chairs and record inspections.
            </p>
        </div>

        <div class="bg-amber-500/10 dark:bg-amber-500/15 border border-amber-500/30 rounded-2xl px-4 py-3 text-xs text-amber-900 dark:text-amber-300 font-medium">
            Assigned Tools: <span class="font-bold text-amber-800 dark:text-amber-200">@Model.Items.Count items</span>
        </div>
    </article>

    <!-- Equipment Cards Grid -->
    @if (!Model.Items.Any())
    {
        <article class="card bg-white dark:bg-slate-900 rounded-3xl p-16 text-center text-slate-400 dark:text-slate-500 border border-slate-200/90 dark:border-slate-800 shadow-sm transition">
            <svg class="w-12 h-12 mx-auto text-slate-300 dark:text-slate-600 mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.07a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.118.58.094 1.193-.07 1.743" /></svg>
            <p class="text-base font-semibold text-slate-700 dark:text-slate-300">No equipment currently assigned to you.</p>
            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Please consult your shop administrator to register tool assignments.</p>
        </article>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model.Items)
            {
                var condLower = item.Condition.ToLowerInvariant();
                var badgeClass = condLower.Contains("good")
                    ? "bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800"
                    : condLower.Contains("fair")
                        ? "bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border-amber-300 dark:border-amber-800"
                        : "bg-red-100 dark:bg-red-950/60 text-red-800 dark:text-red-300 border-red-300 dark:border-red-800";

                <article class="card bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm p-6 flex flex-col justify-between hover:shadow-md hover:border-amber-500/40 dark:hover:border-amber-500/40 transition">
                    <div class="space-y-4">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <span class="font-mono text-[11px] font-bold text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/50 px-2 py-0.5 rounded border border-amber-200 dark:border-amber-800">
                                    @item.SerialNumber
                                </span>
                                <h3 class="text-lg font-serif font-bold text-slate-900 dark:text-slate-100 mt-2">@item.Name</h3>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border @badgeClass shrink-0 capitalize">
                                @item.Condition
                            </span>
                        </div>

                        <div class="p-3 rounded-2xl bg-slate-50 dark:bg-slate-850 border border-slate-100 dark:border-slate-800 text-xs space-y-1.5 text-slate-600 dark:text-slate-400">
                            <div class="flex justify-between">
                                <span class="text-slate-400 dark:text-slate-500">Last Inspection:</span>
                                <span class="font-semibold text-slate-800 dark:text-slate-200">@item.LastInspectionDate</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400 dark:text-slate-500">Next Due Date:</span>
                                <span class="font-semibold text-amber-800 dark:text-amber-300">@item.NextInspectionDue</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.LastNotes))
                            {
                                <div class="pt-1.5 border-t border-slate-200/60 dark:border-slate-700/60 text-[11px] italic text-slate-500 dark:text-slate-400">
                                    "@item.LastNotes"
                                </div>
                            }
                        </div>
                    </div>

                    <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2">
                        <span class="text-[11px] text-slate-400 dark:text-slate-500 font-medium">Tag: @item.SerialNumber</span>
                        <div class="flex items-center gap-1.5">
                            <form method="post" action="/barber/equipment/@item.Id/inspect" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="condition" value="Good" />
                                <input type="hidden" name="notes" value="Daily workstation check: cleaned, oiled blades, and sanitized." />
                                <button type="submit" class="px-2.5 py-1.5 rounded-lg text-xs font-bold bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-950/70 active:scale-95 transition" title="1-click daily sanitization log">
                                    ✓ Good
                                </button>
                            </form>
                            <button type="button" onclick="openInspectionModal(@item.Id, '@item.Name', '@item.SerialNumber')"
                                    class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 active:scale-95 transition shadow-xs">
                                Log Check
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

<!-- Log Inspection Native Modal Dialog -->
<dialog id="inspectionModal" closedby="any" class="hidden m-auto rounded-3xl p-0 bg-transparent backdrop:bg-slate-950/70 backdrop:backdrop-blur-xs max-w-md w-[calc(100%-2rem)] shadow-2xl focus:outline-none">
    <div class="bg-white dark:bg-slate-900 rounded-3xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-slate-100 relative">
        <h3 id="inspectModalTitle" class="text-xl font-serif font-bold text-slate-900 dark:text-slate-100">Equipment Inspection</h3>
        <p id="inspectModalSubtitle" class="text-xs text-slate-600 dark:text-slate-400 mt-1">Record a condition audit on this tool.</p>

        <form id="inspectionForm" method="post" action="" class="mt-5 space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label for="inspect-condition" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Equipment Condition</label>
                <select id="inspect-condition" name="condition" required class="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500">
                    <option value="Good">Good - Fully operational and sanitized</option>
                    <option value="Fair">Fair - Minor wear, acceptable for service</option>
                    <option value="Needs Maintenance">Needs Maintenance - Dull blades or requires service</option>
                    <option value="Poor">Poor - Out of service</option>
                </select>
            </div>

            <div>
                <label for="inspect-notes" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1">Audit Notes / Sanitization Log (optional)</label>
                <textarea id="inspect-notes" name="notes" rows="3" placeholder="e.g. Cleaned, oiled blades, tension adjusted..."
                          class="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500/20 focus:border-amber-500"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2">
                <button type="button" onclick="closeInspectionModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95 transition">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 rounded-xl text-xs font-bold bg-amber-500 text-slate-950 hover:bg-amber-400 active:scale-[0.98] transition shadow-sm">
                    Record Inspection
                </button>
            </div>
        </form>
    </div>
</dialog>

<style>
    dialog:modal {
        overscroll-behavior: contain;
    }
</style>

<script>
    function openInspectionModal(id, name, serial) {
        const modal = document.getElementById('inspectionModal');
        const form = document.getElementById('inspectionForm');
        form.action = `/barber/equipment/${id}/inspect`;
        document.getElementById('inspectModalTitle').textContent = `Log Inspection: ${name}`;
        document.getElementById('inspectModalSubtitle').textContent = `Serial No: ${serial}`;
        modal.classList.remove('hidden');
        modal.showModal();
    }

    function closeInspectionModal() {
        const modal = document.getElementById('inspectionModal');
        modal.close();
        modal.classList.add('hidden');
    }

    const inspectionDialog = document.getElementById('inspectionModal');
    if (inspectionDialog) {
        inspectionDialog.addEventListener('cancel', (e) => {
            e.preventDefault();
            closeInspectionModal();
        });
        inspectionDialog.addEventListener('click', (e) => {
            if (e.target === inspectionDialog) {
                closeInspectionModal();
            }
        });
    }
</script>

